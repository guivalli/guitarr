+++ b/server/seerapi/settings.go
@@ -0,0 +1,35 @@
+package seerapi
+
+import (
+	"context"
+	"encoding/json"
+	"net/http"
+
+	"github.com/navidrome/navidrome/log"
+)
+
+// Settings are the switches an admin changes from the UI.
+type Settings interface {
+	AutoApprove(ctx context.Context) bool
+	SetAutoApprove(ctx context.Context, on bool) error
+}
+
+func (api *Router) getSettings(w http.ResponseWriter, r *http.Request) {
+	writeJSON(w, http.StatusOK, map[string]bool{"autoApprove": api.settings.AutoApprove(r.Context())})
+}
+
+func (api *Router) setSettings(w http.ResponseWriter, r *http.Request) {
+	var body struct {
+		AutoApprove *bool `json:"autoApprove"`
+	}
+	if err := json.NewDecoder(http.MaxBytesReader(w, r.Body, 4<<10)).Decode(&body); err != nil || body.AutoApprove == nil {
+		http.Error(w, "invalid body", http.StatusBadRequest)
+		return
+	}
+	if err := api.settings.SetAutoApprove(r.Context(), *body.AutoApprove); err != nil {
+		log.Error(r.Context(), "Seer: saving settings failed", err)
+		http.Error(w, "internal error", http.StatusInternalServerError)
+		return
+	}
+	api.getSettings(w, r)
+}
