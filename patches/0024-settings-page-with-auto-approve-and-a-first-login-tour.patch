@@ -0,0 +1,56 @@
+import { useEffect, useState } from 'react'
+import { Button, FormControlLabel, Switch, Typography } from '@material-ui/core'
+import { Title, useNotify, useTranslate } from 'react-admin'
+import { getSeerSettings, setSeerSettings } from './api'
+import { Section } from './components'
+
+export const SeerSettings = () => {
+  const translate = useTranslate()
+  const notify = useNotify()
+  const [settings, setSettings] = useState(null)
+
+  useEffect(() => {
+    getSeerSettings()
+      .then(setSettings)
+      .catch(() => notify('resources.seer.settings.loadError', 'warning'))
+  }, [notify])
+
+  const toggleAutoApprove = (e) => {
+    setSeerSettings({ autoApprove: e.target.checked })
+      .then(setSettings)
+      .catch(() => notify('resources.seer.settings.saveError', 'warning'))
+  }
+
+  return (
+    <div style={{ padding: 24, maxWidth: 720 }}>
+      <Title title={translate('resources.seer.settings.title')} />
+      <Section title={translate('resources.seer.settings.requests')}>
+        <div data-tour="auto-approve" style={{ marginTop: 12 }}>
+          <FormControlLabel
+            control={
+              <Switch
+                color="primary"
+                checked={!!settings?.autoApprove}
+                disabled={!settings}
+                onChange={toggleAutoApprove}
+              />
+            }
+            label={translate('resources.seer.settings.autoApprove')}
+          />
+          <Typography variant="body2" color="textSecondary">
+            {translate('resources.seer.settings.autoApproveHint')}
+          </Typography>
+        </div>
+      </Section>
+      <Section title={translate('resources.seer.settings.help')}>
+        <Button
+          variant="outlined"
+          style={{ marginTop: 12 }}
+          onClick={() => window.dispatchEvent(new CustomEvent('seer:tour'))}
+        >
+          {translate('resources.seer.settings.restartTour')}
+        </Button>
+      </Section>
+    </div>
+  )
+}
