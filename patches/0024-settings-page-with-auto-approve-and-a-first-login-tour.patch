@@ -0,0 +1,227 @@
+import { useCallback, useEffect, useState } from 'react'
+import { Button, Paper, Typography } from '@material-ui/core'
+import { makeStyles } from '@material-ui/core/styles'
+import { useHistory, useLocation } from 'react-router-dom'
+import { usePermissions, useTranslate } from 'react-admin'
+import { getClientState, putClientState } from './api'
+
+// One step per feature. `target` is a data-tour attribute on the page; a step without one, or
+// whose target is not on screen, is shown in the middle of the page.
+const STEPS = [
+  { id: 'welcome' },
+  { id: 'search', path: '/seer', target: 'search' },
+  { id: 'requests', path: '/seer', target: 'requests' },
+  { id: 'imports', path: '/seer', target: 'imports' },
+  { id: 'podcasts', path: '/seer', target: 'podcasts' },
+  { id: 'storage', target: 'storage' },
+  { id: 'album', admin: true },
+  { id: 'approval', admin: true, path: '/seersettings', target: 'auto-approve' },
+  { id: 'done' },
+]
+
+const CARD_HEIGHT = 230
+const CARD_WIDTH = 360
+
+const useStyles = makeStyles((theme) => ({
+  dim: {
+    position: 'fixed',
+    top: 0,
+    right: 0,
+    bottom: 0,
+    left: 0,
+    zIndex: 1400,
+    background: 'rgba(0,0,0,0.72)',
+  },
+  spot: {
+    position: 'fixed',
+    zIndex: 1400,
+    borderRadius: 12,
+    boxShadow: '0 0 0 9999px rgba(0,0,0,0.72)',
+    transition: 'all 250ms ease',
+    pointerEvents: 'none',
+  },
+  card: {
+    position: 'fixed',
+    zIndex: 1401,
+    width: `min(${CARD_WIDTH}px, calc(100vw - 32px))`,
+    padding: theme.spacing(2.5),
+    borderRadius: 16,
+  },
+  actions: {
+    display: 'flex',
+    alignItems: 'center',
+    gap: theme.spacing(1),
+    marginTop: theme.spacing(2),
+  },
+  grow: { flex: 1 },
+}))
+
+// The card sits under the highlighted element, or above it when there is no room below.
+const cardPosition = (rect) => {
+  if (!rect) {
+    return { top: '50%', left: '50%', transform: 'translate(-50%, -50%)' }
+  }
+  const left = Math.min(
+    Math.max(rect.left, 16),
+    window.innerWidth - CARD_WIDTH - 16,
+  )
+  const below = rect.bottom + CARD_HEIGHT < window.innerHeight
+  return below
+    ? { top: rect.bottom + 16, left }
+    : { top: Math.max(16, rect.top - CARD_HEIGHT), left }
+}
+
+const findTarget = (step) =>
+  step?.target
+    ? document.querySelector(`[data-tour="${step.target}"]`)
+    : null
+
+// The first-login tour. It runs once per user (the "done" flag lives in the server-side client
+// state, so it follows the user to every browser) and can be replayed from Settings.
+export const SeerTour = () => {
+  const classes = useStyles()
+  const translate = useTranslate()
+  const history = useHistory()
+  const location = useLocation()
+  const { permissions } = usePermissions()
+  const isAdmin = permissions === 'admin'
+  const [active, setActive] = useState(false)
+  const [index, setIndex] = useState(0)
+  const [rect, setRect] = useState(null)
+
+  const steps = STEPS.filter((s) => !s.admin || isAdmin)
+  const step = steps[index]
+  const last = index === steps.length - 1
+
+  const start = useCallback(() => {
+    setIndex(0)
+    setActive(true)
+  }, [])
+
+  const finish = useCallback(() => {
+    setActive(false)
+    putClientState({ tour: { done: true } }).catch(() => {})
+  }, [])
+
+  // First login: start unless this user already finished or skipped the tour.
+  useEffect(() => {
+    getClientState()
+      .then((st) => {
+        if (!st?.tour?.done) start()
+      })
+      .catch(() => {})
+  }, [start])
+
+  useEffect(() => {
+    window.addEventListener('seer:tour', start)
+    return () => window.removeEventListener('seer:tour', start)
+  }, [start])
+
+  useEffect(() => {
+    if (!active) return undefined
+    const onKey = (e) => {
+      if (e.key === 'Escape') finish()
+    }
+    window.addEventListener('keydown', onKey)
+    return () => window.removeEventListener('keydown', onKey)
+  }, [active, finish])
+
+  // Go to the step's page, then wait for its target to render and highlight it.
+  useEffect(() => {
+    if (!active || !step) return undefined
+    if (step.path && location.pathname !== step.path) {
+      history.push(step.path)
+      return undefined
+    }
+    let tries = 0
+    let timer
+    const locate = () => {
+      const el = findTarget(step)
+      if (el) {
+        el.scrollIntoView({ block: 'center', behavior: 'smooth' })
+        setRect(el.getBoundingClientRect())
+      } else if (step.target && tries < 15) {
+        tries += 1
+        timer = setTimeout(locate, 150)
+      } else {
+        setRect(null)
+      }
+    }
+    const remeasure = () => {
+      const el = findTarget(step)
+      setRect(el ? el.getBoundingClientRect() : null)
+    }
+    locate()
+    window.addEventListener('resize', remeasure)
+    window.addEventListener('scroll', remeasure, true)
+    return () => {
+      clearTimeout(timer)
+      window.removeEventListener('resize', remeasure)
+      window.removeEventListener('scroll', remeasure, true)
+    }
+  }, [active, step, location.pathname, history])
+
+  if (!active || !step) return null
+
+  const next = () => (last ? finish() : setIndex((i) => i + 1))
+  const back = () => setIndex((i) => Math.max(0, i - 1))
+
+  return (
+    <>
+      {rect ? (
+        <div
+          className={classes.spot}
+          style={{
+            top: rect.top - 8,
+            left: rect.left - 8,
+            width: rect.width + 16,
+            height: rect.height + 16,
+          }}
+        />
+      ) : (
+        <div className={classes.dim} />
+      )}
+      <Paper
+        className={classes.card}
+        style={cardPosition(rect)}
+        role="dialog"
+        aria-label={translate(`resources.seer.tour.${step.id}.title`)}
+        elevation={8}
+      >
+        <Typography variant="overline" color="textSecondary">
+          {translate('resources.seer.tour.progress', {
+            current: index + 1,
+            total: steps.length,
+          })}
+        </Typography>
+        <Typography variant="h6" component="h2" gutterBottom>
+          {translate(`resources.seer.tour.${step.id}.title`)}
+        </Typography>
+        <Typography variant="body2" color="textSecondary">
+          {translate(`resources.seer.tour.${step.id}.text`)}
+        </Typography>
+        <div className={classes.actions}>
+          <Button size="small" onClick={finish}>
+            {translate('resources.seer.tour.skip')}
+          </Button>
+          <span className={classes.grow} />
+          {index > 0 && (
+            <Button size="small" onClick={back}>
+              {translate('resources.seer.tour.back')}
+            </Button>
+          )}
+          <Button
+            size="small"
+            variant="contained"
+            color="primary"
+            onClick={next}
+          >
+            {translate(
+              last ? 'resources.seer.tour.finish' : 'resources.seer.tour.next',
+            )}
+          </Button>
+        </div>
+      </Paper>
+    </>
+  )
+}
