diff --git a/core/seer/settings.go b/core/seer/settings.go
new file mode 100644
index 0000000..7913621
--- /dev/null
+++ b/core/seer/settings.go
@@ -0,0 +1,36 @@
+package seer
+
+import (
+	"context"
+	"strconv"
+
+	"github.com/navidrome/navidrome/conf"
+	"github.com/navidrome/navidrome/model"
+)
+
+const autoApproveKey = "seer.autoapprove"
+
+// Settings are the switches an admin changes in the UI. They are kept in the property table, so a
+// change survives restarts; until one is saved, the configuration file decides.
+type Settings struct {
+	ds model.DataStore
+}
+
+func NewSettings(ds model.DataStore) *Settings {
+	return &Settings{ds: ds}
+}
+
+// AutoApprove reports whether new requests are queued without waiting for an admin.
+func (s *Settings) AutoApprove(ctx context.Context) bool {
+	def := strconv.FormatBool(conf.Server.Seer.AutoApprove)
+	v, err := s.ds.Property().DefaultGet(ctx, autoApproveKey, def)
+	if err != nil {
+		return conf.Server.Seer.AutoApprove
+	}
+	return v == "true"
+}
+
+// SetAutoApprove saves the switch.
+func (s *Settings) SetAutoApprove(ctx context.Context, on bool) error {
+	return s.ds.Property().Put(ctx, autoApproveKey, strconv.FormatBool(on))
+}
