+
+func TestParseRSSFeedChannelImage(t *testing.T) {
+	const ns = `xmlns:itunes="http://www.itunes.com/dtds/podcast-1.0.dtd"`
+	cases := []struct{ name, xml, want string }{
+		{"itunes only (Anchor)", `<rss ` + ns + `><channel><title>A</title><itunes:image href="https://x/a.jpg"/>` +
+			`<item><enclosure url="https://x/1.mp3"/></item></channel></rss>`, "https://x/a.jpg"},
+		{"plain image only", `<rss ` + ns + `><channel><title>A</title><image><url>https://x/b.jpg</url></image>` +
+			`<item><enclosure url="https://x/1.mp3"/></item></channel></rss>`, "https://x/b.jpg"},
+		{"both prefers itunes", `<rss ` + ns + `><channel><image><url>https://x/b.jpg</url></image><itunes:image href="https://x/a.jpg"/>` +
+			`</channel></rss>`, "https://x/a.jpg"},
+		{"episode art fallback", `<rss ` + ns + `><channel><title>A</title>` +
+			`<item><enclosure url="https://x/1.mp3"/><itunes:image href="https://x/e.jpg"/></item></channel></rss>`, "https://x/e.jpg"},
+	}
+	for _, c := range cases {
+		f, err := parseRSSFeed([]byte(c.xml), "https://x/feed")
+		if err != nil {
+			t.Fatalf("%s: %v", c.name, err)
+		}
+		if f.ImageURL != c.want {
+			t.Errorf("%s: ImageURL = %q, want %q", c.name, f.ImageURL, c.want)
+		}
+	}
+}
