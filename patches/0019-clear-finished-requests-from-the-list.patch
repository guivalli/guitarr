@@ -0,0 +1,36 @@
+package acquire
+
+import "context"
+
+// ClearFinished forgets the finished requests (available or failed) of one user, or of
+// everybody when userID is empty. Requests in any other status are left alone, and the
+// music files stay where they are: only the request records go. It returns how many went.
+func (s *Service) ClearFinished(ctx context.Context, userID string, statuses ...Status) (int, error) {
+	reqs, err := s.store.List(ctx, userID)
+	if err != nil {
+		return 0, err
+	}
+	removed := 0
+	for _, r := range reqs {
+		if r.Status != StatusAvailable && r.Status != StatusFailed {
+			continue
+		}
+		if !contains(statuses, r.Status) {
+			continue
+		}
+		if err := s.store.Delete(ctx, r.ID); err != nil {
+			return removed, err
+		}
+		removed++
+	}
+	return removed, nil
+}
+
+func contains(list []Status, want Status) bool {
+	for _, s := range list {
+		if s == want {
+			return true
+		}
+	}
+	return false
+}
