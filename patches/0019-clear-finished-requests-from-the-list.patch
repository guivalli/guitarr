+++ b/core/acquire/clear_test.go
@@ -0,0 +1,45 @@
+package acquire
+
+import (
+	"context"
+	"errors"
+	"testing"
+)
+
+func TestClearFinishedKeepsActiveRequests(t *testing.T) {
+	lib := &fakeLib{have: map[string]bool{}}
+	st := NewMemoryStore()
+	svc := NewService(fastConfig(false), fakeCatalog{}, nil, st, lib)
+	ctx := context.Background()
+	add := func(id, user string, status Status) {
+		if err := st.Create(ctx, &Request{ID: id, UserID: user, Kind: KindTrack, MBID: id, Status: status}); err != nil {
+			t.Fatal(err)
+		}
+	}
+	add("ok", "u1", StatusAvailable)
+	add("bad", "u1", StatusFailed)
+	add("busy", "u1", StatusDownloading)
+	add("other", "u2", StatusFailed)
+
+	if n, err := svc.ClearFinished(ctx, "u1", StatusAvailable, StatusFailed); err != nil || n != 2 {
+		t.Fatalf("user clear removed %d (%v), want 2", n, err)
+	}
+	if _, err := st.Get(ctx, "ok"); !errors.Is(err, ErrNotFound) {
+		t.Errorf("available request should be gone, got %v", err)
+	}
+	if _, err := st.Get(ctx, "busy"); err != nil {
+		t.Errorf("a request in progress must stay: %v", err)
+	}
+	if _, err := st.Get(ctx, "other"); err != nil {
+		t.Errorf("another user's request must stay: %v", err)
+	}
+	if n, _ := svc.ClearFinished(ctx, "", StatusFailed); n != 1 {
+		t.Errorf("admin clear of failed removed %d, want 1 (only other's)", n)
+	}
+	if n, _ := svc.ClearFinished(ctx, "", StatusDownloading); n != 0 {
+		t.Errorf("only finished requests can be cleared, removed %d", n)
+	}
+	if _, err := st.Get(ctx, "busy"); err != nil {
+		t.Errorf("the request in progress was removed: %v", err)
+	}
+}
