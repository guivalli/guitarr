+// clearRequests forgets the finished requests named in ?status=available,failed.
+// Like the list, admins clear everybody's unless ?mine=true. The music stays.
+func (api *Router) clearRequests(w http.ResponseWriter, r *http.Request) {
+	q := r.URL.Query().Get("status")
+	if q == "" {
+		http.Error(w, "status is required (available, failed)", http.StatusBadRequest)
+		return
+	}
+	user, _ := request.UserFrom(r.Context())
+	userID := user.ID
+	if user.IsAdmin && r.URL.Query().Get("mine") != "true" {
+		userID = ""
+	}
+	var statuses []acquire.Status
+	for _, s := range strings.Split(q, ",") {
+		statuses = append(statuses, acquire.Status(strings.TrimSpace(s)))
+	}
+	n, err := api.svc.ClearFinished(r.Context(), userID, statuses...)
+	if err != nil {
+		log.Error(r.Context(), "Seer: clearing requests failed", err)
+		http.Error(w, "internal error", http.StatusInternalServerError)
+		return
+	}
+	writeJSON(w, http.StatusOK, map[string]int{"removed": n})
+}
