+++ b/core/seer/report.go
@@ -0,0 +1,211 @@
+package seer
+
+import (
+	"context"
+	"sort"
+	"strings"
+	"unicode"
+
+	. "github.com/Masterminds/squirrel"
+	"github.com/navidrome/navidrome/model"
+	"golang.org/x/text/unicode/norm"
+)
+
+// MetaReport tells what is messy in the library tags: albums and artists that only differ by
+// case, accents or punctuation, albums without MusicBrainz ids and tracks without tags.
+type MetaReport struct {
+	Songs        int            `json:"songs"`
+	Albums       int            `json:"albums"`
+	Artists      int            `json:"artists"`
+	WithMBID     int            `json:"songsWithAlbumMbid"`
+	AlbumGroups  []AlbumGroup   `json:"albumGroups"`
+	ArtistGroups []ArtistGroup  `json:"artistGroups"`
+	NoMBID       []AlbumVariant `json:"noMbid"`
+	Unknown      []UnknownTrack `json:"unknown"`
+}
+
+// AlbumVariant is one album record of the library.
+type AlbumVariant struct {
+	ID                string `json:"id"`
+	Name              string `json:"name"`
+	Artist            string `json:"artist"`
+	Songs             int    `json:"songs"`
+	Year              int    `json:"year,omitempty"`
+	MbzAlbumID        string `json:"mbzAlbumId,omitempty"`
+	MbzReleaseGroupID string `json:"mbzReleaseGroupId,omitempty"`
+	MbzAlbumArtistID  string `json:"mbzAlbumArtistId,omitempty"`
+}
+
+// AlbumGroup is a set of albums that are the same album written differently.
+type AlbumGroup struct {
+	Variants []AlbumVariant `json:"variants"`
+	// SameReleaseGroup: they are editions of one MusicBrainz release group (e.g. clean and explicit).
+	SameReleaseGroup bool `json:"sameReleaseGroup"`
+}
+
+// ArtistVariant is one spelling of an artist, with the albums and tracks that carry it.
+type ArtistVariant struct {
+	Name    string   `json:"name"`
+	Tracks  int      `json:"tracks"`
+	Albums  []string `json:"albums"`  // albums whose album artist is this spelling
+	SongIDs []string `json:"songIds"` // tracks whose artist is this spelling
+}
+
+// ArtistGroup is a set of artist names that are the same artist written differently.
+type ArtistGroup struct {
+	Variants []ArtistVariant `json:"variants"`
+}
+
+// UnknownTrack is a track whose album or artist tag is missing.
+type UnknownTrack struct {
+	ID     string `json:"id"`
+	Title  string `json:"title"`
+	Artist string `json:"artist"`
+	Album  string `json:"album"`
+	Path   string `json:"path"`
+}
+
+// looseKey lowercases and keeps only letters and digits (accents dropped), so "Lavô Tá Novo",
+// "lavo ta novo" and "blink‐182" / "blink-182" are the same key.
+func looseKey(s string) string {
+	var sb strings.Builder
+	for _, r := range norm.NFD.String(strings.ToLower(s)) {
+		if unicode.IsLetter(r) || unicode.IsDigit(r) {
+			sb.WriteRune(r)
+		}
+	}
+	return sb.String()
+}
+
+const maxReportRows = 300
+
+func isUnknown(s string) bool {
+	return strings.HasPrefix(strings.ToLower(strings.TrimSpace(s)), "[unknown")
+}
+
+// Report analyzes the whole library; it does not change anything.
+func (e *Editor) Report(ctx context.Context) (*MetaReport, error) {
+	albums, err := e.ds.Album().GetAll(ctx, model.QueryOptions{Filters: Eq{"album.missing": false}})
+	if err != nil {
+		return nil, err
+	}
+	files, err := e.ds.MediaFile().GetAll(ctx, model.QueryOptions{Filters: Eq{"media_file.missing": false}})
+	if err != nil {
+		return nil, err
+	}
+	return buildMetaReport(albums, files), nil
+}
+
+func buildMetaReport(albums model.Albums, files model.MediaFiles) *MetaReport {
+	r := &MetaReport{Songs: len(files), Albums: len(albums),
+		AlbumGroups: []AlbumGroup{}, ArtistGroups: []ArtistGroup{}, NoMBID: []AlbumVariant{}, Unknown: []UnknownTrack{}}
+
+	// --- albums that are the same once case, accents and punctuation are ignored
+	byKey := map[string][]AlbumVariant{}
+	var keys []string
+	for _, a := range albums {
+		v := AlbumVariant{ID: a.ID, Name: a.Name, Artist: a.AlbumArtist, Songs: a.SongCount, Year: a.MinYear,
+			MbzAlbumID: a.MbzAlbumID, MbzReleaseGroupID: a.MbzReleaseGroupID, MbzAlbumArtistID: a.MbzAlbumArtistID}
+		if isUnknown(a.Name) {
+			continue
+		}
+		k := looseKey(a.AlbumArtist) + "|" + looseKey(a.Name)
+		if _, ok := byKey[k]; !ok {
+			keys = append(keys, k)
+		}
+		byKey[k] = append(byKey[k], v)
+		if a.MbzAlbumID == "" && len(r.NoMBID) < maxReportRows {
+			r.NoMBID = append(r.NoMBID, v)
+		}
+	}
+	sort.Strings(keys)
+	for _, k := range keys {
+		vs := byKey[k]
+		if len(vs) < 2 {
+			continue
+		}
+		sort.SliceStable(vs, func(i, j int) bool { return vs[i].Songs > vs[j].Songs })
+		same := vs[0].MbzReleaseGroupID != ""
+		for _, v := range vs[1:] {
+			if v.MbzReleaseGroupID != vs[0].MbzReleaseGroupID {
+				same = false
+			}
+		}
+		r.AlbumGroups = append(r.AlbumGroups, AlbumGroup{Variants: vs, SameReleaseGroup: same})
+	}
+
+	// --- artists spelled differently (track artist and album artist both count)
+	type spelling struct {
+		tracks int
+		albums map[string]bool
+		songs  []string
+	}
+	byArtist := map[string]map[string]*spelling{}
+	add := func(name, albumID, songID string) {
+		name = strings.TrimSpace(name)
+		k := looseKey(name)
+		if name == "" || k == "" || isUnknown(name) {
+			return
+		}
+		m := byArtist[k]
+		if m == nil {
+			m = map[string]*spelling{}
+			byArtist[k] = m
+		}
+		sp := m[name]
+		if sp == nil {
+			sp = &spelling{albums: map[string]bool{}}
+			m[name] = sp
+		}
+		if albumID != "" {
+			sp.albums[albumID] = true
+		}
+		if songID != "" {
+			sp.tracks++
+			if len(sp.songs) < 500 {
+				sp.songs = append(sp.songs, songID)
+			}
+		}
+	}
+	for _, a := range albums {
+		add(a.AlbumArtist, a.ID, "")
+	}
+	artists := map[string]bool{}
+	for _, f := range files {
+		add(f.Artist, "", f.ID)
+		artists[looseKey(f.Artist)] = true
+		if f.MbzAlbumID != "" {
+			r.WithMBID++
+		}
+		if (isUnknown(f.Album) || isUnknown(f.Artist)) && len(r.Unknown) < maxReportRows {
+			r.Unknown = append(r.Unknown, UnknownTrack{ID: f.ID, Title: f.Title, Artist: f.Artist, Album: f.Album, Path: f.Path})
+		}
+	}
+	r.Artists = len(artists)
+	var akeys []string
+	for k, m := range byArtist {
+		if len(m) > 1 {
+			akeys = append(akeys, k)
+		}
+	}
+	sort.Strings(akeys)
+	for _, k := range akeys {
+		var g ArtistGroup
+		for name, sp := range byArtist[k] {
+			ids := make([]string, 0, len(sp.albums))
+			for id := range sp.albums {
+				ids = append(ids, id)
+			}
+			sort.Strings(ids)
+			g.Variants = append(g.Variants, ArtistVariant{Name: name, Tracks: sp.tracks, Albums: ids, SongIDs: sp.songs})
+		}
+		sort.SliceStable(g.Variants, func(i, j int) bool {
+			if g.Variants[i].Tracks != g.Variants[j].Tracks {
+				return g.Variants[i].Tracks > g.Variants[j].Tracks
+			}
+			return g.Variants[i].Name < g.Variants[j].Name
+		})
+		r.ArtistGroups = append(r.ArtistGroups, g)
+	}
+	return r
+}
diff --git a/core/seer/report_test.go b/core/seer/report_test.go
new file mode 100644
index 0000000..4e699b6
--- /dev/null
+++ b/core/seer/report_test.go
@@ -0,0 +1,45 @@
+package seer
+
+import (
+	"testing"
+
+	"github.com/navidrome/navidrome/model"
+)
+
+func TestBuildReportFindsNearDuplicates(t *testing.T) {
+	albums := model.Albums{
+		{ID: "a1", Name: "Cantigas de Roda", AlbumArtist: "Raimundos", SongCount: 1, MbzAlbumID: "x"},
+		{ID: "a2", Name: "Cantigas de roda", AlbumArtist: "Raimundos", SongCount: 3},
+		{ID: "a3", Name: "Dude Ranch", AlbumArtist: "blink\u2010182", SongCount: 16},
+		{ID: "a4", Name: "Dude Ranch", AlbumArtist: "blink-182", SongCount: 2},
+		{ID: "a5", Name: "[Unknown Album]", AlbumArtist: "[Unknown Artist]", SongCount: 1},
+	}
+	files := model.MediaFiles{
+		{ID: "s1", Title: "Faixa", Artist: "Charlie Brown Jr.", Album: "X"},
+		{ID: "s2", Title: "Faixa 2", Artist: "Charlie Brown Jr", Album: "X", MbzAlbumID: "m"},
+		{ID: "s3", Title: "?", Artist: "[Unknown Artist]", Album: "[Unknown Album]"},
+	}
+	r := buildMetaReport(albums, files)
+	if len(r.AlbumGroups) != 2 {
+		t.Fatalf("album groups = %d, want 2 (%+v)", len(r.AlbumGroups), r.AlbumGroups)
+	}
+	for _, g := range r.AlbumGroups {
+		if g.Variants[0].Songs < g.Variants[1].Songs {
+			t.Errorf("variants should start with the biggest: %+v", g.Variants)
+		}
+	}
+	if len(r.ArtistGroups) != 2 {
+		t.Fatalf("artist groups = %d, want 2 (blink-182 and Charlie Brown Jr): %+v", len(r.ArtistGroups), r.ArtistGroups)
+	}
+	if len(r.Unknown) != 1 || r.Unknown[0].ID != "s3" {
+		t.Errorf("unknown = %+v", r.Unknown)
+	}
+	if r.WithMBID != 1 || r.Songs != 3 {
+		t.Errorf("counts: %+v", r)
+	}
+	for _, v := range r.NoMBID {
+		if isUnknown(v.Name) {
+			t.Errorf("[Unknown Album] must not be listed as a match candidate")
+		}
+	}
+}
