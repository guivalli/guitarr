+
+// metadataReport lists the albums and artists that are the same thing written differently,
+// the albums without MusicBrainz ids and the tracks without tags (it changes nothing).
+func (api *Router) metadataReport(w http.ResponseWriter, r *http.Request) {
+	rep, err := api.editor.Report(r.Context())
+	if err != nil {
+		log.Error(r.Context(), "Seer: metadata report failed", err)
+		http.Error(w, err.Error(), http.StatusInternalServerError)
+		return
+	}
+	writeJSON(w, http.StatusOK, rep)
+}
