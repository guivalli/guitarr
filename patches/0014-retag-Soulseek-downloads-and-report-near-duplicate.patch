+++ b/core/acquire/retag_test.go
@@ -0,0 +1,65 @@
+package acquire
+
+import (
+	"reflect"
+	"strings"
+	"testing"
+)
+
+const (
+	rgID   = "d40233d7-f8af-3daa-9c29-a96bac9b2a7c"
+	relID  = "fdde6a1a-8559-4c90-9ed0-e4f040a9e6ca"
+	artID  = "0743b15a-3c32-48c8-ad58-cb325350befa"
+	recID1 = "11111111-1111-4111-8111-111111111111"
+	recID2 = "22222222-2222-4222-8222-222222222222"
+)
+
+func sampleAlbum() *AlbumDetail {
+	return &AlbumDetail{
+		Album: CatalogItem{Kind: KindAlbum, MBID: rgID, ReleaseID: relID, Title: "Greatest Hits", Artist: "blink\u2010182", ArtistMBID: artID, Year: 2005},
+		Tracks: []CatalogItem{
+			{Kind: KindTrack, MBID: recID1, Title: "Dammit", Artist: "blink\u2010182", ArtistMBID: artID, TrackNumber: 1},
+			{Kind: KindTrack, MBID: recID2, Title: "What\u2019s My Age Again?", Artist: "blink\u2010182", ArtistMBID: artID, TrackNumber: 2},
+		},
+	}
+}
+
+func TestMatchTracksByTitleThenNumber(t *testing.T) {
+	paths := []string{"/m/01 - dammit.flac", "/m/02 whats my age again.flac", "/m/09 - Faixa Estranha.flac"}
+	got := matchTracks(paths, sampleAlbum().Tracks)
+	want := map[int]int{0: 0, 1: 1}
+	if !reflect.DeepEqual(got, want) {
+		t.Errorf("matchTracks = %v, want %v", got, want)
+	}
+	// só o número no nome: cai no número da faixa
+	got = matchTracks([]string{"/m/02.flac"}, sampleAlbum().Tracks)
+	if got[0] != 1 {
+		t.Errorf("number-only name should map to track 2, got %v", got)
+	}
+}
+
+func TestAlbumTagPlansNormalizeNamesAndIds(t *testing.T) {
+	plans := albumTagPlans(sampleAlbum(), []string{"/m/01 - dammit.flac", "/m/bonus.flac"})
+	if len(plans) != 2 {
+		t.Fatalf("plans = %d", len(plans))
+	}
+	first := strings.Join(plans[0].tags, "|")
+	for _, want := range []string{"album=Greatest Hits", "album_artist=blink\u2010182", "date=2005", "title=Dammit", "track=1",
+		"MUSICBRAINZ_RELEASEGROUPID=" + rgID, "MUSICBRAINZ_ALBUMID=" + relID, "MUSICBRAINZ_ALBUMARTISTID=" + artID,
+		"MUSICBRAINZ_TRACKID=" + recID1, "MUSICBRAINZ_ARTISTID=" + artID} {
+		if !strings.Contains(first, want) {
+			t.Errorf("tags missing %q in %s", want, first)
+		}
+	}
+	// arquivo sem faixa correspondente: só os dados do álbum, sem título inventado
+	second := strings.Join(plans[1].tags, "|")
+	if strings.Contains(second, "title=") || !strings.Contains(second, "album=Greatest Hits") {
+		t.Errorf("unmatched file tags = %s", second)
+	}
+}
+
+func TestLooseKey(t *testing.T) {
+	if looseKey("Lavô Tá Novo") != looseKey("lavo ta novo") || looseKey("blink\u2010182") != looseKey("blink-182") {
+		t.Error("looseKey should ignore case, accents and punctuation")
+	}
+}
