diff --git a/core/acquire/retag.go b/core/acquire/retag.go
new file mode 100644
index 0000000..b45ab5f
--- /dev/null
+++ b/core/acquire/retag.go
@@ -0,0 +1,190 @@
+package acquire
+
+import (
+	"context"
+	"fmt"
+	"path/filepath"
+	"regexp"
+	"strconv"
+	"strings"
+	"unicode"
+
+	"golang.org/x/text/unicode/norm"
+)
+
+// tagPlan is the set of tags to write into one downloaded file.
+type tagPlan struct {
+	path string
+	tags []string
+}
+
+// retag writes the MusicBrainz names and ids into files that a source downloaded with the
+// uploader's own tags (Soulseek). Without this the same album arrives as "Greatest Hits",
+// "greatest hits" or "Greatest Hits (Explicit)" and the library fills with near duplicates.
+// A failure never fails the request: it only adds a warning.
+func (s *Service) retag(ctx context.Context, req *Request, res Result) Result {
+	if res.Tagged || len(res.Paths) == 0 || !ValidMBID(req.MBID) {
+		return res
+	}
+	var plans []tagPlan
+	switch req.Kind {
+	case KindTrack:
+		plans = []tagPlan{{path: res.Paths[0], tags: requestTags(*req)}}
+	case KindAlbum:
+		detail, err := s.catalog.Album(ctx, req.MBID)
+		if err != nil || detail == nil {
+			return addWarning(res, "tags were not normalized (MusicBrainz did not answer)")
+		}
+		plans = albumTagPlans(detail, res.Paths)
+	}
+	ffmpeg := cmp(s.cfg.FFmpeg, "ffmpeg")
+	failed := 0
+	for _, p := range plans {
+		if err := writeTags(ctx, ffmpeg, p.path, p.tags); err != nil {
+			failed++
+		}
+	}
+	if failed > 0 {
+		res = addWarning(res, fmt.Sprintf("%d file(s) kept the original tags", failed))
+	}
+	return res
+}
+
+func addWarning(res Result, w string) Result {
+	if res.Warning == "" {
+		res.Warning = w
+	} else {
+		res.Warning += "; " + w
+	}
+	return res
+}
+
+// requestTags are the tags of a single requested track.
+func requestTags(req Request) []string {
+	tags := []string{"title=" + req.Title, "artist=" + req.Artist, "album_artist=" + cmp(req.AlbumArtist, req.Artist)}
+	if req.Album != "" {
+		tags = append(tags, "album="+req.Album)
+	}
+	if req.TrackNumber > 0 {
+		tags = append(tags, fmt.Sprintf("track=%d", req.TrackNumber))
+	}
+	if req.Kind == KindTrack && ValidMBID(req.MBID) {
+		tags = append(tags, "MUSICBRAINZ_TRACKID="+req.MBID)
+	}
+	return tags
+}
+
+// albumTagPlans pairs each downloaded file with a track of the release and builds its tags. Files
+// that match no track still get the album-level tags, so they land in the same album.
+func albumTagPlans(d *AlbumDetail, paths []string) []tagPlan {
+	al := d.Album
+	common := []string{"album=" + al.Title, "album_artist=" + al.Artist}
+	if al.Year > 0 {
+		common = append(common, "date="+strconv.Itoa(al.Year))
+	}
+	if ValidMBID(al.MBID) {
+		common = append(common, "MUSICBRAINZ_RELEASEGROUPID="+al.MBID)
+	}
+	if ValidMBID(al.ReleaseID) {
+		common = append(common, "MUSICBRAINZ_ALBUMID="+al.ReleaseID)
+	}
+	if ValidMBID(al.ArtistMBID) {
+		common = append(common, "MUSICBRAINZ_ALBUMARTISTID="+al.ArtistMBID)
+	}
+	match := matchTracks(paths, d.Tracks)
+	plans := make([]tagPlan, 0, len(paths))
+	for i, p := range paths {
+		tags := append([]string{}, common...)
+		if ti, ok := match[i]; ok {
+			t := d.Tracks[ti]
+			tags = append(tags, "title="+t.Title, "artist="+cmp(t.Artist, al.Artist), fmt.Sprintf("track=%d", cmp0(t.TrackNumber, ti+1)))
+			if ValidMBID(t.MBID) {
+				tags = append(tags, "MUSICBRAINZ_TRACKID="+t.MBID)
+			}
+			if ValidMBID(t.ArtistMBID) {
+				tags = append(tags, "MUSICBRAINZ_ARTISTID="+t.ArtistMBID)
+			}
+		}
+		plans = append(plans, tagPlan{path: p, tags: tags})
+	}
+	return plans
+}
+
+func cmp0(v, def int) int {
+	if v == 0 {
+		return def
+	}
+	return v
+}
+
+var leadingTrackNo = regexp.MustCompile(`^\s*(?:\d{1,2}\s*[-.]\s*)?(\d{1,3})\b`)
+
+// matchTracks maps the index of each file to the index of its track in the tracklist. Titles are
+// compared first (a file name is often "03 - Title.flac"), then the track number in the name.
+func matchTracks(paths []string, tracks []CatalogItem) map[int]int {
+	out := map[int]int{}
+	claimed := map[int]bool{}
+	titles := make([]string, len(tracks))
+	for i, t := range tracks {
+		titles[i] = looseKey(t.Title)
+	}
+	names := make([]string, len(paths))
+	for i, p := range paths {
+		base := strings.TrimSuffix(filepath.Base(p), filepath.Ext(p))
+		names[i] = base
+		k := looseKey(leadingTrackNo.ReplaceAllString(base, ""))
+		if k == "" {
+			continue
+		}
+		for ti, tk := range titles {
+			if !claimed[ti] && tk != "" && tk == k {
+				out[i], claimed[ti] = ti, true
+				break
+			}
+		}
+	}
+	for i := range paths {
+		if _, ok := out[i]; ok {
+			continue
+		}
+		k := looseKey(leadingTrackNo.ReplaceAllString(names[i], ""))
+		if len(k) < 4 {
+			continue
+		}
+		for ti, tk := range titles {
+			if !claimed[ti] && len(tk) >= 4 && (strings.Contains(k, tk) || strings.Contains(tk, k)) {
+				out[i], claimed[ti] = ti, true
+				break
+			}
+		}
+	}
+	for i := range paths {
+		if _, ok := out[i]; ok {
+			continue
+		}
+		m := leadingTrackNo.FindStringSubmatch(names[i])
+		if m == nil {
+			continue
+		}
+		n, _ := strconv.Atoi(m[1])
+		for ti, t := range tracks {
+			if !claimed[ti] && cmp0(t.TrackNumber, ti+1) == n {
+				out[i], claimed[ti] = ti, true
+				break
+			}
+		}
+	}
+	return out
+}
+
+// looseKey lowercases, drops accents and keeps only letters and digits, so "Lavô Tá Novo" and
+// "lavo ta novo" (or "blink‐182" and "blink-182") compare equal.
+func looseKey(s string) string {
+	var sb strings.Builder
+	for _, r := range norm.NFD.String(strings.ToLower(s)) {
+		if unicode.IsLetter(r) || unicode.IsDigit(r) {
+			sb.WriteRune(r)
+		}
+	}
+	return sb.String()
+}
