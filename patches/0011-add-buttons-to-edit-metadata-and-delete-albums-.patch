diff --git a/server/seerapi/library.go b/server/seerapi/library.go
new file mode 100644
index 00000000..4d7df709
--- /dev/null
+++ b/server/seerapi/library.go
@@ -0,0 +1,64 @@
+package seerapi
+
+import (
+	"encoding/json"
+	"errors"
+	"net/http"
+
+	"github.com/go-chi/chi/v5"
+	"github.com/navidrome/navidrome/core/seer"
+	"github.com/navidrome/navidrome/log"
+)
+
+// Admin-only library editing: PUT edits tags, DELETE removes the files from disk.
+
+func (api *Router) editSong(w http.ResponseWriter, r *http.Request) {
+	changes, ok := decodeChanges(w, r)
+	if !ok {
+		return
+	}
+	res, err := api.editor.EditSong(r.Context(), chi.URLParam(r, "id"), changes)
+	writeEditResult(w, r, res, err)
+}
+
+func (api *Router) editAlbum(w http.ResponseWriter, r *http.Request) {
+	changes, ok := decodeChanges(w, r)
+	if !ok {
+		return
+	}
+	res, err := api.editor.EditAlbum(r.Context(), chi.URLParam(r, "id"), changes)
+	writeEditResult(w, r, res, err)
+}
+
+func (api *Router) deleteSong(w http.ResponseWriter, r *http.Request) {
+	writeEditResult(w, r, nil, api.editor.DeleteSong(r.Context(), chi.URLParam(r, "id")))
+}
+
+func (api *Router) deleteAlbum(w http.ResponseWriter, r *http.Request) {
+	writeEditResult(w, r, nil, api.editor.DeleteAlbum(r.Context(), chi.URLParam(r, "id")))
+}
+
+func decodeChanges(w http.ResponseWriter, r *http.Request) (seer.TagChanges, bool) {
+	var changes seer.TagChanges
+	if err := json.NewDecoder(http.MaxBytesReader(w, r.Body, 64<<10)).Decode(&changes); err != nil {
+		http.Error(w, "invalid body", http.StatusBadRequest)
+		return changes, false
+	}
+	return changes, true
+}
+
+func writeEditResult(w http.ResponseWriter, r *http.Request, res *seer.EditResult, err error) {
+	switch {
+	case errors.Is(err, seer.ErrItemNotFound):
+		http.Error(w, "not found", http.StatusNotFound)
+	case errors.Is(err, seer.ErrInvalidTags):
+		http.Error(w, err.Error(), http.StatusBadRequest)
+	case err != nil:
+		log.Error(r.Context(), "Seer: library edit failed", err)
+		http.Error(w, err.Error(), http.StatusInternalServerError)
+	case res == nil:
+		w.WriteHeader(http.StatusNoContent)
+	default:
+		writeJSON(w, http.StatusOK, res)
+	}
+}
