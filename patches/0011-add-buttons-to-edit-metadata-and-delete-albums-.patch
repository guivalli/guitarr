+)
+
+type fakeEditor struct{ calls []string }
+
+func (f *fakeEditor) EditSong(_ context.Context, id string, c seer.TagChanges) (*seer.EditResult, error) {
+	if id == "missing" {
+		return nil, seer.ErrItemNotFound
+	}
+	if c.TrackNumber != nil {
+		return nil, fmt.Errorf("%w: bad track", seer.ErrInvalidTags)
+	}
+	f.calls = append(f.calls, "editSong:"+id+":"+*c.Title)
+	return &seer.EditResult{ID: id, AlbumID: "al2"}, nil
+}
+func (f *fakeEditor) EditAlbum(_ context.Context, id string, c seer.TagChanges) (*seer.EditResult, error) {
+	f.calls = append(f.calls, "editAlbum:"+id+":"+*c.Album)
+	return &seer.EditResult{ID: "al2", AlbumID: "al2"}, nil
+}
+func (f *fakeEditor) DeleteSong(_ context.Context, id string) error {
+	f.calls = append(f.calls, "deleteSong:"+id)
+	return nil
+}
+func (f *fakeEditor) DeleteAlbum(_ context.Context, id string) error {
+	f.calls = append(f.calls, "deleteAlbum:"+id)
+	return nil
+}
+
+func TestLibraryAPI(t *testing.T) {
+	ed := &fakeEditor{}
+	api := NewWithServices(nil, &fakeService{}, ed)
+	user := model.User{ID: "u1"}
+	admin := model.User{ID: "adm", IsAdmin: true}
+
+	if w := do(t, api, user, "DELETE", "/library/song/s1", ""); w.Code != 403 {
+		t.Errorf("non-admin delete: %d", w.Code)
+	}
+	if w := do(t, api, admin, "PUT", "/library/song/s1", `{"title":"New"}`); w.Code != 200 || !strings.Contains(w.Body.String(), `"albumId":"al2"`) {
+		t.Errorf("edit song: %d %s", w.Code, w.Body)
+	}
+	if w := do(t, api, admin, "PUT", "/library/song/missing", `{"title":"x"}`); w.Code != 404 {
+		t.Errorf("edit missing: %d", w.Code)
+	}
+	if w := do(t, api, admin, "PUT", "/library/song/s1", `{"title":"x","trackNumber":"a"}`); w.Code != 400 {
+		t.Errorf("invalid tags: %d", w.Code)
+	}
+	if w := do(t, api, admin, "PUT", "/library/song/s1", `not json`); w.Code != 400 {
+		t.Errorf("invalid body: %d", w.Code)
+	}
+	if w := do(t, api, admin, "PUT", "/library/album/al1", `{"album":"A"}`); w.Code != 200 {
+		t.Errorf("edit album: %d %s", w.Code, w.Body)
+	}
+	if w := do(t, api, admin, "DELETE", "/library/song/s1", ""); w.Code != 204 {
+		t.Errorf("delete song: %d", w.Code)
+	}
+	if w := do(t, api, admin, "DELETE", "/library/album/al1", ""); w.Code != 204 {
+		t.Errorf("delete album: %d", w.Code)
+	}
+	want := "editSong:s1:New,editAlbum:al1:A,deleteSong:s1,deleteAlbum:al1"
+	if got := strings.Join(ed.calls, ","); got != want {
+		t.Errorf("calls = %s, want %s", got, want)
+	}
+
+	// Without an editor the routes do not exist.
+	if w := do(t, NewWithService(nil, &fakeService{}), admin, "DELETE", "/library/song/s1", ""); w.Code != 404 && w.Code != 405 {
+		t.Errorf("no editor: %d", w.Code)
+	}
+}
