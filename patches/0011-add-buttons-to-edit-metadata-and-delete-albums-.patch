diff --git a/ui/src/dialogs/EditMetadataDialog.jsx b/ui/src/dialogs/EditMetadataDialog.jsx
new file mode 100644
index 00000000..068f3217
--- /dev/null
+++ b/ui/src/dialogs/EditMetadataDialog.jsx
@@ -0,0 +1,316 @@
+import React, { useState, useEffect, useCallback } from 'react'
+import { useDispatch, useSelector } from 'react-redux'
+import { useNotify, useRefresh, useTranslate } from 'react-admin'
+import { useHistory, useLocation } from 'react-router-dom'
+import {
+  Button,
+  CircularProgress,
+  Dialog,
+  DialogActions,
+  DialogContent,
+  DialogTitle,
+  Grid,
+  TextField,
+  makeStyles,
+} from '@material-ui/core'
+import { closeEditMetadataDialog } from '../actions'
+import { editAlbum, editSong } from '../seer/api'
+
+const useStyles = makeStyles((theme) => ({
+  dialogContent: {
+    paddingTop: theme.spacing(1),
+  },
+  field: {
+    marginBottom: theme.spacing(2),
+  },
+}))
+
+export const EditMetadataDialog = () => {
+  const classes = useStyles()
+  const dispatch = useDispatch()
+  const translate = useTranslate()
+  const notify = useNotify()
+  const refresh = useRefresh()
+  const history = useHistory()
+  const location = useLocation()
+
+  const { open, record, recordType } = useSelector(
+    (state) => state.editMetadataDialog || {},
+  )
+
+  const isAlbum = recordType === 'album'
+
+  const [title, setTitle] = useState('')
+  const [artist, setArtist] = useState('')
+  const [album, setAlbum] = useState('')
+  const [albumArtist, setAlbumArtist] = useState('')
+  const [year, setYear] = useState('')
+  const [genre, setGenre] = useState('')
+  const [trackNumber, setTrackNumber] = useState('')
+  const [discNumber, setDiscNumber] = useState('')
+  const [isSaving, setIsSaving] = useState(false)
+
+  useEffect(() => {
+    if (open && record) {
+      if (isAlbum) {
+        setAlbum(record.name || record.album || '')
+        setAlbumArtist(record.albumArtist || record.artist || '')
+        setYear(record.year != null ? String(record.year) : '')
+        setGenre(record.genre || '')
+      } else {
+        setTitle(record.title || '')
+        setArtist(record.artist || '')
+        setAlbum(record.album || '')
+        setAlbumArtist(record.albumArtist || '')
+        setYear(record.year != null ? String(record.year) : '')
+        setGenre(record.genre || '')
+        setTrackNumber(
+          record.trackNumber != null ? String(record.trackNumber) : '',
+        )
+        setDiscNumber(
+          record.discNumber != null ? String(record.discNumber) : '',
+        )
+      }
+    }
+  }, [open, record, isAlbum])
+
+  const handleClose = useCallback(
+    (e) => {
+      if (e) e.stopPropagation()
+      if (!isSaving) {
+        dispatch(closeEditMetadataDialog())
+      }
+    },
+    [dispatch, isSaving],
+  )
+
+  const handleSave = useCallback(
+    async (e) => {
+      if (e) e.preventDefault()
+      if (!record || !record.id) return
+
+      const cleanAlbum = album.trim()
+      if (!cleanAlbum) {
+        notify('resources.album.fields.album', { type: 'warning' })
+        return
+      }
+
+      if (!isAlbum && !title.trim()) {
+        notify('resources.song.fields.title', { type: 'warning' })
+        return
+      }
+
+      setIsSaving(true)
+      try {
+        const changes = {
+          album: cleanAlbum,
+          albumArtist: albumArtist.trim(),
+          year: year.trim(),
+          genre: genre.trim(),
+        }
+
+        let res
+        if (isAlbum) {
+          res = await editAlbum(record.id, changes)
+        } else {
+          changes.title = title.trim()
+          changes.artist = artist.trim()
+          changes.trackNumber = trackNumber.trim()
+          changes.discNumber = discNumber.trim()
+          res = await editSong(record.id, changes)
+        }
+
+        notify('ra.notification.updated', {
+          type: 'info',
+          messageArgs: { smart_count: 1 },
+        })
+
+        // If the album was renamed and user is on its show page, update URL
+        if (
+          isAlbum &&
+          res?.albumId &&
+          res.albumId !== record.id &&
+          location.pathname.startsWith(`/album/${record.id}`)
+        ) {
+          history.replace(`/album/${res.albumId}/show`)
+        }
+
+        refresh()
+        dispatch(closeEditMetadataDialog())
+      } catch (err) {
+        notify(err.message || 'ra.page.error', { type: 'warning' })
+      } finally {
+        setIsSaving(false)
+      }
+    },
+    [
+      record,
+      isAlbum,
+      album,
+      albumArtist,
+      year,
+      genre,
+      title,
+      artist,
+      trackNumber,
+      discNumber,
+      notify,
+      location.pathname,
+      history,
+      refresh,
+      dispatch,
+    ],
+  )
+
+  if (!open || !record) {
+    return null
+  }
+
+  const dialogTitle = isAlbum
+    ? translate('resources.album.actions.editMetadata', {
+        _: 'Edit Album Metadata',
+      })
+    : translate('resources.song.actions.editMetadata', {
+        _: 'Edit Metadata',
+      })
+
+  return (
+    <Dialog
+      open={open}
+      onClose={handleClose}
+      aria-labelledby="edit-metadata-dialog-title"
+      fullWidth
+      maxWidth="sm"
+    >
+      <form onSubmit={handleSave}>
+        <DialogTitle id="edit-metadata-dialog-title">
+          {dialogTitle}
+        </DialogTitle>
+        <DialogContent className={classes.dialogContent}>
+          {!isAlbum && (
+            <TextField
+              className={classes.field}
+              value={title}
+              onChange={(e) => setTitle(e.target.value)}
+              fullWidth
+              variant="outlined"
+              label={translate('resources.song.fields.title', { _: 'Title' })}
+              required
+              disabled={isSaving}
+              autoFocus
+            />
+          )}
+
+          {!isAlbum && (
+            <TextField
+              className={classes.field}
+              value={artist}
+              onChange={(e) => setArtist(e.target.value)}
+              fullWidth
+              variant="outlined"
+              label={translate('resources.song.fields.artist', { _: 'Artist' })}
+              disabled={isSaving}
+            />
+          )}
+
+          <TextField
+            className={classes.field}
+            value={album}
+            onChange={(e) => setAlbum(e.target.value)}
+            fullWidth
+            variant="outlined"
+            label={translate('resources.song.fields.album', { _: 'Album' })}
+            required
+            disabled={isSaving}
+            autoFocus={isAlbum}
+          />
+
+          <TextField
+            className={classes.field}
+            value={albumArtist}
+            onChange={(e) => setAlbumArtist(e.target.value)}
+            fullWidth
+            variant="outlined"
+            label={translate('resources.song.fields.albumArtist', {
+              _: 'Album Artist',
+            })}
+            disabled={isSaving}
+          />
+
+          {!isAlbum && (
+            <Grid container spacing={2}>
+              <Grid item xs={6}>
+                <TextField
+                  className={classes.field}
+                  value={trackNumber}
+                  onChange={(e) => setTrackNumber(e.target.value)}
+                  fullWidth
+                  variant="outlined"
+                  label={translate('resources.song.fields.trackNumber', {
+                    _: 'Track #',
+                  })}
+                  disabled={isSaving}
+                />
+              </Grid>
+              <Grid item xs={6}>
+                <TextField
+                  className={classes.field}
+                  value={discNumber}
+                  onChange={(e) => setDiscNumber(e.target.value)}
+                  fullWidth
+                  variant="outlined"
+                  label={translate('resources.song.fields.disc', {
+                    _: 'Disc #',
+                  })}
+                  disabled={isSaving}
+                />
+              </Grid>
+            </Grid>
+          )}
+
+          <Grid container spacing={2}>
+            <Grid item xs={6}>
+              <TextField
+                className={classes.field}
+                value={year}
+                onChange={(e) => setYear(e.target.value)}
+                fullWidth
+                variant="outlined"
+                label={translate('resources.song.fields.year', { _: 'Year' })}
+                disabled={isSaving}
+                placeholder="YYYY"
+              />
+            </Grid>
+            <Grid item xs={6}>
+              <TextField
+                className={classes.field}
+                value={genre}
+                onChange={(e) => setGenre(e.target.value)}
+                fullWidth
+                variant="outlined"
+                label={translate('resources.song.fields.genre', { _: 'Genre' })}
+                disabled={isSaving}
+              />
+            </Grid>
+          </Grid>
+        </DialogContent>
+        <DialogActions>
+          <Button onClick={handleClose} disabled={isSaving}>
+            {translate('ra.action.cancel', { _: 'Cancel' })}
+          </Button>
+          <Button
+            type="submit"
+            color="primary"
+            variant="contained"
+            disabled={isSaving || (isAlbum ? !album.trim() : !title.trim())}
+            startIcon={isSaving ? <CircularProgress size={20} /> : null}
+          >
+            {translate('ra.action.save', { _: 'Save' })}
+          </Button>
+        </DialogActions>
+      </form>
+    </Dialog>
+  )
+}
+
+export default EditMetadataDialog
