+++ b/core/seer/editor.go
@@ -0,0 +1,402 @@
+package seer
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"os"
+	"path/filepath"
+	"regexp"
+	"slices"
+	"strings"
+	"time"
+
+	. "github.com/Masterminds/squirrel"
+	"github.com/navidrome/navidrome/core"
+	"github.com/navidrome/navidrome/log"
+	"github.com/navidrome/navidrome/model"
+	"go.senan.xyz/taglib"
+)
+
+// Errors returned by the Editor. The API maps them to HTTP status codes.
+var (
+	ErrItemNotFound = errors.New("not found")
+	ErrInvalidTags  = errors.New("invalid tags")
+)
+
+// TagChanges are the tags to write. A nil field is left untouched; an empty string removes the tag.
+type TagChanges struct {
+	Title       *string `json:"title,omitempty"`
+	Artist      *string `json:"artist,omitempty"`
+	Album       *string `json:"album,omitempty"`
+	AlbumArtist *string `json:"albumArtist,omitempty"`
+	Genre       *string `json:"genre,omitempty"`
+	Year        *string `json:"year,omitempty"`
+	TrackNumber *string `json:"trackNumber,omitempty"`
+	DiscNumber  *string `json:"discNumber,omitempty"`
+}
+
+// albumOnly keeps the fields that make sense for every track of an album.
+func (c TagChanges) albumOnly() TagChanges {
+	return TagChanges{Album: c.Album, AlbumArtist: c.AlbumArtist, Genre: c.Genre, Year: c.Year}
+}
+
+func (c TagChanges) empty() bool {
+	return c == TagChanges{}
+}
+
+var (
+	positiveNumber = regexp.MustCompile(`^[1-9][0-9]{0,3}$`)
+	yearOrDate     = regexp.MustCompile(`^[0-9]{4}(-[0-9]{2}(-[0-9]{2})?)?$`)
+)
+
+// validate trims every value and rejects numbers and dates the scanner could not read back.
+func (c *TagChanges) validate() error {
+	for _, f := range []**string{&c.Title, &c.Artist, &c.Album, &c.AlbumArtist, &c.Genre, &c.Year, &c.TrackNumber, &c.DiscNumber} {
+		if *f != nil {
+			v := strings.TrimSpace(**f)
+			*f = &v
+		}
+	}
+	if c.Title != nil && *c.Title == "" {
+		return fmt.Errorf("%w: the title cannot be empty", ErrInvalidTags)
+	}
+	if c.Album != nil && *c.Album == "" {
+		return fmt.Errorf("%w: the album name cannot be empty", ErrInvalidTags)
+	}
+	for name, v := range map[string]*string{"track number": c.TrackNumber, "disc number": c.DiscNumber} {
+		if v != nil && *v != "" && !positiveNumber.MatchString(*v) {
+			return fmt.Errorf("%w: %s must be a positive number", ErrInvalidTags, name)
+		}
+	}
+	if c.Year != nil && *c.Year != "" && !yearOrDate.MatchString(*c.Year) {
+		return fmt.Errorf("%w: use a year (2001) or a date (2001-09-11)", ErrInvalidTags)
+	}
+	return nil
+}
+
+// tagMap turns the changes into TagLib properties. An empty slice erases the tag.
+// current holds the file's existing properties, used to keep related tags consistent.
+func (c TagChanges) tagMap(current map[string][]string) map[string][]string {
+	tags := map[string][]string{}
+	set := func(v *string, key string, stale ...string) {
+		if v == nil {
+			return
+		}
+		tags[key] = nil
+		if *v != "" {
+			tags[key] = []string{*v}
+		}
+		// Navidrome prefers these over the main tag (ARTISTS over ARTIST) or uses them to sort,
+		// so leaving the old values would hide the edit.
+		for _, k := range stale {
+			if _, ok := current[k]; ok {
+				tags[k] = nil
+			}
+		}
+	}
+	set(c.Title, taglib.Title, taglib.TitleSort)
+	set(c.Artist, taglib.Artist, taglib.Artists, taglib.ArtistSort, "ARTISTSSORT")
+	set(c.Album, taglib.Album, taglib.AlbumSort)
+	set(c.AlbumArtist, taglib.AlbumArtist, "ALBUMARTISTS", taglib.AlbumArtistSort, "ALBUMARTISTSSORT")
+	set(c.Genre, taglib.Genre)
+	set(c.TrackNumber, taglib.TrackNumber)
+	set(c.DiscNumber, taglib.DiscNumber)
+	if c.Year != nil {
+		set(c.Year, taglib.Date)
+		// The scanner may show the original or release date instead of DATE: keep them in step.
+		for _, k := range []string{taglib.OriginalDate, taglib.ReleaseDate} {
+			if _, ok := current[k]; ok {
+				set(c.Year, k)
+			}
+		}
+	}
+	return tags
+}
+
+// TagIO reads and writes tags in audio files (TagLib in production, a fake in tests).
+type TagIO interface {
+	Read(path string) (map[string][]string, error)
+	Write(path string, tags map[string][]string) error
+}
+
+type taglibIO struct{}
+
+func (taglibIO) Read(path string) (map[string][]string, error) { return taglib.ReadTags(path) }
+func (taglibIO) Write(path string, tags map[string][]string) error {
+	return taglib.WriteTags(path, tags, 0)
+}
+
+// Editor lets admins fix tags and delete albums or tracks from the web UI. Every change is
+// written to the files and then picked up by a quick scan of the affected folders, so the
+// library stays in sync with what is on disk.
+type Editor struct {
+	ds          model.DataStore
+	scanner     model.Scanner
+	maintenance core.Maintenance
+	tags        TagIO
+	// keep are folders never removed when they become empty (e.g. the Seer destination).
+	keep func() []string
+}
+
+// NewEditor builds an Editor that writes tags with TagLib.
+func NewEditor(ds model.DataStore, scanner model.Scanner, maintenance core.Maintenance, tags TagIO, keep func() []string) *Editor {
+	if tags == nil {
+		tags = taglibIO{}
+	}
+	if keep == nil {
+		keep = func() []string { return nil }
+	}
+	return &Editor{ds: ds, scanner: scanner, maintenance: maintenance, tags: tags, keep: keep}
+}
+
+// EditResult tells the UI where the edited item lives now (the album ID changes with its name).
+type EditResult struct {
+	ID      string `json:"id"`
+	AlbumID string `json:"albumId"`
+}
+
+// EditSong writes the changes to one track.
+func (e *Editor) EditSong(ctx context.Context, id string, changes TagChanges) (*EditResult, error) {
+	if err := changes.validate(); err != nil {
+		return nil, err
+	}
+	mf, err := e.song(ctx, id)
+	if err != nil {
+		return nil, err
+	}
+	if changes.empty() {
+		return &EditResult{ID: mf.ID, AlbumID: mf.AlbumID}, nil
+	}
+	if err := e.writeTags(ctx, []model.MediaFile{*mf}, changes); err != nil {
+		return nil, err
+	}
+	// The scanner updates the record matched by path, so the track keeps its ID.
+	albumID := mf.AlbumID
+	if cur, err := e.ds.MediaFile().Get(ctx, mf.ID); err == nil {
+		albumID = cur.AlbumID
+	}
+	return &EditResult{ID: mf.ID, AlbumID: albumID}, nil
+}
+
+// EditAlbum writes the album-level changes (name, album artist, year, genre) to all its tracks.
+func (e *Editor) EditAlbum(ctx context.Context, id string, changes TagChanges) (*EditResult, error) {
+	changes = changes.albumOnly()
+	if err := changes.validate(); err != nil {
+		return nil, err
+	}
+	files, err := e.albumSongs(ctx, id)
+	if err != nil {
+		return nil, err
+	}
+	if changes.empty() {
+		return &EditResult{ID: id, AlbumID: id}, nil
+	}
+	if err := e.writeTags(ctx, files, changes); err != nil {
+		return nil, err
+	}
+	albumID := id
+	if cur, err := e.ds.MediaFile().Get(ctx, files[0].ID); err == nil {
+		albumID = cur.AlbumID
+	}
+	return &EditResult{ID: albumID, AlbumID: albumID}, nil
+}
+
+// DeleteSong removes the track's file from disk and from the library.
+func (e *Editor) DeleteSong(ctx context.Context, id string) error {
+	mf, err := e.song(ctx, id)
+	if err != nil {
+		return err
+	}
+	return e.deleteFiles(ctx, []model.MediaFile{*mf}, false)
+}
+
+// DeleteAlbum removes all the album's files, and its folder when nothing else is left in it.
+func (e *Editor) DeleteAlbum(ctx context.Context, id string) error {
+	files, err := e.albumSongs(ctx, id)
+	if err != nil {
+		return err
+	}
+	return e.deleteFiles(ctx, files, true)
+}
+
+func (e *Editor) song(ctx context.Context, id string) (*model.MediaFile, error) {
+	mf, err := e.ds.MediaFile().Get(ctx, id)
+	if errors.Is(err, model.ErrNotFound) || (err == nil && mf.Missing) {
+		return nil, ErrItemNotFound
+	}
+	if err != nil {
+		return nil, err
+	}
+	return mf, nil
+}
+
+func (e *Editor) albumSongs(ctx context.Context, id string) ([]model.MediaFile, error) {
+	files, err := e.ds.MediaFile().GetAll(ctx, model.QueryOptions{
+		Filters: And{Eq{"media_file.album_id": id}, Eq{"media_file.missing": false}},
+	})
+	if err != nil {
+		return nil, err
+	}
+	if len(files) == 0 {
+		return nil, ErrItemNotFound
+	}
+	return files, nil
+}
+
+// writeTags writes the changes to every file, then rescans their folders. It stops at the first
+// file that cannot be written, but still rescans so the library matches the files already changed.
+func (e *Editor) writeTags(ctx context.Context, files []model.MediaFile, changes TagChanges) error {
+	var writeErr error
+	var written []model.MediaFile
+	for _, mf := range files {
+		path, err := absolutePath(mf)
+		if err != nil {
+			writeErr = err
+			break
+		}
+		current, err := e.tags.Read(path)
+		if err != nil {
+			writeErr = fmt.Errorf("could not read the tags of %s: %w", mf.Path, err)
+			break
+		}
+		if err := e.tags.Write(path, changes.tagMap(current)); err != nil {
+			writeErr = fmt.Errorf("could not write the tags of %s (is the music folder writable?): %w", mf.Path, err)
+			break
+		}
+		written = append(written, mf)
+	}
+	if len(written) > 0 {
+		log.Info(ctx, "Seer: tags edited", "files", len(written), "first", written[0].Path)
+		if err := e.rescan(ctx, written); err != nil {
+			return errors.Join(writeErr, err)
+		}
+	}
+	return writeErr
+}
+
+// deleteFiles removes the files, rescans their folders and purges the now-missing records.
+func (e *Editor) deleteFiles(ctx context.Context, files []model.MediaFile, removeLeftovers bool) error {
+	var deleteErr error
+	var deleted []model.MediaFile
+	folders := map[string]string{} // absolute folder -> library root
+	for _, mf := range files {
+		path, err := absolutePath(mf)
+		if err != nil {
+			deleteErr = err
+			break
+		}
+		if err := os.Remove(path); err != nil && !errors.Is(err, os.ErrNotExist) {
+			deleteErr = fmt.Errorf("could not delete %s (is the music folder writable?): %w", mf.Path, err)
+			break
+		}
+		deleted = append(deleted, mf)
+		folders[filepath.Dir(path)] = filepath.Clean(mf.LibraryPath)
+	}
+	if len(deleted) == 0 {
+		return deleteErr
+	}
+	log.Info(ctx, "Seer: files deleted", "files", len(deleted), "first", deleted[0].Path)
+	for dir, root := range folders {
+		e.removeEmptyFolders(ctx, dir, root, removeLeftovers)
+	}
+	if err := e.rescan(ctx, deleted); err != nil {
+		return errors.Join(deleteErr, err)
+	}
+	ids := make([]string, len(deleted))
+	for i, mf := range deleted {
+		ids[i] = mf.ID
+	}
+	if err := e.maintenance.DeleteMissingFiles(ctx, ids); err != nil {
+		return errors.Join(deleteErr, fmt.Errorf("files deleted, but removing them from the library failed: %w", err))
+	}
+	return deleteErr
+}
+
+// leftovers are files that belong to an album folder and are useless without its tracks.
+var leftovers = []string{
+	".jpg", ".jpeg", ".png", ".gif", ".webp", ".bmp", ".cue", ".log", ".nfo", ".txt", ".m3u",
+	".m3u8", ".sfv", ".md5", ".accurip", ".lrc", ".pdf", ".ini", ".db",
+}
+
+// removeEmptyFolders deletes dir when it holds no other tracks or folders, then its parents
+// while they are empty, never going above the library root or into a kept folder.
+// With removeLeftovers, covers, cue sheets and logs left behind are deleted too.
+func (e *Editor) removeEmptyFolders(ctx context.Context, dir, root string, removeLeftovers bool) {
+	keep := e.keep()
+	for first := true; ; first = false {
+		dir = filepath.Clean(dir)
+		if !isInside(root, dir) || dir == root || slices.Contains(keep, dir) {
+			return
+		}
+		entries, err := os.ReadDir(dir)
+		if err != nil {
+			return
+		}
+		if first && removeLeftovers && len(entries) > 0 {
+			for _, en := range entries {
+				if en.IsDir() || !slices.Contains(leftovers, strings.ToLower(filepath.Ext(en.Name()))) &&
+					!strings.HasPrefix(en.Name(), ".") {
+					return // something else lives here: keep the folder
+				}
+			}
+			for _, en := range entries {
+				_ = os.Remove(filepath.Join(dir, en.Name()))
+			}
+		}
+		if err := os.Remove(dir); err != nil {
+			return // not empty
+		}
+		log.Debug(ctx, "Seer: removed empty folder", "folder", dir)
+		dir = filepath.Dir(dir)
+	}
+}
+
+// rescan runs a quick scan of the folders holding the files and waits for it. If another scan
+// is running (the file watcher may have started one), it waits and tries again.
+func (e *Editor) rescan(ctx context.Context, files []model.MediaFile) error {
+	ctx = context.WithoutCancel(ctx) // the files changed already: finish even if the browser gives up
+	seen := map[model.ScanTarget]bool{}
+	var targets []model.ScanTarget
+	for _, mf := range files {
+		t := model.ScanTarget{LibraryID: mf.LibraryID, FolderPath: existingFolder(mf.LibraryPath, filepath.Dir(mf.Path))}
+		if !seen[t] {
+			seen[t] = true
+			targets = append(targets, t)
+		}
+	}
+	deadline := time.Now().Add(3 * time.Minute)
+	for {
+		_, err := e.scanner.ScanFolders(ctx, false, targets)
+		if !errors.Is(err, model.ErrAlreadyScanning) {
+			if err != nil {
+				return fmt.Errorf("files changed, but the library scan failed: %w", err)
+			}
+			return nil
+		}
+		if time.Now().After(deadline) {
+			return errors.New("files changed, but a library scan is still running: they will show up after it")
+		}
+		time.Sleep(2 * time.Second)
+	}
+}
+
+// existingFolder returns rel, or its closest parent that still exists ("." for the library root).
+func existingFolder(root, rel string) string {
+	for rel != "." && rel != "/" && rel != "" {
+		if st, err := os.Stat(filepath.Join(root, rel)); err == nil && st.IsDir() {
+			return rel
+		}
+		rel = filepath.Dir(rel)
+	}
+	return "."
+}
+
+func absolutePath(mf model.MediaFile) (string, error) {
+	root := filepath.Clean(mf.LibraryPath)
+	path := filepath.Join(root, mf.Path)
+	if mf.LibraryPath == "" || !isInside(root, path) || path == root {
+		return "", fmt.Errorf("refusing to touch %q: it is outside the library", mf.Path)
+	}
+	return path, nil
+}
diff --git a/core/seer/editor_test.go b/core/seer/editor_test.go
new file mode 100644
index 00000000..1b65763d
--- /dev/null
+++ b/core/seer/editor_test.go
@@ -0,0 +1,296 @@
+package seer
+
+import (
+	"context"
+	"errors"
+	"io"
+	"os"
+	"path/filepath"
+	"reflect"
+	"testing"
+
+	"github.com/navidrome/navidrome/model"
+	"github.com/navidrome/navidrome/tests"
+)
+
+func ptr(s string) *string { return &s }
+
+func TestTagChangesValidate(t *testing.T) {
+	ok := []TagChanges{
+		{},
+		{Title: ptr("  Song  "), Year: ptr("2001"), TrackNumber: ptr("3"), DiscNumber: ptr("")},
+		{Year: ptr("2001-09-11"), Genre: ptr("")},
+	}
+	for _, c := range ok {
+		if err := c.validate(); err != nil {
+			t.Errorf("validate(%+v) = %v", c, err)
+		}
+	}
+	bad := []TagChanges{
+		{Title: ptr("  ")},
+		{Album: ptr("")},
+		{TrackNumber: ptr("0")},
+		{TrackNumber: ptr("3/12")},
+		{DiscNumber: ptr("x")},
+		{Year: ptr("01")},
+		{Year: ptr("2001/09")},
+	}
+	for _, c := range bad {
+		if err := c.validate(); !errors.Is(err, ErrInvalidTags) {
+			t.Errorf("validate(%+v) = %v, want ErrInvalidTags", c, err)
+		}
+	}
+	c := TagChanges{Title: ptr("  Song  ")}
+	_ = c.validate()
+	if *c.Title != "Song" {
+		t.Errorf("title not trimmed: %q", *c.Title)
+	}
+}
+
+func TestTagMap(t *testing.T) {
+	current := map[string][]string{
+		"ARTIST": {"A"}, "ARTISTS": {"A", "B"}, "ARTISTSORT": {"A"},
+		"DATE": {"1999"}, "ORIGINALDATE": {"1990"},
+	}
+	got := TagChanges{
+		Artist: ptr("New"), Genre: ptr(""), Year: ptr("2001"),
+	}.tagMap(current)
+	want := map[string][]string{
+		"ARTIST": {"New"}, "ARTISTS": nil, "ARTISTSORT": nil,
+		"GENRE": nil, "DATE": {"2001"}, "ORIGINALDATE": {"2001"},
+	}
+	if !reflect.DeepEqual(got, want) {
+		t.Errorf("tagMap =\n%v\nwant\n%v", got, want)
+	}
+}
+
+func TestTagMapAlbumOnly(t *testing.T) {
+	c := TagChanges{Title: ptr("x"), Album: ptr("Al"), TrackNumber: ptr("1")}.albumOnly()
+	if c.Title != nil || c.TrackNumber != nil || c.Album == nil {
+		t.Errorf("albumOnly kept track fields: %+v", c)
+	}
+}
+
+// TestTaglibRoundTrip writes tags to a real MP3 with TagLib and reads them back.
+func TestTaglibRoundTrip(t *testing.T) {
+	path := copyFixture(t, "01 Invisible (RED) Edit Version.mp3", t.TempDir())
+	tio := taglibIO{}
+	current, err := tio.Read(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	changes := TagChanges{Title: ptr("Novo título"), Album: ptr("Álbum"), TrackNumber: ptr("7"), Genre: ptr("")}
+	if err := tio.Write(path, changes.tagMap(current)); err != nil {
+		t.Fatal(err)
+	}
+	after, err := tio.Read(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for k, v := range map[string]string{"TITLE": "Novo título", "ALBUM": "Álbum", "TRACKNUMBER": "7"} {
+		if len(after[k]) != 1 || after[k][0] != v {
+			t.Errorf("%s = %v, want %q", k, after[k], v)
+		}
+	}
+	if _, ok := after["GENRE"]; ok {
+		t.Errorf("GENRE should be removed, got %v", after["GENRE"])
+	}
+	if !reflect.DeepEqual(after["ARTIST"], current["ARTIST"]) {
+		t.Errorf("ARTIST changed: %v -> %v", current["ARTIST"], after["ARTIST"])
+	}
+}
+
+type fakeScanner struct {
+	targets [][]model.ScanTarget
+	busy    int // how many calls answer ErrAlreadyScanning
+}
+
+func (f *fakeScanner) ScanAll(ctx context.Context, full bool) ([]string, error) { return nil, nil }
+func (f *fakeScanner) Status(context.Context) (*model.ScannerStatus, error)     { return nil, nil }
+func (f *fakeScanner) ScanFolders(_ context.Context, _ bool, t []model.ScanTarget) ([]string, error) {
+	if f.busy > 0 {
+		f.busy--
+		return nil, model.ErrAlreadyScanning
+	}
+	f.targets = append(f.targets, t)
+	return nil, nil
+}
+
+type fakeMaintenance struct{ deleted []string }
+
+func (f *fakeMaintenance) DeleteMissingFiles(_ context.Context, ids []string) error {
+	f.deleted = append(f.deleted, ids...)
+	return nil
+}
+func (f *fakeMaintenance) DeleteAllMissingFiles(context.Context) error          { return nil }
+func (f *fakeMaintenance) RemapMissingFile(context.Context, string, string) error { return nil }
+
+type fakeTags struct{ written map[string]map[string][]string }
+
+func (f *fakeTags) Read(path string) (map[string][]string, error) {
+	if _, err := os.Stat(path); err != nil {
+		return nil, err
+	}
+	return map[string][]string{}, nil
+}
+func (f *fakeTags) Write(path string, tags map[string][]string) error {
+	f.written[path] = tags
+	return nil
+}
+
+// setupTestLibrary builds <root>/Artist/Album with two tracks and a cover, plus another artist folder.
+func setupTestLibrary(t *testing.T) (string, *tests.MockDataStore, model.MediaFiles) {
+	root := t.TempDir()
+	album := filepath.Join(root, "Artist", "Album")
+	for _, p := range []string{filepath.Join(album, "01.mp3"), filepath.Join(album, "02.mp3"), filepath.Join(album, "cover.jpg"), filepath.Join(root, "Other", "x.mp3")} {
+		if err := os.MkdirAll(filepath.Dir(p), 0o755); err != nil {
+			t.Fatal(err)
+		}
