diff --git a/ui/src/dialogs/DeleteConfirmDialog.jsx b/ui/src/dialogs/DeleteConfirmDialog.jsx
new file mode 100644
index 00000000..95d7fce3
--- /dev/null
+++ b/ui/src/dialogs/DeleteConfirmDialog.jsx
@@ -0,0 +1,155 @@
+import React, { useState, useCallback } from 'react'
+import { useDispatch, useSelector } from 'react-redux'
+import { useNotify, useRefresh, useTranslate } from 'react-admin'
+import { useHistory, useLocation } from 'react-router-dom'
+import {
+  Button,
+  CircularProgress,
+  Dialog,
+  DialogActions,
+  DialogContent,
+  DialogContentText,
+  DialogTitle,
+  makeStyles,
+} from '@material-ui/core'
+import DeleteIcon from '@material-ui/icons/Delete'
+import { closeDeleteConfirmDialog } from '../actions'
+import { deleteAlbum, deleteSong } from '../seer/api'
+
+const useStyles = makeStyles((theme) => ({
+  deleteButton: {
+    backgroundColor: theme.palette.error.main,
+    color: theme.palette.error.contrastText,
+    '&:hover': {
+      backgroundColor: theme.palette.error.dark,
+    },
+  },
+  itemName: {
+    fontWeight: 'bold',
+    color: theme.palette.text.primary,
+  },
+}))
+
+export const DeleteConfirmDialog = () => {
+  const classes = useStyles()
+  const dispatch = useDispatch()
+  const translate = useTranslate()
+  const notify = useNotify()
+  const refresh = useRefresh()
+  const history = useHistory()
+  const location = useLocation()
+
+  const { open, record, recordType } = useSelector(
+    (state) => state.deleteConfirmDialog || {},
+  )
+
+  const isAlbum = recordType === 'album'
+  const [isDeleting, setIsDeleting] = useState(false)
+
+  const handleClose = useCallback(
+    (e) => {
+      if (e) e.stopPropagation()
+      if (!isDeleting) {
+        dispatch(closeDeleteConfirmDialog())
+      }
+    },
+    [dispatch, isDeleting],
+  )
+
+  const handleDelete = useCallback(async () => {
+    if (!record || !record.id) return
+
+    setIsDeleting(true)
+    try {
+      if (isAlbum) {
+        await deleteAlbum(record.id)
+      } else {
+        await deleteSong(record.id)
+      }
+
+      notify('ra.notification.deleted', {
+        type: 'info',
+        messageArgs: { smart_count: 1 },
+      })
+
+      if (isAlbum && location.pathname.startsWith(`/album/${record.id}`)) {
+        history.push('/album')
+      }
+
+      refresh()
+      dispatch(closeDeleteConfirmDialog())
+    } catch (err) {
+      notify(err.message || 'ra.page.error', { type: 'warning' })
+    } finally {
+      setIsDeleting(false)
+    }
+  }, [
+    record,
+    isAlbum,
+    location.pathname,
+    history,
+    refresh,
+    dispatch,
+    notify,
+  ])
+
+  if (!open || !record) {
+    return null
+  }
+
+  const itemName = isAlbum
+    ? record.name || record.album || ''
+    : record.title || ''
+  const itemArtist = record.artist || record.albumArtist || ''
+
+  const dialogTitle = isAlbum
+    ? translate('resources.album.actions.delete', { _: 'Delete Album' })
+    : translate('resources.song.actions.delete', { _: 'Delete Track' })
+
+  const dialogMessage = isAlbum
+    ? translate('resources.album.notifications.deleteConfirm', {
+        _: 'Are you sure you want to permanently delete this album and all its tracks from your storage? This action cannot be undone.',
+      })
+    : translate('resources.song.notifications.deleteConfirm', {
+        _: 'Are you sure you want to permanently delete this track from your storage? This action cannot be undone.',
+      })
+
+  return (
+    <Dialog
+      open={open}
+      onClose={handleClose}
+      aria-labelledby="delete-confirm-dialog-title"
+      maxWidth="xs"
+      fullWidth
+    >
+      <DialogTitle id="delete-confirm-dialog-title">{dialogTitle}</DialogTitle>
+      <DialogContent>
+        <DialogContentText>
+          <span className={classes.itemName}>
+            {itemName}
+            {itemArtist ? ` — ${itemArtist}` : ''}
+          </span>
+        </DialogContentText>
+        <DialogContentText>{dialogMessage}</DialogContentText>
+      </DialogContent>
+      <DialogActions>
+        <Button onClick={handleClose} disabled={isDeleting}>
+          {translate('ra.action.cancel', { _: 'Cancel' })}
+        </Button>
+        <Button
+          onClick={handleDelete}
+          className={classes.deleteButton}
+          variant="contained"
+          disabled={isDeleting}
+          startIcon={
+            isDeleting ? <CircularProgress size={20} color="inherit" /> : <DeleteIcon />
+          }
+        >
+          {translate('ra.action.delete', { _: 'Delete' })}
+        </Button>
+      </DialogActions>
+    </Dialog>
+  )
+}
+
+export default DeleteConfirmDialog
