+                        height: 56,
+                        borderRadius: 8,
+                        backgroundColor: '#444',
+                        display: 'flex',
+                        alignItems: 'center',
+                        justifyContent: 'center',
+                        flexShrink: 0,
+                      }}
+                    >
+                      {pod.sourceType === 'youtube' ? (
+                        <YouTubeIcon color="error" />
+                      ) : (
+                        <RssFeedIcon color="primary" />
+                      )}
+                    </Box>
+                  )}
+                  <div style={{ minWidth: 0, flex: 1 }}>
+                    <Typography
+                      style={{
+                        fontWeight: 700,
+                        fontSize: '0.95rem',
+                        whiteSpace: 'nowrap',
+                        overflow: 'hidden',
+                        textOverflow: 'ellipsis',
+                      }}
+                    >
+                      {pod.title}
+                    </Typography>
+                    <Typography
+                      variant="body2"
+                      color="textSecondary"
+                      style={{
+                        whiteSpace: 'nowrap',
+                        overflow: 'hidden',
+                        textOverflow: 'ellipsis',
+                      }}
+                    >
+                      {pod.author || pod.description}
+                    </Typography>
+                    <Chip
+                      size="small"
+                      label={pod.sourceType === 'youtube' ? 'YouTube' : 'RSS / Apple'}
+                      icon={pod.sourceType === 'youtube' ? <YouTubeIcon /> : <RssFeedIcon />}
+                      variant="outlined"
+                      style={{ marginTop: 4, height: 22 }}
+                    />
+                  </div>
+                </div>
+                <Button
+                  size="small"
+                  variant="contained"
+                  color="primary"
+                  onClick={() => {
+                    setSelectedPodcast(pod)
+                    setDialogOpen(true)
+                  }}
+                  style={{ marginTop: 12 }}
+                >
+                  {translate('resources.podcast.subscribe', { _: 'Inscrever-se' })}
+                </Button>
+              </Card>
+            ))}
+          </Grid>
+        </Section>
+      )}
+
+      <AddPodcastDialog
+        open={dialogOpen}
+        onClose={() => setDialogOpen(false)}
+        initialItem={selectedPodcast}
+      />
     </div>
   )
 }
