+  const [directUrl, setDirectUrl] = useState('')
+  const [keepPolicy, setKeepPolicy] = useState(1) // default: keep 1
+  const [autoDownload, setAutoDownload] = useState(true)
+  const [submitting, setSubmitting] = useState(false)
+
+  // Reset when opened
+  useEffect(() => {
+    if (open) {
+      if (initialItem) {
+        setTab(0)
+        setSearchTerm(initialItem.title || '')
+        setSearchResults([initialItem])
+        setSelectedResult(initialItem)
+        setDirectUrl(initialItem.feedUrl || initialItem.url || '')
+      } else {
+        setTab(0)
+        setSearchTerm('')
+        setSearchResults([])
+        setSelectedResult(null)
+        setDirectUrl('')
+      }
+      setKeepPolicy(1)
+      setAutoDownload(true)
+      setSubmitting(false)
+    }
+  }, [open, initialItem])
+
+  const handleSearch = (e) => {
+    e?.preventDefault()
+    const query = searchTerm.trim()
+    if (!query) return
+
+    setSearching(true)
+    setSelectedResult(null)
+    searchPodcasts(query, 'all', 15)
+      .then((results) => {
+        setSearchResults(results || [])
+        if (!results || results.length === 0) {
+          notify(
+            translate('resources.podcast.noResults', {
+              _: 'Nenhum podcast encontrado',
+            }),
+            'info',
+          )
+        }
+      })
+      .catch((err) => {
+        notify(err.message || 'Erro ao buscar podcasts', 'warning')
+      })
+      .finally(() => setSearching(false))
+  }
+
+  const handleSubmit = () => {
+    let url = ''
+    let sourceType = 'rss'
+
+    if (tab === 0) {
+      if (!selectedResult) {
+        notify(
+          translate('resources.podcast.selectOne', {
+            _: 'Selecione um podcast da lista',
+          }),
+          'warning',
+        )
+        return
+      }
+      url = selectedResult.feedUrl
+      sourceType = selectedResult.sourceType || 'rss'
+    } else {
+      url = directUrl.trim()
+      if (!url) {
+        notify(
+          translate('resources.podcast.enterUrl', {
+            _: 'Insira a URL do podcast',
+          }),
+          'warning',
+        )
+        return
+      }
+      if (url.includes('youtube.com') || url.includes('youtu.be')) {
+        sourceType = 'youtube'
+      }
+    }
+
+    setSubmitting(true)
+    createPodcast({
+      url,
+      sourceType,
+      keepPolicy: Number(keepPolicy),
+      autoDownload,
+    })
+      .then((ch) => {
+        notify(
+          translate('resources.podcast.subscribedSuccess', {
+            _: 'Podcast inscrito com sucesso! Os episódios serão baixados.',
+          }),
+          'info',
+        )
+        if (onCreated) onCreated(ch)
+        onClose()
+      })
+      .catch((err) => {
+        notify(err.message || 'Erro ao inscrever podcast', 'warning')
+      })
+      .finally(() => setSubmitting(false))
+  }
+
+  return (
+    <Dialog open={open} onClose={onClose} maxWidth="sm" fullWidth>
+      <DialogTitle>
+        {translate('resources.podcast.add', { _: 'Adicionar Podcast' })}
+      </DialogTitle>
+      <DialogContent className={classes.dialogContent}>
+        <Tabs
+          value={tab}
+          onChange={(_, val) => setTab(val)}
+          indicatorColor="primary"
+          textColor="primary"
+          variant="fullWidth"
+          style={{ marginBottom: 16 }}
+        >
+          <Tab
+            label={translate('resources.podcast.searchTab', {
+              _: 'Buscar Podcasts',
+            })}
+          />
+          <Tab
+            label={translate('resources.podcast.directUrlTab', {
+              _: 'URL Direta (YouTube / RSS)',
+            })}
+          />
+        </Tabs>
+
+        {tab === 0 && (
+          <div>
+            <form onSubmit={handleSearch} className={classes.searchBox}>
+              <TextField
+                fullWidth
+                variant="outlined"
+                size="small"
+                placeholder={translate('resources.podcast.searchPlaceholder', {
+                  _: 'Buscar podcasts no Apple Podcasts ou YouTube...',
+                })}
+                value={searchTerm}
+                onChange={(e) => setSearchTerm(e.target.value)}
+                InputProps={{
+                  startAdornment: (
+                    <InputAdornment position="start">
+                      <SearchIcon color="action" />
+                    </InputAdornment>
+                  ),
+                  endAdornment: (
+                    <InputAdornment position="end">
+                      {searchTerm && (
+                        <IconButton
+                          size="small"
+                          onClick={() => setSearchTerm('')}
+                        >
+                          <CloseIcon fontSize="small" />
+                        </IconButton>
+                      )}
+                      <Button
+                        size="small"
+                        color="primary"
+                        variant="contained"
+                        onClick={handleSearch}
+                        disabled={searching || !searchTerm.trim()}
+                        style={{ marginLeft: 8 }}
+                      >
+                        {searching ? (
+                          <CircularProgress size={20} color="inherit" />
+                        ) : (
+                          translate('resources.podcast.searchBtn', {
+                            _: 'Buscar',
+                          })
+                        )}
+                      </Button>
+                    </InputAdornment>
+                  ),
+                }}
+              />
+            </form>
+
+            <div className={classes.resultsList}>
+              {searching && (
+                <Box display="flex" justifyContent="center" p={3}>
+                  <CircularProgress size={32} />
+                </Box>
+              )}
+              {!searching &&
+                searchResults.map((item, index) => {
+                  const isSelected = selectedResult?.feedUrl === item.feedUrl
+                  return (
+                    <Card
+                      key={index}
+                      className={`${classes.resultCard} ${
+                        isSelected ? classes.resultCardSelected : ''
+                      }`}
+                      onClick={() => setSelectedResult(item)}
+                    >
+                      {item.imageUrl ? (
+                        <CardMedia
+                          className={classes.cardMedia}
+                          image={item.imageUrl}
+                          title={item.title}
+                        />
+                      ) : (
+                        <Box
+                          className={classes.cardMedia}
+                          display="flex"
+                          alignItems="center"
+                          justifyContent="center"
+                        >
+                          {item.sourceType === 'youtube' ? (
+                            <YouTubeIcon color="error" />
+                          ) : (
+                            <RssFeedIcon color="primary" />
+                          )}
+                        </Box>
+                      )}
+                      <CardContent className={classes.cardContent}>
+                        <Typography className={classes.cardTitle}>
+                          {item.title}
+                        </Typography>
+                        <Typography className={classes.cardAuthor}>
+                          {item.author || item.description}
+                        </Typography>
+                        <Box display="flex" gap={1} mt={0.5}>
+                          <Chip
+                            size="small"
+                            label={
+                              item.sourceType === 'youtube'
+                                ? 'YouTube'
+                                : 'Apple Podcasts / RSS'
+                            }
+                            icon={
+                              item.sourceType === 'youtube' ? (
+                                <YouTubeIcon />
+                              ) : (
+                                <RssFeedIcon />
+                              )
+                            }
+                            variant="outlined"
+                          />
+                        </Box>
+                      </CardContent>
+                    </Card>
+                  )
+                })}
+            </div>
+          </div>
+        )}
+
+        {tab === 1 && (
+          <Box mb={2}>
+            <TextField
+              fullWidth
+              variant="outlined"
+              label={translate('resources.podcast.urlLabel', {
+                _: 'Link do RSS ou YouTube',
+              })}
+              placeholder="https://feed.podbean.com/... ou https://youtube.com/@podcast"
+              value={directUrl}
+              onChange={(e) => setDirectUrl(e.target.value)}
+              helperText={translate('resources.podcast.urlHelper', {
+                _: 'Suporta canais, playlists ou vídeos do YouTube e feeds RSS de podcasts.',
+              })}
+            />
+          </Box>
+        )}
+
+        {/* Retention Policy & Automatic Download */}
+        <div className={classes.policySection}>
+          <Typography className={classes.policyLabel}>
+            {translate('resources.podcast.keepPolicyTitle', {
+              _: 'Política de download e retenção:',
+            })}
+          </Typography>
+          <RadioGroup
+            value={keepPolicy}
+            onChange={(e) => setKeepPolicy(Number(e.target.value))}
+          >
+            <FormControlLabel
+              value={1}
+              control={<Radio color="primary" size="small" />}
+              label={translate('resources.podcast.keep1', {
+                _: 'Manter apenas o último episódio (apaga anteriores ao baixar o novo)',
+              })}
+            />
+            <FormControlLabel
+              value={3}
+              control={<Radio color="primary" size="small" />}
+              label={translate('resources.podcast.keep3', {
+                _: 'Manter os 3 últimos episódios',
+              })}
+            />
+            <FormControlLabel
+              value={0}
+              control={<Radio color="primary" size="small" />}
+              label={translate('resources.podcast.keepAll', {
+                _: 'Baixar todos e manter todos',
+              })}
+            />
+          </RadioGroup>
+
+          <Box mt={1}>
+            <FormControlLabel
+              control={
+                <Checkbox
+                  checked={autoDownload}
+                  onChange={(e) => setAutoDownload(e.target.checked)}
+                  color="primary"
+                  size="small"
+                />
+              }
+              label={translate('resources.podcast.autoDownloadWeekly', {
+                _: 'Verificar e baixar novos episódios periodicamente (semanalmente)',
+              })}
+            />
+          </Box>
+        </div>
+      </DialogContent>
+      <DialogActions>
+        <Button onClick={onClose} disabled={submitting}>
+          {translate('ra.action.cancel', { _: 'Cancelar' })}
+        </Button>
+        <Button
+          onClick={handleSubmit}
+          color="primary"
+          variant="contained"
+          disabled={
+            submitting ||
+            (tab === 0 && !selectedResult) ||
+            (tab === 1 && !directUrl.trim())
+          }
+        >
+          {submitting ? (
+            <CircularProgress size={20} color="inherit" />
+          ) : (
+            translate('resources.podcast.subscribe', { _: 'Inscrever-se' })
+          )}
+        </Button>
+      </DialogActions>
+    </Dialog>
+  )
+}
+
+export default AddPodcastDialog
