+      backgroundColor: theme.palette.primary.dark,
+    },
+  },
+}))
+
+export const PodcastShow = ({ id, onBack }) => {
+  const classes = useStyles()
+  const notify = useNotify()
+  const translate = useTranslate()
+  const dispatch = useDispatch()
+
+  const [loading, setLoading] = useState(true)
+  const [show, setShow] = useState(null)
+  const [episodes, setEpisodes] = useState([])
+  const [refreshing, setRefreshing] = useState(false)
+
+  // Settings Dialog
+  const [settingsOpen, setSettingsOpen] = useState(false)
+  const [editKeepPolicy, setEditKeepPolicy] = useState(1)
+  const [editAutoDownload, setEditAutoDownload] = useState(true)
+
+  // Delete Dialog
+  const [deleteOpen, setDeleteOpen] = useState(false)
+  const [deleteFiles, setDeleteFiles] = useState(true)
+
+  const loadData = useCallback(() => {
+    return getPodcast(id)
+      .then((data) => {
+        setShow(data)
+        setEpisodes(data.episodes || [])
+        setEditKeepPolicy(data.keepPolicy ?? 1)
+        setEditAutoDownload(data.autoDownload ?? true)
+      })
+      .catch((err) => {
+        notify(err.message || 'Erro ao carregar podcast', 'warning')
+      })
+      .finally(() => setLoading(false))
+  }, [id, notify])
+
+  useEffect(() => {
+    loadData()
+  }, [loadData])
+
+  useRefreshOnEvents({
+    events: ['podcast', 'seer'],
+    onRefresh: loadData,
+  })
+
+  const handleRefresh = () => {
+    setRefreshing(true)
+    refreshPodcast(id)
+      .then(() => {
+        notify(
+          translate('resources.podcast.refreshStarted', {
+            _: 'Verificando novos episódios...',
+          }),
+          'info',
+        )
+      })
+      .catch((err) => notify(err.message || 'Erro ao atualizar', 'warning'))
+      .finally(() => setRefreshing(false))
+  }
+
+  const handleSaveSettings = () => {
+    updatePodcast(id, {
+      keepPolicy: Number(editKeepPolicy),
+      autoDownload: editAutoDownload,
+    })
+      .then((updated) => {
+        setShow((prev) => ({ ...prev, ...updated }))
+        setSettingsOpen(false)
+        notify(
+          translate('resources.podcast.settingsSaved', {
+            _: 'Configurações salvas com sucesso!',
+          }),
+          'info',
+        )
+        // Refresh to apply new policy immediately
+        refreshPodcast(id)
+      })
+      .catch((err) => notify(err.message || 'Erro ao salvar', 'warning'))
+  }
+
+  const handleDelete = () => {
+    deletePodcast(id, deleteFiles)
+      .then(() => {
+        notify(
+          translate('resources.podcast.deletedSuccess', {
+            _: 'Podcast excluído',
+          }),
+          'info',
+        )
+        setDeleteOpen(false)
+        if (onBack) onBack()
+      })
+      .catch((err) => notify(err.message || 'Erro ao excluir', 'warning'))
+  }
+
+  const handlePlayEpisode = (ep) => {
+    const track = {
+      id: ep.id,
+      trackId: ep.id,
+      title: ep.title,
+      name: ep.title,
+      artist: show.title,
+      album: show.title,
+      cover: ep.imageUrl || show.imageUrl,
+      streamUrl: `/api/seer/podcasts/episodes/${ep.id}/stream`,
+      isPodcast: true,
+    }
+    dispatch(playTracks({ [ep.id]: track }, [ep.id], ep.id))
+    notify(
+      translate('resources.podcast.playing', {
+        _: 'Reproduzindo episódio: %{title}',
+        title: ep.title,
+      }),
+      'info',
+    )
+  }
+
+  const handleDownloadEp = (ep) => {
+    downloadEpisode(ep.id)
+      .then(() => {
+        notify(
+          translate('resources.podcast.downloadingEp', {
+            _: 'Download iniciado!',
+          }),
+          'info',
+        )
+        setEpisodes((prev) =>
+          prev.map((e) => (e.id === ep.id ? { ...e, status: 'downloading' } : e)),
+        )
+      })
+      .catch((err) => notify(err.message || 'Erro ao iniciar download', 'warning'))
+  }
+
+  const handleDeleteEp = (ep) => {
+    deleteEpisode(ep.id)
+      .then(() => {
+        notify(
+          translate('resources.podcast.deletedEp', {
+            _: 'Arquivo do episódio excluído.',
+          }),
+          'info',
+        )
+        setEpisodes((prev) =>
+          prev.map((e) =>
+            e.id === ep.id ? { ...e, status: 'deleted', filePath: '' } : e,
+          ),
+        )
+      })
+      .catch((err) => notify(err.message || 'Erro ao excluir áudio', 'warning'))
+  }
+
+  const formatDuration = (seconds) => {
+    if (!seconds) return ''
+    const h = Math.floor(seconds / 3600)
+    const m = Math.floor((seconds % 3600) / 60)
+    if (h > 0) return `${h}h ${m}m`
+    return `${m} min`
+  }
+
+  const formatDate = (dateStr) => {
+    if (!dateStr) return ''
+    try {
+      return new Date(dateStr).toLocaleDateString(undefined, {
+        day: '2-digit',
+        month: 'short',
+        year: 'numeric',
+      })
+    } catch {
+      return dateStr
+    }
+  }
+
+  const policyLabel = (policy) => {
+    switch (policy) {
+      case 1:
+        return 'Manter apenas o último'
+      case 3:
+        return 'Manter os 3 últimos'
+      default:
+        return 'Manter todos'
+    }
+  }
+
+  if (loading) {
+    return (
+      <Box display="flex" justifyContent="center" p={8}>
+        <CircularProgress size={48} />
+      </Box>
+    )
+  }
+
+  if (!show) {
+    return (
+      <Box p={4} textAlign="center">
+        <Typography variant="h6">Podcast não encontrado</Typography>
+        <Button onClick={onBack} startIcon={<ArrowBackIcon />} style={{ marginTop: 16 }}>
+          Voltar
+        </Button>
+      </Box>
+    )
+  }
+
+  return (
+    <div className={classes.root}>
+      <Button
+        startIcon={<ArrowBackIcon />}
+        onClick={onBack}
+        style={{ marginBottom: 16 }}
+      >
+        {translate('resources.podcast.backToList', { _: 'Todos os Podcasts' })}
+      </Button>
+
+      {/* Show Header */}
+      <Card className={classes.headerCard}>
+        {show.imageUrl ? (
+          <CardMedia className={classes.cover} image={show.imageUrl} title={show.title} />
+        ) : (
+          <div className={classes.cover}>
+            <MicIcon style={{ fontSize: 64, color: '#aaa' }} />
+          </div>
+        )}
+
+        <CardContent className={classes.headerContent}>
+          <div>
+            <Typography className={classes.title}>{show.title}</Typography>
+            <Typography className={classes.author}>{show.author}</Typography>
+            {show.description && (
+              <Typography className={classes.description}>
+                {show.description}
+              </Typography>
+            )}
+
+            <Box display="flex" gap={1} flexWrap="wrap" mb={1}>
+              <Chip
+                label={policyLabel(show.keepPolicy)}
+                color="primary"
+                variant="outlined"
+                size="small"
+              />
+              {show.autoDownload && (
+                <Chip
+                  label="Download semanal ativo"
+                  color="secondary"
+                  variant="outlined"
+                  size="small"
+                />
+              )}
+              {show.url && (
+                <Chip
+                  label="Página de origem"
+                  icon={<OpenInNewIcon fontSize="small" />}
+                  clickable
+                  component="a"
+                  href={show.url}
+                  target="_blank"
+                  rel="noreferrer"
+                  size="small"
+                />
+              )}
+            </Box>
+          </div>
+
+          <div className={classes.actionsRow}>
+            <Button
+              variant="contained"
+              color="primary"
+              startIcon={
+                refreshing ? (
+                  <CircularProgress size={16} color="inherit" />
+                ) : (
+                  <RefreshIcon />
+                )
+              }
+              onClick={handleRefresh}
+              disabled={refreshing}
+            >
+              {translate('resources.podcast.refresh', { _: 'Verificar agora' })}
+            </Button>
+            <Button
+              variant="outlined"
+              startIcon={<SettingsIcon />}
+              onClick={() => setSettingsOpen(true)}
+            >
+              {translate('resources.podcast.settings', {
+                _: 'Configurações de retenção',
+              })}
+            </Button>
+            <Button
+              variant="outlined"
+              color="secondary"
+              startIcon={<DeleteOutlineIcon />}
+              onClick={() => setDeleteOpen(true)}
+            >
+              {translate('resources.podcast.unsubscribe', { _: 'Excluir' })}
+            </Button>
+          </div>
+        </CardContent>
+      </Card>
+
+      {/* Episodes Table */}
+      <Typography variant="h5" style={{ fontWeight: 700, marginBottom: 16 }}>
+        {translate('resources.podcast.episodes', { _: 'Episódios' })} (
+        {episodes.length})
+      </Typography>
+
+      <TableContainer component={Paper} elevation={1} style={{ borderRadius: 12 }}>
+        <Table>
+          <TableHead>
+            <TableRow>
+              <TableCell width={60}></TableCell>
+              <TableCell>{translate('resources.seer.fields.title', { _: 'Título' })}</TableCell>
+              <TableCell width={140}>Data</TableCell>
+              <TableCell width={100}>Duração</TableCell>
+              <TableCell width={140}>Status</TableCell>
+              <TableCell width={100} align="right">Ações</TableCell>
+            </TableRow>
+          </TableHead>
+          <TableBody>
+            {episodes.map((ep) => {
+              const isDownloaded = ep.status === 'downloaded'
+              const isDownloading = ep.status === 'downloading'
+              return (
+                <TableRow key={ep.id} className={classes.episodeRow}>
+                  <TableCell>
+                    <IconButton
+                      size="small"
+                      className={classes.playBtn}
+                      onClick={() => handlePlayEpisode(ep)}
+                      aria-label="Play"
+                    >
+                      <PlayArrowIcon />
+                    </IconButton>
+                  </TableCell>
+                  <TableCell>
+                    <Typography style={{ fontWeight: 600, fontSize: '0.95rem' }}>
+                      {ep.title}
+                    </Typography>
+                    {ep.description && (
+                      <Typography
+                        variant="body2"
+                        color="textSecondary"
+                        style={{
+                          maxHeight: 40,
+                          overflow: 'hidden',
+                          textOverflow: 'ellipsis',
+                          display: '-webkit-box',
+                          WebkitLineClamp: 2,
+                          WebkitBoxOrient: 'vertical',
+                        }}
+                      >
+                        {ep.description}
+                      </Typography>
+                    )}
+                  </TableCell>
+                  <TableCell>{formatDate(ep.publishedAt)}</TableCell>
+                  <TableCell>{formatDuration(ep.duration)}</TableCell>
+                  <TableCell>
+                    {isDownloaded && (
+                      <Chip
+                        size="small"
+                        label="Baixado"
+                        style={{ backgroundColor: '#2e7d32', color: '#fff' }}
+                      />
+                    )}
+                    {isDownloading && (
+                      <Chip
+                        size="small"
+                        label="Baixando..."
+                        color="primary"
+                        icon={<CircularProgress size={14} color="inherit" />}
+                      />
+                    )}
+                    {ep.status === 'pending' && (
+                      <Chip size="small" label="Pendente" variant="outlined" />
+                    )}
+                    {ep.status === 'deleted' && (
+                      <Chip
+                        size="small"
+                        label="Retenção (excluído)"
+                        variant="outlined"
+                        color="default"
+                      />
+                    )}
+                    {ep.status === 'error' && (
+                      <Tooltip title={ep.error || 'Erro ao baixar'}>
+                        <Chip size="small" label="Erro" color="secondary" />
+                      </Tooltip>
+                    )}
+                  </TableCell>
+                  <TableCell align="right">
+                    {isDownloaded ? (
+                      <Tooltip title="Excluir áudio do disco">
+                        <IconButton
+                          size="small"
+                          color="secondary"
+                          onClick={() => handleDeleteEp(ep)}
+                        >
+                          <DeleteOutlineIcon />
+                        </IconButton>
+                      </Tooltip>
+                    ) : (
+                      <Tooltip title="Baixar episódio agora">
+                        <IconButton
+                          size="small"
+                          color="primary"
+                          disabled={isDownloading}
+                          onClick={() => handleDownloadEp(ep)}
+                        >
+                          <GetAppIcon />
+                        </IconButton>
+                      </Tooltip>
+                    )}
+                  </TableCell>
+                </TableRow>
+              )
+            })}
+          </TableBody>
+        </Table>
+      </TableContainer>
+
+      {/* Settings Dialog */}
+      <Dialog
+        open={settingsOpen}
+        onClose={() => setSettingsOpen(false)}
+        maxWidth="xs"
+        fullWidth
+      >
+        <DialogTitle>Configurações de Retenção</DialogTitle>
+        <DialogContent>
+          <Typography variant="subtitle2" style={{ marginBottom: 8, fontWeight: 600 }}>
+            Quantos episódios deseja manter baixados:
+          </Typography>
+          <RadioGroup
+            value={editKeepPolicy}
+            onChange={(e) => setEditKeepPolicy(Number(e.target.value))}
+          >
+            <FormControlLabel
+              value={1}
+              control={<Radio color="primary" size="small" />}
+              label="Manter apenas o último episódio (apaga anteriores)"
+            />
+            <FormControlLabel
+              value={3}
+              control={<Radio color="primary" size="small" />}
+              label="Manter os 3 últimos episódios"
+            />
+            <FormControlLabel
+              value={0}
+              control={<Radio color="primary" size="small" />}
+              label="Baixar todos e manter todos"
+            />
+          </RadioGroup>
+
+          <Box mt={2}>
+            <FormControlLabel
+              control={
+                <Checkbox
+                  checked={editAutoDownload}
+                  onChange={(e) => setEditAutoDownload(e.target.checked)}
+                  color="primary"
+                  size="small"
+                />
+              }
+              label="Baixar novos episódios automaticamente (semanalmente)"
+            />
+          </Box>
+        </DialogContent>
+        <DialogActions>
+          <Button onClick={() => setSettingsOpen(false)}>Cancelar</Button>
+          <Button onClick={handleSaveSettings} color="primary" variant="contained">
+            Salvar
+          </Button>
+        </DialogActions>
+      </Dialog>
+
+      {/* Delete Dialog */}
+      <Dialog open={deleteOpen} onClose={() => setDeleteOpen(false)}>
+        <DialogTitle>Excluir Podcast</DialogTitle>
+        <DialogContent>
+          <Typography style={{ marginBottom: 16 }}>
+            Tem certeza que deseja cancelar a inscrição de <strong>{show.title}</strong>?
+          </Typography>
+          <FormControlLabel
+            control={
+              <Checkbox
+                checked={deleteFiles}
+                onChange={(e) => setDeleteFiles(e.target.checked)}
+                color="secondary"
+              />
+            }
+            label="Excluir também os arquivos de áudio baixados do disco"
+          />
+        </DialogContent>
+        <DialogActions>
+          <Button onClick={() => setDeleteOpen(false)}>Cancelar</Button>
+          <Button onClick={handleDelete} color="secondary" variant="contained">
+            Confirmar Exclusão
+          </Button>
+        </DialogActions>
+      </Dialog>
+    </div>
+  )
+}
+
+export default PodcastShow
