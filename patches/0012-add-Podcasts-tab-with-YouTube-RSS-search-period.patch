+package seerapi
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"net/http"
+	"os"
+	"strconv"
+	"strings"
+
+	"github.com/go-chi/chi/v5"
+	"github.com/navidrome/navidrome/core/seer"
+	"github.com/navidrome/navidrome/log"
+	"github.com/navidrome/navidrome/model/request"
+)
+
+// Podcasts is the interface for podcast operations used by the API.
+type Podcasts interface {
+	Search(ctx context.Context, query, source string, limit int) ([]seer.PodcastSearchResult, error)
+	List(ctx context.Context, userID string) ([]seer.PodcastChannel, error)
+	Get(ctx context.Context, id string) (*seer.PodcastChannel, []seer.PodcastEpisode, error)
+	Subscribe(ctx context.Context, userID, rawURL, sourceType string, keepPolicy int, autoDownload bool) (*seer.PodcastChannel, error)
+	Update(ctx context.Context, id string, keepPolicy int, autoDownload bool) (*seer.PodcastChannel, error)
+	DeleteChannel(ctx context.Context, id string, deleteFiles bool) error
+	SyncChannel(ctx context.Context, id string) error
+	RefreshAll(ctx context.Context) error
+	GetEpisode(ctx context.Context, id string) (*seer.PodcastEpisode, error)
+	DownloadEpisode(ctx context.Context, id string) error
+	DeleteEpisodeFile(ctx context.Context, id string) error
+}
+
+func (api *Router) searchPodcasts(w http.ResponseWriter, r *http.Request) {
+	q := r.URL.Query().Get("q")
+	src := r.URL.Query().Get("source")
+	limit, _ := strconv.Atoi(r.URL.Query().Get("limit"))
+	if limit <= 0 || limit > 50 {
+		limit = 15
+	}
+	results, err := api.podcasts.Search(r.Context(), q, src, limit)
+	if err != nil {
+		log.Error(r.Context(), "Seer: searching podcasts failed", err)
+		http.Error(w, "search failed: "+err.Error(), http.StatusInternalServerError)
+		return
+	}
+	if results == nil {
+		results = []seer.PodcastSearchResult{}
+	}
+	writeJSON(w, http.StatusOK, results)
+}
+
+func (api *Router) listPodcasts(w http.ResponseWriter, r *http.Request) {
+	user, _ := request.UserFrom(r.Context())
+	userID := user.ID
+	if user.IsAdmin && r.URL.Query().Get("mine") != "true" {
+		userID = ""
+	}
+	channels, err := api.podcasts.List(r.Context(), userID)
+	if err != nil {
+		log.Error(r.Context(), "Seer: listing podcasts failed", err)
+		http.Error(w, "internal error", http.StatusInternalServerError)
+		return
+	}
+	if channels == nil {
+		channels = []seer.PodcastChannel{}
+	}
+	w.Header().Set("X-Total-Count", strconv.Itoa(len(channels)))
+	writeJSON(w, http.StatusOK, channels)
+}
+
+func (api *Router) createPodcast(w http.ResponseWriter, r *http.Request) {
+	user, _ := request.UserFrom(r.Context())
+	var body struct {
+		URL          string `json:"url"`
+		SourceType   string `json:"sourceType"`
+		KeepPolicy   int    `json:"keepPolicy"`
+		AutoDownload bool   `json:"autoDownload"`
+	}
+	if err := json.NewDecoder(http.MaxBytesReader(w, r.Body, 64<<10)).Decode(&body); err != nil {
+		http.Error(w, "invalid body", http.StatusBadRequest)
+		return
+	}
+	ch, err := api.podcasts.Subscribe(r.Context(), user.ID, body.URL, body.SourceType, body.KeepPolicy, body.AutoDownload)
+	if err != nil {
+		log.Error(r.Context(), "Seer: subscribing to podcast failed", err)
+		http.Error(w, err.Error(), http.StatusBadRequest)
+		return
+	}
+	writeJSON(w, http.StatusCreated, ch)
+}
+
+func (api *Router) refreshAllPodcasts(w http.ResponseWriter, r *http.Request) {
+	go func() {
+		_ = api.podcasts.RefreshAll(context.Background())
+	}()
+	w.WriteHeader(http.StatusAccepted)
+}
+
+func (api *Router) getPodcast(w http.ResponseWriter, r *http.Request) {
+	user, _ := request.UserFrom(r.Context())
+	id := chi.URLParam(r, "id")
+	ch, eps, err := api.podcasts.Get(r.Context(), id)
+	if err != nil || (!user.IsAdmin && ch.UserID != user.ID) {
+		http.Error(w, "not found", http.StatusNotFound)
+		return
+	}
+	if eps == nil {
+		eps = []seer.PodcastEpisode{}
+	}
+	out := struct {
+		*seer.PodcastChannel
+		Episodes []seer.PodcastEpisode `json:"episodes"`
+	}{
+		PodcastChannel: ch,
+		Episodes:       eps,
+	}
+	writeJSON(w, http.StatusOK, out)
+}
+
+func (api *Router) updatePodcast(w http.ResponseWriter, r *http.Request) {
+	user, _ := request.UserFrom(r.Context())
+	id := chi.URLParam(r, "id")
+	ch, _, err := api.podcasts.Get(r.Context(), id)
+	if err != nil || (!user.IsAdmin && ch.UserID != user.ID) {
+		http.Error(w, "not found", http.StatusNotFound)
+		return
+	}
+	var body struct {
+		KeepPolicy   int  `json:"keepPolicy"`
+		AutoDownload bool `json:"autoDownload"`
+	}
+	if err := json.NewDecoder(http.MaxBytesReader(w, r.Body, 16<<10)).Decode(&body); err != nil {
+		http.Error(w, "invalid body", http.StatusBadRequest)
+		return
+	}
+	updated, err := api.podcasts.Update(r.Context(), id, body.KeepPolicy, body.AutoDownload)
+	if err != nil {
+		http.Error(w, err.Error(), http.StatusInternalServerError)
+		return
+	}
+	writeJSON(w, http.StatusOK, updated)
+}
+
+func (api *Router) deletePodcast(w http.ResponseWriter, r *http.Request) {
+	user, _ := request.UserFrom(r.Context())
+	id := chi.URLParam(r, "id")
+	ch, _, err := api.podcasts.Get(r.Context(), id)
+	if err != nil || (!user.IsAdmin && ch.UserID != user.ID) {
+		http.Error(w, "not found", http.StatusNotFound)
+		return
+	}
+	deleteFiles := r.URL.Query().Get("deleteFiles") == "true"
+	if err := api.podcasts.DeleteChannel(r.Context(), id, deleteFiles); err != nil {
+		http.Error(w, err.Error(), http.StatusInternalServerError)
+		return
+	}
+	w.WriteHeader(http.StatusNoContent)
+}
+
+func (api *Router) refreshPodcast(w http.ResponseWriter, r *http.Request) {
+	user, _ := request.UserFrom(r.Context())
+	id := chi.URLParam(r, "id")
+	ch, _, err := api.podcasts.Get(r.Context(), id)
+	if err != nil || (!user.IsAdmin && ch.UserID != user.ID) {
+		http.Error(w, "not found", http.StatusNotFound)
+		return
+	}
+	go func() {
+		_ = api.podcasts.SyncChannel(context.Background(), id)
+	}()
+	w.WriteHeader(http.StatusAccepted)
+}
+
+func (api *Router) downloadEpisode(w http.ResponseWriter, r *http.Request) {
+	epId := chi.URLParam(r, "epId")
+	go func() {
+		_ = api.podcasts.DownloadEpisode(context.Background(), epId)
+	}()
+	w.WriteHeader(http.StatusAccepted)
+}
+
+func (api *Router) deleteEpisode(w http.ResponseWriter, r *http.Request) {
+	epId := chi.URLParam(r, "epId")
+	if err := api.podcasts.DeleteEpisodeFile(r.Context(), epId); err != nil {
+		http.Error(w, err.Error(), http.StatusInternalServerError)
+		return
+	}
+	w.WriteHeader(http.StatusNoContent)
+}
+
+func (api *Router) streamEpisode(w http.ResponseWriter, r *http.Request) {
+	epId := chi.URLParam(r, "epId")
+	ep, err := api.podcasts.GetEpisode(r.Context(), epId)
+	if err != nil || ep == nil {
+		http.Error(w, "episode not found", http.StatusNotFound)
+		return
+	}
+	if ep.FilePath == "" {
+		http.Error(w, "episode file not downloaded", http.StatusNotFound)
+		return
+	}
+	if _, err := os.Stat(ep.FilePath); errors.Is(err, os.ErrNotExist) {
+		http.Error(w, "file does not exist on disk", http.StatusNotFound)
+		return
+	}
+
+	w.Header().Set("Content-Type", "audio/mpeg")
+	if strings.HasSuffix(ep.FilePath, ".m4a") {
+		w.Header().Set("Content-Type", "audio/mp4")
+	} else if strings.HasSuffix(ep.FilePath, ".opus") || strings.HasSuffix(ep.FilePath, ".ogg") {
+		w.Header().Set("Content-Type", "audio/ogg")
+	}
+	http.ServeFile(w, r, ep.FilePath)
+}
