+type PodcastService struct {
+	store      *PodcastStore
+	destFolder func() string
+	lib        *library
+	broker     events.Broker
+	ffmpeg     string
+	ytdlp      string
+
+	mu      sync.Mutex
+	syncing map[string]bool
+}
+
+func NewPodcastService(store *PodcastStore, destFolder func() string, lib *library, broker events.Broker, ffmpeg, ytdlp string) *PodcastService {
+	if ffmpeg == "" {
+		ffmpeg = "ffmpeg"
+	}
+	if ytdlp == "" {
+		ytdlp = "yt-dlp"
+	}
+	return &PodcastService{
+		store:      store,
+		destFolder: destFolder,
+		lib:        lib,
+		broker:     broker,
+		ffmpeg:     ffmpeg,
+		ytdlp:      ytdlp,
+		syncing:    make(map[string]bool),
+	}
+}
+
+func (s *PodcastService) notifyUI() {
+	if s.broker != nil {
+		s.broker.SendBroadcastMessage(context.Background(), (&events.RefreshResource{}).With("podcast"))
+		s.broker.SendBroadcastMessage(context.Background(), (&events.RefreshResource{}).With("seer"))
+	}
+}
+
+func (s *PodcastService) randomID(prefix string) string {
+	b := make([]byte, 8)
+	_, _ = rand.Read(b)
+	return prefix + "_" + hex.EncodeToString(b)
+}
+
+func (s *PodcastService) podcastsDir() (string, error) {
+	root := s.destFolder()
+	if root == "" {
+		return "", errors.New("destination folder is not configured")
+	}
+	dir := filepath.Join(root, "Podcasts")
+	if err := os.MkdirAll(dir, 0755); err != nil {
+		return "", fmt.Errorf("creating podcasts directory: %w", err)
+	}
+	return dir, nil
+}
+
+// Subscribe subscribes to a podcast feed and triggers the initial sync.
+func (s *PodcastService) Subscribe(ctx context.Context, userID, rawURL, sourceType string, keepPolicy int, autoDownload bool) (*PodcastChannel, error) {
+	rawURL = strings.TrimSpace(rawURL)
+	if rawURL == "" {
+		return nil, errors.New("podcast URL is required")
+	}
+	if sourceType == "" {
+		if IsYouTubeURL(rawURL) {
+			sourceType = "youtube"
+		} else {
+			sourceType = "rss"
+		}
+	}
+
+	feed, err := FetchFeed(ctx, rawURL, s.ytdlp)
+	if err != nil {
+		return nil, fmt.Errorf("failed to fetch podcast feed: %w", err)
+	}
+
+	title := cmpStr(feed.Title, "Podcast")
+	ch := &PodcastChannel{
+		ID:           s.randomID("pchan"),
+		UserID:       userID,
+		Title:        title,
+		Author:       cmpStr(feed.Author, "Unknown"),
+		Description:  feed.Description,
+		SourceType:   cmpStr(feed.SourceType, sourceType),
+		URL:          cmpStr(feed.URL, rawURL),
+		FeedURL:      rawURL,
+		ImageURL:     feed.ImageURL,
+		KeepPolicy:   keepPolicy,
+		AutoDownload: autoDownload,
+	}
+
+	if err := s.store.CreateChannel(ctx, ch); err != nil {
+		return nil, fmt.Errorf("saving podcast channel: %w", err)
+	}
+
+	for _, ep := range feed.Episodes {
+		episode := &PodcastEpisode{
+			ID:          s.randomID("pep"),
+			ChannelID:   ch.ID,
+			GUID:        ep.GUID,
+			Title:       cmpStr(ep.Title, "Untitled Episode"),
+			Description: ep.Description,
+			AudioURL:    ep.AudioURL,
+			ImageURL:    cmpStr(ep.ImageURL, ch.ImageURL),
+			PublishedAt: ep.PublishedAt,
+			Duration:    ep.Duration,
+			Status:      "pending",
+		}
+		_ = s.store.CreateEpisode(ctx, episode)
+	}
+
+	s.notifyUI()
+
+	// Asynchronously run initial sync/download
+	go func() {
+		bgCtx := context.Background()
+		if err := s.SyncChannel(bgCtx, ch.ID); err != nil {
+			log.Error(bgCtx, "Podcast initial sync failed", "channelId", ch.ID, err)
+		}
+	}()
+
+	return s.store.GetChannel(ctx, ch.ID)
+}
+
+// SyncChannel refreshes a channel's feed and enforces download & retention policies.
+func (s *PodcastService) SyncChannel(ctx context.Context, channelID string) error {
+	s.mu.Lock()
+	if s.syncing[channelID] {
+		s.mu.Unlock()
+		return nil // already syncing
+	}
+	s.syncing[channelID] = true
+	s.mu.Unlock()
+
+	defer func() {
+		s.mu.Lock()
+		delete(s.syncing, channelID)
+		s.mu.Unlock()
+		s.notifyUI()
+	}()
+
+	ch, err := s.store.GetChannel(ctx, channelID)
+	if err != nil {
+		return err
+	}
+
+	feed, err := FetchFeed(ctx, ch.FeedURL, s.ytdlp)
+	now := time.Now().UTC()
+	ch.LastCheckedAt = &now
+	if err != nil {
+		ch.LastError = err.Error()
+		_ = s.store.UpdateChannel(ctx, ch)
+		return err
+	}
+
+	ch.LastError = ""
+	if feed.Title != "" {
+		ch.Title = feed.Title
+	}
+	if feed.Author != "" {
+		ch.Author = feed.Author
+	}
+	if feed.ImageURL != "" {
+		ch.ImageURL = feed.ImageURL
+	}
+	if feed.Description != "" {
+		ch.Description = feed.Description
+	}
+	_ = s.store.UpdateChannel(ctx, ch)
+
+	// Insert any new episodes from the feed
+	for _, ep := range feed.Episodes {
+		existing, err := s.store.GetEpisodeByGUID(ctx, ch.ID, ep.GUID)
+		if errors.Is(err, ErrEpisodeNotFound) || existing == nil {
+			newEp := &PodcastEpisode{
+				ID:          s.randomID("pep"),
+				ChannelID:   ch.ID,
+				GUID:        ep.GUID,
+				Title:       cmpStr(ep.Title, "Untitled Episode"),
+				Description: ep.Description,
+				AudioURL:    ep.AudioURL,
+				ImageURL:    cmpStr(ep.ImageURL, ch.ImageURL),
+				PublishedAt: ep.PublishedAt,
+				Duration:    ep.Duration,
+				Status:      "pending",
+			}
+			_ = s.store.CreateEpisode(ctx, newEp)
+		}
+	}
+
+	// Now enforce retention & download according to KeepPolicy
+	return s.processChannelEpisodes(ctx, ch)
+}
+
+// processChannelEpisodes downloads episodes matching keep policy and deletes older ones.
+func (s *PodcastService) processChannelEpisodes(ctx context.Context, ch *PodcastChannel) error {
+	allEps, err := s.store.ListEpisodes(ctx, ch.ID)
+	if err != nil {
+		return err
+	}
+	if len(allEps) == 0 {
+		return nil
+	}
+
+	// Sort newest first
+	sort.SliceStable(allEps, func(i, j int) bool {
+		ti, tj := allEps[i].PublishedAt, allEps[j].PublishedAt
+		if ti == nil {
+			return false
+		}
+		if tj == nil {
+			return true
+		}
+		return ti.After(*tj)
+	})
+
+	var toDownload []*PodcastEpisode
+
+	switch ch.KeepPolicy {
+	case 1:
+		// Keep only the latest 1 episode
+		if len(allEps) > 0 {
+			toDownload = append(toDownload, &allEps[0])
+		}
+	case 3:
+		// Keep latest 3 episodes
+		limit := 3
+		if len(allEps) < limit {
+			limit = len(allEps)
+		}
+		for i := 0; i < limit; i++ {
+			toDownload = append(toDownload, &allEps[i])
+		}
+	default:
+		// 0 = keep all / download all pending
+		for i := range allEps {
+			toDownload = append(toDownload, &allEps[i])
+		}
+	}
+
+	// Download target episodes if not yet downloaded
+	var downloadedAny bool
+	for _, ep := range toDownload {
+		if ep.Status != "downloaded" {
+			if err := s.downloadEpisode(ctx, ch, ep); err != nil {
+				log.Warn(ctx, "Failed downloading episode", "channel", ch.Title, "episode", ep.Title, err)
+			} else {
+				downloadedAny = true
+			}
+		}
+	}
+
+	// Prune older downloaded episodes if keepPolicy > 0
+	if ch.KeepPolicy > 0 {
+		downloaded, err := s.store.ListDownloadedEpisodes(ctx, ch.ID)
+		if err == nil && len(downloaded) > ch.KeepPolicy {
+			// downloaded is sorted newest first
+			for i := ch.KeepPolicy; i < len(downloaded); i++ {
+				ep := downloaded[i]
+				if ep.FilePath != "" {
+					_ = os.Remove(ep.FilePath)
+				}
+				ep.Status = "deleted"
+				ep.FilePath = ""
+				ep.FileSize = 0
+				_ = s.store.UpdateEpisode(ctx, &ep)
+			}
+		}
+	}
+
+	if downloadedAny && s.lib != nil {
+		_ = s.lib.Rescan(ctx)
+	}
+
+	return nil
+}
+
+// DownloadEpisode downloads a single episode manually.
+func (s *PodcastService) DownloadEpisode(ctx context.Context, episodeID string) error {
+	ep, err := s.store.GetEpisode(ctx, episodeID)
+	if err != nil {
+		return err
+	}
+	ch, err := s.store.GetChannel(ctx, ep.ChannelID)
+	if err != nil {
+		return err
+	}
+	if err := s.downloadEpisode(ctx, ch, ep); err != nil {
+		return err
+	}
+	if s.lib != nil {
+		_ = s.lib.Rescan(ctx)
+	}
+	s.notifyUI()
+	return nil
+}
+
+func (s *PodcastService) downloadEpisode(ctx context.Context, ch *PodcastChannel, ep *PodcastEpisode) error {
+	podDir, err := s.podcastsDir()
+	if err != nil {
+		return err
+	}
+
+	channelFolder := filepath.Join(podDir, sanitizeFilename(ch.Title))
+	if err := os.MkdirAll(channelFolder, 0755); err != nil {
+		return fmt.Errorf("creating show directory: %w", err)
+	}
+
+	datePrefix := ""
+	if ep.PublishedAt != nil {
+		datePrefix = ep.PublishedAt.Format("2006-01-02") + " - "
+	}
+	baseName := datePrefix + sanitizeFilename(ep.Title)
+
+	ep.Status = "downloading"
+	_ = s.store.UpdateEpisode(ctx, ep)
+	s.notifyUI()
+
+	var destPath string
+	if ch.SourceType == "youtube" || IsYouTubeURL(ep.AudioURL) {
+		destPath, err = s.downloadYouTubeAudio(ctx, ch, ep, channelFolder, baseName)
+	} else {
+		destPath, err = s.downloadRSSAudio(ctx, ch, ep, channelFolder, baseName)
+	}
+
+	if err != nil {
+		ep.Status = "error"
+		ep.Error = err.Error()
+		_ = s.store.UpdateEpisode(ctx, ep)
+		return err
+	}
+
+	fi, statErr := os.Stat(destPath)
+	var size int64
+	if statErr == nil {
+		size = fi.Size()
+	}
+
+	ep.Status = "downloaded"
+	ep.FilePath = destPath
+	ep.FileSize = size
+	ep.Error = ""
+	_ = s.store.UpdateEpisode(ctx, ep)
+	return nil
+}
+
+func (s *PodcastService) downloadRSSAudio(ctx context.Context, ch *PodcastChannel, ep *PodcastEpisode, dir, baseName string) (string, error) {
+	req, err := http.NewRequestWithContext(ctx, http.MethodGet, ep.AudioURL, nil)
+	if err != nil {
+		return "", err
+	}
+	req.Header.Set("User-Agent", "Navidrome-Seer/1.0 (+https://www.navidrome.org)")
+
+	client := &http.Client{Timeout: 10 * time.Minute}
+	resp, err := client.Do(req)
+	if err != nil {
+		return "", fmt.Errorf("downloading audio stream: %w", err)
+	}
+	defer resp.Body.Close()
+
+	if resp.StatusCode < 200 || resp.StatusCode >= 300 {
+		return "", fmt.Errorf("audio server returned HTTP %d", resp.StatusCode)
+	}
+
+	ext := ".mp3"
+	if ct := resp.Header.Get("Content-Type"); ct != "" {
+		switch {
+		case strings.Contains(ct, "m4a") || strings.Contains(ct, "mp4"):
+			ext = ".m4a"
+		case strings.Contains(ct, "ogg") || strings.Contains(ct, "opus"):
+			ext = ".opus"
+		case strings.Contains(ct, "aac"):
+			ext = ".aac"
+		}
+	} else if u, err := url.Parse(ep.AudioURL); err == nil {
+		if pathExt := filepath.Ext(u.Path); pathExt != "" && len(pathExt) <= 5 {
+			ext = pathExt
+		}
+	}
+
+	partPath := filepath.Join(dir, baseName+".downloading"+ext)
+	finalPath := filepath.Join(dir, baseName+ext)
+
+	f, err := os.Create(partPath)
+	if err != nil {
+		return "", fmt.Errorf("creating temp audio file: %w", err)
+	}
+
+	_, copyErr := io.Copy(f, resp.Body)
+	_ = f.Close()
+	if copyErr != nil {
+		_ = os.Remove(partPath)
+		return "", fmt.Errorf("writing audio file: %w", copyErr)
+	}
+
+	// Tag the file using ffmpeg if available
+	_ = s.tagAudioFile(ctx, partPath, ch.Title, ch.Author, ep.Title, ep.PublishedAt)
+
+	if err := os.Rename(partPath, finalPath); err != nil {
+		_ = os.Remove(partPath)
+		return "", fmt.Errorf("finalizing audio file: %w", err)
+	}
+
+	return finalPath, nil
+}
+
+func (s *PodcastService) downloadYouTubeAudio(ctx context.Context, ch *PodcastChannel, ep *PodcastEpisode, dir, baseName string) (string, error) {
+	outTpl := filepath.Join(dir, baseName+".%(ext)s")
+	args := []string{
+		"-x", "--audio-format", "mp3",
+		"--embed-thumbnail",
+		"--no-playlist",
+		"--no-warnings",
+		"--socket-timeout", "20",
+		"--print", "after_move:filepath",
+		"-o", outTpl,
+		"--", ep.AudioURL,
+	}
+
+	ctx, cancel := context.WithTimeout(ctx, 10*time.Minute)
+	defer cancel()
+
+	cmd := exec.CommandContext(ctx, s.ytdlp, args...)
+	out, err := cmd.CombinedOutput()
+	if err != nil {
+		return "", fmt.Errorf("yt-dlp download failed: %w: %s", err, strings.TrimSpace(string(out)))
+	}
+
+	var producedPath string
+	for _, line := range strings.Split(string(out), "\n") {
+		p := strings.TrimSpace(line)
+		if p != "" && !strings.HasPrefix(p, "[") {
+			producedPath = p
+			break
+		}
+	}
+	if producedPath == "" {
+		// Fallback to checking expected file
+		expected := filepath.Join(dir, baseName+".mp3")
+		if _, err := os.Stat(expected); err == nil {
+			producedPath = expected
+		} else {
+			return "", fmt.Errorf("yt-dlp produced no output file: %s", strings.TrimSpace(string(out)))
+		}
+	}
+
+	// Tag metadata
+	_ = s.tagAudioFile(ctx, producedPath, ch.Title, ch.Author, ep.Title, ep.PublishedAt)
+
+	return producedPath, nil
+}
+
+func (s *PodcastService) tagAudioFile(ctx context.Context, path, showTitle, author, epTitle string, pubDate *time.Time) error {
+	tmp := strings.TrimSuffix(path, filepath.Ext(path)) + ".tagging" + filepath.Ext(path)
+	tags := []string{
+		"title=" + epTitle,
+		"artist=" + author,
+		"album=" + showTitle,
+		"album_artist=" + author,
+		"genre=Podcast",
+	}
+	if pubDate != nil {
+		tags = append(tags, fmt.Sprintf("date=%d", pubDate.Year()))
+	}
+
+	args := []string{"-y", "-v", "error", "-i", path, "-map", "0", "-c", "copy"}
+	for _, t := range tags {
+		args = append(args, "-metadata", t, "-metadata:s:a:0", t)
+	}
+	args = append(args, tmp)
+
+	cmd := exec.CommandContext(ctx, s.ffmpeg, args...)
+	if err := cmd.Run(); err != nil {
+		_ = os.Remove(tmp)
+		return err
+	}
+	return os.Rename(tmp, path)
+}
+
+// DeleteEpisodeFile removes the episode audio file from disk.
+func (s *PodcastService) DeleteEpisodeFile(ctx context.Context, episodeID string) error {
+	ep, err := s.store.GetEpisode(ctx, episodeID)
+	if err != nil {
+		return err
+	}
+	if ep.FilePath != "" {
+		_ = os.Remove(ep.FilePath)
+	}
+	ep.Status = "deleted"
+	ep.FilePath = ""
+	ep.FileSize = 0
+	if err := s.store.UpdateEpisode(ctx, ep); err != nil {
+		return err
+	}
+	if s.lib != nil {
+		_ = s.lib.Rescan(ctx)
+	}
+	s.notifyUI()
+	return nil
+}
+
+// DeleteChannel unsubscribes from a channel and optionally removes downloaded files.
+func (s *PodcastService) DeleteChannel(ctx context.Context, channelID string, deleteFiles bool) error {
+	ch, err := s.store.GetChannel(ctx, channelID)
+	if err != nil {
+		return err
+	}
+
+	if deleteFiles {
+		podDir, err := s.podcastsDir()
+		if err == nil {
+			channelFolder := filepath.Join(podDir, sanitizeFilename(ch.Title))
+			_ = os.RemoveAll(channelFolder)
+		}
+	}
+
+	if err := s.store.DeleteChannel(ctx, channelID); err != nil {
+		return err
+	}
+
+	if deleteFiles && s.lib != nil {
+		_ = s.lib.Rescan(ctx)
+	}
+	s.notifyUI()
+	return nil
+}
+
+// RefreshAll refreshes all channels with auto_download enabled.
+func (s *PodcastService) RefreshAll(ctx context.Context) error {
+	channels, err := s.store.ListChannels(ctx, "")
+	if err != nil {
+		return err
+	}
+	for _, ch := range channels {
+		if ch.AutoDownload {
+			_ = s.SyncChannel(ctx, ch.ID)
+		}
+	}
+	return nil
+}
+
+// Start launches the periodic background worker for automatic weekly / periodic checks.
+func (s *PodcastService) Start(ctx context.Context) {
+	log.Info(ctx, "Starting Seer podcast scheduler")
+	go func() {
+		// Run initial check after 2 minutes
+		select {
+		case <-ctx.Done():
+			return
+		case <-time.After(2 * time.Minute):
+			_ = s.RefreshAll(ctx)
+		}
+
+		// Periodic ticker every 6 hours
+		ticker := time.NewTicker(6 * time.Hour)
+		defer ticker.Stop()
+		for {
+			select {
+			case <-ctx.Done():
+				return
+			case <-ticker.C:
+				channels, err := s.store.ListChannels(ctx, "")
+				if err != nil {
+					continue
+				}
+				for _, ch := range channels {
+					if !ch.AutoDownload {
+						continue
+					}
+					// If not checked in the last 24h, refresh
+					if ch.LastCheckedAt == nil || time.Since(*ch.LastCheckedAt) > 24*time.Hour {
+						_ = s.SyncChannel(ctx, ch.ID)
+					}
+				}
+			}
+		}
+	}()
+}
+
+// Search searches podcast directories (Apple Podcasts and/or YouTube).
+func (s *PodcastService) Search(ctx context.Context, query, source string, limit int) ([]PodcastSearchResult, error) {
+	query = strings.TrimSpace(query)
+	if query == "" {
+		return []PodcastSearchResult{}, nil
+	}
+	var results []PodcastSearchResult
+	switch strings.ToLower(source) {
+	case "youtube":
+		return SearchYouTubePodcasts(ctx, query, limit, s.ytdlp)
+	case "rss", "itunes":
+		return SearchITunes(ctx, query, limit)
+	default:
+		// Search both
+		itunesRes, err1 := SearchITunes(ctx, query, limit)
+		if err1 == nil {
+			results = append(results, itunesRes...)
+		}
+		ytRes, err2 := SearchYouTubePodcasts(ctx, query, 5, s.ytdlp)
+		if err2 == nil {
+			results = append(results, ytRes...)
+		}
+		if err1 != nil && err2 != nil && len(results) == 0 {
+			return nil, fmt.Errorf("search failed: %v / %v", err1, err2)
+		}
+		return results, nil
+	}
+}
+
+// List returns channels for a user, or all channels if userID is empty.
+func (s *PodcastService) List(ctx context.Context, userID string) ([]PodcastChannel, error) {
+	return s.store.ListChannels(ctx, userID)
+}
+
+// Get returns the channel and its episodes.
+func (s *PodcastService) Get(ctx context.Context, id string) (*PodcastChannel, []PodcastEpisode, error) {
+	ch, err := s.store.GetChannel(ctx, id)
+	if err != nil {
+		return nil, nil, err
+	}
+	eps, err := s.store.ListEpisodes(ctx, id)
+	if err != nil {
+		return nil, nil, err
+	}
+	return ch, eps, nil
+}
+
+// Update updates channel settings.
+func (s *PodcastService) Update(ctx context.Context, id string, keepPolicy int, autoDownload bool) (*PodcastChannel, error) {
+	ch, err := s.store.GetChannel(ctx, id)
+	if err != nil {
+		return nil, err
+	}
+	ch.KeepPolicy = keepPolicy
+	ch.AutoDownload = autoDownload
+	if err := s.store.UpdateChannel(ctx, ch); err != nil {
+		return nil, err
+	}
+	s.notifyUI()
+	return ch, nil
+}
+
+// GetEpisode returns an episode by its ID.
+func (s *PodcastService) GetEpisode(ctx context.Context, id string) (*PodcastEpisode, error) {
+	return s.store.GetEpisode(ctx, id)
+}
+
diff --git a/core/seer/podcast_feed.go b/core/seer/podcast_feed.go
new file mode 100644
index 00000000..b6c1b474
--- /dev/null
+++ b/core/seer/podcast_feed.go
@@ -0,0 +1,460 @@
+package seer
+
+import (
+	"context"
+	"encoding/json"
+	"encoding/xml"
+	"fmt"
+	"io"
+	"net/http"
+	"net/url"
+	"os/exec"
+	"strconv"
+	"strings"
+	"time"
+)
+
+type PodcastSearchResult struct {
+	Title       string `json:"title"`
+	Author      string `json:"author"`
+	FeedURL     string `json:"feedUrl"`
+	URL         string `json:"url"`
+	ImageURL    string `json:"imageUrl"`
+	SourceType  string `json:"sourceType"` // "rss" or "youtube"
+	Description string `json:"description"`
+}
+
+type ParsedFeed struct {
+	Title       string
+	Author      string
+	Description string
+	URL         string
+	FeedURL     string
+	ImageURL    string
+	SourceType  string
+	Episodes    []ParsedEpisode
+}
+
+type ParsedEpisode struct {
+	GUID        string
+	Title       string
+	Description string
+	AudioURL    string
+	ImageURL    string
+	PublishedAt *time.Time
+	Duration    int // seconds
+}
+
+// RSS XML structs
+type rssFeed struct {
+	XMLName xml.Name   `xml:"rss"`
+	Channel rssChannel `xml:"channel"`
+}
+
+type rssChannel struct {
+	Title        string         `xml:"title"`
+	Link         string         `xml:"link"`
+	Description  string         `xml:"description"`
+	Author       string         `xml:"author"`
+	ItunesAuthor string         `xml:"http://www.itunes.com/dtds/podcast-1.0.dtd author"`
+	Image        rssImage       `xml:"image"`
+	ItunesImage  rssItunesImage `xml:"http://www.itunes.com/dtds/podcast-1.0.dtd image"`
+	Items        []rssItem      `xml:"item"`
+}
+
+type rssImage struct {
+	URL string `xml:"url"`
+}
+
+type rssItunesImage struct {
+	Href string `xml:"href,attr"`
+}
+
+type rssItem struct {
+	Title          string         `xml:"title"`
+	Link           string         `xml:"link"`
+	Description    string         `xml:"description"`
+	ItunesSummary  string         `xml:"http://www.itunes.com/dtds/podcast-1.0.dtd summary"`
+	GUID           string         `xml:"guid"`
+	PubDate        string         `xml:"pubDate"`
+	Enclosure      rssEnclosure   `xml:"enclosure"`
+	ItunesDuration string         `xml:"http://www.itunes.com/dtds/podcast-1.0.dtd duration"`
+	ItunesImage    rssItunesImage `xml:"http://www.itunes.com/dtds/podcast-1.0.dtd image"`
+}
+
+type rssEnclosure struct {
+	URL    string `xml:"url,attr"`
+	Length string `xml:"length,attr"`
+	Type   string `xml:"type,attr"`
+}
+
+// FetchFeed parses an RSS feed URL or YouTube channel/playlist URL.
+func FetchFeed(ctx context.Context, feedURL, ytdlpBin string) (*ParsedFeed, error) {
+	if IsYouTubeURL(feedURL) {
+		return fetchYouTubeFeed(ctx, feedURL, ytdlpBin)
+	}
+	return fetchRSSFeed(ctx, feedURL)
+}
+
+func IsYouTubeURL(rawURL string) bool {
+	lower := strings.ToLower(rawURL)
+	return strings.Contains(lower, "youtube.com") || strings.Contains(lower, "youtu.be")
+}
+
+func fetchRSSFeed(ctx context.Context, feedURL string) (*ParsedFeed, error) {
+	req, err := http.NewRequestWithContext(ctx, http.MethodGet, feedURL, nil)
+	if err != nil {
+		return nil, fmt.Errorf("invalid feed URL: %w", err)
+	}
+	req.Header.Set("User-Agent", "Navidrome-Seer/1.0 (+https://www.navidrome.org)")
+	req.Header.Set("Accept", "application/rss+xml, application/xml, text/xml, */*")
+
+	client := &http.Client{Timeout: 30 * time.Second}
+	resp, err := client.Do(req)
+	if err != nil {
+		return nil, fmt.Errorf("fetching feed failed: %w", err)
+	}
+	defer resp.Body.Close()
+
+	if resp.StatusCode < 200 || resp.StatusCode >= 300 {
+		return nil, fmt.Errorf("feed server returned HTTP %d", resp.StatusCode)
+	}
+
+	body, err := io.ReadAll(io.LimitReader(resp.Body, 10<<20)) // 10MB limit
+	if err != nil {
+		return nil, fmt.Errorf("reading feed body failed: %w", err)
+	}
+
+	var rss rssFeed
+	if err := xml.Unmarshal(body, &rss); err != nil {
+		return nil, fmt.Errorf("parsing RSS XML: %w", err)
+	}
+
+	ch := rss.Channel
+	author := cmpStr(ch.ItunesAuthor, ch.Author)
+	imageURL := cmpStr(ch.ItunesImage.Href, ch.Image.URL)
+
+	feed := &ParsedFeed{
+		Title:       strings.TrimSpace(ch.Title),
+		Author:      strings.TrimSpace(author),
+		Description: strings.TrimSpace(ch.Description),
+		URL:         strings.TrimSpace(ch.Link),
+		FeedURL:     feedURL,
+		ImageURL:    strings.TrimSpace(imageURL),
+		SourceType:  "rss",
+	}
+
+	for _, it := range ch.Items {
+		audioURL := strings.TrimSpace(it.Enclosure.URL)
+		if audioURL == "" {
+			continue // skip items with no media enclosure
+		}
+		guid := strings.TrimSpace(it.GUID)
+		if guid == "" {
+			guid = audioURL
+		}
+		desc := cmpStr(strings.TrimSpace(it.Description), strings.TrimSpace(it.ItunesSummary))
+		pubDate := parseFeedDate(it.PubDate)
+		dur := parseFeedDuration(it.ItunesDuration)
+		epImg := strings.TrimSpace(it.ItunesImage.Href)
+		if epImg == "" {
+			epImg = feed.ImageURL
+		}
+
+		feed.Episodes = append(feed.Episodes, ParsedEpisode{
+			GUID:        guid,
+			Title:       strings.TrimSpace(it.Title),
+			Description: desc,
+			AudioURL:    audioURL,
+			ImageURL:    epImg,
+			PublishedAt: pubDate,
+			Duration:    dur,
+		})
+	}
+
+	return feed, nil
+}
+
+func fetchYouTubeFeed(ctx context.Context, ytURL, ytdlpBin string) (*ParsedFeed, error) {
+	if ytdlpBin == "" {
+		ytdlpBin = "yt-dlp"
+	}
+	ctx, cancel := context.WithTimeout(ctx, 45*time.Second)
+	defer cancel()
+
+	args := []string{"--flat-playlist", "-J", "--no-warnings", "--socket-timeout", "20", "--", ytURL}
+	cmd := exec.CommandContext(ctx, ytdlpBin, args...)
+	out, err := cmd.Output()
+	if err != nil {
+		return nil, fmt.Errorf("yt-dlp failed to inspect URL: %w", err)
+	}
+
+	var ytInfo struct {
+		Title       string `json:"title"`
+		Uploader    string `json:"uploader"`
+		Channel     string `json:"channel"`
+		Description string `json:"description"`
+		WebpageURL  string `json:"webpage_url"`
+		Thumbnails  []struct {
+			URL string `json:"url"`
+		} `json:"thumbnails"`
+		Entries []struct {
+			ID          string   `json:"id"`
+			Title       string   `json:"title"`
+			Description string   `json:"description"`
+			URL         string   `json:"url"`
+			WebpageURL  string   `json:"webpage_url"`
+			Duration    float64  `json:"duration"`
+			UploadDate  string   `json:"upload_date"` // YYYYMMDD
+			Thumbnails  []struct {
+				URL string `json:"url"`
+			} `json:"thumbnails"`
+		} `json:"entries"`
+	}
+
+	if err := json.Unmarshal(out, &ytInfo); err != nil {
+		return nil, fmt.Errorf("unmarshaling yt-dlp json: %w", err)
+	}
+
+	author := cmpStr(ytInfo.Channel, ytInfo.Uploader)
+	var img string
+	if len(ytInfo.Thumbnails) > 0 {
+		img = ytInfo.Thumbnails[len(ytInfo.Thumbnails)-1].URL
+	}
+
+	feed := &ParsedFeed{
+		Title:       strings.TrimSpace(ytInfo.Title),
+		Author:      strings.TrimSpace(author),
+		Description: strings.TrimSpace(ytInfo.Description),
+		URL:         cmpStr(ytInfo.WebpageURL, ytURL),
+		FeedURL:     ytURL,
+		ImageURL:    img,
+		SourceType:  "youtube",
+	}
+
+	for _, e := range ytInfo.Entries {
+		epURL := cmpStr(e.WebpageURL, e.URL)
+		if epURL == "" && e.ID != "" {
+			epURL = "https://www.youtube.com/watch?v=" + e.ID
+		}
+		if epURL == "" {
+			continue
+		}
+		guid := cmpStr(e.ID, epURL)
+		pubDate := parseYouTubeDate(e.UploadDate)
+		var epImg string
+		if len(e.Thumbnails) > 0 {
+			epImg = e.Thumbnails[len(e.Thumbnails)-1].URL
+		} else {
+			epImg = feed.ImageURL
+		}
+
+		feed.Episodes = append(feed.Episodes, ParsedEpisode{
+			GUID:        guid,
+			Title:       strings.TrimSpace(e.Title),
+			Description: strings.TrimSpace(e.Description),
+			AudioURL:    epURL,
+			ImageURL:    epImg,
+			PublishedAt: pubDate,
+			Duration:    int(e.Duration),
+		})
+	}
+
+	return feed, nil
+}
+
+// SearchITunes queries Apple's public podcast directory.
+func SearchITunes(ctx context.Context, term string, limit int) ([]PodcastSearchResult, error) {
+	if limit <= 0 || limit > 50 {
+		limit = 15
+	}
+	endpoint := fmt.Sprintf("https://itunes.apple.com/search?term=%s&media=podcast&limit=%d",
+		url.QueryEscape(strings.TrimSpace(term)), limit)
+
+	req, err := http.NewRequestWithContext(ctx, http.MethodGet, endpoint, nil)
+	if err != nil {
+		return nil, err
+	}
+	client := &http.Client{Timeout: 10 * time.Second}
+	resp, err := client.Do(req)
+	if err != nil {
+		return nil, fmt.Errorf("iTunes search request failed: %w", err)
+	}
+	defer resp.Body.Close()
+
+	if resp.StatusCode != http.StatusOK {
+		return nil, fmt.Errorf("iTunes returned HTTP %d", resp.StatusCode)
+	}
+
+	var res struct {
+		Results []struct {
+			ArtistName       string `json:"artistName"`
+			CollectionName   string `json:"collectionName"`
+			FeedURL          string `json:"feedUrl"`
+			CollectionViewURL string `json:"collectionViewUrl"`
+			ArtworkURL600    string `json:"artworkUrl600"`
+			PrimaryGenreName string `json:"primaryGenreName"`
+		} `json:"results"`
+	}
+
+	if err := json.NewDecoder(resp.Body).Decode(&res); err != nil {
+		return nil, fmt.Errorf("decoding iTunes response: %w", err)
+	}
+
+	var results []PodcastSearchResult
+	for _, it := range res.Results {
+		if it.FeedURL == "" {
+			continue
+		}
+		results = append(results, PodcastSearchResult{
+			Title:       strings.TrimSpace(it.CollectionName),
+			Author:      strings.TrimSpace(it.ArtistName),
+			FeedURL:     strings.TrimSpace(it.FeedURL),
+			URL:         strings.TrimSpace(it.CollectionViewURL),
+			ImageURL:    strings.TrimSpace(it.ArtworkURL600),
+			SourceType:  "rss",
+			Description: strings.TrimSpace(it.PrimaryGenreName),
+		})
+	}
+	return results, nil
+}
+
+// SearchYouTubePodcasts searches YouTube via yt-dlp.
+func SearchYouTubePodcasts(ctx context.Context, term string, limit int, ytdlpBin string) ([]PodcastSearchResult, error) {
+	if ytdlpBin == "" {
+		ytdlpBin = "yt-dlp"
+	}
+	if limit <= 0 || limit > 20 {
+		limit = 6
+	}
+	query := fmt.Sprintf("ytsearch%d:%s podcast", limit, strings.TrimSpace(term))
+	ctx, cancel := context.WithTimeout(ctx, 30*time.Second)
+	defer cancel()
+
+	cmd := exec.CommandContext(ctx, ytdlpBin, "--flat-playlist", "-J", "--no-warnings", "--socket-timeout", "20", "--", query)
+	out, err := cmd.Output()
+	if err != nil {
+		return nil, fmt.Errorf("yt-dlp search failed: %w", err)
+	}
+
+	var res struct {
+		Entries []struct {
+			ID         string `json:"id"`
+			Title      string `json:"title"`
+			Channel    string `json:"channel"`
+			Uploader   string `json:"uploader"`
+			WebpageURL string `json:"webpage_url"`
+			Thumbnails []struct {
+				URL string `json:"url"`
+			} `json:"thumbnails"`
+		} `json:"entries"`
+	}
+	if err := json.Unmarshal(out, &res); err != nil {
+		return nil, fmt.Errorf("parsing yt search output: %w", err)
+	}
+
+	var results []PodcastSearchResult
+	for _, e := range res.Entries {
+		u := cmpStr(e.WebpageURL, "https://www.youtube.com/watch?v="+e.ID)
+		var img string
+		if len(e.Thumbnails) > 0 {
+			img = e.Thumbnails[len(e.Thumbnails)-1].URL
+		}
+		results = append(results, PodcastSearchResult{
+			Title:       strings.TrimSpace(e.Title),
+			Author:      cmpStr(e.Channel, e.Uploader),
+			FeedURL:     u,
+			URL:         u,
+			ImageURL:    img,
+			SourceType:  "youtube",
+			Description: "YouTube Video / Playlist",
+		})
+	}
+	return results, nil
+}
+
+func parseFeedDate(s string) *time.Time {
+	s = strings.TrimSpace(s)
+	if s == "" {
+		return nil
+	}
+	layouts := []string{
+		time.RFC1123Z,
+		time.RFC1123,
+		time.RFC822Z,
+		time.RFC822,
+		time.RFC3339,
+		"Mon, 2 Jan 2006 15:04:05 -0700",
+		"Mon, 2 Jan 2006 15:04:05 MST",
+		"2 Jan 2006 15:04:05 -0700",
+		"2 Jan 2006 15:04:05 MST",
+		"2006-01-02 15:04:05",
+		"2006-01-02",
+	}
+	for _, l := range layouts {
+		if t, err := time.Parse(l, s); err == nil {
+			utc := t.UTC()
+			return &utc
+		}
+	}
+	return nil
+}
+
+func parseYouTubeDate(s string) *time.Time {
+	s = strings.TrimSpace(s)
+	if len(s) == 8 {
+		if t, err := time.Parse("20060102", s); err == nil {
+			utc := t.UTC()
+			return &utc
+		}
+	}
+	return nil
+}
+
+func parseFeedDuration(s string) int {
+	s = strings.TrimSpace(s)
+	if s == "" {
+		return 0
+	}
+	if n, err := strconv.Atoi(s); err == nil {
+		return n
+	}
+	parts := strings.Split(s, ":")
+	switch len(parts) {
+	case 2:
+		m, _ := strconv.Atoi(parts[0])
+		sec, _ := strconv.Atoi(parts[1])
+		return m*60 + sec
+	case 3:
+		h, _ := strconv.Atoi(parts[0])
+		m, _ := strconv.Atoi(parts[1])
+		sec, _ := strconv.Atoi(parts[2])
+		return h*3600 + m*60 + sec
+	}
+	return 0
+}
+
+func cmpStr(a, b string) string {
+	if a != "" {
+		return a
+	}
+	return b
+}
+
+func sanitizeFilename(s string) string {
+	r := strings.NewReplacer(
+		"/", "_", "\\", "_", ":", "_", "*", "_", "?", "_",
+		"\"", "_", "<", "_", ">", "_", "|", "_", "\x00", "",
+	)
+	s = strings.TrimSpace(r.Replace(s))
+	s = strings.TrimLeft(s, ".")
+	s = strings.TrimRight(s, ". ")
+	runes := []rune(s)
+	if len(runes) > 100 {
+		s = strings.TrimSpace(string(runes[:100]))
+	}
+	if s == "" {
+		return "Episode"
+	}
+	return s
+}
diff --git a/core/seer/podcast_store.go b/core/seer/podcast_store.go
new file mode 100644
index 00000000..72b98b50
--- /dev/null
+++ b/core/seer/podcast_store.go
@@ -0,0 +1,331 @@
+package seer
+
+import (
+	"context"
+	"database/sql"
+	"errors"
+	"strings"
+	"time"
+)
+
+var (
+	ErrPodcastNotFound = errors.New("podcast not found")
+	ErrEpisodeNotFound = errors.New("episode not found")
+)
+
+type PodcastChannel struct {
+	ID              string     `json:"id"`
+	UserID          string     `json:"userId"`
+	Title           string     `json:"title"`
+	Author          string     `json:"author"`
+	Description     string     `json:"description"`
+	SourceType      string     `json:"sourceType"` // "rss" or "youtube"
+	URL             string     `json:"url"`
+	FeedURL         string     `json:"feedUrl"`
+	ImageURL        string     `json:"imageUrl"`
+	KeepPolicy      int        `json:"keepPolicy"` // 0 = all, 1 = keep 1, 3 = keep 3
+	AutoDownload    bool       `json:"autoDownload"`
+	LastError       string     `json:"lastError"`
+	LastCheckedAt   *time.Time `json:"lastCheckedAt"`
+	CreatedAt       time.Time  `json:"createdAt"`
+	UpdatedAt       time.Time  `json:"updatedAt"`
+	EpisodeCount    int        `json:"episodeCount"`
+	DownloadedCount int        `json:"downloadedCount"`
+}
+
+type PodcastEpisode struct {
+	ID           string     `json:"id"`
+	ChannelID    string     `json:"channelId"`
+	GUID         string     `json:"guid"`
+	Title        string     `json:"title"`
+	Description  string     `json:"description"`
+	AudioURL     string     `json:"audioUrl"`
+	ImageURL     string     `json:"imageUrl"`
+	PublishedAt  *time.Time `json:"publishedAt"`
+	Duration     int        `json:"duration"` // seconds
+	Status       string     `json:"status"`   // "pending", "downloading", "downloaded", "deleted", "error"
+	FilePath     string     `json:"filePath,omitempty"`
+	FileSize     int64      `json:"fileSize,omitempty"`
+	MediaFileID  string     `json:"mediaFileId,omitempty"`
+	Error        string     `json:"error,omitempty"`
+	CreatedAt    time.Time  `json:"createdAt"`
+	UpdatedAt    time.Time  `json:"updatedAt"`
+	ChannelTitle string     `json:"channelTitle,omitempty"`
+}
+
+type PodcastStore struct {
+	db *sql.DB
+}
+
+func NewPodcastStore(db *sql.DB) *PodcastStore {
+	return &PodcastStore{db: db}
+}
+
+const (
+	channelColumns = `id, user_id, title, author, description, source_type, url, feed_url, image_url, keep_policy, auto_download, last_error, last_checked_at, created_at, updated_at`
+	episodeColumns = `id, channel_id, guid, title, description, audio_url, image_url, published_at, duration, status, file_path, file_size, media_file_id, error, created_at, updated_at`
+)
+
+func (s *PodcastStore) CreateChannel(ctx context.Context, c *PodcastChannel) error {
+	now := time.Now().UTC()
+	if c.CreatedAt.IsZero() {
+		c.CreatedAt = now
+	}
+	c.UpdatedAt = now
+	_, err := s.db.ExecContext(ctx, `INSERT INTO podcast_channel (`+channelColumns+`) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,
+		c.ID, c.UserID, c.Title, c.Author, c.Description, c.SourceType, c.URL, c.FeedURL, c.ImageURL,
+		c.KeepPolicy, c.AutoDownload, c.LastError, c.LastCheckedAt, c.CreatedAt, c.UpdatedAt,
+	)
+	return err
+}
+
+func (s *PodcastStore) UpdateChannel(ctx context.Context, c *PodcastChannel) error {
+	c.UpdatedAt = time.Now().UTC()
+	res, err := s.db.ExecContext(ctx, `UPDATE podcast_channel SET
+		title = ?, author = ?, description = ?, source_type = ?, url = ?, feed_url = ?, image_url = ?,
+		keep_policy = ?, auto_download = ?, last_error = ?, last_checked_at = ?, updated_at = ?
+		WHERE id = ?`,
+		c.Title, c.Author, c.Description, c.SourceType, c.URL, c.FeedURL, c.ImageURL,
+		c.KeepPolicy, c.AutoDownload, c.LastError, c.LastCheckedAt, c.UpdatedAt, c.ID,
+	)
+	if err != nil {
+		return err
+	}
+	if n, _ := res.RowsAffected(); n == 0 {
+		return ErrPodcastNotFound
+	}
+	return nil
+}
+
+func (s *PodcastStore) GetChannel(ctx context.Context, id string) (*PodcastChannel, error) {
+	row := s.db.QueryRowContext(ctx, `
+		SELECT c.`+strings.ReplaceAll(channelColumns, ", ", ", c.")+`,
+			(SELECT COUNT(*) FROM podcast_episode e WHERE e.channel_id = c.id) as ep_count,
+			(SELECT COUNT(*) FROM podcast_episode e WHERE e.channel_id = c.id AND e.status = 'downloaded') as dl_count
+		FROM podcast_channel c WHERE c.id = ?`, id)
+
+	var c PodcastChannel
+	var lastChecked sql.NullTime
+	err := row.Scan(
+		&c.ID, &c.UserID, &c.Title, &c.Author, &c.Description, &c.SourceType, &c.URL, &c.FeedURL, &c.ImageURL,
+		&c.KeepPolicy, &c.AutoDownload, &c.LastError, &lastChecked, &c.CreatedAt, &c.UpdatedAt,
+		&c.EpisodeCount, &c.DownloadedCount,
+	)
+	if errors.Is(err, sql.ErrNoRows) {
+		return nil, ErrPodcastNotFound
+	}
+	if err != nil {
+		return nil, err
+	}
+	if lastChecked.Valid {
+		t := lastChecked.Time.UTC()
+		c.LastCheckedAt = &t
+	}
+	return &c, nil
+}
+
+func (s *PodcastStore) ListChannels(ctx context.Context, userID string) ([]PodcastChannel, error) {
+	query := `
+		SELECT c.` + strings.ReplaceAll(channelColumns, ", ", ", c.") + `,
+			(SELECT COUNT(*) FROM podcast_episode e WHERE e.channel_id = c.id) as ep_count,
+			(SELECT COUNT(*) FROM podcast_episode e WHERE e.channel_id = c.id AND e.status = 'downloaded') as dl_count
+		FROM podcast_channel c`
+	var args []any
+	if userID != "" {
+		query += ` WHERE c.user_id = ?`
+		args = append(args, userID)
+	}
+	query += ` ORDER BY c.title COLLATE NOCASE ASC`
+
+	rows, err := s.db.QueryContext(ctx, query, args...)
+	if err != nil {
+		return nil, err
+	}
+	defer rows.Close()
+
+	var out []PodcastChannel
+	for rows.Next() {
+		var c PodcastChannel
+		var lastChecked sql.NullTime
+		err := rows.Scan(
+			&c.ID, &c.UserID, &c.Title, &c.Author, &c.Description, &c.SourceType, &c.URL, &c.FeedURL, &c.ImageURL,
+			&c.KeepPolicy, &c.AutoDownload, &c.LastError, &lastChecked, &c.CreatedAt, &c.UpdatedAt,
+			&c.EpisodeCount, &c.DownloadedCount,
+		)
+		if err != nil {
+			return nil, err
+		}
+		if lastChecked.Valid {
+			t := lastChecked.Time.UTC()
+			c.LastCheckedAt = &t
+		}
+		out = append(out, c)
+	}
+	return out, rows.Err()
+}
+
+func (s *PodcastStore) DeleteChannel(ctx context.Context, id string) error {
+	res, err := s.db.ExecContext(ctx, `DELETE FROM podcast_channel WHERE id = ?`, id)
+	if err != nil {
+		return err
+	}
+	if n, _ := res.RowsAffected(); n == 0 {
+		return ErrPodcastNotFound
+	}
+	return nil
+}
+
+func (s *PodcastStore) CreateEpisode(ctx context.Context, e *PodcastEpisode) error {
+	now := time.Now().UTC()
+	if e.CreatedAt.IsZero() {
+		e.CreatedAt = now
+	}
+	e.UpdatedAt = now
+	_, err := s.db.ExecContext(ctx, `INSERT INTO podcast_episode (`+episodeColumns+`) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,
+		e.ID, e.ChannelID, e.GUID, e.Title, e.Description, e.AudioURL, e.ImageURL,
+		e.PublishedAt, e.Duration, e.Status, e.FilePath, e.FileSize, e.MediaFileID, e.Error, e.CreatedAt, e.UpdatedAt,
+	)
+	return err
+}
+
+func (s *PodcastStore) UpdateEpisode(ctx context.Context, e *PodcastEpisode) error {
+	e.UpdatedAt = time.Now().UTC()
+	res, err := s.db.ExecContext(ctx, `UPDATE podcast_episode SET
+		title = ?, description = ?, audio_url = ?, image_url = ?, published_at = ?, duration = ?,
+		status = ?, file_path = ?, file_size = ?, media_file_id = ?, error = ?, updated_at = ?
+		WHERE id = ?`,
+		e.Title, e.Description, e.AudioURL, e.ImageURL, e.PublishedAt, e.Duration,
+		e.Status, e.FilePath, e.FileSize, e.MediaFileID, e.Error, e.UpdatedAt, e.ID,
+	)
+	if err != nil {
+		return err
+	}
+	if n, _ := res.RowsAffected(); n == 0 {
+		return ErrEpisodeNotFound
+	}
+	return nil
+}
+
+func (s *PodcastStore) GetEpisode(ctx context.Context, id string) (*PodcastEpisode, error) {
+	row := s.db.QueryRowContext(ctx, `
+		SELECT e.`+strings.ReplaceAll(episodeColumns, ", ", ", e.")+`, c.title
+		FROM podcast_episode e
+		JOIN podcast_channel c ON c.id = e.channel_id
+		WHERE e.id = ?`, id)
+
+	var e PodcastEpisode
+	var pubTime sql.NullTime
+	err := row.Scan(
+		&e.ID, &e.ChannelID, &e.GUID, &e.Title, &e.Description, &e.AudioURL, &e.ImageURL,
+		&pubTime, &e.Duration, &e.Status, &e.FilePath, &e.FileSize, &e.MediaFileID, &e.Error, &e.CreatedAt, &e.UpdatedAt,
+		&e.ChannelTitle,
+	)
+	if errors.Is(err, sql.ErrNoRows) {
+		return nil, ErrEpisodeNotFound
+	}
+	if err != nil {
+		return nil, err
+	}
+	if pubTime.Valid {
+		t := pubTime.Time.UTC()
+		e.PublishedAt = &t
+	}
+	return &e, nil
+}
+
+func (s *PodcastStore) GetEpisodeByGUID(ctx context.Context, channelID, guid string) (*PodcastEpisode, error) {
+	row := s.db.QueryRowContext(ctx, `
+		SELECT `+episodeColumns+` FROM podcast_episode WHERE channel_id = ? AND guid = ?`, channelID, guid)
+
+	var e PodcastEpisode
+	var pubTime sql.NullTime
+	err := row.Scan(
+		&e.ID, &e.ChannelID, &e.GUID, &e.Title, &e.Description, &e.AudioURL, &e.ImageURL,
+		&pubTime, &e.Duration, &e.Status, &e.FilePath, &e.FileSize, &e.MediaFileID, &e.Error, &e.CreatedAt, &e.UpdatedAt,
+	)
+	if errors.Is(err, sql.ErrNoRows) {
+		return nil, ErrEpisodeNotFound
+	}
+	if err != nil {
+		return nil, err
+	}
+	if pubTime.Valid {
+		t := pubTime.Time.UTC()
+		e.PublishedAt = &t
+	}
+	return &e, nil
+}
+
+func (s *PodcastStore) ListEpisodes(ctx context.Context, channelID string) ([]PodcastEpisode, error) {
+	rows, err := s.db.QueryContext(ctx, `
+		SELECT e.`+strings.ReplaceAll(episodeColumns, ", ", ", e.")+`, c.title
+		FROM podcast_episode e
+		JOIN podcast_channel c ON c.id = e.channel_id
+		WHERE e.channel_id = ?
+		ORDER BY CASE WHEN e.published_at IS NULL THEN 1 ELSE 0 END, e.published_at DESC, e.created_at DESC`, channelID)
+	if err != nil {
+		return nil, err
+	}
+	defer rows.Close()
