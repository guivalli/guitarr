@@ -0,0 +1,218 @@
+package seer
+
+import (
+	"context"
+	"database/sql"
+	"os"
+	"path/filepath"
+	"testing"
+	"time"
+
+	_ "github.com/mattn/go-sqlite3"
+)
+
+func TestParseFeedDate(t *testing.T) {
+	tests := []struct {
+		input    string
+		expected int // year
+	}{
+		{"Fri, 10 Oct 2026 12:00:00 +0000", 2026},
+		{"Mon, 02 Jan 2006 15:04:05 MST", 2006},
+		{"2026-10-11T10:00:00Z", 2026},
+		{"2026-10-11", 2026},
+		{"11 Oct 2026 12:00:00 -0300", 2026},
+		{"", 0},
+	}
+
+	for _, tt := range tests {
+		parsed := parseFeedDate(tt.input)
+		if tt.expected == 0 {
+			if parsed != nil {
+				t.Errorf("parseFeedDate(%q) = %v; want nil", tt.input, parsed)
+			}
+		} else {
+			if parsed == nil || parsed.Year() != tt.expected {
+				t.Errorf("parseFeedDate(%q) = %v; want year %d", tt.input, parsed, tt.expected)
+			}
+		}
+	}
+}
+
+func TestParseFeedDuration(t *testing.T) {
+	tests := []struct {
+		input    string
+		expected int
+	}{
+		{"", 0},
+		{"3600", 3600},
+		{"01:00:00", 3600},
+		{"01:23:45", 3600 + 23*60 + 45},
+		{"45:10", 45*60 + 10},
+		{"05:00", 300},
+	}
+
+	for _, tt := range tests {
+		got := parseFeedDuration(tt.input)
+		if got != tt.expected {
+			t.Errorf("parseFeedDuration(%q) = %d; want %d", tt.input, got, tt.expected)
+		}
+	}
+}
+
+func TestIsYouTubeURL(t *testing.T) {
+	if !IsYouTubeURL("https://www.youtube.com/watch?v=dQw4w9WgXcQ") {
+		t.Error("expected true for youtube.com")
+	}
+	if !IsYouTubeURL("https://youtu.be/dQw4w9WgXcQ") {
+		t.Error("expected true for youtu.be")
+	}
+	if !IsYouTubeURL("https://www.youtube.com/@flowpodcast") {
+		t.Error("expected true for youtube channel")
+	}
+	if IsYouTubeURL("https://jovemnerd.com.br/feed-nerdcast/") {
+		t.Error("expected false for rss feed")
+	}
+}
+
+func setupTestDB(t *testing.T) *sql.DB {
+	db, err := sql.Open("sqlite3", ":memory:")
+	if err != nil {
+		t.Fatalf("opening sqlite in memory: %v", err)
+	}
+
+	schema := `
+	CREATE TABLE user (
+		id VARCHAR(255) PRIMARY KEY
+	);
+	INSERT INTO user (id) VALUES ('u1');
+
+	CREATE TABLE podcast_channel (
+		id              VARCHAR(255) NOT NULL PRIMARY KEY,
+		user_id         VARCHAR(255) NOT NULL REFERENCES user(id) ON DELETE CASCADE,
+		title           VARCHAR(255) NOT NULL DEFAULT '',
+		author          VARCHAR(255) NOT NULL DEFAULT '',
+		description     TEXT         NOT NULL DEFAULT '',
+		source_type     VARCHAR(32)  NOT NULL DEFAULT 'rss',
+		url             TEXT         NOT NULL DEFAULT '',
+		feed_url        TEXT         NOT NULL DEFAULT '',
+		image_url       TEXT         NOT NULL DEFAULT '',
+		keep_policy     INTEGER      NOT NULL DEFAULT 0,
+		auto_download   BOOL         NOT NULL DEFAULT true,
+		last_error      TEXT         NOT NULL DEFAULT '',
+		last_checked_at DATETIME,
+		created_at      DATETIME     NOT NULL,
+		updated_at      DATETIME     NOT NULL
+	);
+
+	CREATE TABLE podcast_episode (
+		id              VARCHAR(255) NOT NULL PRIMARY KEY,
+		channel_id      VARCHAR(255) NOT NULL REFERENCES podcast_channel(id) ON DELETE CASCADE,
+		guid            VARCHAR(500) NOT NULL DEFAULT '',
+		title           VARCHAR(255) NOT NULL DEFAULT '',
+		description     TEXT         NOT NULL DEFAULT '',
+		audio_url       TEXT         NOT NULL DEFAULT '',
+		image_url       TEXT         NOT NULL DEFAULT '',
+		published_at    DATETIME,
+		duration        INTEGER      NOT NULL DEFAULT 0,
+		status          VARCHAR(32)  NOT NULL DEFAULT 'pending',
+		file_path       TEXT         NOT NULL DEFAULT '',
+		file_size       BIGINT       NOT NULL DEFAULT 0,
+		media_file_id   VARCHAR(255) NOT NULL DEFAULT '',
+		error           TEXT         NOT NULL DEFAULT '',
+		created_at      DATETIME     NOT NULL,
+		updated_at      DATETIME     NOT NULL
+	);
+	`
+	if _, err := db.Exec(schema); err != nil {
+		t.Fatalf("setting up schema: %v", err)
+	}
+	return db
+}
+
+func TestPodcastStoreAndRetention(t *testing.T) {
+	db := setupTestDB(t)
+	defer db.Close()
+	store := NewPodcastStore(db)
+	ctx := context.Background()
+
+	ch := &PodcastChannel{
+		ID:           "p1",
+		UserID:       "u1",
+		Title:        "Tech Talk",
+		Author:       "Host",
+		FeedURL:      "https://example.com/feed.xml",
+		KeepPolicy:   3,
+		AutoDownload: true,
+	}
+
+	if err := store.CreateChannel(ctx, ch); err != nil {
+		t.Fatalf("CreateChannel failed: %v", err)
+	}
+
+	loaded, err := store.GetChannel(ctx, "p1")
+	if err != nil || loaded.Title != "Tech Talk" {
+		t.Fatalf("GetChannel failed: %v, got %+v", err, loaded)
+	}
+
+	// Create 5 episodes with descending dates
+	tmpDir := t.TempDir()
+	now := time.Now().UTC()
+	var files []string
+	for i := 0; i < 5; i++ {
+		pub := now.Add(-time.Duration(i) * 24 * time.Hour)
+		filePath := filepath.Join(tmpDir, pub.Format("2006-01-02")+".mp3")
+		_ = os.WriteFile(filePath, []byte("fake audio"), 0644)
+		files = append(files, filePath)
+
+		ep := &PodcastEpisode{
+			ID:          string(rune('e' + i)),
+			ChannelID:   "p1",
+			GUID:        string(rune('g' + i)),
+			Title:       "Episode " + string(rune('1'+i)),
+			PublishedAt: &pub,
+			Status:      "downloaded",
+			FilePath:    filePath,
+			FileSize:    10,
+		}
+		if err := store.CreateEpisode(ctx, ep); err != nil {
+			t.Fatalf("CreateEpisode %d failed: %v", i, err)
+		}
+	}
+
+	eps, err := store.ListEpisodes(ctx, "p1")
+	if err != nil || len(eps) != 5 {
+		t.Fatalf("ListEpisodes failed: %v (count=%d)", err, len(eps))
+	}
+
+	// Service process retention for keepPolicy = 3
+	svc := NewPodcastService(store, func() string { return tmpDir }, nil, nil, "ffmpeg", "yt-dlp")
+	if err := svc.processChannelEpisodes(ctx, loaded); err != nil {
+		t.Fatalf("processChannelEpisodes failed: %v", err)
+	}
+
+	// Check downloaded episodes count: should be 3
+	downloaded, err := store.ListDownloadedEpisodes(ctx, "p1")
+	if err != nil {
+		t.Fatalf("ListDownloadedEpisodes failed: %v", err)
+	}
+	if len(downloaded) != 3 {
+		t.Fatalf("expected 3 downloaded episodes, got %d", len(downloaded))
+	}
+
+	// First 3 files should exist, 4th and 5th files should have been removed
+	if _, err := os.Stat(files[0]); err != nil {
+		t.Errorf("expected latest file %s to exist", files[0])
+	}
+	if _, err := os.Stat(files[1]); err != nil {
+		t.Errorf("expected 2nd latest file %s to exist", files[1])
+	}
+	if _, err := os.Stat(files[2]); err != nil {
+		t.Errorf("expected 3rd latest file %s to exist", files[2])
+	}
+	if _, err := os.Stat(files[3]); !os.IsNotExist(err) {
+		t.Errorf("expected 4th file %s to be deleted, got err: %v", files[3], err)
+	}
+	if _, err := os.Stat(files[4]); !os.IsNotExist(err) {
+		t.Errorf("expected 5th file %s to be deleted, got err: %v", files[4], err)
+	}
+}
