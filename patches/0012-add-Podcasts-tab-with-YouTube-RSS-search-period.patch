+
+type fakePodcasts struct {
+	channels map[string]*seer.PodcastChannel
+	episodes map[string]*seer.PodcastEpisode
+	refreshed string
+}
+
+func newFakePodcasts() *fakePodcasts {
+	return &fakePodcasts{
+		channels: map[string]*seer.PodcastChannel{
+			"p1": {
+				ID:           "p1",
+				UserID:       "u1",
+				Title:        "NerdCast",
+				KeepPolicy:   3,
+				AutoDownload: true,
+			},
+		},
+		episodes: map[string]*seer.PodcastEpisode{
+			"e1": {
+				ID:        "e1",
+				ChannelID: "p1",
+				Title:     "Episode 1",
+				Status:    "downloaded",
+			},
+		},
+	}
+}
+
+func (f *fakePodcasts) Search(ctx context.Context, query, source string, limit int) ([]seer.PodcastSearchResult, error) {
+	return []seer.PodcastSearchResult{
+		{Title: "NerdCast", FeedURL: "https://example.com/rss", SourceType: "rss"},
+	}, nil
+}
+
+func (f *fakePodcasts) List(ctx context.Context, userID string) ([]seer.PodcastChannel, error) {
+	var out []seer.PodcastChannel
+	for _, c := range f.channels {
+		if userID == "" || c.UserID == userID {
+			out = append(out, *c)
+		}
+	}
+	return out, nil
+}
+
+func (f *fakePodcasts) Get(ctx context.Context, id string) (*seer.PodcastChannel, []seer.PodcastEpisode, error) {
+	c, ok := f.channels[id]
+	if !ok {
+		return nil, nil, seer.ErrPodcastNotFound
+	}
+	var eps []seer.PodcastEpisode
+	for _, e := range f.episodes {
+		if e.ChannelID == id {
+			eps = append(eps, *e)
+		}
+	}
+	return c, eps, nil
+}
+
+func (f *fakePodcasts) Subscribe(ctx context.Context, userID, rawURL, sourceType string, keepPolicy int, autoDownload bool) (*seer.PodcastChannel, error) {
+	c := &seer.PodcastChannel{
+		ID:           "p_new",
+		UserID:       userID,
+		Title:        "New Show",
+		FeedURL:      rawURL,
+		SourceType:   sourceType,
+		KeepPolicy:   keepPolicy,
+		AutoDownload: autoDownload,
+	}
+	f.channels[c.ID] = c
+	return c, nil
+}
+
+func (f *fakePodcasts) Update(ctx context.Context, id string, keepPolicy int, autoDownload bool) (*seer.PodcastChannel, error) {
+	c, ok := f.channels[id]
+	if !ok {
+		return nil, seer.ErrPodcastNotFound
+	}
+	c.KeepPolicy = keepPolicy
+	c.AutoDownload = autoDownload
+	return c, nil
+}
+
+func (f *fakePodcasts) DeleteChannel(ctx context.Context, id string, deleteFiles bool) error {
+	delete(f.channels, id)
+	return nil
+}
+
+func (f *fakePodcasts) SyncChannel(ctx context.Context, id string) error {
+	f.refreshed = id
+	return nil
+}
+
+func (f *fakePodcasts) RefreshAll(ctx context.Context) error {
+	f.refreshed = "all"
+	return nil
+}
+
+func (f *fakePodcasts) GetEpisode(ctx context.Context, id string) (*seer.PodcastEpisode, error) {
+	e, ok := f.episodes[id]
+	if !ok {
+		return nil, seer.ErrEpisodeNotFound
+	}
+	return e, nil
+}
+
+func (f *fakePodcasts) DownloadEpisode(ctx context.Context, id string) error {
+	return nil
+}
+
+func (f *fakePodcasts) DeleteEpisodeFile(ctx context.Context, id string) error {
+	if e, ok := f.episodes[id]; ok {
+		e.Status = "deleted"
+	}
+	return nil
+}
+
+func TestPodcastsAPI(t *testing.T) {
+	fp := newFakePodcasts()
+	api := NewWithPodcasts(nil, &fakeService{}, fp)
+	user := model.User{ID: "u1"}
+	admin := model.User{ID: "adm", IsAdmin: true}
+
+	// 1. Search
+	w := do(t, api, user, "GET", "/podcasts/search?q=nerd", "")
+	if w.Code != 200 || !strings.Contains(w.Body.String(), "NerdCast") {
+		t.Errorf("search failed: %d %s", w.Code, w.Body)
+	}
+
+	// 2. List
+	w = do(t, api, user, "GET", "/podcasts", "")
+	if w.Code != 200 || !strings.Contains(w.Body.String(), "NerdCast") {
+		t.Errorf("list failed: %d %s", w.Code, w.Body)
+	}
+
+	// 3. Get Show
+	w = do(t, api, user, "GET", "/podcasts/p1", "")
+	if w.Code != 200 || !strings.Contains(w.Body.String(), "Episode 1") {
+		t.Errorf("get show failed: %d %s", w.Code, w.Body)
+	}
+
+	// 4. Update Show
+	w = do(t, api, user, "PUT", "/podcasts/p1", `{"keepPolicy":1,"autoDownload":false}`)
+	if w.Code != 200 || !strings.Contains(w.Body.String(), `"keepPolicy":1`) {
+		t.Errorf("update show failed: %d %s", w.Code, w.Body)
+	}
+
+	// 5. Subscribe
+	w = do(t, api, user, "POST", "/podcasts", `{"url":"https://feed.test","keepPolicy":3,"autoDownload":true}`)
+	if w.Code != 201 || !strings.Contains(w.Body.String(), "New Show") {
+		t.Errorf("subscribe failed: %d %s", w.Code, w.Body)
+	}
+
+	// 6. Delete
+	w = do(t, api, admin, "DELETE", "/podcasts/p1?deleteFiles=true", "")
+	if w.Code != 204 {
+		t.Errorf("delete failed: %d", w.Code)
+	}
+}
