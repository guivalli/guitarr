+			&e.ID, &e.ChannelID, &e.GUID, &e.Title, &e.Description, &e.AudioURL, &e.ImageURL,
+			&pubTime, &e.Duration, &e.Status, &e.FilePath, &e.FileSize, &e.MediaFileID, &e.Error, &e.CreatedAt, &e.UpdatedAt,
+			&e.ChannelTitle,
+		)
+		if err != nil {
+			return nil, err
+		}
+		if pubTime.Valid {
+			t := pubTime.Time.UTC()
+			e.PublishedAt = &t
+		}
+		out = append(out, e)
+	}
+	return out, rows.Err()
+}
+
