+var leadingNumber = regexp.MustCompile(`^[\d\s._-]+`)
+
+// trackKey identifies a track across peers that name files differently:
+// "Artist - Album - 03 - Não É Sério.flac" and "03. nao e serio.mp3" give "naoeserio".
+func trackKey(name string) string {
+	base := remoteBase(name)
+	base = strings.TrimSuffix(base, filepath.Ext(base))
+	if i := strings.LastIndex(base, " - "); i >= 0 {
+		base = base[i+3:]
+	}
+	return fold(leadingNumber.ReplaceAllString(base, ""))
 }
