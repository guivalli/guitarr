+// oneFormat keeps a single format when a folder has the same album twice (FLAC and MP3).
+func (s *Soulseek) oneFormat(files []slskFile) []slskFile {
+	count := map[string]int{}
+	for _, f := range files {
+		count[strings.ToLower(filepath.Ext(f.Filename))]++
+	}
+	if len(count) < 2 {
+		return files
+	}
+	keep, best := "", -1
+	for ext, n := range count {
+		if (s.PreferFLAC && ext == ".flac") || (n > best && !(s.PreferFLAC && keep == ".flac")) {
+			keep, best = ext, n
 		}
-		if score > bestScore {
-			bestScore, bestUser, best = score, r.Username, cand
+	}
+	var out []slskFile
+	for _, f := range files {
+		if strings.ToLower(filepath.Ext(f.Filename)) == keep {
+			out = append(out, f)
 		}
 	}
-	return bestUser, best
+	return out
+}
