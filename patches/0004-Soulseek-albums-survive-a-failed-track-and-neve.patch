+func TestSoulseekAlbumRetriesAndKeepsOneRelease(t *testing.T) {
+	dl, lib := t.TempDir(), t.TempDir()
+	peers := []slskResponse{
+		{Username: "a", HasFreeSlot: true, Files: []slskFile{
+			{Filename: `Musicas\CBJR\2004 - Tamo Aí na Atividade\CBJR - Tamo aí na atividade - 01 - Um.flac`},
+			{Filename: `Musicas\CBJR\2004 - Tamo Aí na Atividade\CBJR - Tamo aí na atividade - 02 - Dois.flac`},
+			{Filename: `Musicas\CBJR\2004 - Tamo Aí na Atividade\CBJR - Tamo aí na atividade - 02 - Dois.mp3`},
+			{Filename: `Musicas\CBJR\2004 - Tamo Aí na Atividade\CBJR - Tamo aí na atividade - 03 - Tres.flac`},
+			{Filename: `Musicas\CBJR\2020 - Em casa\CBJR - Em casa - 07 - Tamo aí na atividade.mp3`},
+		}},
+		{Username: "b", Files: []slskFile{
+			{Filename: `b\Tamo Ai na Atividade (2004)\02. Dois.mp3`},
+		}},
+		{Username: "c", Files: []slskFile{
+			{Filename: `c\Random\03 - Tres.mp3`},
+		}},
+	}
+	fail := map[string]bool{
+		`a|Musicas\CBJR\2004 - Tamo Aí na Atividade\CBJR - Tamo aí na atividade - 02 - Dois.flac`: true,
+		`a|Musicas\CBJR\2004 - Tamo Aí na Atividade\CBJR - Tamo aí na atividade - 03 - Tres.flac`: true,
+	}
+	srv, queued := albumSlskd(t, dl, peers, fail)
+	s := &Soulseek{BaseURL: srv.URL, APIKey: "key", DownloadDir: dl, On: true, PollInterval: time.Millisecond, PreferFLAC: true}
+	s.searchPoll = time.Millisecond
+
+	res, err := s.Fetch(context.Background(), Request{Kind: KindAlbum, Artist: "CBJR", Title: "Tamo aí na atividade"}, lib)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(res.Paths) != 2 || !strings.Contains(res.Warning, "03 - Tres.flac") {
+		t.Fatalf("paths %v, warning %q", res.Paths, res.Warning)
+	}
+	for _, q := range *queued {
+		if strings.Contains(q, "Em casa") || strings.HasSuffix(q, "Dois.mp3") && strings.HasPrefix(q, "a|") || strings.HasPrefix(q, "c|") {
+			t.Errorf("queued a file from the wrong release or format: %s", q)
+		}
+	}
+	retries := 0
+	for _, q := range *queued {
+		if strings.HasSuffix(q, "02 - Dois.flac") {
+			retries++
+		}
+	}
+	if retries != 2 {
+		t.Errorf("failed track should be retried once from the same peer, queued %d times", retries)
+	}
+	if _, err := os.Stat(filepath.Join(lib, "CBJR", "Tamo aí na atividade", "02. Dois.mp3")); err != nil {
+		t.Errorf("replacement from another peer not imported: %v", err)
+	}
+}
