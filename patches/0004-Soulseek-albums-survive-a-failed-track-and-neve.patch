+// albumSlskd emulates peers offering folders. fail lists "user|file" pairs whose
+// transfers always fail; everything else downloads at once.
+func albumSlskd(t *testing.T, dlDir string, peers []slskResponse, fail map[string]bool) (*httptest.Server, *[]string) {
+	var mu sync.Mutex
+	var queued []string
+	done := map[string]map[string]string{} // user -> file -> state
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		mu.Lock()
+		defer mu.Unlock()
+		const dl = "/api/v0/transfers/downloads/"
+		switch {
+		case r.Method == http.MethodPost && r.URL.Path == "/api/v0/searches":
+			_ = json.NewEncoder(w).Encode(map[string]string{"id": "s1"})
+		case r.URL.Path == "/api/v0/searches/s1":
+			_ = json.NewEncoder(w).Encode(map[string]bool{"isComplete": true})
+		case r.URL.Path == "/api/v0/searches/s1/responses":
+			_ = json.NewEncoder(w).Encode(peers)
+		case r.Method == http.MethodPost && strings.HasPrefix(r.URL.Path, dl):
+			user := strings.TrimPrefix(r.URL.Path, dl)
+			var files []slskFile
+			_ = json.NewDecoder(r.Body).Decode(&files)
+			if done[user] == nil {
+				done[user] = map[string]string{}
+			}
+			for _, f := range files {
+				if _, exists := done[user][f.Filename]; exists {
+					w.WriteHeader(http.StatusConflict) // slskd refuses a file it still tracks
+					return
+				}
+				queued = append(queued, user+"|"+f.Filename)
+				if fail[user+"|"+f.Filename] {
+					done[user][f.Filename] = "Completed, Errored"
+					continue
+				}
+				done[user][f.Filename] = "Completed, Succeeded"
+				dir := filepath.Join(dlDir, remoteParent(f.Filename))
+				_ = os.MkdirAll(dir, 0o755)
+				_ = os.WriteFile(filepath.Join(dir, remoteBase(f.Filename)), []byte(user), 0o644)
+			}
+		case r.Method == http.MethodGet && strings.HasPrefix(r.URL.Path, dl):
+			var ts []slskTransfer
+			for f, st := range done[strings.TrimPrefix(r.URL.Path, dl)] {
+				ts = append(ts, slskTransfer{ID: f, Filename: f, State: st})
+			}
+			_ = json.NewEncoder(w).Encode(map[string]any{"directories": []any{map[string]any{"files": ts}}})
+		case r.Method == http.MethodDelete && strings.HasPrefix(r.URL.Path, dl):
+			parts := strings.SplitN(strings.TrimPrefix(r.URL.Path, dl), "/", 2)
+			delete(done[parts[0]], parts[1])
+		default:
+			t.Errorf("unexpected call %s %s", r.Method, r.URL.Path)
+		}
+	}))
+	t.Cleanup(srv.Close)
+	return srv, &queued
+}
