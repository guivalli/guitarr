+func TestSoulseekImportReplacesEarlierCopies(t *testing.T) {
+	dl, dest := t.TempDir(), t.TempDir()
+	dir := filepath.Join(dest, "blink‐182", "NINE")
+	if err := os.MkdirAll(dir, 0o755); err != nil {
+		t.Fatal(err)
+	}
+	// an earlier attempt from another peer, named differently
+	for _, n := range []string{"01 - The First Time.flac", "02 - Happy Days.flac", "cover.jpg"} {
+		_ = os.WriteFile(filepath.Join(dir, n), []byte("old"), 0o600)
+	}
+	if err := os.MkdirAll(filepath.Join(dl, "NINE (2019)"), 0o755); err != nil {
+		t.Fatal(err)
