+import React from 'react'
+import { render, fireEvent, waitFor } from '@testing-library/react'
+import { describe, it, expect, vi, beforeEach } from 'vitest'
+import * as api from './api'
+import { DuplicatesPanel } from './DuplicatesPanel'
+
+const notify = vi.fn()
+vi.mock('react-admin', async () => {
+  const actual = await vi.importActual('react-admin')
+  return {
+    ...actual,
+    useTranslate: () => (key, opts) =>
+      opts ? `${key}:${JSON.stringify(opts)}` : key,
+    useNotify: () => notify,
+    useLocale: () => 'en',
+  }
+})
+
+vi.mock('./api', () => ({
+  getDuplicates: vi.fn(),
+  cleanDuplicates: vi.fn(),
+}))
+
+const report = {
+  files: 2,
+  bytes: 60_000_000,
+  groups: [
+    {
+      artist: 'blink-182',
+      title: 'The First Time',
+      files: [{ id: 'a' }, { id: 'b', remove: true }],
+    },
+    {
+      artist: 'blink-182',
+      title: 'Darkside',
+      files: [{ id: 'c' }, { id: 'd', remove: true }],
+    },
+  ],
+}
+
+describe('DuplicatesPanel', () => {
+  beforeEach(() => vi.clearAllMocks())
+
+  it('says when there is nothing to clean', async () => {
+    api.getDuplicates.mockResolvedValue({ files: 0, groups: [] })
+    const { findByText } = render(<DuplicatesPanel />)
+    expect(await findByText('resources.seer.duplicates.none')).toBeTruthy()
+  })
+
+  it('lists the duplicates and cleans them after a confirmation', async () => {
+    api.getDuplicates.mockResolvedValue(report)
+    api.cleanDuplicates.mockResolvedValue({ ...report, trash: '/t' })
+    const onCleaned = vi.fn()
+    const { findByText, getByText, queryByText } = render(
+      <DuplicatesPanel onCleaned={onCleaned} />,
+    )
+    expect(await findByText('blink-182 · The First Time')).toBeTruthy()
+    getByText(
+      'resources.seer.duplicates.found:{"smart_count":2,"size":"60 MB"}',
+    )
+    fireEvent.click(getByText('resources.seer.duplicates.clean'))
+    expect(api.cleanDuplicates).not.toHaveBeenCalled()
+    fireEvent.click(
+      getByText('resources.seer.duplicates.confirm:{"smart_count":2}'),
+    )
+    await waitFor(() => expect(onCleaned).toHaveBeenCalled())
+    expect(api.cleanDuplicates).toHaveBeenCalledTimes(1)
+    expect(notify).toHaveBeenCalledWith(
+      'resources.seer.duplicates.cleaned',
+      'info',
+      { smart_count: 2 },
+    )
+    expect(queryByText('blink-182 · The First Time')).toBeNull()
+  })
+})
