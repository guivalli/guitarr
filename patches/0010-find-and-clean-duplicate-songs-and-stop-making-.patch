+	trash := t.TempDir()
+	old := filepath.Join(trash, "2020-01-01_000000")
+	_ = os.MkdirAll(old, 0o755)
+	weekAgo := time.Now().Add(-8 * 24 * time.Hour)
+	_ = os.Chtimes(old, weekAgo, weekAgo)
+	d := &Duplicates{ds: ds, destDir: func() string { return seerDir }, trash: trash}
+	got, err := d.Clean(context.Background())
+	if err != nil || got.Files != 2 || got.Trash == "" {
+		t.Fatalf("clean: %+v %v", got, err)
+	}
+	for id, path := range map[string]string{"a": mfs[0].Path, "e": mfs[4].Path} {
+		if _, err := os.Stat(filepath.Join(lib, path)); !os.IsNotExist(err) {
+			t.Errorf("%s still in the library", id)
+		}
+		if _, err := os.Stat(filepath.Join(got.Trash, path[len("Seer/"):])); err != nil {
+			t.Errorf("%s not in the trash: %v", id, err)
+		}
+	}
+	for _, path := range []string{mfs[1].Path, mfs[2].Path, mfs[3].Path} {
+		if _, err := os.Stat(filepath.Join(lib, path)); err != nil {
+			t.Errorf("%s was removed", path)
+		}
+	}
+	if _, err := os.Stat(old); !os.IsNotExist(err) {
+		t.Error("week-old trash was not purged")
+	}
+}
