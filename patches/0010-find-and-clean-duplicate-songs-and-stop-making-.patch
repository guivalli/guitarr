+// filesOnDisk counts the audio files a source would have written for an album
+// request (DestDir/Artist/Album, the folder every source uses).
+func (s *Service) filesOnDisk(req *Request) int {
+	if req.Kind != KindAlbum || s.cfg.DestDir == "" {
+		return 0
+	}
+	dir := filepath.Join(s.cfg.DestDir, sanitize(req.Artist), sanitize(cmp(req.Album, req.Title)))
+	entries, err := os.ReadDir(dir)
+	if err != nil {
+		return 0
+	}
+	n := 0
+	for _, e := range entries {
+		if !e.IsDir() && audioExts[strings.ToLower(filepath.Ext(e.Name()))] {
+			n++
+		}
+	}
+	return n
+}
+
 // trackSources are the sources used to build an album track by track: the
 // track-only ones (web). Album-capable ones (Soulseek) already had their go at
 // the whole album, and searching them again per track is slow.
