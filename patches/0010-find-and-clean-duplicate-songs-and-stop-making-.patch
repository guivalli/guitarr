diff --git a/core/seer/duplicates.go b/core/seer/duplicates.go
new file mode 100644
index 0000000..0e56fba
--- /dev/null
+++ b/core/seer/duplicates.go
@@ -0,0 +1,227 @@
+package seer
+
+import (
+	"context"
+	"errors"
+	"os"
+	"path/filepath"
+	"sort"
+	"strconv"
+	"strings"
+	"time"
+
+	. "github.com/Masterminds/squirrel"
+	"github.com/navidrome/navidrome/conf"
+	"github.com/navidrome/navidrome/log"
+	"github.com/navidrome/navidrome/model"
+)
+
+// trashKeep is how long cleaned-up duplicates stay in the trash folder.
+const trashKeep = 7 * 24 * time.Hour
+
+// DupFile is one copy of a duplicated song.
+type DupFile struct {
+	ID      string `json:"id"`
+	Path    string `json:"path"`
+	Suffix  string `json:"suffix"`
+	BitRate int    `json:"bitRate"`
+	Size    int64  `json:"size"`
+	Remove  bool   `json:"remove"` // a cleanup moves it to the trash
+}
+
+// DupGroup is a song that is in the library more than once.
+type DupGroup struct {
+	Artist string    `json:"artist"`
+	Album  string    `json:"album"`
+	Title  string    `json:"title"`
+	Files  []DupFile `json:"files"`
+}
+
+// DupReport lists the duplicates a cleanup would remove.
+type DupReport struct {
+	Groups []DupGroup `json:"groups"`
+	Files  int        `json:"files"` // copies to remove
+	Bytes  int64      `json:"bytes"`
+	Trash  string     `json:"trash,omitempty"` // where Clean moved them
+}
+
+// Duplicates finds songs that are in the library twice (same album, disc and
+// title, same length) and removes the extra copies that Seer downloaded.
+// Files outside the Seer folder are the user's own and are never touched; the
+// copy kept is the user's own, else the best quality one.
+type Duplicates struct {
+	ds      model.DataStore
+	lib     *library
+	destDir func() string
+	trash   string // trash root; defaults to <DataFolder>/seer-trash
+}
+
+// Find reports the duplicates without changing anything.
+func (d *Duplicates) Find(ctx context.Context) (*DupReport, error) {
+	mfs, err := d.ds.MediaFile().GetAll(ctx, model.QueryOptions{Filters: Expr(`media_file.id IN (
+		SELECT m.id FROM media_file m JOIN (
+			SELECT album_id, disc_number, lower(title) AS t FROM media_file WHERE missing = 0
+			GROUP BY album_id, disc_number, lower(title) HAVING count(*) > 1
+		) d ON m.album_id = d.album_id AND m.disc_number = d.disc_number AND lower(m.title) = d.t
+		WHERE m.missing = 0)`)})
+	if err != nil {
+		return nil, err
+	}
+	return buildReport(mfs, d.destDir()), nil
+}
+
+func buildReport(mfs model.MediaFiles, seerDir string) *DupReport {
+	byKey := map[string]model.MediaFiles{}
+	var keys []string
+	for _, mf := range mfs {
+		k := mf.AlbumID + "\x00" + strconv.Itoa(mf.DiscNumber) + "\x00" + strings.ToLower(mf.Title)
+		if _, ok := byKey[k]; !ok {
+			keys = append(keys, k)
+		}
+		byKey[k] = append(byKey[k], mf)
+	}
+	sort.Strings(keys)
+	rep := &DupReport{Groups: []DupGroup{}}
+	for _, k := range keys {
+		group := byKey[k]
+		sort.SliceStable(group, func(i, j int) bool { return group[i].Duration < group[j].Duration })
+		// split by length: same title but a different length is another recording
+		start := 0
+		for i := 1; i <= len(group); i++ {
+			if i < len(group) && group[i].Duration-group[i-1].Duration <= 3 {
+				continue
+			}
+			if g := group[start:i]; len(g) > 1 {
+				if dg, ok := dupGroup(g, seerDir); ok {
+					rep.Groups = append(rep.Groups, dg)
+					for _, f := range dg.Files {
+						if f.Remove {
+							rep.Files++
+							rep.Bytes += f.Size
+						}
+					}
+				}
+			}
+			start = i
+		}
+	}
+	return rep
+}
+
+var lossless = map[string]bool{"flac": true, "alac": true, "wav": true, "aiff": true, "ape": true, "wv": true}
+
+func dupGroup(g model.MediaFiles, seerDir string) (DupGroup, bool) {
+	inSeer := func(mf model.MediaFile) bool { return seerDir != "" && isInside(seerDir, mf.AbsolutePath()) }
+	rank := func(mf model.MediaFile) int64 {
+		r := int64(mf.BitRate)
+		if !inSeer(mf) {
+			r += 1 << 40 // the user's own copy always stays
+		}
+		if lossless[strings.ToLower(mf.Suffix)] {
+			r += 1 << 30
+		}
+		return r
+	}
+	keep := 0
+	for i := range g {
+		if rank(g[i]) > rank(g[keep]) || (rank(g[i]) == rank(g[keep]) && g[i].Size > g[keep].Size) {
+			keep = i
+		}
+	}
+	dg := DupGroup{Artist: g[keep].Artist, Album: g[keep].Album, Title: g[keep].Title}
+	removable := false
+	for i, mf := range g {
+		f := DupFile{ID: mf.ID, Path: mf.AbsolutePath(), Suffix: mf.Suffix, BitRate: mf.BitRate, Size: mf.Size}
+		if i != keep && inSeer(mf) {
+			f.Remove, removable = true, true
+		}
+		dg.Files = append(dg.Files, f)
+	}
+	return dg, removable
+}
+
+// Clean moves the extra copies to <DataFolder>/seer-trash/<time>/ (kept for a
+// week, then purged) and rescans the library.
+func (d *Duplicates) Clean(ctx context.Context) (*DupReport, error) {
+	rep, err := d.Find(ctx)
+	if err != nil {
+		return nil, err
+	}
+	seerDir := d.destDir()
+	if seerDir == "" {
+		return nil, errors.New("no Seer folder configured")
+	}
+	root := d.trash
+	if root == "" {
+		root = filepath.Join(conf.Server.DataFolder.String(), "seer-trash")
+	}
+	purgeTrash(ctx, root)
+	if rep.Files == 0 {
+		return rep, nil
+	}
+	trash := filepath.Join(root, time.Now().Format("2006-01-02_150405"))
+	moved := 0
+	for _, g := range rep.Groups {
+		for _, f := range g.Files {
+			if !f.Remove || !isInside(seerDir, f.Path) {
+				continue
+			}
+			rel, err := filepath.Rel(seerDir, f.Path)
+			if err != nil {
+				continue
+			}
+			dst := filepath.Join(trash, rel)
+			if err := os.MkdirAll(filepath.Dir(dst), 0o755); err != nil {
+				return nil, err
+			}
+			if err := move(f.Path, dst); err != nil {
+				log.Warn(ctx, "Seer: could not move duplicate to the trash", "path", f.Path, err)
+				continue
+			}
+			moved++
+		}
+	}
+	log.Info(ctx, "Seer: moved duplicate songs to the trash", "files", moved, "trash", trash)
+	rep.Trash = trash
+	if d.lib != nil {
+		go func() { _ = d.lib.Rescan(context.WithoutCancel(ctx)) }()
+	}
+	return rep, nil
+}
+
+func purgeTrash(ctx context.Context, root string) {
+	entries, err := os.ReadDir(root)
+	if err != nil {
+		return
+	}
+	for _, e := range entries {
+		info, err := e.Info()
+		if err != nil || !e.IsDir() || time.Since(info.ModTime()) < trashKeep {
+			continue
+		}
+		if err := os.RemoveAll(filepath.Join(root, e.Name())); err != nil {
+			log.Warn(ctx, "Seer: could not purge old trash", "dir", e.Name(), err)
+		}
+	}
+}
+
+// move renames, or copies and deletes across file systems (the trash is in
+// the data folder, usually another mount than the music).
+func move(src, dst string) error {
+	if err := os.Rename(src, dst); err == nil {
+		return nil
+	}
+	in, err := os.ReadFile(src) //nolint:gosec
+	if err != nil {
+		return err
+	}
+	if err := os.WriteFile(dst, in, 0o644); err != nil { //nolint:gosec
+		return err
+	}
+	return os.Remove(src)
+}
+
+func isInside(root, path string) bool {
+	rel, err := filepath.Rel(filepath.Clean(root), filepath.Clean(path))
+	return err == nil && rel != "." && rel != ".." && !strings.HasPrefix(rel, ".."+string(filepath.Separator)) && !filepath.IsAbs(rel)
+}
diff --git a/core/seer/duplicates_test.go b/core/seer/duplicates_test.go
