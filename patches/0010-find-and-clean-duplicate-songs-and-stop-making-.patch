+	files := []slskFile{{Filename: `@@music\NINE (2019)\blink-182 - NINE - 01 - The First Time.flac`}}
+	_ = os.WriteFile(filepath.Join(dl, "NINE (2019)", "blink-182 - NINE - 01 - The First Time.flac"), []byte("new"), 0o600)
+	s := &Soulseek{DownloadDir: dl}
+	paths, err := s.importFiles(Request{Kind: KindAlbum, Artist: "blink‐182", Title: "NINE"}, files, dest)
+	if err != nil || len(paths) != 1 {
+		t.Fatalf("import: %v %v", paths, err)
+	}
+	entries, _ := os.ReadDir(dir)
