new file mode 100644
index 0000000..a9a0e67
--- /dev/null
+++ b/ui/src/seer/DuplicatesPanel.jsx
@@ -0,0 +1,140 @@
+import { useEffect, useState } from 'react'
+import { Button } from '@material-ui/core'
+import { makeStyles } from '@material-ui/core/styles'
+import { useLocale, useNotify, useTranslate } from 'react-admin'
+import { cleanDuplicates, getDuplicates } from './api'
+import { formatBytes } from './StorageWidget'
+
+const useStyles = makeStyles((theme) => ({
+  root: {
+    marginTop: theme.spacing(2.5),
+    paddingTop: theme.spacing(2),
+    borderTop: `1px solid ${theme.palette.divider}`,
+  },
+  title: { fontSize: 14, fontWeight: 700, marginBottom: 4 },
+  sub: { fontSize: 12, color: theme.palette.text.secondary, lineHeight: 1.4 },
+  list: {
+    margin: theme.spacing(1, 0),
+    padding: 0,
+    listStyle: 'none',
+    fontSize: 13,
+    maxHeight: 140,
+    overflowY: 'auto',
+    '& li': {
+      padding: '3px 0',
+      whiteSpace: 'nowrap',
+      overflow: 'hidden',
+      textOverflow: 'ellipsis',
+    },
+  },
+  actions: { display: 'flex', gap: 8, marginTop: theme.spacing(1) },
+}))
+
+const MAX_LISTED = 20
+
+// Lists the songs that are in the library twice and moves the extra copies
+// Seer downloaded to the trash (kept for a week).
+export const DuplicatesPanel = ({ onCleaned }) => {
+  const classes = useStyles()
+  const translate = useTranslate()
+  const notify = useNotify()
+  const locale = useLocale()
+  const [report, setReport] = useState(null)
+  const [confirm, setConfirm] = useState(false)
+  const [busy, setBusy] = useState(false)
+
+  useEffect(() => {
+    getDuplicates()
+      .then(setReport)
+      .catch(() => setReport({ groups: [], files: 0, failed: true }))
+  }, [])
+
+  const clean = () => {
+    setBusy(true)
+    cleanDuplicates()
+      .then((rep) => {
+        notify('resources.seer.duplicates.cleaned', 'info', {
+          smart_count: rep.files,
+        })
+        setReport({ groups: [], files: 0 })
+        setConfirm(false)
+        onCleaned && onCleaned()
+      })
+      .catch((e) => notify(e?.body || e?.message || String(e), 'warning'))
+      .finally(() => setBusy(false))
+  }
+
+  const groups = (report?.groups || []).filter((g) =>
+    g.files.some((f) => f.remove),
+  )
+
+  return (
+    <div className={classes.root} data-testid="seer-duplicates">
+      <div className={classes.title}>
+        {translate('resources.seer.duplicates.title')}
+      </div>
+      {!report ? (
+        <div className={classes.sub}>
+          {translate('resources.seer.duplicates.checking')}
+        </div>
+      ) : report.failed ? (
+        <div className={classes.sub}>
+          {translate('resources.seer.duplicates.failed')}
+        </div>
+      ) : report.files === 0 ? (
+        <div className={classes.sub}>
+          {translate('resources.seer.duplicates.none')}
+        </div>
+      ) : (
+        <>
+          <div className={classes.sub}>
+            {translate('resources.seer.duplicates.found', {
+              smart_count: report.files,
+              size: formatBytes(report.bytes, locale),
+            })}
+          </div>
+          <ul className={classes.list}>
+            {groups.slice(0, MAX_LISTED).map((g) => (
+              <li key={g.files.map((f) => f.id).join()}>
+                {g.artist} · {g.title}
+              </li>
+            ))}
+            {groups.length > MAX_LISTED && (
+              <li className={classes.sub}>
+                {translate('resources.seer.duplicates.more', {
+                  smart_count: groups.length - MAX_LISTED,
+                })}
+              </li>
+            )}
+          </ul>
+          <div className={classes.sub}>
+            {translate('resources.seer.duplicates.help')}
+          </div>
+          <div className={classes.actions}>
+            {confirm ? (
+              <>
+                <Button
+                  variant="contained"
+                  color="secondary"
+                  disabled={busy}
+                  onClick={clean}
+                >
+                  {translate('resources.seer.duplicates.confirm', {
+                    smart_count: report.files,
+                  })}
+                </Button>
+                <Button disabled={busy} onClick={() => setConfirm(false)}>
+                  {translate('ra.action.cancel')}
+                </Button>
+              </>
+            ) : (
+              <Button variant="outlined" onClick={() => setConfirm(true)}>
+                {translate('resources.seer.duplicates.clean')}
+              </Button>
+            )}
+          </div>
+        </>
+      )}
+    </div>
+  )
+}
