@@ -0,0 +1,102 @@
+package seer
+
+import (
+	"context"
+	"os"
+	"path/filepath"
+	"testing"
+	"time"
+
+	"github.com/navidrome/navidrome/model"
+	"github.com/navidrome/navidrome/tests"
+)
+
+func TestDuplicatesReportAndClean(t *testing.T) {
+	lib := t.TempDir()
+	seerDir := filepath.Join(lib, "Seer")
+	song := func(id, path, suffix string, bitRate int, dur float32) model.MediaFile {
+		full := filepath.Join(lib, path)
+		_ = os.MkdirAll(filepath.Dir(full), 0o755)
+		_ = os.WriteFile(full, []byte(id), 0o600)
+		return model.MediaFile{ID: id, LibraryPath: lib, Path: path, AlbumID: "al", DiscNumber: 1, Title: "The First Time",
+			Artist: "blink-182", Album: "NINE", Suffix: suffix, BitRate: bitRate, Duration: dur, Size: int64(bitRate)}
+	}
+	mfs := model.MediaFiles{
+		// two Seer downloads of the same song: the FLAC stays
+		song("a", "Seer/blink-182/NINE/01 - The First Time.mp3", "mp3", 320, 180),
+		song("b", "Seer/blink-182/NINE/The First Time.flac", "flac", 900, 181),
+		// same title, much longer: another recording, not a duplicate
+		song("c", "Seer/blink-182/NINE/The First Time (live).flac", "flac", 900, 260),
+		// the user's own copy beats a Seer FLAC, and is never removed
+		func() model.MediaFile {
+			m := song("d", "Mine/Blink/Darkside.mp3", "mp3", 128, 200)
+			m.Title, m.AlbumID = "Darkside", "al2"
+			return m
+		}(),
+		func() model.MediaFile {
+			m := song("e", "Seer/blink-182/NINE/Darkside.flac", "flac", 900, 200)
+			m.Title, m.AlbumID = "darkside", "al2"
+			return m
+		}(),
+		// a lone song is ignored
+		func() model.MediaFile {
+			m := song("f", "Seer/x/y/Other.flac", "flac", 900, 100)
+			m.Title = "Other"
+			return m
+		}(),
+	}
+
+	rep := buildReport(mfs, seerDir)
+	if len(rep.Groups) != 2 || rep.Files != 2 {
+		t.Fatalf("groups=%d files=%d: %+v", len(rep.Groups), rep.Files, rep)
+	}
+	remove := map[string]bool{}
+	for _, g := range rep.Groups {
+		for _, f := range g.Files {
+			if f.Remove {
+				remove[f.ID] = true
+			}
+		}
+	}
+	if !remove["a"] || !remove["e"] || remove["b"] || remove["c"] || remove["d"] {
+		t.Errorf("remove = %v", remove)
+	}
