+
+// validKeepPolicy accepts the retention modes: manual, keep all, keep the last 1 or 3.
+func validKeepPolicy(v int) bool {
+	return v == seer.KeepManual || v == 0 || v == 1 || v == 3
+}
+
+// prunePreview lists the downloads a new retention would delete, so the user can confirm first.
+func (api *Router) prunePreview(w http.ResponseWriter, r *http.Request) {
+	user, _ := request.UserFrom(r.Context())
+	id := chi.URLParam(r, "id")
+	ch, _, err := api.podcasts.Get(r.Context(), id)
+	if err != nil || (!user.IsAdmin && ch.UserID != user.ID) {
+		http.Error(w, "not found", http.StatusNotFound)
+		return
+	}
+	keep, err := strconv.Atoi(r.URL.Query().Get("keepPolicy"))
+	if err != nil || !validKeepPolicy(keep) {
+		http.Error(w, "keepPolicy must be -1, 0, 1 or 3", http.StatusBadRequest)
+		return
+	}
+	plan, err := api.podcasts.PrunePlan(r.Context(), id, keep)
+	if err != nil {
+		http.Error(w, err.Error(), http.StatusInternalServerError)
+		return
+	}
+	if plan == nil {
+		plan = []seer.PodcastEpisode{}
+	}
+	writeJSON(w, http.StatusOK, plan)
+}
