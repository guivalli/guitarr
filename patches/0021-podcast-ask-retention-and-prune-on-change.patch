new file mode 100644
index 0000000..7f5b5c6
--- /dev/null
+++ b/core/seer/podcast_prune.go
@@ -0,0 +1,46 @@
+package seer
+
+import (
+	"context"
+	"os"
+)
+
+// PrunePlan lists the downloaded episodes that a keep policy would remove, newest first.
+// Keep 0 removes nothing. KeepManual removes every download, because no episode enters
+// that mode by itself. Keep 1 or 3 removes the downloads beyond the newest N.
+func (s *PodcastService) PrunePlan(ctx context.Context, channelID string, keepPolicy int) ([]PodcastEpisode, error) {
+	downloaded, err := s.store.ListDownloadedEpisodes(ctx, channelID)
+	if err != nil {
+		return nil, err
+	}
+	switch {
+	case keepPolicy == KeepManual:
+		return downloaded, nil
+	case keepPolicy > 0 && len(downloaded) > keepPolicy:
+		return downloaded[keepPolicy:], nil
+	}
+	return nil, nil
+}
+
+// ApplyPrune deletes the files the keep policy no longer allows and returns how many went.
+func (s *PodcastService) ApplyPrune(ctx context.Context, channelID string, keepPolicy int) (int, error) {
+	plan, err := s.PrunePlan(ctx, channelID, keepPolicy)
+	if err != nil {
+		return 0, err
+	}
+	for i := range plan {
+		ep := plan[i]
+		if ep.FilePath != "" {
+			_ = os.Remove(ep.FilePath)
+		}
+		ep.Status = "deleted"
+		ep.FilePath = ""
+		ep.FileSize = 0
+		_ = s.store.UpdateEpisode(ctx, &ep)
+	}
+	if len(plan) > 0 && s.lib != nil {
+		_ = s.lib.Rescan(ctx)
+	}
+	s.notifyUI()
+	return len(plan), nil
+}
