@@ -0,0 +1,37 @@
+package seer
+
+import (
+	"context"
+	"testing"
+	"time"
+)
+
+func TestPrunePlanPerRetentionMode(t *testing.T) {
+	db := setupTestDB(t)
+	defer db.Close()
+	store := NewPodcastStore(db)
+	ctx := context.Background()
+	if err := store.CreateChannel(ctx, &PodcastChannel{ID: "k1", UserID: "u1", Title: "K", FeedURL: "https://example.com/k.xml", KeepPolicy: 0}); err != nil {
+		t.Fatal(err)
+	}
+	now := time.Now().UTC()
+	for i := 0; i < 4; i++ {
+		pub := now.Add(-time.Duration(i) * time.Hour)
+		ep := &PodcastEpisode{ID: "d" + string(rune('0'+i)), ChannelID: "k1", GUID: "g" + string(rune('0'+i)), Title: "Ep", PublishedAt: &pub, Status: "downloaded"}
+		if err := store.CreateEpisode(ctx, ep); err != nil {
+			t.Fatal(err)
+		}
+	}
+	svc := NewPodcastService(store, func() string { return t.TempDir() }, nil, nil, "ffmpeg", "yt-dlp")
+	cases := map[int]int{0: 0, 1: 3, 3: 1, KeepManual: 4}
+	for keep, want := range cases {
+		plan, err := svc.PrunePlan(ctx, "k1", keep)
+		if err != nil || len(plan) != want {
+			t.Errorf("keep %d: plan has %d episodes (err %v), want %d", keep, len(plan), err, want)
+		}
+	}
+	plan, _ := svc.PrunePlan(ctx, "k1", 1)
+	if len(plan) == 3 && plan[0].ID != "d1" {
+		t.Errorf("keep 1 must spare the newest download, first to go is %s", plan[0].ID)
+	}
+}
