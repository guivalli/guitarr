diff --git a/core/seer/versions.go b/core/seer/versions.go
new file mode 100644
index 00000000..2f41ad48
--- /dev/null
+++ b/core/seer/versions.go
@@ -0,0 +1,207 @@
+package seer
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"io"
+	"os"
+	"path/filepath"
+	"strings"
+	"sync"
+	"time"
+
+	"github.com/navidrome/navidrome/core/acquire"
+	"github.com/navidrome/navidrome/log"
+	"github.com/navidrome/navidrome/model"
+	"go.senan.xyz/taglib"
+)
+
+// VersionSource finds and downloads other recordings of a song (the acquire Service).
+type VersionSource interface {
+	Versions(ctx context.Context, artist, title string, durationMs int) ([]acquire.Version, error)
+	FetchVersion(ctx context.Context, v acquire.Version, dir string) (string, error)
+}
+
+// VersionJob is the swap of one song for another version, running in the background.
+type VersionJob struct {
+	SongID    string          `json:"songId"`
+	Status    string          `json:"status"` // downloading, replacing, done, failed
+	Error     string          `json:"error,omitempty"`
+	Version   acquire.Version `json:"version"`
+	StartedAt time.Time       `json:"startedAt"`
+	UpdatedAt time.Time       `json:"updatedAt"`
+}
+
+// Versions swaps a library file for another recording of the same song. The new
+// audio takes the old file's tags and name, so Navidrome keeps the same song
+// (favorites, plays, ratings and playlists stay).
+type Versions struct {
+	src    VersionSource
+	editor *Editor
+	// dir is where downloads wait before replacing the file (outside the library).
+	dir func() string
+
+	mu   sync.Mutex
+	jobs map[string]*VersionJob
+}
+
+func NewVersions(src VersionSource, editor *Editor, dir func() string) *Versions {
+	return &Versions{src: src, editor: editor, dir: dir, jobs: map[string]*VersionJob{}}
+}
+
+// Find lists the other versions of a song.
+func (v *Versions) Find(ctx context.Context, songID string) ([]acquire.Version, error) {
+	mf, err := v.editor.song(ctx, songID)
+	if err != nil {
+		return nil, err
+	}
+	return v.src.Versions(ctx, firstArtist(mf), mf.Title, int(mf.Duration*1000))
+}
+
+// Job returns the latest swap of a song, or nil.
+func (v *Versions) Job(songID string) *VersionJob {
+	v.mu.Lock()
+	defer v.mu.Unlock()
+	if j := v.jobs[songID]; j != nil {
+		c := *j
+		return &c
+	}
+	return nil
+}
+
+var ErrVersionBusy = errors.New("this song is already being replaced")
+
+// Start downloads the version and replaces the song's file in the background.
+func (v *Versions) Start(ctx context.Context, songID string, ver acquire.Version) (*VersionJob, error) {
+	mf, err := v.editor.song(ctx, songID)
+	if err != nil {
+		return nil, err
+	}
+	if _, err := absolutePath(*mf); err != nil {
+		return nil, err
+	}
+	v.mu.Lock()
+	if j := v.jobs[songID]; j != nil && (j.Status == "downloading" || j.Status == "replacing") {
+		v.mu.Unlock()
+		return nil, ErrVersionBusy
+	}
+	now := time.Now()
+	job := &VersionJob{SongID: songID, Status: "downloading", Version: ver, StartedAt: now, UpdatedAt: now}
+	v.jobs[songID] = job
+	c := *job
+	v.mu.Unlock()
+	go v.run(context.WithoutCancel(ctx), songID, ver)
+	return &c, nil
+}
+
+func (v *Versions) set(songID, status, msg string) {
+	v.mu.Lock()
+	defer v.mu.Unlock()
+	if j := v.jobs[songID]; j != nil {
+		j.Status, j.Error, j.UpdatedAt = status, msg, time.Now()
+	}
+}
+
+func (v *Versions) run(ctx context.Context, songID string, ver acquire.Version) {
+	ctx, cancel := context.WithTimeout(ctx, 20*time.Minute)
+	defer cancel()
+	dir, err := os.MkdirTemp(v.dir(), "version-")
+	if err != nil {
+		v.set(songID, "failed", err.Error())
+		return
+	}
+	defer os.RemoveAll(dir)
+	path, err := v.src.FetchVersion(ctx, ver, dir)
+	if err != nil {
+		log.Warn(ctx, "Seer: could not download the other version", "song", songID, err)
+		v.set(songID, "failed", err.Error())
+		return
+	}
+	v.set(songID, "replacing", "")
+	if err := v.editor.ReplaceAudio(ctx, songID, path); err != nil {
+		log.Warn(ctx, "Seer: could not replace the song file", "song", songID, err)
+		v.set(songID, "failed", err.Error())
+		return
+	}
+	v.set(songID, "done", "")
+}
+
+// ReplaceAudio puts the audio of newPath in place of the song's file. The new file gets the old
+// tags (and embedded picture) and the old name, only the extension may change; then the folder is
+// rescanned. Same name and tags = same persistent ID, so the scanner treats it as the same song.
+func (e *Editor) ReplaceAudio(ctx context.Context, songID, newPath string) error {
+	mf, err := e.song(ctx, songID)
+	if err != nil {
+		return err
+	}
+	old, err := absolutePath(*mf)
+	if err != nil {
+		return err
+	}
+	ext := strings.ToLower(filepath.Ext(newPath))
+	if ext == "" {
+		return errors.New("the downloaded file has no extension")
+	}
+	dst := strings.TrimSuffix(old, filepath.Ext(old)) + ext
+	if dst != old {
+		if _, err := os.Stat(dst); err == nil {
+			return fmt.Errorf("%s already exists", filepath.Base(dst))
+		}
+	}
+	tags, err := e.tags.Read(old)
+	if err != nil {
+		return fmt.Errorf("could not read the tags of %s: %w", mf.Path, err)
+	}
+	// copy next to the old file first, so the final rename cannot fail half way
+	tmp := filepath.Join(filepath.Dir(old), ".guitarr-swap-"+filepath.Base(dst))
+	if err := copyFile(newPath, tmp); err != nil {
+		return fmt.Errorf("could not write in the music folder: %w", err)
+	}
+	defer os.Remove(tmp)
+	newTags, _ := e.tags.Read(tmp)
+	for k := range newTags {
+		if _, ok := tags[k]; !ok {
+			tags[k] = nil // drop what the download brought (description, URL...)
+		}
+	}
+	if err := e.tags.Write(tmp, tags); err != nil {
+		return fmt.Errorf("could not tag the new file: %w", err)
+	}
+	if iw, ok := e.tags.(ImageWriter); ok {
+		if img, _ := readImage(old); len(img) > 0 {
+			if err := iw.WriteImage(tmp, img); err != nil {
+				log.Warn(ctx, "Seer: could not copy the picture to the new version", "path", mf.Path, err)
+			}
+		}
+	}
+	if err := os.Rename(tmp, dst); err != nil {
+		return err
+	}
+	if dst != old {
+		if err := os.Remove(old); err != nil {
+			log.Warn(ctx, "Seer: new version saved, but the old file could not be removed", "path", mf.Path, err)
+		}
+	}
+	log.Info(ctx, "Seer: song replaced by another version", "path", mf.Path, "new", filepath.Base(dst))
+	return e.rescan(ctx, []model.MediaFile{*mf})
+}
+
+var readImage = func(path string) ([]byte, error) { return taglib.ReadImage(path) }
+
+func copyFile(src, dst string) error {
+	in, err := os.Open(src)
+	if err != nil {
+		return err
+	}
+	defer in.Close()
+	out, err := os.OpenFile(dst, os.O_WRONLY|os.O_CREATE|os.O_TRUNC, 0o644)
+	if err != nil {
+		return err
+	}
+	if _, err := io.Copy(out, in); err != nil {
+		out.Close()
+		return err
+	}
+	return out.Close()
+}
