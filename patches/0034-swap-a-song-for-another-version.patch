+// TestReplaceAudioWithTaglib swaps a real MP3 for a real Opus file and checks the tags moved over.
+func TestReplaceAudioWithTaglib(t *testing.T) {
+	root, ds, _ := setupTestLibrary(t)
+	old := filepath.Join(root, "Artist/Album/01.mp3")
+	src := copyFixture(t, "test.mp3", t.TempDir())
+	b, _ := os.ReadFile(src)
+	if err := os.WriteFile(old, b, 0o644); err != nil {
+		t.Fatal(err)
+	}
+	tio := taglibIO{}
+	if err := tio.Write(old, map[string][]string{"TITLE": {"Guitarr"}, "MUSICBRAINZ_TRACKID": {"rec-1"}}); err != nil {
+		t.Fatal(err)
+	}
+	oldTags, _ := tio.Read(old)
+	dl := copyFixture(t, "test.opus", t.TempDir())
+	newTags, _ := tio.Read(dl)
+	e := NewEditor(ds, &fakeScanner{}, &fakeMaintenance{}, nil, nil)
+	if err := e.ReplaceAudio(context.Background(), "s1", dl); err != nil {
+		t.Fatal(err)
+	}
+	after, err := tio.Read(filepath.Join(root, "Artist/Album/01.opus"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !reflect.DeepEqual(after["TITLE"], []string{"Guitarr"}) || !reflect.DeepEqual(after["MUSICBRAINZ_TRACKID"], []string{"rec-1"}) {
+		t.Errorf("tags = %v", after)
+	}
+	for k := range newTags {
+		if _, inOld := oldTags[k]; !inOld {
+			if v, kept := after[k]; kept {
+				t.Errorf("tag %s from the download was kept: %v", k, v)
+			}
+		}
+	}
+}
