diff --git a/core/acquire/versions.go b/core/acquire/versions.go
new file mode 100644
index 00000000..8a8bdb95
--- /dev/null
+++ b/core/acquire/versions.go
@@ -0,0 +1,213 @@
+package acquire
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"net/url"
+	"path/filepath"
+	"sort"
+	"strings"
+	"sync"
+)
+
+// Version is another recording of a song (live take, acoustic, remaster, another upload...)
+// that a library file can be swapped for.
+type Version struct {
+	// Source is "musicbrainz" for a catalog recording (fetched by the normal sources),
+	// or the web site of a direct upload ("YouTube", "YouTube Music", "SoundCloud").
+	Source         string `json:"source"`
+	MBID           string `json:"mbid,omitempty"`
+	Title          string `json:"title"`
+	Artist         string `json:"artist"`
+	Album          string `json:"album,omitempty"`
+	Year           int    `json:"year,omitempty"`
+	DurationMs     int    `json:"durationMs,omitempty"`
+	Disambiguation string `json:"disambiguation,omitempty"`
+	CoverID        string `json:"coverId,omitempty"`
+	URL            string `json:"url,omitempty"`
+	Channel        string `json:"channel,omitempty"`
+}
+
+// recordingLister is implemented by catalogs that can list every recording of a song.
+type recordingLister interface {
+	Recordings(ctx context.Context, artist, title string) ([]Version, error)
+}
+
+// Recordings lists the recordings of a song, one per distinct take (live, acoustic,
+// remix...), each shown with the release that best represents it.
+func (m *MusicBrainz) Recordings(ctx context.Context, artist, title string) ([]Version, error) {
+	var recs struct {
+		Recordings []mbRecording `json:"recordings"`
+	}
+	q := fmt.Sprintf(`recording:"%s" AND artist:"%s"`, luceneEscaper.Replace(title), luceneEscaper.Replace(artist))
+	if err := m.get(ctx, "/recording", url.Values{"query": {q}, "limit": {"60"}}, &recs); err != nil {
+		return nil, err
+	}
+	seen := map[string]bool{}
+	var out []Version
+	for _, r := range recs.Recordings {
+		if r.Score < 70 {
+			continue
+		}
+		it, ok := r.item()
+		if !ok {
+			continue
+		}
+		// remasters of the same take differ by a second or two: one entry per take
+		key := fold(it.Title) + "|" + fold(r.Disambiguation) + "|" + fmt.Sprint((it.DurationMs+2500)/5000)
+		if seen[key] {
+			continue
+		}
+		seen[key] = true
+		out = append(out, Version{
+			Source: "musicbrainz", MBID: it.MBID, Title: it.Title, Artist: it.Artist, Album: it.Album,
+			Year: it.Year, DurationMs: it.DurationMs, Disambiguation: r.Disambiguation, CoverID: it.CoverID,
+		})
+		if len(out) >= 25 {
+			break
+		}
+	}
+	return out, nil
+}
+
+// webSites returns the downloader and the sites of the enabled web sources.
+func (s *Service) webSites() (*ytdlp, []webSite) {
+	var d *ytdlp
+	var sites []webSite
+	for _, src := range s.srcs() {
+		if !src.Enabled() {
+			continue
+		}
+		switch v := src.(type) {
+		case *YouTube:
+			if d == nil {
+				d = &ytdlp{Binary: v.Binary, FFmpeg: v.FFmpeg, Format: v.Format, Cookies: v.Cookies, AttemptTimeout: v.AttemptTimeout}
+			}
+			sites = append(sites, siteYouTubeMusic, siteYouTube)
+		case *SoundCloud:
+			if d == nil {
+				d = &ytdlp{Binary: v.Binary, FFmpeg: v.FFmpeg, Format: v.Format, AttemptTimeout: v.AttemptTimeout}
+			}
+			sites = append(sites, siteSoundCloud)
+		}
+	}
+	return d, sites
+}
+
+// Versions lists other recordings of a song: the MusicBrainz takes first, then
+// uploads found on the web sources. A failing side only drops its part.
+func (s *Service) Versions(ctx context.Context, artist, title string, durationMs int) ([]Version, error) {
+	var (
+		mu   sync.Mutex
+		out  []Version
+		web  []Version
+		errs []error
+		wg   sync.WaitGroup
+	)
+	if rl, ok := s.catalog.(recordingLister); ok {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			v, err := rl.Recordings(ctx, artist, title)
+			mu.Lock()
+			defer mu.Unlock()
+			out = v
+			if err != nil {
+				errs = append(errs, err)
+			}
+		}()
+	}
+	if d, sites := s.webSites(); d != nil {
+		d.Candidates = 6
+		req := Request{Kind: KindTrack, Artist: artist, Title: title, DurationMs: durationMs}
+		for _, site := range sites {
+			wg.Add(1)
+			go func() {
+				defer wg.Done()
+				cands, err := d.search(ctx, site, req)
+				mu.Lock()
+				defer mu.Unlock()
+				if err != nil {
+					errs = append(errs, fmt.Errorf("%s: %w", site.name, err))
+				}
+				for _, c := range cands {
+					web = append(web, Version{
+						Source: site.name, URL: c.URL, Title: c.Title, Artist: artist,
+						DurationMs: int(c.Duration * 1000), Channel: strings.TrimSpace(c.Channel),
+					})
+				}
+			}()
+		}
+	}
+	wg.Wait()
+	seen := map[string]bool{}
+	sort.SliceStable(web, func(i, j int) bool { return siteRank(web[i].Source) < siteRank(web[j].Source) })
+	for _, v := range web {
+		if !seen[v.URL] {
+			seen[v.URL] = true
+			out = append(out, v)
+		}
+	}
+	if len(out) == 0 && len(errs) > 0 {
+		return nil, errors.Join(errs...)
+	}
+	return out, nil
+}
+
+func siteRank(name string) int {
+	switch name {
+	case siteYouTubeMusic.name:
+		return 0
+	case siteYouTube.name:
+		return 1
+	}
+	return 2
+}
+
+// FetchVersion downloads one Version into dir (outside the library) and returns the file.
+// A web upload is downloaded as is; a MusicBrainz recording goes through the track
+// sources in order, like a request for that recording would.
+func (s *Service) FetchVersion(ctx context.Context, v Version, dir string) (string, error) {
+	if v.URL != "" {
+		d, sites := s.webSites()
+		if d == nil {
+			return "", errors.New("no web source is enabled")
+		}
+		site, ok := webSite{}, false
+		for _, st := range sites {
+			if st.name == v.Source {
+				site, ok = st, true
+			}
+		}
+		if !ok {
+			return "", fmt.Errorf("source %q is not enabled", v.Source)
+		}
+		return d.downloadFirst(ctx, site, []webCandidate{{URL: v.URL}}, filepath.Join(dir, "version.%(ext)s"), 0)
+	}
+	if v.MBID == "" {
+		return "", errors.New("version has neither a link nor a MusicBrainz id")
+	}
+	req := Request{Kind: KindTrack, MBID: v.MBID, Artist: v.Artist, Title: v.Title, Album: v.Album, DurationMs: v.DurationMs}
+	var errs []string
+	for _, src := range s.srcs() {
+		if !src.Enabled() || !src.Supports(KindTrack) {
+			continue
+		}
+		res, err := src.Fetch(ctx, req, dir)
+		if ctx.Err() != nil {
+			return "", ctx.Err()
+		}
+		if err == nil && len(res.Paths) > 0 {
+			return res.Paths[0], nil
+		}
+		if err == nil {
+			err = errors.New("nothing was downloaded")
+		}
+		errs = append(errs, fmt.Sprintf("%s: %v", src.Name(), err))
+	}
+	if len(errs) == 0 {
+		return "", errors.New("no enabled source can download a single track")
+	}
+	return "", errors.New(strings.Join(errs, "; "))
+}
diff --git a/core/acquire/versions_test.go b/core/acquire/versions_test.go
new file mode 100644
index 00000000..dc8d35bf
--- /dev/null
+++ b/core/acquire/versions_test.go
@@ -0,0 +1,86 @@
+package acquire
+
+import (
+	"context"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+)
+
+func TestRecordingsOnePerTake(t *testing.T) {
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.URL.Path != "/recording" || !strings.Contains(r.URL.Query().Get("query"), `recording:"Zóio de Lula"`) {
+			_, _ = w.Write([]byte(`{}`))
+			return
+		}
+		_, _ = w.Write([]byte(`{"recordings":[
+			{"id":"a","title":"Zóio de Lula","length":250000,"score":100,"artist-credit":[{"name":"Charlie Brown Jr."}],
+			 "releases":[{"title":"Preço Curto","date":"1999","status":"Official","release-group":{"id":"rg","primary-type":"Album"}}]},
+			{"id":"b","title":"Zóio de Lula","length":251000,"score":100,"artist-credit":[{"name":"Charlie Brown Jr."}],
+			 "releases":[{"title":"Remaster","date":"2010","status":"Official","release-group":{"id":"rg2","primary-type":"Album"}}]},
+			{"id":"c","title":"Zóio de Lula","disambiguation":"live","length":262000,"score":95,"artist-credit":[{"name":"Charlie Brown Jr."}],
+			 "releases":[{"title":"Acústico MTV","date":"2003","status":"Official","release-group":{"id":"rg3","primary-type":"Album","secondary-types":["Live"]}}]},
+			{"id":"d","title":"Outra","score":40,"releases":[{"title":"x"}]},
+			{"id":"e","title":"Zóio de Lula","score":90,"video":true,"releases":[{"title":"x"}]}]}`))
+	}))
+	defer srv.Close()
+	m := &MusicBrainz{BaseURL: srv.URL}
+	got, err := m.Recordings(context.Background(), "Charlie Brown Jr.", "Zóio de Lula")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(got) != 2 {
+		t.Fatalf("got %d versions: %+v", len(got), got)
+	}
+	if got[0].MBID != "a" || got[0].Album != "Preço Curto" || got[0].Source != "musicbrainz" {
+		t.Errorf("first = %+v", got[0])
+	}
+	if got[1].MBID != "c" || got[1].Disambiguation != "live" || got[1].Year != 2003 {
+		t.Errorf("second = %+v", got[1])
+	}
+}
+
+type versionSource struct {
+	name  string
+	kinds []Kind
+	paths []string
+	err   error
+	got   []Request
+}
+
+func (s *versionSource) Name() string  { return s.name }
+func (s *versionSource) Enabled() bool { return true }
+func (s *versionSource) Supports(k Kind) bool {
+	for _, x := range s.kinds {
+		if x == k {
+			return true
+		}
+	}
+	return false
+}
+func (s *versionSource) Fetch(_ context.Context, req Request, _ string) (Result, error) {
+	s.got = append(s.got, req)
+	return Result{Paths: s.paths}, s.err
+}
+
+func TestFetchVersionTriesTrackSourcesInOrder(t *testing.T) {
+	lidarr := &versionSource{name: "lidarr", kinds: []Kind{KindAlbum}}
+	slsk := &versionSource{name: "soulseek", kinds: []Kind{KindTrack, KindAlbum}, err: context.DeadlineExceeded}
+	yt := &versionSource{name: "youtube", kinds: []Kind{KindTrack}, paths: []string{"/tmp/x/a.opus"}}
+	s := &Service{}
+	s.SetSources([]Source{lidarr, slsk, yt})
+	p, err := s.FetchVersion(context.Background(), Version{MBID: "c", Title: "Zóio", Artist: "CBJR"}, "/tmp/x")
+	if err != nil || p != "/tmp/x/a.opus" {
+		t.Fatalf("FetchVersion = %q, %v", p, err)
+	}
+	if len(lidarr.got) != 0 || len(slsk.got) != 1 || slsk.got[0].MBID != "c" || slsk.got[0].Kind != KindTrack {
+		t.Errorf("calls: lidarr %v, soulseek %v", lidarr.got, slsk.got)
+	}
+	if _, err := s.FetchVersion(context.Background(), Version{}, "/tmp/x"); err == nil {
+		t.Error("empty version should fail")
+	}
+	if _, err := s.FetchVersion(context.Background(), Version{Source: "YouTube", URL: "https://x"}, "/tmp/x"); err == nil {
+		t.Error("link without a web source should fail")
+	}
+}
