+package seerapi
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"net/http"
+
+	"github.com/go-chi/chi/v5"
+	"github.com/navidrome/navidrome/core/acquire"
+	"github.com/navidrome/navidrome/core/seer"
+	"github.com/navidrome/navidrome/log"
+)
+
+// Versions swaps a song for another recording of it (admin-only, under /library).
+type Versions interface {
+	Find(ctx context.Context, songID string) ([]acquire.Version, error)
+	Start(ctx context.Context, songID string, v acquire.Version) (*seer.VersionJob, error)
+	Job(songID string) *seer.VersionJob
+}
+
+// songVersions lists other recordings of the song (MusicBrainz takes and web uploads).
+func (api *Router) songVersions(w http.ResponseWriter, r *http.Request) {
+	if api.versions == nil {
+		http.Error(w, "not available", http.StatusNotFound)
+		return
+	}
+	list, err := api.versions.Find(r.Context(), chi.URLParam(r, "id"))
+	switch {
+	case errors.Is(err, seer.ErrItemNotFound):
+		http.Error(w, "not found", http.StatusNotFound)
+	case err != nil:
+		log.Warn(r.Context(), "Seer: version search failed", err)
+		http.Error(w, err.Error(), http.StatusBadGateway)
+	default:
+		if list == nil {
+			list = []acquire.Version{}
+		}
+		writeJSON(w, http.StatusOK, list)
+	}
+}
+
+// replaceSongVersion starts downloading the chosen version; it replaces the file when it arrives.
+func (api *Router) replaceSongVersion(w http.ResponseWriter, r *http.Request) {
+	if api.versions == nil {
+		http.Error(w, "not available", http.StatusNotFound)
+		return
+	}
+	var v acquire.Version
+	if err := json.NewDecoder(http.MaxBytesReader(w, r.Body, 16<<10)).Decode(&v); err != nil || (v.URL == "" && v.MBID == "") {
+		http.Error(w, "invalid body", http.StatusBadRequest)
+		return
+	}
+	job, err := api.versions.Start(r.Context(), chi.URLParam(r, "id"), v)
+	switch {
+	case errors.Is(err, seer.ErrItemNotFound):
+		http.Error(w, "not found", http.StatusNotFound)
+	case errors.Is(err, seer.ErrVersionBusy):
+		http.Error(w, err.Error(), http.StatusConflict)
+	case err != nil:
+		http.Error(w, err.Error(), http.StatusBadRequest)
+	default:
+		writeJSON(w, http.StatusAccepted, job)
+	}
+}
+
+// songVersionJob reports the latest swap of the song (404 when there was none).
+func (api *Router) songVersionJob(w http.ResponseWriter, r *http.Request) {
+	if api.versions == nil {
+		http.Error(w, "not available", http.StatusNotFound)
+		return
+	}
+	job := api.versions.Job(chi.URLParam(r, "id"))
+	if job == nil {
+		http.Error(w, "no job", http.StatusNotFound)
+		return
+	}
+	writeJSON(w, http.StatusOK, job)
+}
