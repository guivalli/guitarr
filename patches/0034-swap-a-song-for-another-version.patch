+
+// pathTags keeps the tags of each file by path, like a real TagIO would.
+type pathTags struct {
+	files map[string]map[string][]string
+}
+
+func (f *pathTags) Read(path string) (map[string][]string, error) {
+	if _, err := os.Stat(path); err != nil {
+		return nil, err
+	}
+	out := map[string][]string{}
+	for k, v := range f.files[path] {
+		out[k] = v
+	}
+	return out, nil
+}
+
+func (f *pathTags) Write(path string, tags map[string][]string) error {
+	cur := f.files[path]
+	if cur == nil {
+		cur = map[string][]string{}
+	}
+	for k, v := range tags {
+		if v == nil {
+			delete(cur, k)
+		} else {
+			cur[k] = v
+		}
+	}
+	f.files[path] = cur
+	return nil
+}
+
+func swapSetup(t *testing.T) (string, *Editor, *fakeScanner, *pathTags, string) {
+	t.Helper()
+	root, ds, _ := setupTestLibrary(t)
+	old := filepath.Join(root, "Artist/Album/01.mp3")
+	tags := &pathTags{files: map[string]map[string][]string{
+		old: {"TITLE": {"Song"}, "MUSICBRAINZ_TRACKID": {"rec-1"}},
+	}}
+	sc := &fakeScanner{}
+	e := NewEditor(ds, sc, &fakeMaintenance{}, tags, nil)
+	dl := filepath.Join(t.TempDir(), "version.opus")
+	if err := os.WriteFile(dl, []byte("new audio"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	tags.files[dl] = map[string][]string{"TITLE": {"Song (Official Video)"}, "COMMENT": {"https://youtu.be/x"}}
+	return root, e, sc, tags, dl
+}
+
+func TestReplaceAudioKeepsNameTagsAndSong(t *testing.T) {
+	root, e, sc, tags, dl := swapSetup(t)
+	tags.files[filepath.Join(root, "Artist/Album/.guitarr-swap-01.opus")] = tags.files[dl]
+
+	if err := e.ReplaceAudio(context.Background(), "s1", dl); err != nil {
+		t.Fatal(err)
+	}
+	dst := filepath.Join(root, "Artist/Album/01.opus")
+	if b, err := os.ReadFile(dst); err != nil || string(b) != "new audio" {
+		t.Fatalf("new file = %q, %v", b, err)
+	}
+	if _, err := os.Stat(filepath.Join(root, "Artist/Album/01.mp3")); !os.IsNotExist(err) {
+		t.Errorf("old file still there: %v", err)
+	}
+	if _, err := os.Stat(filepath.Join(root, "Artist/Album/.guitarr-swap-01.opus")); !os.IsNotExist(err) {
+		t.Errorf("temporary file left behind: %v", err)
+	}
+	got := tags.files[filepath.Join(root, "Artist/Album/.guitarr-swap-01.opus")]
+	want := map[string][]string{"TITLE": {"Song"}, "MUSICBRAINZ_TRACKID": {"rec-1"}}
+	if !reflect.DeepEqual(got, want) {
+		t.Errorf("tags of the new file = %v, want %v", got, want)
+	}
+	if w := [][]model.ScanTarget{{{LibraryID: 1, FolderPath: "Artist/Album"}}}; !reflect.DeepEqual(sc.targets, w) {
+		t.Errorf("scan targets = %v", sc.targets)
+	}
+}
+
+func TestReplaceAudioSameExtensionOverwrites(t *testing.T) {
+	root, e, _, _, _ := swapSetup(t)
+	dl := filepath.Join(t.TempDir(), "x.mp3")
+	if err := os.WriteFile(dl, []byte("mp3 take 2"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	if err := e.ReplaceAudio(context.Background(), "s1", dl); err != nil {
+		t.Fatal(err)
+	}
+	if b, _ := os.ReadFile(filepath.Join(root, "Artist/Album/01.mp3")); string(b) != "mp3 take 2" {
+		t.Errorf("file = %q", b)
+	}
+}
+
+func TestReplaceAudioRefusesToOverwriteAnotherFile(t *testing.T) {
+	root, e, _, _, dl := swapSetup(t)
+	other := filepath.Join(root, "Artist/Album/01.opus")
+	if err := os.WriteFile(other, []byte("someone else"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	if err := e.ReplaceAudio(context.Background(), "s1", dl); err == nil {
+		t.Fatal("want an error")
+	}
+	if b, _ := os.ReadFile(other); string(b) != "someone else" {
+		t.Errorf("other file changed: %q", b)
+	}
+	if _, err := os.Stat(filepath.Join(root, "Artist/Album/01.mp3")); err != nil {
+		t.Errorf("old file removed: %v", err)
+	}
+}
