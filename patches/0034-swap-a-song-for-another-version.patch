+type fakeVersionSource struct {
+	file string
+	err  error
+	got  acquire.Version
+}
+
+func (f *fakeVersionSource) Versions(context.Context, string, string, int) ([]acquire.Version, error) {
+	return []acquire.Version{{Source: "musicbrainz", MBID: "r2", Title: "Song (live)"}}, nil
+}
+
+func (f *fakeVersionSource) FetchVersion(_ context.Context, v acquire.Version, dir string) (string, error) {
+	f.got = v
+	if f.err != nil {
+		return "", f.err
+	}
+	p := filepath.Join(dir, "dl.mp3")
+	return p, os.WriteFile(p, []byte(f.file), 0o644)
+}
+
+func waitJob(t *testing.T, v *Versions, id string) *VersionJob {
+	t.Helper()
+	for range 200 {
+		if j := v.Job(id); j != nil && (j.Status == "done" || j.Status == "failed") {
+			return j
+		}
+		time.Sleep(10 * time.Millisecond)
+	}
+	t.Fatal("job did not finish")
+	return nil
+}
+
+func TestVersionsJob(t *testing.T) {
+	root, e, _, _, _ := swapSetup(t)
+	src := &fakeVersionSource{file: "live take"}
+	tmp := t.TempDir()
+	v := NewVersions(src, e, func() string { return tmp })
+
+	list, err := v.Find(context.Background(), "s1")
+	if err != nil || len(list) != 1 {
+		t.Fatalf("Find = %v, %v", list, err)
+	}
+	if _, err := v.Find(context.Background(), "nope"); !errors.Is(err, ErrItemNotFound) {
+		t.Errorf("unknown song: %v", err)
+	}
+	job, err := v.Start(context.Background(), "s1", list[0])
+	if err != nil || job.Status != "downloading" {
+		t.Fatalf("Start = %+v, %v", job, err)
+	}
+	if j := waitJob(t, v, "s1"); j.Status != "done" {
+		t.Fatalf("job = %+v", j)
+	}
+	if b, _ := os.ReadFile(filepath.Join(root, "Artist/Album/01.mp3")); string(b) != "live take" {
+		t.Errorf("file = %q", b)
+	}
+	if src.got.MBID != "r2" {
+		t.Errorf("fetched %+v", src.got)
+	}
+	if left, _ := os.ReadDir(tmp); len(left) != 0 {
+		t.Errorf("download folder not cleaned: %v", left)
+	}
+
+	src.err = errors.New("nothing found")
+	if _, err := v.Start(context.Background(), "s1", list[0]); err != nil {
+		t.Fatal(err)
+	}
+	if j := waitJob(t, v, "s1"); j.Status != "failed" || j.Error != "nothing found" {
+		t.Errorf("job = %+v", j)
+	}
+}
