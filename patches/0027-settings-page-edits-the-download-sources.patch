+      {config && (
+        <>
+          <Section title={translate('resources.seer.settings.sourcesSection')}>
+            <div style={{ marginTop: 12 }}>
+              {text('sources', 'resources.seer.settings.sources', {
+                helperText: translate('resources.seer.settings.sourcesHint'),
+              })}
+              {toggle('youtubeEnabled', 'resources.seer.settings.youtubeEnabled')}
+              {toggle('soundcloudEnabled', 'resources.seer.settings.soundcloudEnabled')}
+              {toggle('soulseekEnabled', 'resources.seer.settings.soulseekEnabled')}
+              {toggle('lidarrEnabled', 'resources.seer.settings.lidarrEnabled')}
+            </div>
+          </Section>
+
+          <Section title={translate('resources.seer.settings.youtube')}>
+            <div style={{ marginTop: 12 }}>
+              {text('youtubeCookies', 'resources.seer.settings.youtubeCookies')}
+            </div>
+          </Section>
+
+          <Section title={translate('resources.seer.settings.soulseek')}>
+            <div style={{ marginTop: 12 }}>
+              {text('soulseekUrl', 'resources.seer.settings.soulseekUrl')}
+              {secret('soulseekApiKey', 'resources.seer.settings.soulseekApiKey')}
+              {text('soulseekDownloads', 'resources.seer.settings.soulseekDownloads')}
+              {toggle('soulseekPreferFlac', 'resources.seer.settings.soulseekPreferFlac')}
+            </div>
+          </Section>
+
+          <Section title={translate('resources.seer.settings.lidarr')}>
+            <div style={{ marginTop: 12 }}>
+              {text('lidarrUrl', 'resources.seer.settings.lidarrUrl')}
+              {secret('lidarrApiKey', 'resources.seer.settings.lidarrApiKey')}
+              {text('lidarrRootFolder', 'resources.seer.settings.lidarrRootFolder')}
+            </div>
+          </Section>
+
+          <Section title={translate('resources.seer.settings.spotify')}>
+            <div style={{ marginTop: 12 }}>
+              {text('spotifyClientId', 'resources.seer.settings.spotifyClientId')}
+              {secret('spotifyClientSecret', 'resources.seer.settings.spotifyClientSecret')}
+            </div>
+          </Section>
+
+          <Section title={translate('resources.seer.settings.space')}>
+            <div style={{ marginTop: 12 }}>
+              {text('minFreeSpace', 'resources.seer.settings.minFreeSpace')}
+            </div>
+          </Section>
+
+          <div style={{ marginTop: 24, display: 'flex', alignItems: 'center', gap: 16 }}>
+            <Button
+              variant="contained"
+              color="primary"
+              disabled={saving}
+              onClick={save}
+            >
+              {translate('resources.seer.settings.save')}
+            </Button>
+            <Typography variant="body2" color="textSecondary">
+              {translate('resources.seer.settings.encryptionNote')}
+            </Typography>
+          </div>
+        </>
+      )}
+
       <Section title={translate('resources.seer.settings.help')}>
         <Button
           variant="outlined"
