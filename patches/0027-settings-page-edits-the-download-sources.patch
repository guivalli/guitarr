@@ -1,18 +1,59 @@
 import { useEffect, useState } from 'react'
-import { Button, FormControlLabel, Switch, Typography } from '@material-ui/core'
+import {
+  Button,
+  FormControlLabel,
+  Switch,
+  TextField,
+  Typography,
+} from '@material-ui/core'
 import { Title, useNotify, useTranslate } from 'react-admin'
-import { getSeerSettings, setSeerSettings } from './api'
+import { getSeerConfig, getSeerSettings, setSeerConfig, setSeerSettings } from './api'
 import { Section } from './components'
 
+// Plain values, and the secrets with the flag the server reports for each one.
+const PLAIN_KEYS = [
+  'sources',
+  'youtubeEnabled',
+  'youtubeCookies',
+  'soundcloudEnabled',
+  'soulseekEnabled',
+  'soulseekUrl',
+  'soulseekDownloads',
+  'soulseekPreferFlac',
+  'lidarrEnabled',
+  'lidarrUrl',
+  'lidarrRootFolder',
+  'spotifyClientId',
+  'minFreeSpace',
+]
+const SECRET_SET = {
+  soulseekApiKey: 'soulseekApiKeySet',
+  lidarrApiKey: 'lidarrApiKeySet',
+  spotifyClientSecret: 'spotifyClientSecretSet',
+}
+
+const errorMessage = (err) => err?.body || err?.message || String(err)
+
 export const SeerSettings = () => {
   const translate = useTranslate()
   const notify = useNotify()
   const [settings, setSettings] = useState(null)
+  const [config, setConfig] = useState(null)
+  const [draft, setDraft] = useState({})
+  // A secret is only sent when it was typed; '' clears it.
+  const [secrets, setSecrets] = useState({})
+  const [saving, setSaving] = useState(false)
 
   useEffect(() => {
     getSeerSettings()
       .then(setSettings)
       .catch(() => notify('resources.seer.settings.loadError', 'warning'))
+    getSeerConfig()
+      .then((view) => {
+        setConfig(view)
+        setDraft(view)
+      })
+      .catch(() => notify('resources.seer.settings.loadError', 'warning'))
   }, [notify])
 
   const toggleAutoApprove = (e) => {
@@ -21,6 +62,83 @@ export const SeerSettings = () => {
       .catch(() => notify('resources.seer.settings.saveError', 'warning'))
   }
 
+  const setField = (key, value) => setDraft((d) => ({ ...d, [key]: value }))
+  const setSecret = (key, value) => setSecrets((s) => ({ ...s, [key]: value }))
+
+  const save = () => {
+    const patch = {}
+    for (const key of PLAIN_KEYS) {
+      if (draft[key] !== config[key]) patch[key] = draft[key]
+    }
+    for (const key of Object.keys(SECRET_SET)) {
+      if (secrets[key] !== undefined) patch[key] = secrets[key]
+    }
+    if (Object.keys(patch).length === 0) return
+    setSaving(true)
+    setSeerConfig(patch)
+      .then((view) => {
+        setConfig(view)
+        setDraft(view)
+        setSecrets({})
+        notify('resources.seer.settings.saved', 'info')
+      })
+      .catch((err) => notify(errorMessage(err), 'warning'))
+      .finally(() => setSaving(false))
+  }
+
+  const text = (key, label, props = {}) => (
+    <TextField
+      key={key}
+      label={translate(label)}
+      value={draft[key] ?? ''}
+      onChange={(e) => setField(key, e.target.value)}
+      fullWidth
+      margin="normal"
+      {...props}
+    />
+  )
+
+  const toggle = (key, label) => (
+    <FormControlLabel
+      key={key}
+      control={
+        <Switch
+          color="primary"
+          checked={!!draft[key]}
+          onChange={(e) => setField(key, e.target.checked)}
+        />
+      }
+      label={translate(label)}
+    />
+  )
+
+  const secret = (key, label) => (
+    <div key={key} style={{ display: 'flex', alignItems: 'flex-end', gap: 8 }}>
+      <TextField
+        label={translate(label)}
+        type="password"
+        autoComplete="off"
+        value={secrets[key] ?? ''}
+        placeholder={config?.[SECRET_SET[key]] ? '••••••••' : ''}
+        helperText={
+          config?.[SECRET_SET[key]]
+            ? translate('resources.seer.settings.secretSaved')
+            : ''
+        }
+        onChange={(e) => setSecret(key, e.target.value)}
+        fullWidth
+        margin="normal"
+      />
+      <Button
+        size="small"
+        style={{ marginBottom: 12 }}
+        onClick={() => setSecret(key, '')}
+      >
+        {translate('resources.seer.settings.clear')}
+      </Button>
+    </div>
+  )
+
   return (
     <div style={{ padding: 24, maxWidth: 720 }}>
       <Title title={translate('resources.seer.settings.title')} />
@@ -42,6 +160,73 @@ export const SeerSettings = () => {
           </Typography>
         </div>
       </Section>
