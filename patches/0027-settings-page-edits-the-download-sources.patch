     body: JSON.stringify(patch),
   }).then(({ json }) => json)
+
+export const getSeerConfig = () =>
+  httpClient(`${SEER_URL}/config`).then(({ json }) => json)
+
+export const setSeerConfig = (changes) =>
+  httpClient(`${SEER_URL}/config`, {
+    method: 'PUT',
+    body: JSON.stringify(changes),
+  }).then(({ json }) => json)
