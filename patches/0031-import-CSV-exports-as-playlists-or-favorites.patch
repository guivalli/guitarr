+// ParseImportFiles reads one exported playlist, or every playlist inside a .zip
+// (Exportify's "Export All"). Files in the zip that hold no songs are skipped.
+func ParseImportFiles(name string, data []byte) ([]*ImportList, error) {
+	if !strings.EqualFold(fileExt(name), ".zip") {
+		list, err := ParseImportFile(name, data)
+		if err != nil {
+			return nil, err
+		}
+		return []*ImportList{list}, nil
+	}
+	zr, err := zip.NewReader(bytes.NewReader(data), int64(len(data)))
+	if err != nil {
+		return nil, fmt.Errorf("reading zip: %w", err)
+	}
+	var lists []*ImportList
+	for _, f := range zr.File {
+		ext := strings.ToLower(fileExt(f.Name))
+		if f.FileInfo().IsDir() || (ext != ".csv" && ext != ".json" && ext != ".txt") || strings.Contains(f.Name, "__MACOSX") {
+			continue
+		}
+		rc, err := f.Open()
+		if err != nil {
+			continue
+		}
+		body, err := io.ReadAll(io.LimitReader(rc, 16<<20))
+		rc.Close()
+		if err != nil {
+			continue
+		}
+		if list, err := ParseImportFile(f.Name, body); err == nil {
+			lists = append(lists, list)
+		}
+	}
+	if len(lists) == 0 {
+		return nil, errors.New("no playlists found in the zip")
+	}
+	return lists, nil
+}
+
+var likedSongs = regexp.MustCompile(`(?i)^(liked[ _-]?songs|your[ _-]?likes|liked[ _-]?music|m[uú]sicas[ _-]?curtidas|curtidas)$`)
+
+// IsLikedSongs tells if an exported list is the "Liked Songs" of the account.
+func IsLikedSongs(name string) bool {
+	return likedSongs.MatchString(strings.TrimSpace(name))
+}
+
 func fileExt(s string) string {
 	if i := strings.LastIndex(s, "."); i > 0 {
 		return s[i:]
