+// StarSongs marks the songs as favorites of the user, leaving the ones already
+// starred alone (their date stays, and an unchanged list writes nothing).
+func (w *playlistWriter) StarSongs(ctx context.Context, userID string, ids []string) error {
+	user, err := w.ds.User().Get(ctx, userID)
+	if err != nil {
+		return err
+	}
+	ctx = request.WithUser(ctx, *user)
+	repo := w.ds.MediaFile()
+	for chunk := range slices.Chunk(ids, 500) {
+		mfs, err := repo.GetAll(ctx, model.QueryOptions{Filters: squirrel.Eq{"media_file.id": chunk}})
+		if err != nil {
+			return err
+		}
+		var todo []string
+		for _, mf := range mfs {
+			if !mf.Starred {
+				todo = append(todo, mf.ID)
+			}
+		}
+		if len(todo) > 0 {
+			if err := repo.SetStar(ctx, true, todo...); err != nil {
+				return err
+			}
+		}
+	}
+	return nil
+}
