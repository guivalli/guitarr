+func TestParseImportFilesZip(t *testing.T) {
+	var buf bytes.Buffer
+	zw := zip.NewWriter(&buf)
+	for name, body := range map[string]string{
+		"liked_songs.csv":  "Track Name,Artist Name(s)\nA,B\n",
+		"road_trip.csv":    "Track Name,Artist Name(s)\nC,D;E\n",
+		"empty.csv":        "Track Name,Artist Name(s)\n",
+		"__MACOSX/._x.csv": "junk",
+		"cover.png":        "png",
+	} {
+		f, _ := zw.Create(name)
+		_, _ = f.Write([]byte(body))
+	}
+	_ = zw.Close()
+	lists, err := ParseImportFiles("spotify_playlists.zip", buf.Bytes())
+	if err != nil || len(lists) != 2 {
+		t.Fatalf("zip: %v %v", lists, err)
+	}
+	names := map[string]bool{}
+	for _, l := range lists {
+		names[l.Name] = true
+	}
+	if !names["liked songs"] || !names["road trip"] {
+		t.Errorf("names = %v", names)
+	}
+	if !IsLikedSongs("liked songs") || !IsLikedSongs("Músicas Curtidas") || IsLikedSongs("road trip") {
+		t.Error("IsLikedSongs")
+	}
+	if _, err := ParseImportFiles("x.zip", []byte("not a zip")); err == nil {
+		t.Error("bad zip accepted")
+	}
+}
