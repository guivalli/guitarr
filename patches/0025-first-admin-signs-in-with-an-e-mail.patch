+      "invalidEmail": "Enter a valid e-mail address"
     },
     "action": {
       "add_filter": "Add filter",
diff --git a/ui/src/layout/Login.jsx b/ui/src/layout/Login.jsx
index a7763cf..b8be2b8 100644
--- a/ui/src/layout/Login.jsx
+++ b/ui/src/layout/Login.jsx
@@ -269,7 +269,8 @@ const FormSignUp = ({ loading, handleSubmit, validate }) => {
                     autoFocus
                     name="username"
                     component={renderInput}
-                    label={translate('ra.auth.username')}
+                    label={translate('ra.auth.email')}
+                    type="email"
                     disabled={loading}
                     spellCheck={false}
                   />
@@ -361,9 +362,9 @@ const Login = ({ location }) => {
   const validateSignup = useCallback(
     (values) => {
       const errors = validateLogin(values)
-      const regex = /^\w+$/g
+      const regex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/
       if (values.username && !values.username.match(regex)) {
-        errors.username = translate('ra.validation.invalidChars')
+        errors.username = translate('ra.validation.invalidEmail')
       }
       if (!values.confirmPassword) {
         errors.confirmPassword = translate('ra.validation.required')
