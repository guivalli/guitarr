+func (m *MusicBrainz) store(key string, body []byte) {
+	ttl := m.CacheTTL
+	if ttl <= 0 {
+		ttl = 10 * time.Minute
+	}
+	m.cacheMu.Lock()
+	defer m.cacheMu.Unlock()
+	if m.cache == nil || len(m.cache) > 500 {
+		m.cache = map[string]cacheEntry{}
+	}
+	m.cache[key] = cacheEntry{body: body, exp: time.Now().Add(ttl)}
+}
