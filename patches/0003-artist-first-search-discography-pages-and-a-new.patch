+import { useCallback, useEffect, useState } from 'react'
+
+// Responses are kept for the session, so going back to a page is instant.
+const cache = new Map()
+
+// useCatalog loads key with fetcher, exposing {data, loading, error, retry}.
+// A null key loads nothing.
+export const useCatalog = (key, fetcher) => {
+  const [state, setState] = useState(() => ({
+    data: key ? cache.get(key) || null : null,
+    loading: !!key && !cache.has(key),
+    error: null,
+  }))
+  const [attempt, setAttempt] = useState(0)
+
+  useEffect(() => {
+    if (!key) {
+      setState({ data: null, loading: false, error: null })
+      return
+    }
+    if (cache.has(key)) {
+      setState({ data: cache.get(key), loading: false, error: null })
+      return
+    }
+    let cancelled = false
+    setState((s) => ({ data: s.data, loading: true, error: null }))
+    fetcher()
+      .then((data) => {
+        cache.set(key, data)
+        if (!cancelled) setState({ data, loading: false, error: null })
+      })
+      .catch((error) => {
+        if (!cancelled) setState({ data: null, loading: false, error })
+      })
+    return () => {
+      cancelled = true
+    }
+    // fetcher is derived from key
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, [key, attempt])
+
+  const retry = useCallback(() => {
+    cache.delete(key)
+    setAttempt((a) => a + 1)
+  }, [key])
+
+  return { ...state, retry }
+}
+
+// forget drops cached responses (after a request, library flags may change).
+export const forget = () => cache.clear()
