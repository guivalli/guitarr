--- /dev/null
+++ b/ui/src/seer/SearchView.jsx
@@ -0,0 +1,262 @@
+import { ButtonBase, Typography } from '@material-ui/core'
+import { makeStyles } from '@material-ui/core/styles'
+import { useTranslate } from 'react-admin'
+import { ItemAction } from './actions'
+import { ArtistAvatar, Cover } from './artwork'
+import {
+  AlbumCard,
+  ArtistCard,
+  Grid,
+  GridSkeleton,
+  Section,
+  Shimmer,
+  TrackRow,
+  useNav,
+  useTypeLabel,
+} from './components'
+import { ErrorState } from './states'
+
+const fold = (s = '') =>
+  s
+    .normalize('NFD')
+    .toLowerCase()
+    .replace(/[^\p{L}\p{N}]/gu, '')
+
+// pickTop chooses the "best result": the artist whose name was typed, else the first album or track.
+export const pickTop = (items, query) =>
+  items.find((i) => i.kind === 'artist' && fold(i.title) === fold(query)) ||
+  items.find((i) => i.kind === 'album') ||
+  items.find((i) => i.kind === 'track') ||
+  items[0]
+
+const useStyles = makeStyles((theme) => {
+  const dark = theme.palette.type === 'dark'
+  return {
+    topRow: {
+      display: 'grid',
+      gridTemplateColumns: 'minmax(0, 5fr) minmax(0, 7fr)',
+      gap: theme.spacing(3),
+      [theme.breakpoints.down('sm')]: { gridTemplateColumns: 'minmax(0, 1fr)' },
+    },
+    top: {
+      display: 'flex',
+      flexDirection: 'column',
+      alignItems: 'flex-start',
+      textAlign: 'left',
+      width: '100%',
+      boxSizing: 'border-box',
+      minHeight: 236,
+      padding: theme.spacing(2.5),
+      borderRadius: 14,
+      position: 'relative',
+      overflow: 'hidden',
+      background: dark ? 'rgba(255,255,255,0.05)' : 'rgba(0,0,0,0.035)',
+      transition: 'background 200ms ease',
+      '&:hover': {
+        background: dark ? 'rgba(255,255,255,0.1)' : 'rgba(0,0,0,0.07)',
+      },
+      '&:hover $topAction': { opacity: 1, transform: 'translateY(0)' },
+    },
+    glow: {
+      position: 'absolute',
+      inset: 0,
+      opacity: dark ? 0.22 : 0.14,
+      pointerEvents: 'none',
+    },
+    topTitle: {
+      fontSize: 32,
+      fontWeight: 900,
+      letterSpacing: '-0.03em',
+      lineHeight: 1.1,
+      marginTop: theme.spacing(2.5),
+      display: '-webkit-box',
+      WebkitLineClamp: 2,
+      WebkitBoxOrient: 'vertical',
+      overflow: 'hidden',
+    },
+    topSub: {
+      marginTop: theme.spacing(1),
+      display: 'flex',
+      alignItems: 'center',
+      gap: theme.spacing(1),
+      color: theme.palette.text.secondary,
+      fontSize: 14,
+      flexWrap: 'wrap',
+    },
+    badge: {
+      fontSize: 11,
+      fontWeight: 800,
+      textTransform: 'uppercase',
+      letterSpacing: '0.08em',
+      padding: '4px 10px',
+      borderRadius: 999,
+      background: dark ? 'rgba(0,0,0,0.4)' : 'rgba(255,255,255,0.8)',
+      color: theme.palette.text.primary,
+    },
+    topAction: {
+      position: 'absolute',
+      right: theme.spacing(2.5),
+      bottom: theme.spacing(2.5),
+      opacity: 0,
+      transform: 'translateY(8px)',
+      transition: 'opacity 200ms ease, transform 200ms ease',
+      '@media (hover: none)': { opacity: 1, transform: 'none' },
+    },
+    songs: { display: 'flex', flexDirection: 'column', gap: 2 },
+  }
+})
+
+const TopResult = ({ item }) => {
+  const classes = useStyles()
+  const translate = useTranslate()
+  const nav = useNav()
+  const typeLabel = useTypeLabel()
+  const isArtist = item.kind === 'artist'
+  const open = () =>
+    isArtist ? nav.artist(item.mbid) : nav.album(item.coverId || item.mbid)
+  return (
+    <ButtonBase
+      component="div"
+      className={classes.top}
+      onClick={open}
+      focusRipple
+    >
+      {isArtist ? (
+        <ArtistAvatar
+          name={item.title}
+          seed={item.mbid}
+          size={104}
+          style={{ boxShadow: '0 10px 30px rgba(0,0,0,0.4)' }}
+        />
+      ) : (
+        <Cover
+          id={item.coverId || item.mbid}
+          seed={item.album || item.title}
+          radius={8}
+          style={{
+            width: 104,
+            height: 104,
+            boxShadow: '0 10px 30px rgba(0,0,0,0.4)',
+          }}
+        />
+      )}
+      <div className={classes.topTitle}>{item.title}</div>
+      <div className={classes.topSub}>
+        <span className={classes.badge}>
+          {translate(`resources.seer.kind.${item.kind}`)}
+        </span>
+        <span>
+          {isArtist
+            ? [typeLabel(item.type), item.country, item.disambiguation]
+                .filter(Boolean)
+                .join(' · ')
+            : [item.artist, item.year].filter(Boolean).join(' · ')}
+        </span>
+      </div>
+      {!isArtist && (
+        <div className={classes.topAction}>
+          <ItemAction item={item} variant="fab" />
+        </div>
+      )}
+    </ButtonBase>
+  )
+}
+
+export const SearchSkeleton = () => {
+  const classes = useStyles()
+  return (
+    <>
+      <div className={classes.topRow} style={{ marginTop: 32 }}>
+        <Shimmer height={236} />
+        <div className={classes.songs}>
+          {[0, 1, 2, 3].map((i) => (
+            <div
+              key={i}
+              style={{
+                display: 'flex',
+                gap: 16,
+                padding: '8px 12px',
+                alignItems: 'center',
+              }}
+            >
+              <Shimmer width={44} height={44} />
+              <div style={{ flex: 1 }}>
+                <Shimmer width="55%" height={14} style={{ marginBottom: 8 }} />
+                <Shimmer width="30%" height={12} />
+              </div>
+            </div>
+          ))}
+        </div>
+      </div>
+      <div style={{ height: 40 }} />
+      <GridSkeleton count={6} />
+    </>
+  )
+}
+
+export const SearchView = ({ query, results, loading, error, onRetry }) => {
+  const classes = useStyles()
+  const translate = useTranslate()
+  if (loading && !results) return <SearchSkeleton />
+  if (error) return <ErrorState onRetry={onRetry} />
+  if (!results) return null
+  if (results.length === 0) {
+    return (
+      <Typography
+        variant="h6"
+        style={{ marginTop: 48, textAlign: 'center', opacity: 0.7 }}
+      >
+        {translate('resources.seer.message.noResults', { query })}
+      </Typography>
+    )
+  }
+  const top = pickTop(results, query)
+  const artists = results.filter((i) => i.kind === 'artist')
+  const albums = results.filter((i) => i.kind === 'album')
+  const tracks = results.filter((i) => i.kind === 'track')
+  const firstTracks = tracks.slice(0, 4)
+  const moreTracks = tracks.slice(4)
+  return (
+    <div style={{ opacity: loading ? 0.5 : 1, transition: 'opacity 200ms' }}>
+      <div className={classes.topRow}>
+        <Section title={translate('resources.seer.sections.topResult')}>
+          <TopResult item={top} />
+        </Section>
+        {firstTracks.length > 0 && (
+          <Section title={translate('resources.seer.sections.songs')}>
+            <div className={classes.songs}>
+              {firstTracks.map((t) => (
+                <TrackRow key={t.mbid} item={t} showAlbum={false} />
+              ))}
+            </div>
+          </Section>
+        )}
+      </div>
+      {artists.length > 0 && (
+        <Section title={translate('resources.seer.sections.artists')}>
+          <Grid>
+            {artists.map((a) => (
+              <ArtistCard key={a.mbid} item={a} />
+            ))}
+          </Grid>
+        </Section>
+      )}
+      {albums.length > 0 && (
+        <Section title={translate('resources.seer.sections.albums')}>
+          <Grid>
+            {albums.map((a) => (
+              <AlbumCard key={a.mbid} item={a} />
+            ))}
+          </Grid>
+        </Section>
+      )}
+      {moreTracks.length > 0 && (
+        <Section title={translate('resources.seer.sections.moreSongs')}>
+          {moreTracks.map((t) => (
+            <TrackRow key={t.mbid} item={t} />
+          ))}
+        </Section>
+      )}
+    </div>
+  )
+}
