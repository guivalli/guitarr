+// item picks the release that best represents the recording: an official
+// studio album if there is one, so the cover and album name are the familiar ones.
+func (r mbRecording) item() (CatalogItem, bool) {
+	if len(r.Releases) == 0 || r.Video {
+		return CatalogItem{}, false
+	}
+	best, bestRank := 0, 99
+	for i, rel := range r.Releases {
+		rank := 0
+		if rel.Status != "" && rel.Status != "Official" {
+			rank += 4
+		}
+		if len(rel.ReleaseGroup.SecondaryTypes) > 0 {
+			rank += 2 // compilation, live...
+		}
+		if rel.ReleaseGroup.PrimaryType != "Album" {
+			rank++
+		}
+		if rank < bestRank || (rank == bestRank && rel.Date != "" && (r.Releases[best].Date == "" || rel.Date < r.Releases[best].Date)) {
+			best, bestRank = i, rank
+		}
+	}
+	rel := r.Releases[best]
+	return CatalogItem{
+		Kind: KindTrack, MBID: r.ID, Artist: r.ArtistCredit.String(), ArtistMBID: r.ArtistCredit.firstID(),
+		Title: r.Title, DurationMs: r.Length, Album: rel.Title, Year: yearOf(rel.Date), CoverID: rel.ReleaseGroup.ID,
+	}, true
