+import { ButtonBase, Typography } from '@material-ui/core'
+import { makeStyles } from '@material-ui/core/styles'
+import { useTranslate } from 'react-admin'
+import { useHistory } from 'react-router-dom'
+import { ItemAction } from './actions'
+import { ArtistAvatar, Cover } from './artwork'
+
+export const formatDuration = (ms) => {
+  if (!ms) return ''
+  const s = Math.round(ms / 1000)
+  const h = Math.floor(s / 3600)
+  const m = Math.floor((s % 3600) / 60)
+  const ss = String(s % 60).padStart(2, '0')
+  return h ? `${h}:${String(m).padStart(2, '0')}:${ss}` : `${m}:${ss}`
+}
+
+// useTypeLabel translates MusicBrainz types ("Album + Live", "Group"...).
+export const useTypeLabel = () => {
+  const translate = useTranslate()
+  return (type) =>
+    (type || '')
+      .split(' + ')
+      .filter(Boolean)
+      .map((t) =>
+        translate(`resources.seer.types.${t.replace(/[^A-Za-z]/g, '')}`, {
+          _: t,
+        }),
+      )
+      .join(' · ')
+}
+
+export const useNav = () => {
+  const history = useHistory()
+  return {
+    artist: (mbid) => mbid && history.push(`/seer?artist=${mbid}`),
+    album: (mbid) => mbid && history.push(`/seer?album=${mbid}`),
+    back: () => (history.length > 1 ? history.goBack() : history.push('/seer')),
+  }
