+import { ButtonBase, Typography } from '@material-ui/core'
+import { makeStyles } from '@material-ui/core/styles'
+import { usePermissions, useTranslate } from 'react-admin'
+import { Cover } from './artwork'
+import { useNav } from './components'
+import { StatusChip } from './StatusChip'
+
+const useStyles = makeStyles((theme) => {
+  const dark = theme.palette.type === 'dark'
+  return {
+    list: { display: 'flex', flexDirection: 'column', gap: 4 },
+    row: {
+      display: 'grid',
+      gridTemplateColumns: '52px minmax(0, 1fr) auto auto',
+      alignItems: 'center',
+      gap: theme.spacing(2),
+      padding: '8px 12px',
+      borderRadius: 10,
+      transition: 'background 150ms ease',
+      '&:hover': {
+        background: dark ? 'rgba(255,255,255,0.07)' : 'rgba(0,0,0,0.05)',
+      },
+      [theme.breakpoints.down('xs')]: {
+        gridTemplateColumns: '44px minmax(0, 1fr) auto',
+        gap: theme.spacing(1.5),
+      },
+    },
+    cover: {
+      width: 52,
+      height: 52,
+      cursor: 'pointer',
+      fontSize: 10,
+      [theme.breakpoints.down('xs')]: { width: 44, height: 44 },
+    },
+    title: {
+      fontSize: 15,
+      fontWeight: 600,
+      overflow: 'hidden',
+      textOverflow: 'ellipsis',
+      whiteSpace: 'nowrap',
+    },
+    sub: {
+      fontSize: 13,
+      color: theme.palette.text.secondary,
+      overflow: 'hidden',
+      textOverflow: 'ellipsis',
+      whiteSpace: 'nowrap',
+    },
+    error: {
+      fontSize: 12,
+      color: '#ff5c7a',
+      overflow: 'hidden',
+      textOverflow: 'ellipsis',
+      whiteSpace: 'nowrap',
+    },
+    when: {
+      fontSize: 13,
+      color: theme.palette.text.secondary,
+      whiteSpace: 'nowrap',
+      [theme.breakpoints.down('xs')]: { display: 'none' },
+    },
+    side: {
+      display: 'flex',
+      alignItems: 'center',
+      gap: theme.spacing(1),
+      justifyContent: 'flex-end',
+    },
+    admin: {
+      borderRadius: 999,
+      padding: '5px 14px',
+      fontSize: 12,
+      fontWeight: 700,
+      border: `1px solid ${theme.palette.divider}`,
+      '&:hover': { borderColor: theme.palette.text.primary },
+    },
+    empty: {
+      color: theme.palette.text.secondary,
+      padding: theme.spacing(2, 1),
+    },
+  }
+})
+
+const relative = (iso, locale) => {
+  const diff = (new Date(iso).getTime() - Date.now()) / 1000
+  const rtf = new Intl.RelativeTimeFormat(locale, { numeric: 'auto' })
+  const steps = [
+    [60, 'second'],
+    [3600, 'minute'],
+    [86400, 'hour'],
+    [604800, 'day'],
+    [2629800, 'week'],
+    [31557600, 'month'],
+  ]
+  for (const [limit, unit] of steps) {
+    if (Math.abs(diff) < limit) {
+      const div = {
+        second: 1,
+        minute: 60,
+        hour: 3600,
+        day: 86400,
+        week: 604800,
+        month: 2629800,
+      }[unit]
+      return rtf.format(Math.round(diff / div), unit)
+    }
+  }
+  return new Date(iso).toLocaleDateString(locale)
+}
+
+export const RequestsList = ({ requests, onApprove }) => {
+  const classes = useStyles()
+  const translate = useTranslate()
+  const nav = useNav()
+  const { permissions } = usePermissions()
+  const isAdmin = permissions === 'admin'
+  const locale = document.documentElement.lang || undefined
+
+  if (requests.length === 0) {
+    return (
+      <Typography className={classes.empty}>
+        {translate('resources.seer.message.noRequests')}
+      </Typography>
+    )
+  }
+  return (
+    <div className={classes.list}>
+      {requests.map((r) => {
+        const target = r.kind === 'album' ? r.mbid : r.coverId
+        return (
+          <div key={r.id} className={classes.row}>
+            <Cover
+              id={r.coverId || (r.kind === 'album' ? r.mbid : null)}
+              seed={r.album || r.title}
+              radius={6}
+              className={classes.cover}
+              style={{}}
+            />
+            <div style={{ minWidth: 0 }} onClick={() => nav.album(target)}>
+              <div className={classes.title} title={r.title}>
+                {r.title}
+              </div>
+              <div className={classes.sub}>
+                {[
+                  translate(`resources.seer.kind.${r.kind}`),
+                  r.artist,
+                  r.kind === 'track' ? r.album : null,
+                  r.source,
+                ]
+                  .filter(Boolean)
+                  .join(' · ')}
+              </div>
+              {r.status === 'failed' && r.error && (
+                <div className={classes.error} title={r.error}>
+                  {r.error}
+                </div>
+              )}
+            </div>
+            <span className={classes.when}>
+              {relative(r.createdAt, locale)}
+            </span>
+            <div className={classes.side}>
+              <StatusChip status={r.status} error={r.error} />
+              {isAdmin && (r.status === 'pending' || r.status === 'failed') && (
+                <ButtonBase
+                  className={classes.admin}
+                  onClick={() => onApprove(r)}
+                >
+                  {translate(
+                    r.status === 'pending'
+                      ? 'resources.seer.actions.approve'
+                      : 'resources.seer.actions.retry',
+                  )}
+                </ButtonBase>
+              )}
+            </div>
+          </div>
+        )
+      })}
+    </div>
+  )
+}
