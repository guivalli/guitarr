+// TrackRow: "#/cover | title + artist | album | duration | action".
+export const TrackRow = ({
+  item,
+  index,
+  showCover = true,
+  showAlbum = true,
+}) => {
+  const classes = useStyles()
+  const nav = useNav()
+  const lead = showCover ? '44px' : '28px'
+  const cols = `${lead} minmax(0, 1fr) ${showAlbum ? 'minmax(0, 0.8fr)' : ''} 52px 120px`
+  const colsXs = `${lead} minmax(0, 1fr) auto`
+  return (
+    <div
+      className={classes.row}
+      style={{ '--cols': cols, '--cols-xs': colsXs }}
+    >
+      {showCover ? (
+        <Cover
+          id={item.coverId}
+          seed={item.album || item.title}
+          size={44}
+          radius={4}
+          style={{ width: 44, height: 44, fontSize: 9 }}
+        />
+      ) : (
+        <span className={classes.num}>{index}</span>
+      )}
+      <div style={{ minWidth: 0 }}>
+        <div className={classes.rowTitle} title={item.title}>
+          {item.inLibrary && <span className={classes.ownedDot} />}
+          {item.title}
+        </div>
+        <div className={classes.rowSub}>
+          <span
+            className={item.artistMbid ? classes.link : undefined}
+            onClick={() => nav.artist(item.artistMbid)}
+          >
+            {item.artist}
+          </span>
+        </div>
+      </div>
+      {showAlbum && (
+        <div className={`${classes.rowSub} ${classes.hideXs}`}>
+          <span
+            className={item.coverId ? classes.link : undefined}
+            onClick={() => nav.album(item.coverId)}
+          >
+            {item.album}
+          </span>
+        </div>
+      )}
+      <span className={`${classes.duration} ${classes.hideXs}`}>
+        {formatDuration(item.durationMs)}
+      </span>
+      <div style={{ display: 'flex', justifyContent: 'flex-end' }}>
+        <ItemAction item={item} variant="icon" />
+      </div>
+    </div>
+  )
+}
+
+export const Shimmer = ({ width = '100%', height = 16, style, round }) => {
+  const classes = useStyles()
+  return (
+    <div
+      className={classes.shimmer}
+      style={{
+        width,
+        height,
+        borderRadius: round ? '50%' : undefined,
+        ...style,
+      }}
+    />
+  )
+}
+
+export const GridSkeleton = ({ count = 6, round }) => (
+  <Grid>
+    {Array.from({ length: count }).map((_, i) => (
+      <div key={i} style={{ padding: 12 }}>
+        <Shimmer
+          height="auto"
+          round={round}
+          style={{ aspectRatio: '1 / 1', marginBottom: 12 }}
+        />
+        <Shimmer width="80%" height={14} style={{ marginBottom: 8 }} />
+        <Shimmer width="50%" height={12} />
+      </div>
+    ))}
+  </Grid>
+)
