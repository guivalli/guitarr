+// matches reports whether the user typed this artist's name (or one of its aliases).
+func (a mbArtist) matches(query string) bool {
+	q := fold(query)
+	if q == "" {
+		return false
+	}
+	if fold(a.Name) == q {
+		return true
+	}
+	for _, al := range a.Aliases {
+		if fold(al.Name) == q {
+			return true
+		}
+	}
+	return false
