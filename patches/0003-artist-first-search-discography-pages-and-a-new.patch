+		}
+		q := url.Values{"artist": {a.ID}, "type": {"album|ep"}, "limit": {"100"}, "offset": {strconv.Itoa(offset)}}
+		if err := m.get(ctx, "/release-group", q, &page); err != nil {
+			if len(all) > 0 {
+				break
+			}
+			return nil, err
+		}
+		all = append(all, page.ReleaseGroups...)
+		if len(all) >= page.Count || len(page.ReleaseGroups) == 0 {
+			break
+		}
+	}
+	sort.SliceStable(all, func(i, j int) bool {
+		si, sj := len(all[i].SecondaryTypes) > 0, len(all[j].SecondaryTypes) > 0
+		if si != sj {
+			return !si
+		}
+		ai, aj := all[i].PrimaryType == "Album", all[j].PrimaryType == "Album"
+		if ai != aj {
+			return ai
+		}
+		di, dj := all[i].FirstRelease, all[j].FirstRelease
+		if (di == "") != (dj == "") {
+			return di != ""
+		}
+		return di < dj
+	})
+	out := make([]CatalogItem, 0, len(all))
+	for _, rg := range all {
+		out = append(out, rg.item(a.Name, a.ID))
+	}
+	return out, nil
+}
+
+// Artist returns an artist and its discography.
+func (m *MusicBrainz) Artist(ctx context.Context, mbid string) (*ArtistDetail, error) {
+	if !ValidMBID(mbid) {
+		return nil, ErrNotFound
+	}
+	var a mbArtist
+	if err := m.get(ctx, "/artist/"+mbid, url.Values{}, &a); err != nil {
+		return nil, err
+	}
+	albums, err := m.artistAlbums(ctx, a)
+	if err != nil {
+		return nil, err
+	}
+	return &ArtistDetail{Artist: a.item(), Albums: albums}, nil
+}
+
+// Album returns an album (release group) with the tracklist of its most
+// representative release: official, fewest discs, earliest.
+func (m *MusicBrainz) Album(ctx context.Context, mbid string) (*AlbumDetail, error) {
+	if !ValidMBID(mbid) {
+		return nil, ErrNotFound
+	}
+	var rg mbReleaseGroup
+	if err := m.get(ctx, "/release-group/"+mbid, url.Values{"inc": {"artist-credits"}}, &rg); err != nil {
+		return nil, err
+	}
+	var rels struct {
+		Releases []struct {
+			Status string `json:"status"`
+			Date   string `json:"date"`
+			Media  []struct {
+				Tracks []struct {
+					Position  int    `json:"position"`
+					Title     string `json:"title"`
+					Length    int    `json:"length"`
+					Recording struct {
+						ID           string         `json:"id"`
+						Title        string         `json:"title"`
+						Length       int            `json:"length"`
+						ArtistCredit mbArtistCredit `json:"artist-credit"`
+					} `json:"recording"`
+				} `json:"tracks"`
+			} `json:"media"`
+		} `json:"releases"`
+	}
+	q := url.Values{"release-group": {mbid}, "inc": {"recordings+artist-credits"}, "limit": {"25"}}
+	if err := m.get(ctx, "/release", q, &rels); err != nil {
+		return nil, err
+	}
+	album := rg.item("", "")
+	detail := &AlbumDetail{Album: album, Tracks: []CatalogItem{}}
+	best, bestRank := -1, [3]int{}
+	for i, rel := range rels.Releases {
+		n := 0
+		for _, md := range rel.Media {
+			n += len(md.Tracks)
+		}
+		if n == 0 {
+			continue
+		}
+		official := 1
+		if rel.Status == "Official" {
+			official = 0
+		}
+		date, _ := strconv.Atoi(strings.ReplaceAll((rel.Date + "9999-99-99")[:10], "-", ""))
+		rank := [3]int{official, len(rel.Media), date}
+		if best < 0 || rank[0] < bestRank[0] || (rank[0] == bestRank[0] && (rank[1] < bestRank[1] || (rank[1] == bestRank[1] && rank[2] < bestRank[2]))) {
+			best, bestRank = i, rank
+		}
+	}
+	if best < 0 {
+		return detail, nil
+	}
+	num := 0
+	for _, md := range rels.Releases[best].Media {
+		for _, t := range md.Tracks {
+			num++
+			title, length := t.Recording.Title, t.Recording.Length
+			if title == "" {
+				title = t.Title
+			}
+			if length == 0 {
+				length = t.Length
+			}
+			artist, artistID := t.Recording.ArtistCredit.String(), t.Recording.ArtistCredit.firstID()
+			if artist == "" {
+				artist, artistID = album.Artist, album.ArtistMBID
+			}
+			detail.Tracks = append(detail.Tracks, CatalogItem{
+				Kind: KindTrack, MBID: t.Recording.ID, Artist: artist, ArtistMBID: artistID,
+				Album: album.Title, Title: title, Year: album.Year, DurationMs: length,
+				CoverID: album.MBID, TrackNumber: num,
+			})
+		}
+	}
+	return detail, nil
+}
