@@ -0,0 +1,222 @@
+import { createContext, useContext, useState } from 'react'
+import {
+  ButtonBase,
+  CircularProgress,
+  IconButton,
+  Tooltip,
+} from '@material-ui/core'
+import { makeStyles } from '@material-ui/core/styles'
+import AddIcon from '@material-ui/icons/Add'
+import CheckCircleIcon from '@material-ui/icons/CheckCircle'
+import PlayArrowIcon from '@material-ui/icons/PlayArrow'
+import { useDataProvider, useNotify, useTranslate } from 'react-admin'
+import { useDispatch } from 'react-redux'
+import { useHistory } from 'react-router-dom'
+import { playTracks } from '../actions'
+import { StatusChip } from './StatusChip'
+
+// SeerContext shares the user's requests and the request action with every view.
+export const SeerContext = createContext({ requests: [], request: () => {} })
+export const useSeer = () => useContext(SeerContext)
+
+export const findRequest = (requests, item) =>
+  requests.find(
+    (r) =>
+      r.kind === item.kind && r.mbid === item.mbid && r.status !== 'failed',
+  )
+
+export const GREEN = '#1ed760'
+
+const useStyles = makeStyles((theme) => ({
+  fab: {
+    width: 48,
+    height: 48,
+    borderRadius: '50%',
+    background: GREEN,
+    color: '#000',
+    boxShadow: '0 8px 18px rgba(0,0,0,0.35)',
+    transition: 'transform 150ms ease, background 150ms ease',
+    '&:hover': { transform: 'scale(1.06)', background: '#3be477' },
+    '& svg': { fontSize: 28 },
+  },
+  fabLarge: {
+    width: 56,
+    height: 56,
+    '& svg': { fontSize: 32 },
+  },
+  pill: {
+    borderRadius: 999,
+    padding: '6px 16px',
+    fontSize: 13,
+    fontWeight: 700,
+    letterSpacing: '0.02em',
+    border: `1px solid ${theme.palette.type === 'dark' ? 'rgba(255,255,255,0.35)' : 'rgba(0,0,0,0.3)'}`,
+    color: theme.palette.text.primary,
+    transition: 'all 150ms ease',
+    whiteSpace: 'nowrap',
+    '&:hover': {
+      borderColor: theme.palette.text.primary,
+      transform: 'scale(1.04)',
+    },
+    '& svg': { fontSize: 18, marginRight: 4, marginLeft: -4 },
+  },
+  pillLarge: {
+    padding: '12px 28px',
+    fontSize: 15,
+    background: GREEN,
+    color: '#000',
+    border: 'none',
+    boxShadow: '0 8px 24px rgba(30,215,96,0.25)',
+    '&:hover': { background: '#3be477', transform: 'scale(1.04)' },
+  },
+  owned: {
+    color: GREEN,
+    display: 'inline-flex',
+    alignItems: 'center',
+    gap: 4,
+    fontSize: 12,
+    fontWeight: 600,
+    whiteSpace: 'nowrap',
+  },
+  icon: {
+    color: theme.palette.text.secondary,
+    '&:hover': { color: theme.palette.text.primary },
+  },
+}))
+
+const usePlayOwned = () => {
+  const dataProvider = useDataProvider()
+  const dispatch = useDispatch()
+  const history = useHistory()
+  const notify = useNotify()
+  return (item) => {
+    if (item.kind === 'album') {
+      history.push(`/album/${item.libraryId}/show`)
+    } else if (item.kind === 'artist') {
+      history.push(`/artist/${item.libraryId}/show`)
+    } else {
+      dataProvider
+        .getOne('song', { id: item.libraryId })
+        .then(({ data }) =>
+          dispatch(playTracks({ [data.id]: data }, [data.id])),
+        )
+        .catch(() => notify('ra.page.error', 'warning'))
+    }
+  }
+}
+
+// ItemAction is the call to action of a catalog item: play/open what is in the
+// library, show the status of what was asked for, or offer to request it.
+//   variant "fab":  round green button (cards)
+//   variant "pill": outlined text button (rows); "hero" is the big green one
+//   variant "icon": compact + icon (track rows)
+export const ItemAction = ({
+  item,
+  variant = 'pill',
+  stopPropagation = true,
+}) => {
+  const classes = useStyles()
+  const translate = useTranslate()
+  const { requests, request } = useSeer()
+  const playOwned = usePlayOwned()
+  const [sending, setSending] = useState(false)
+  const req = findRequest(requests, item)
+
+  const wrap = (fn) => (e) => {
+    if (stopPropagation) e.stopPropagation()
+    fn()
+  }
+  const doRequest = wrap(() => {
+    setSending(true)
+    Promise.resolve(request(item)).finally(() => setSending(false))
+  })
+
+  if (item.inLibrary) {
+    const label = translate(
+      item.kind === 'track'
+        ? 'resources.seer.actions.play'
+        : 'resources.seer.actions.open',
+    )
+    if (variant === 'fab' || variant === 'hero') {
+      return (
+        <Tooltip title={label}>
+          <ButtonBase
+            className={`${classes.fab} ${variant === 'hero' ? classes.fabLarge : ''}`}
+            onClick={wrap(() => playOwned(item))}
+            aria-label={label}
+          >
+            <PlayArrowIcon />
+          </ButtonBase>
+        </Tooltip>
+      )
+    }
+    return (
+      <span className={classes.owned}>
+        <CheckCircleIcon style={{ fontSize: 16 }} />
+        {variant === 'pill' && translate('resources.seer.message.inLibrary')}
+        <IconButton
+          size="small"
+          className={classes.icon}
+          onClick={wrap(() => playOwned(item))}
+          aria-label={label}
+        >
+          <PlayArrowIcon fontSize="small" />
+        </IconButton>
+      </span>
+    )
+  }
+
+  if (req) {
+    return <StatusChip status={req.status} error={req.error} />
+  }
+
+  const label = translate(
+    item.kind === 'album' && variant === 'hero'
+      ? 'resources.seer.actions.requestAlbum'
+      : 'resources.seer.actions.request',
+  )
+  if (sending) {
+    return (
+      <CircularProgress
+        size={variant === 'fab' ? 40 : 22}
+        style={{ color: GREEN }}
+      />
+    )
+  }
+  if (variant === 'fab') {
+    return (
+      <Tooltip title={label}>
+        <ButtonBase
+          className={classes.fab}
+          onClick={doRequest}
+          aria-label={label}
+        >
+          <AddIcon />
+        </ButtonBase>
+      </Tooltip>
+    )
+  }
+  if (variant === 'icon') {
+    return (
+      <Tooltip title={label}>
+        <IconButton
+          size="small"
+          className={classes.icon}
+          onClick={doRequest}
+          aria-label={label}
+        >
+          <AddIcon />
+        </IconButton>
+      </Tooltip>
+    )
+  }
+  return (
+    <ButtonBase
+      className={`${classes.pill} ${variant === 'hero' ? classes.pillLarge : ''}`}
+      onClick={doRequest}
+    >
+      <AddIcon />
+      {label}
+    </ButtonBase>
+  )
+}
