+import { useEffect, useState } from 'react'
+import { makeStyles } from '@material-ui/core/styles'
+import MusicNoteIcon from '@material-ui/icons/MusicNote'
+import { coverUrl } from './api'
+
+// hueOf gives every artist/album a stable color, used while covers load and
+// for items that have no cover (MusicBrainz has no artist pictures).
+export const hueOf = (s = '') => {
+  let h = 0
+  for (let i = 0; i < s.length; i++) h = (h * 31 + s.charCodeAt(i)) % 360
+  return h
+}
+
+export const gradientOf = (s) => {
+  const h = hueOf(s)
+  return `linear-gradient(135deg, hsl(${h}, 62%, 52%) 0%, hsl(${(h + 48) % 360}, 58%, 30%) 100%)`
+}
+
+export const initialsOf = (name = '') =>
+  name
+    .replace(/[^\p{L}\p{N}\s]/gu, '')
+    .split(/\s+/)
+    .filter(Boolean)
+    .slice(0, 2)
+    .map((w) => w[0].toUpperCase())
+    .join('') || '?'
+
+const useStyles = makeStyles({
+  cover: {
+    position: 'relative',
+    overflow: 'hidden',
+    flexShrink: 0,
+    display: 'flex',
+    alignItems: 'center',
+    justifyContent: 'center',
+    color: 'rgba(255,255,255,0.85)',
+    '& img': {
+      position: 'absolute',
+      inset: 0,
+      width: '100%',
+      height: '100%',
+      objectFit: 'cover',
+      transition: 'opacity 300ms ease',
+    },
+  },
+  avatar: {
+    borderRadius: '50%',
+    display: 'flex',
+    alignItems: 'center',
+    justifyContent: 'center',
+    color: 'white',
+    fontWeight: 800,
+    letterSpacing: '-0.02em',
+    flexShrink: 0,
+    textShadow: '0 2px 12px rgba(0,0,0,0.25)',
+    userSelect: 'none',
+  },
+})
+
+// Cover shows the Cover Art Archive front image of a release group, over a
+// colored placeholder that stays when there is no image.
+export const Cover = ({
+  id,
+  seed,
+  size = 250,
+  radius = 6,
+  className,
+  style,
+}) => {
+  const classes = useStyles()
+  const [state, setState] = useState('loading')
+  const src = coverUrl(id, size > 250 ? 500 : 250)
+  useEffect(() => setState(src ? 'loading' : 'error'), [src])
+  return (
+    <div
+      className={`${classes.cover} ${className || ''}`}
+      style={{
+        background: gradientOf(seed || id),
+        borderRadius: radius,
+        ...style,
+      }}
+    >
+      {state !== 'loaded' && (
+        <MusicNoteIcon style={{ fontSize: '2.4em', opacity: 0.6 }} />
+      )}
+      {src && state !== 'error' && (
+        <img
+          src={src}
+          alt=""
+          loading="lazy"
+          style={{ opacity: state === 'loaded' ? 1 : 0 }}
+          onLoad={() => setState('loaded')}
+          onError={() => setState('error')}
+        />
+      )}
+    </div>
+  )
+}
+
+export const ArtistAvatar = ({ name, seed, size = 160, className, style }) => {
+  const classes = useStyles()
+  return (
+    <div
+      className={`${classes.avatar} ${className || ''}`}
+      style={{
+        width: size,
+        height: size,
+        fontSize: size * 0.36,
+        background: gradientOf(seed || name),
+        ...style,
+      }}
+    >
+      {initialsOf(name)}
+    </div>
+  )
+}
+
+// useCoverColor samples the average color of a cover for the page header.
+// It falls back to the item's hash color when the image can't be read.
+export const useCoverColor = (id, seed) => {
+  const fallback = `hsl(${hueOf(seed || id || '')}, 50%, 40%)`
+  const [color, setColor] = useState(fallback)
+  useEffect(() => {
+    setColor(fallback)
+    if (!id) return
+    let cancelled = false
+    const img = new Image()
+    img.crossOrigin = 'anonymous'
+    img.onload = () => {
+      try {
+        const c = document.createElement('canvas')
+        c.width = c.height = 16
+        const ctx = c.getContext('2d')
+        ctx.drawImage(img, 0, 0, 16, 16)
+        const d = ctx.getImageData(0, 0, 16, 16).data
+        let r = 0,
+          g = 0,
+          b = 0
+        for (let i = 0; i < d.length; i += 4) {
+          r += d[i]
+          g += d[i + 1]
+          b += d[i + 2]
+        }
+        const n = d.length / 4
+        // darken a little so white text stays readable on light covers
+        const k = 0.8
+        if (!cancelled)
+          setColor(
+            `rgb(${((r / n) * k) | 0}, ${((g / n) * k) | 0}, ${((b / n) * k) | 0})`,
+          )
+      } catch {
+        // tainted canvas (no CORS): keep the fallback
+      }
+    }
+    img.src = coverUrl(id, 250)
+    return () => {
+      cancelled = true
+    }
+  }, [id, fallback])
+  return color
+}
