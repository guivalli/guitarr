new file mode 100644
index 0000000..ca3ca9e
--- /dev/null
+++ b/ui/src/seer/AlbumView.jsx
@@ -0,0 +1,151 @@
+import { Typography } from '@material-ui/core'
+import { makeStyles } from '@material-ui/core/styles'
+import ScheduleIcon from '@material-ui/icons/Schedule'
+import { useTranslate } from 'react-admin'
+import { ItemAction } from './actions'
+import { getAlbum } from './api'
+import { Cover, useCoverColor } from './artwork'
+import {
+  formatDuration,
+  Shimmer,
+  TrackRow,
+  useNav,
+  useTypeLabel,
+} from './components'
+import { ErrorState, Hero } from './states'
+import { useCatalog } from './useCatalog'
+
+const useStyles = makeStyles((theme) => ({
+  cover: {
+    width: 'clamp(160px, 24vw, 240px)',
+    height: 'clamp(160px, 24vw, 240px)',
+    boxShadow: '0 16px 48px rgba(0,0,0,0.55)',
+    fontSize: 40,
+  },
+  artistLink: {
+    fontWeight: 800,
+    cursor: 'pointer',
+    '&:hover': { textDecoration: 'underline' },
+  },
+  head: {
+    display: 'grid',
+    gridTemplateColumns: '28px minmax(0, 1fr) 52px 120px',
+    gap: theme.spacing(2),
+    padding: '0 12px 8px',
+    margin: theme.spacing(2, 0, 1),
+    borderBottom: `1px solid ${theme.palette.divider}`,
+    color: theme.palette.text.secondary,
+    fontSize: 12,
+    fontWeight: 600,
+    textTransform: 'uppercase',
+    letterSpacing: '0.08em',
+    '& > :nth-child(1), & > :nth-child(3)': { textAlign: 'right' },
+    [theme.breakpoints.down('xs')]: { display: 'none' },
+  },
+  hint: {
+    color: theme.palette.text.secondary,
+    fontSize: 13,
+    maxWidth: 520,
+  },
+}))
+
+export const AlbumView = ({ mbid }) => {
+  const classes = useStyles()
+  const translate = useTranslate()
+  const typeLabel = useTypeLabel()
+  const nav = useNav()
+  const { data, loading, error, retry } = useCatalog(`album:${mbid}`, () =>
+    getAlbum(mbid),
+  )
+  const album = data?.album
+  const color = useCoverColor(mbid, album?.title || mbid)
+
+  if (error) return <ErrorState onRetry={retry} />
+  const tracks = data?.tracks || []
+  const total = tracks.reduce((s, t) => s + (t.durationMs || 0), 0)
+  return (
+    <>
+      <Hero
+        color={color}
+        art={
+          <Cover
+            id={mbid}
+            seed={album?.title || mbid}
+            size={500}
+            radius={8}
+            className={classes.cover}
+          />
+        }
+        label={
+          album
+            ? typeLabel(album.type) || translate('resources.seer.kind.album')
+            : translate('resources.seer.kind.album')
+        }
+        title={
+          album ? (
+            album.title
+          ) : (
+            <Shimmer width="60%" height={72} style={{ opacity: 0.5 }} />
+          )
+        }
+        meta={
+          album && [
+            <span
+              key="a"
+              className={classes.artistLink}
+              onClick={() => nav.artist(album.artistMbid)}
+            >
+              {album.artist}
+            </span>,
+            album.year,
+            tracks.length > 0 &&
+              translate('resources.seer.message.trackCount', {
+                smart_count: tracks.length,
+              }),
+            total > 0 && formatDuration(total),
+          ]
+        }
+      >
+        {album && <ItemAction item={album} variant="hero" />}
+        {album && !album.inLibrary && (
+          <span className={classes.hint}>
+            {translate('resources.seer.message.albumHint')}
+          </span>
+        )}
+      </Hero>
+      {loading ? (
+        [0, 1, 2, 3, 4, 5].map((i) => (
+          <Shimmer key={i} height={44} style={{ margin: '12px 0' }} />
+        ))
+      ) : tracks.length === 0 ? (
+        <Typography
+          variant="body2"
+          color="textSecondary"
+          style={{ marginTop: 24 }}
+        >
+          {translate('resources.seer.message.noTracks')}
+        </Typography>
+      ) : (
+        <>
+          <div className={classes.head}>
+            <span>#</span>
+            <span>{translate('resources.seer.fields.title')}</span>
+            <span>
+              <ScheduleIcon style={{ fontSize: 16, verticalAlign: 'middle' }} />
+            </span>
+            <span />
+          </div>
+          {tracks.map((t) => (
+            <TrackRow
+              key={`${t.trackNumber}-${t.mbid}`}
+              item={t}
+              index={t.trackNumber}
+              showCover={false}
+              showAlbum={false}
+            />
+          ))}
+        </>
+      )}
+    </>
+  )
+}
diff --git a/ui/src/seer/ArtistView.jsx b/ui/src/seer/ArtistView.jsx
new file mode 100644
index 0000000..b85b8ec
--- /dev/null
+++ b/ui/src/seer/ArtistView.jsx
@@ -0,0 +1,144 @@
+import { useMemo, useState } from 'react'
+import { ButtonBase } from '@material-ui/core'
+import { makeStyles } from '@material-ui/core/styles'
+import { useTranslate } from 'react-admin'
+import { ItemAction } from './actions'
+import { getArtist } from './api'
+import { ArtistAvatar, hueOf } from './artwork'
+import {
+  AlbumCard,
+  Grid,
+  GridSkeleton,
+  Section,
+  Shimmer,
+  useTypeLabel,
+} from './components'
+import { ErrorState, Hero } from './states'
+import { useCatalog } from './useCatalog'
+
+const filters = {
+  all: () => true,
+  albums: (a) => a.type === 'Album',
+  eps: (a) => a.type === 'EP',
+  other: (a) => a.type !== 'Album' && a.type !== 'EP',
+}
+
+const useStyles = makeStyles((theme) => {
+  const dark = theme.palette.type === 'dark'
+  return {
+    avatar: {
+      boxShadow: '0 16px 48px rgba(0,0,0,0.5)',
+      width: 'clamp(140px, 22vw, 232px) !important',
+      height: 'clamp(140px, 22vw, 232px) !important',
+      fontSize: 'clamp(48px, 8vw, 84px) !important',
+    },
+    chips: { display: 'flex', gap: theme.spacing(1), flexWrap: 'wrap' },
+    chip: {
+      borderRadius: 999,
+      padding: '6px 14px',
+      fontSize: 13,
+      fontWeight: 600,
+      background: dark ? 'rgba(255,255,255,0.08)' : 'rgba(0,0,0,0.06)',
+      color: theme.palette.text.primary,
+      transition: 'background 150ms ease',
+      '&:hover': {
+        background: dark ? 'rgba(255,255,255,0.14)' : 'rgba(0,0,0,0.1)',
+      },
+    },
+    chipOn: {
+      background: `${theme.palette.text.primary} !important`,
+      color: theme.palette.background.default,
+    },
+  }
+})
+
+export const ArtistView = ({ mbid }) => {
+  const classes = useStyles()
+  const translate = useTranslate()
+  const typeLabel = useTypeLabel()
+  const [filter, setFilter] = useState('all')
+  const { data, loading, error, retry } = useCatalog(`artist:${mbid}`, () =>
+    getArtist(mbid),
+  )
+  const albums = useMemo(() => data?.albums || [], [data])
+  const counts = useMemo(
+    () =>
+      Object.fromEntries(
+        Object.entries(filters).map(([k, f]) => [k, albums.filter(f).length]),
+      ),
+    [albums],
+  )
+
+  if (error) return <ErrorState onRetry={retry} />
+  const artist = data?.artist
+  const color = `hsl(${hueOf(mbid)}, 48%, 36%)`
+  const owned = albums.filter((a) => a.inLibrary).length
+  return (
+    <>
+      <Hero
+        color={color}
+        art={
+          <ArtistAvatar
+            name={artist?.title || ''}
+            seed={mbid}
+            className={classes.avatar}
+          />
+        }
+        label={translate('resources.seer.kind.artist')}
+        title={
+          artist ? (
+            artist.title
+          ) : (
+            <Shimmer width="60%" height={72} style={{ opacity: 0.5 }} />
+          )
+        }
+        meta={
+          artist && [
+            typeLabel(artist.type),
+            artist.country,
+            artist.disambiguation,
+            translate('resources.seer.message.albumCount', {
+              smart_count: albums.length,
+            }),
+            owned > 0 &&
+              translate('resources.seer.message.ownedCount', {
+                smart_count: owned,
+              }),
+          ]
+        }
+      >
+        {artist?.inLibrary && <ItemAction item={artist} variant="hero" />}
+      </Hero>
+      <Section
+        title={translate('resources.seer.sections.discography')}
+        action={
+          !loading && (
+            <div className={classes.chips}>
+              {Object.keys(filters)
+                .filter((k) => k === 'all' || counts[k] > 0)
+                .map((k) => (
+                  <ButtonBase
+                    key={k}
+                    className={`${classes.chip} ${filter === k ? classes.chipOn : ''}`}
+                    onClick={() => setFilter(k)}
+                  >
+                    {translate(`resources.seer.filters.${k}`)} · {counts[k]}
+                  </ButtonBase>
+                ))}
+            </div>
+          )
+        }
+      >
+        {loading ? (
+          <GridSkeleton count={10} />
+        ) : (
+          <Grid>
+            {albums.filter(filters[filter]).map((a) => (
+              <AlbumCard key={a.mbid} item={a} showArtist={false} />
+            ))}
+          </Grid>
+        )}
+      </Section>
+    </>
+  )
+}
