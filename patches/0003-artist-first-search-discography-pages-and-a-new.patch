+package acquire
+
+import (
+	"context"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"sync/atomic"
+	"testing"
+)
+
+const (
+	cbjr  = "11111111-1111-1111-1111-111111111111"
+	other = "22222222-2222-2222-2222-222222222222"
+	rg1   = "33333333-3333-3333-3333-333333333333"
+	rg2   = "44444444-4444-4444-4444-444444444444"
+)
+
+func fakeMB(t *testing.T, busy int32) (*MusicBrainz, *atomic.Int32) {
+	var calls atomic.Int32
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		n := calls.Add(1)
+		if n <= busy {
+			w.WriteHeader(http.StatusServiceUnavailable)
+			return
+		}
+		q := r.URL.Query()
+		switch {
+		case r.URL.Path == "/artist" && q.Get("dismax") == "true":
+			_, _ = w.Write([]byte(`{"artists":[
+				{"id":"` + other + `","name":"Charlie Brown","score":100},
+				{"id":"` + cbjr + `","name":"Charlie Brown Jr.","type":"Group","country":"BR","score":98}]}`))
+		case r.URL.Path == "/artist/"+cbjr:
+			_, _ = w.Write([]byte(`{"id":"` + cbjr + `","name":"Charlie Brown Jr.","type":"Group"}`))
+		case r.URL.Path == "/release-group" && q.Get("artist") == cbjr:
+			_, _ = w.Write([]byte(`{"release-group-count":2,"release-groups":[
+				{"id":"` + rg2 + `","title":"Acústico MTV","primary-type":"Album","secondary-types":["Live"],"first-release-date":"2003"},
+				{"id":"` + rg1 + `","title":"Transpiração Contínua Prolongada","primary-type":"Album","first-release-date":"1997-01-01"}]}`))
+		case r.URL.Path == "/recording" && strings.HasPrefix(q.Get("query"), "arid:"+cbjr):
+			_, _ = w.Write([]byte(`{"recordings":[
+				{"id":"r1","title":"Zóio de Lula","artist-credit":[{"name":"Charlie Brown Jr.","artist":{"id":"` + cbjr + `"}}],
+				 "releases":[{"title":"Hits","status":"Official","release-group":{"id":"` + rg2 + `","primary-type":"Album","secondary-types":["Compilation"]}},
+				             {"title":"Preço Curto","date":"1999","status":"Official","release-group":{"id":"` + rg1 + `","primary-type":"Album"}}]},
+				{"id":"r2","title":"Zóio de lula","artist-credit":[{"name":"Charlie Brown Jr."}],"releases":[{"title":"Live"}]},
+				{"id":"r3","title":"Video","video":true,"releases":[{"title":"x"}]}]}`))
+		case r.URL.Path == "/release-group/"+rg1:
+			_, _ = w.Write([]byte(`{"id":"` + rg1 + `","title":"Transpiração Contínua Prolongada","primary-type":"Album","first-release-date":"1997",
+				"artist-credit":[{"name":"Charlie Brown Jr.","artist":{"id":"` + cbjr + `"}}]}`))
+		case r.URL.Path == "/release" && q.Get("release-group") == rg1:
+			_, _ = w.Write([]byte(`{"releases":[
+				{"status":"Bootleg","date":"1996","media":[{"tracks":[{"title":"x","recording":{"id":"bad"}}]}]},
+				{"status":"Official","date":"1997","media":[{"tracks":[
+					{"position":1,"recording":{"id":"t1","title":"Proibida pra Mim","length":180000}},
+					{"position":2,"recording":{"id":"t2","title":"O Coro Vai Comê!"}}]}]}]}`))
+		default:
+			_, _ = w.Write([]byte(`{}`))
+		}
+	}))
+	t.Cleanup(srv.Close)
+	return &MusicBrainz{BaseURL: srv.URL}, &calls
+}
+
+func TestMusicBrainzSearchArtistFirst(t *testing.T) {
+	mb, _ := fakeMB(t, 0)
+	items, err := mb.Search(context.Background(), "charlie brown jr", 10)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var kinds, titles []string
+	for _, it := range items {
+		kinds = append(kinds, string(it.Kind))
+		titles = append(titles, it.Title)
+	}
+	got := strings.Join(titles, "|")
+	want := "Charlie Brown Jr.|Charlie Brown|Transpiração Contínua Prolongada|Acústico MTV|Zóio de Lula"
+	if got != want {
+		t.Fatalf("titles = %s\nwant      %s (kinds %v)", got, want, kinds)
+	}
+	if items[0].Kind != KindArtist || items[3].Type != "Album + Live" || items[2].CoverID != rg1 {
+		t.Errorf("unexpected items: %+v", items[:4])
+	}
+	if tr := items[4]; tr.Album != "Preço Curto" || tr.CoverID != rg1 || tr.ArtistMBID != cbjr {
+		t.Errorf("track should use the studio album: %+v", tr)
+	}
+}
+
+func TestMusicBrainzRetriesAndCaches(t *testing.T) {
+	mb, calls := fakeMB(t, 2)
+	d, err := mb.Artist(context.Background(), cbjr)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if d.Artist.Title != "Charlie Brown Jr." || len(d.Albums) != 2 {
+		t.Fatalf("artist = %+v", d)
+	}
+	before := calls.Load()
+	if _, err := mb.Artist(context.Background(), cbjr); err != nil || calls.Load() != before {
+		t.Errorf("second call should be cached (calls %d -> %d, err %v)", before, calls.Load(), err)
+	}
+	if _, err := mb.Artist(context.Background(), "nope"); err != ErrNotFound {
+		t.Errorf("invalid mbid: %v", err)
+	}
+}
+
+func TestMusicBrainzAlbum(t *testing.T) {
+	mb, _ := fakeMB(t, 0)
+	d, err := mb.Album(context.Background(), rg1)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(d.Tracks) != 2 || d.Tracks[0].Title != "Proibida pra Mim" || d.Tracks[1].TrackNumber != 2 ||
+		d.Tracks[1].Artist != "Charlie Brown Jr." || d.Tracks[0].CoverID != rg1 || d.Album.Year != 1997 {
+		t.Errorf("album = %+v", d)
+	}
+}
