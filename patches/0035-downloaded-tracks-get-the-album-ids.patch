+// RecordingReleaseGroup is the release group of the most representative release of a recording,
+// for requests made without one (imports, older requests).
+func (m *MusicBrainz) RecordingReleaseGroup(ctx context.Context, mbid string) (string, error) {
+	if !ValidMBID(mbid) {
+		return "", ErrNotFound
+	}
+	var rec mbRecording
+	if err := m.get(ctx, "/recording/"+mbid, url.Values{"inc": {"releases+release-groups+artist-credits"}}, &rec); err != nil {
+		return "", err
+	}
+	it, ok := rec.item()
+	if !ok {
+		return "", ErrNotFound
+	}
+	return it.CoverID, nil
+}
