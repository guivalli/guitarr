+func TestTrackAlbumTagsAddReleaseIds(t *testing.T) {
+	got := strings.Join(trackAlbumTags(sampleAlbum(), Request{MBID: recID2, Title: "whatever"}), "|")
+	for _, want := range []string{"album=Greatest Hits", "date=2005", "track=2",
+		"MUSICBRAINZ_RELEASEGROUPID=" + rgID, "MUSICBRAINZ_ALBUMID=" + relID, "MUSICBRAINZ_ALBUMARTISTID=" + artID, "MUSICBRAINZ_ARTISTID=" + artID} {
+		if !strings.Contains(got, want) {
+			t.Errorf("tags missing %q in %s", want, got)
+		}
+	}
+	// recording not on the chosen release: matched by title; unknown track: album ids only
+	byTitle := strings.Join(trackAlbumTags(sampleAlbum(), Request{MBID: recID1[:len(recID1)-1] + "9", Title: "DAMMIT"}), "|")
+	if !strings.Contains(byTitle, "track=1") {
+		t.Errorf("title match missing: %s", byTitle)
+	}
+	none := strings.Join(trackAlbumTags(sampleAlbum(), Request{MBID: recID1[:len(recID1)-1] + "9", Title: "Other"}), "|")
+	if strings.Contains(none, "track=") || !strings.Contains(none, "MUSICBRAINZ_ALBUMID="+relID) {
+		t.Errorf("unmatched track tags = %s", none)
+	}
+}
