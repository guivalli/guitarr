+// releaseGroupOf is the release group a requested track belongs to: the one the request was made
+// from (CoverID of a catalog track) or, for a request without it, the one MusicBrainz lists for
+// the recording.
+func (s *Service) releaseGroupOf(ctx context.Context, req Request) string {
+	if ValidMBID(req.ReleaseGroupID) {
+		return req.ReleaseGroupID
+	}
+	if ValidMBID(req.CoverID) {
+		return req.CoverID
+	}
+	if f, ok := s.catalog.(interface {
+		RecordingReleaseGroup(ctx context.Context, mbid string) (string, error)
+	}); ok {
+		if id, err := f.RecordingReleaseGroup(ctx, req.MBID); err == nil && ValidMBID(id) {
+			return id
+		}
+	}
+	return ""
+}
+
+// releaseOf is the release (album) a requested track is tagged with; nil when it is unknown.
+func (s *Service) releaseOf(ctx context.Context, req Request) *AlbumDetail {
+	rg := s.releaseGroupOf(ctx, req)
+	if rg == "" {
+		return nil
+	}
+	d, err := s.catalog.Album(ctx, rg)
+	if err != nil || d == nil {
+		return nil
+	}
+	return d
+}
+
+// tagAlbumLevel adds the album ids and the track position to a file whose title and artist are
+// already right. A failure only leaves the file as it was: Organizar Metadados can still fix it.
+func (s *Service) tagAlbumLevel(ctx context.Context, req Request, path string) {
+	d := s.releaseOf(ctx, req)
+	if d == nil {
+		return
+	}
+	_ = writeTags(ctx, cmp(s.cfg.FFmpeg, "ffmpeg"), path, trackAlbumTags(d, req))
+}
+
+// trackAlbumTags are the album-level tags of one requested track, plus its position and artist id
+// when the release lists it (by recording id, then by title).
+func trackAlbumTags(d *AlbumDetail, req Request) []string {
+	al := d.Album
+	tags := []string{"album=" + al.Title, "album_artist=" + al.Artist}
+	if al.Year > 0 {
+		tags = append(tags, "date="+strconv.Itoa(al.Year))
+	}
+	if ValidMBID(al.MBID) {
+		tags = append(tags, "MUSICBRAINZ_RELEASEGROUPID="+al.MBID)
+	}
+	if ValidMBID(al.ReleaseID) {
+		tags = append(tags, "MUSICBRAINZ_ALBUMID="+al.ReleaseID)
+	}
+	if ValidMBID(al.ArtistMBID) {
+		tags = append(tags, "MUSICBRAINZ_ALBUMARTISTID="+al.ArtistMBID)
+	}
+	want := looseKey(req.Title)
+	for i, t := range d.Tracks {
+		if t.MBID != req.MBID && (want == "" || looseKey(t.Title) != want) {
+			continue
+		}
+		tags = append(tags, fmt.Sprintf("track=%d", cmp0(t.TrackNumber, i+1)))
+		if ValidMBID(t.ArtistMBID) {
+			tags = append(tags, "MUSICBRAINZ_ARTISTID="+t.ArtistMBID)
+		}
+		break
+	}
+	return tags
+}
