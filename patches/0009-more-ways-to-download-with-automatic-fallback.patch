+// trackSources are the sources used to build an album track by track: the
+// track-only ones (web). Album-capable ones (Soulseek) already had their go at
+// the whole album, and searching them again per track is slow.
+func (s *Service) trackSources() []Source {
+	var out []Source
+	for _, src := range s.sources {
+		if src.Enabled() && src.Supports(KindTrack) && !src.Supports(KindAlbum) {
+			out = append(out, src)
+		}
+	}
+	return out
+}
+
+// fetchAlbumTracks downloads an album one track at a time through the track
+// sources (each track tries every source in order). Like a Soulseek album, it
+// is kept when at least half of the tracks arrived; missing ones go in Warning.
+func (s *Service) fetchAlbumTracks(ctx context.Context, req *Request) (Result, error) {
+	detail, err := s.catalog.Album(ctx, req.MBID)
+	if err != nil {
+		return Result{}, fmt.Errorf("tracklist: %w", err)
+	}
+	if len(detail.Tracks) == 0 {
+		return Result{}, errors.New("the catalog has no tracklist for this album")
+	}
+	album := cmp(req.Album, req.Title)
+	var paths, missing []string
+	for i, t := range detail.Tracks {
+		if ctx.Err() != nil {
+			return Result{}, ctx.Err()
+		}
+		s.setStatus(ctx, req, StatusDownloading, fmt.Sprintf("track %d of %d", i+1, len(detail.Tracks)))
+		num := t.TrackNumber
+		if num == 0 {
+			num = i + 1
+		}
+		tr := Request{
+			ID: req.ID, UserID: req.UserID, Kind: KindTrack, MBID: t.MBID,
+			Artist: cmp(t.Artist, req.Artist), Album: album, Title: t.Title,
+			DurationMs: t.DurationMs, TrackNumber: num, AlbumArtist: req.Artist,
+			ReleaseGroupID: req.MBID,
+		}
+		got := false
+		for _, src := range s.trackSources() {
+			res, err := src.Fetch(ctx, tr, s.cfg.DestDir)
+			if err == nil && len(res.Paths) > 0 {
+				paths = append(paths, res.Paths...)
+				got = true
+				break
+			}
+		}
+		if !got {
+			missing = append(missing, fmt.Sprintf("%d. %s", num, t.Title))
+		}
+	}
+	if len(paths)*2 < len(detail.Tracks) {
+		for _, p := range paths {
+			_ = os.Remove(p)
+		}
+		return Result{}, fmt.Errorf("only %d of %d tracks found", len(paths), len(detail.Tracks))
+	}
+	res := Result{Paths: paths}
+	if len(missing) > 0 {
+		res.Warning = fmt.Sprintf("%d of %d tracks could not be downloaded: %s",
+			len(missing), len(detail.Tracks), strings.Join(missing, ", "))
+	}
+	return res, nil
+}
+
