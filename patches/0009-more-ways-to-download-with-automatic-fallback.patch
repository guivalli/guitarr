+// trackSource downloads tracks whose title is not in fail, writing real files.
+type trackSource struct {
+	dir  string
+	fail map[string]bool
+	mu   sync.Mutex
+	got  []Request
+}
+
+func (s *trackSource) Name() string         { return "web" }
+func (s *trackSource) Enabled() bool        { return true }
+func (s *trackSource) Supports(k Kind) bool { return k == KindTrack }
+func (s *trackSource) Fetch(_ context.Context, r Request, dest string) (Result, error) {
+	s.mu.Lock()
+	s.got = append(s.got, r)
+	s.mu.Unlock()
+	if s.fail[r.Title] {
+		return Result{}, errors.New("not found")
+	}
+	p := filepath.Join(dest, fmt.Sprintf("%02d.opus", r.TrackNumber))
+	return Result{Paths: []string{p}}, os.WriteFile(p, []byte("x"), 0o600)
+}
+
+func TestAlbumFallsBackToTrackByTrack(t *testing.T) {
+	tracks := []CatalogItem{
+		{Kind: KindTrack, MBID: "t1", Title: "Um", Artist: "Banda", TrackNumber: 1, DurationMs: 1000},
+		{Kind: KindTrack, MBID: "t2", Title: "Dois", Artist: "Banda feat. X", TrackNumber: 2},
+		{Kind: KindTrack, MBID: "t3", Title: "Três", TrackNumber: 3},
+		{Kind: KindTrack, MBID: "t4", Title: "Quatro", TrackNumber: 4},
+	}
+	for _, tc := range []struct {
+		name   string
+		fail   map[string]bool
+		status Status
+	}{
+		{"most tracks found", map[string]bool{"Três": true}, StatusImporting},
+		{"too few tracks", map[string]bool{"Um": true, "Dois": true, "Três": true}, StatusFailed},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			dest := t.TempDir()
+			lib := &fakeLib{have: map[string]bool{}}
+			st := NewMemoryStore()
+			albums := &fakeSource{name: "soulseek", kind: KindAlbum, err: errors.New("no peers")}
+			web := &trackSource{dir: dest, fail: tc.fail}
+			cfg := fastConfig(true)
+			cfg.DestDir = dest
+			cfg.ImportTimeout = time.Hour
+			svc := NewService(cfg, fakeCatalog{items: tracks}, []Source{albums, web}, st, lib)
+			ctx, cancel := context.WithCancel(context.Background())
+			defer cancel()
+			svc.Start(ctx)
+			req, err := svc.Submit(ctx, "u", CatalogItem{Kind: KindAlbum, MBID: "rg1", Title: "Disco", Artist: "Banda"})
+			if err != nil {
+				t.Fatal(err)
+			}
+			got := waitStatus(t, st, req.ID, tc.status)
+			files, _ := filepath.Glob(filepath.Join(dest, "*.opus"))
+			switch tc.status {
+			case StatusImporting:
+				if got.Source != "tracks" || !strings.Contains(got.Error, "1 of 4 tracks could not be downloaded: 3. Três") || len(files) != 3 {
+					t.Errorf("request %+v, files %v", got, files)
+				}
+				web.mu.Lock()
+				first := web.got[0]
+				second := web.got[1]
+				web.mu.Unlock()
+				if first.Album != "Disco" || first.AlbumArtist != "Banda" || first.ReleaseGroupID != "rg1" || first.DurationMs != 1000 || second.Artist != "Banda feat. X" {
+					t.Errorf("track requests: %+v / %+v", first, second)
+				}
+			case StatusFailed:
+				if !strings.Contains(got.Error, "no peers") || !strings.Contains(got.Error, "only 1 of 4 tracks") || len(files) != 0 {
+					t.Errorf("request %+v, files left %v", got, files)
+				}
+			}
+		})
+	}
+}
diff --git a/core/acquire/source_web.go b/core/acquire/source_web.go
new file mode 100644
index 0000000..0ec7410
--- /dev/null
+++ b/core/acquire/source_web.go
@@ -0,0 +1,362 @@
+package acquire
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"math"
+	"net/url"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"regexp"
+	"sort"
+	"strings"
+	"time"
+	"unicode"
+
+	"golang.org/x/text/unicode/norm"
+)
+
+// ytdlp downloads single tracks from sites yt-dlp understands. Each site is a
+// search (a yt-dlp search prefix or URL); the results are scored against the
+// request (title, artist, length, "live"/"cover" noise) and the best ones are
+// downloaded in turn, each with a few yt-dlp settings, until one works. A slow
+// or stuck download is abandoned after AttemptTimeout.
+type ytdlp struct {
+	Binary         string
+	FFmpeg         string
+	Format         string
+	Cookies        string
+	AttemptTimeout time.Duration // per download try, default 4 minutes
+	Candidates     int           // results downloaded per search before giving up, default 3
+}
+
+// webSite is one place to search.
+type webSite struct {
+	name  string
+	query func(artist, title string) string
+	// variants are extra yt-dlp arguments tried in order for each candidate
+	// (YouTube changes often; another player client usually still works).
+	variants [][]string
+	cookies  bool
+}
+
+var (
+	siteYouTubeMusic = webSite{
+		name: "YouTube Music",
+		query: func(artist, title string) string {
+			return "https://music.youtube.com/search?q=" + url.QueryEscape(artist+" "+title) + "#songs"
+		},
+		variants: youtubeVariants,
+		cookies:  true,
+	}
+	siteYouTube = webSite{
+		name:     "YouTube",
+		query:    func(artist, title string) string { return "ytsearch6:" + artist + " - " + title },
+		variants: youtubeVariants,
+		cookies:  true,
+	}
+	siteSoundCloud = webSite{
+		name:     "SoundCloud",
+		query:    func(artist, title string) string { return "scsearch6:" + artist + " " + title },
+		variants: [][]string{nil},
+	}
+	youtubeVariants = [][]string{
+		nil,
+		{"--extractor-args", "youtube:player_client=web_safari,mweb"},
+		{"--extractor-args", "youtube:player_client=tv,ios"},
+	}
+)
+
+var errTooSlow = errors.New("download took too long")
+
+type webCandidate struct {
+	URL      string
+	Title    string
+	Channel  string
+	Duration float64
+	score    int
+}
+
+// fetch tries each site in order and returns the first file that downloaded.
+func (y *ytdlp) fetch(ctx context.Context, sites []webSite, req Request, destDir string) (Result, string, error) {
+	dir := filepath.Join(destDir, sanitize(cmp(req.AlbumArtist, req.Artist)), sanitize(req.Album))
+	if err := ensureInside(destDir, dir); err != nil {
+		return Result{}, "", err
+	}
+	name := sanitize(req.Title)
+	if req.TrackNumber > 0 {
+		name = fmt.Sprintf("%02d - %s", req.TrackNumber, name)
+	}
+	outTpl := filepath.Join(dir, name+".%(ext)s")
+
+	var errs []string
+	for _, site := range sites {
+		if ctx.Err() != nil {
+			return Result{}, "", ctx.Err()
+		}
+		cands, err := y.search(ctx, site, req)
+		if err != nil {
+			errs = append(errs, fmt.Sprintf("%s: %v", site.name, err))
+			continue
+		}
+		if len(cands) == 0 {
+			errs = append(errs, site.name+": nothing that matches")
+			continue
+		}
+		path, err := y.downloadFirst(ctx, site, cands, outTpl)
+		if err != nil {
+			errs = append(errs, fmt.Sprintf("%s: %v", site.name, err))
+			continue
+		}
+		if err := tagFile(ctx, cmp(y.FFmpeg, "ffmpeg"), path, req); err != nil {
+			_ = os.Remove(path)
+			errs = append(errs, err.Error())
+			continue
+		}
+		return Result{Paths: []string{path}}, site.name, nil
+	}
+	return Result{}, "", errors.New(strings.Join(errs, "; "))
+}
+
+// search lists the site's results for the request, best first, dropping the
+// ones that are clearly something else.
+func (y *ytdlp) search(ctx context.Context, site webSite, req Request) ([]webCandidate, error) {
+	ctx, cancel := context.WithTimeout(ctx, 90*time.Second)
+	defer cancel()
+	args := []string{"--flat-playlist", "-J", "--no-warnings", "--socket-timeout", "20"}
+	if site.cookies && y.Cookies != "" {
+		args = append(args, "--cookies", y.Cookies)
+	}
+	// The query is one argv element after "--": user text is never an option.
+	args = append(args, "--", site.query(strings.TrimSpace(req.Artist), strings.TrimSpace(req.Title)))
+	var stdout, stderr bytes.Buffer
+	cmd := exec.CommandContext(ctx, cmp(y.Binary, "yt-dlp"), args...)
+	cmd.Stdout, cmd.Stderr = &stdout, &stderr
+	cmd.WaitDelay = 2 * time.Second
+	if err := cmd.Run(); err != nil {
+		return nil, fmt.Errorf("search failed: %w: %s", err, lastLine(stderr.String()))
+	}
+	var out struct {
+		Entries []struct {
+			URL        string   `json:"url"`
+			WebpageURL string   `json:"webpage_url"`
+			ID         string   `json:"id"`
+			Title      string   `json:"title"`
+			Track      string   `json:"track"`
+			Channel    string   `json:"channel"`
+			Uploader   string   `json:"uploader"`
+			Artist     string   `json:"artist"`
+			Artists    []string `json:"artists"`
+			Duration   float64  `json:"duration"`
+		} `json:"entries"`
+	}
+	if err := json.Unmarshal(stdout.Bytes(), &out); err != nil {
+		return nil, fmt.Errorf("unexpected search output: %w", err)
+	}
+	var cands []webCandidate
+	for _, e := range out.Entries {
+		u := cmp(e.WebpageURL, e.URL)
+		if u == "" || !strings.HasPrefix(u, "http") {
+			continue
+		}
+		c := webCandidate{URL: u, Title: cmp(e.Track, e.Title), Duration: e.Duration}
+		c.Channel = strings.Join(append(e.Artists, e.Artist, e.Channel, e.Uploader), " ")
+		c.score = scoreCandidate(req, c)
+		if c.score >= 40 {
+			cands = append(cands, c)
+		}
+	}
+	sort.SliceStable(cands, func(i, j int) bool { return cands[i].score > cands[j].score })
+	n := y.Candidates
+	if n <= 0 {
+		n = 3
+	}
+	if len(cands) > n {
+		cands = cands[:n]
+	}
+	return cands, nil
+}
+
+var noiseWords = regexp.MustCompile(` (live|ao vivo|en vivo|cover|karaoke|instrumental|remix|8d|slowed|sped up|nightcore|reaction|tutorial|lesson|aula|full album|album completo) `)
+
+// words lowercases, drops accents and turns punctuation into single spaces,
+// padded with spaces so " word " matches whole words only.
+func words(s string) string {
+	var sb strings.Builder
+	sb.WriteByte(' ')
+	space := true
+	for _, r := range norm.NFD.String(strings.ToLower(s)) {
+		switch {
+		case unicode.IsLetter(r) || unicode.IsDigit(r):
+			sb.WriteRune(r)
+			space = false
+		case unicode.Is(unicode.Mn, r): // accents
+		default:
+			if !space {
+				sb.WriteByte(' ')
+				space = true
+			}
+		}
+	}
+	if !space {
+		sb.WriteByte(' ')
+	}
+	return sb.String()
+}
+
+// scoreCandidate rates how likely a search result is the requested recording.
+func scoreCandidate(req Request, c webCandidate) int {
+	if c.Duration > 900 {
+		return 0 // mixes and full-album uploads
+	}
+	title, artist := words(req.Title), words(req.Artist)
+	ct, ch := words(c.Title), words(c.Channel)
+	score := 0
+	switch {
+	case strings.TrimSpace(title) == "":
+		return 0
+	case ct == title:
+		score += 60
+	case strings.Contains(ct, title):
+		score += 45
+	case strings.Contains(title, ct) && len(ct) >= 5:
+		score += 25
+	default:
+		return 0
+	}
+	if artist != " " && (strings.Contains(ch, artist) || strings.Contains(ct, artist)) {
+		score += 30
+	}
+	if strings.Contains(ch, " topic ") || strings.Contains(ch, "vevo") || strings.Contains(ct, " official audio ") || strings.Contains(ct, " audio oficial ") {
+		score += 10
+	}
+	if noiseWords.MatchString(ct) && !noiseWords.MatchString(title) {
+		score -= 50
+	}
+	if req.DurationMs > 0 && c.Duration > 0 {
+		diff := math.Abs(c.Duration - float64(req.DurationMs)/1000)
+		switch {
+		case diff <= 4:
+			score += 30
+		case diff <= 12:
+			score += 15
+		case diff > 40:
+			score -= 60
+		}
+	}
+	return score
+}
+
+// downloadFirst tries the candidates in order, each with the site's variants.
+func (y *ytdlp) downloadFirst(ctx context.Context, site webSite, cands []webCandidate, outTpl string) (string, error) {
+	var last error
+	for _, c := range cands {
+		for _, extra := range site.variants {
+			if ctx.Err() != nil {
+				return "", ctx.Err()
+			}
+			path, err := y.download(ctx, site, c.URL, outTpl, extra)
+			if err == nil {
+				return path, nil
+			}
+			last = err
+			if errors.Is(err, errTooSlow) {
+				break // slow, not blocked: another setting won't help, try the next upload
+			}
+		}
+	}
+	return "", last
+}
+
+func (y *ytdlp) download(ctx context.Context, site webSite, link, outTpl string, extra []string) (string, error) {
+	timeout := y.AttemptTimeout
+	if timeout <= 0 {
+		timeout = 4 * time.Minute
+	}
+	ctx, cancel := context.WithTimeout(ctx, timeout)
+	defer cancel()
+	args := []string{
+		"-x", "--audio-format", cmp(y.Format, "opus"),
+		"--embed-thumbnail",
+		"--no-playlist",
+		"--no-warnings",
+		"--retries", "3", "--fragment-retries", "3", "--socket-timeout", "20",
+		"--match-filter", "duration < 900",
+		"--print", "after_move:filepath",
+		"-o", outTpl,
+	}
+	if y.FFmpeg != "" {
+		args = append(args, "--ffmpeg-location", y.FFmpeg)
+	}
+	if site.cookies && y.Cookies != "" {
+		args = append(args, "--cookies", y.Cookies)
+	}
+	args = append(args, extra...)
+	args = append(args, "--", link)
+	var stdout, stderr bytes.Buffer
+	cmd := exec.CommandContext(ctx, cmp(y.Binary, "yt-dlp"), args...)
+	cmd.Stdout, cmd.Stderr = &stdout, &stderr
+	cmd.WaitDelay = 2 * time.Second // don't wait on children (ffmpeg) holding the pipes after a timeout
+	err := cmd.Run()
+	if ctx.Err() == context.DeadlineExceeded {
+		return "", fmt.Errorf("%w (%s)", errTooSlow, timeout)
+	}
+	if err != nil {
+		return "", fmt.Errorf("download failed: %s", lastLine(stderr.String()))
+	}
+	for _, line := range strings.Split(stdout.String(), "\n") {
+		if p := strings.TrimSpace(line); p != "" {
+			return p, nil
+		}
+	}
+	return "", errors.New("yt-dlp produced no file")
+}
+
+func lastLine(s string) string {
+	lines := strings.Split(strings.TrimSpace(s), "\n")
+	return strings.TrimSpace(lines[len(lines)-1])
+}
+
+// YouTube searches YouTube Music first (official "Topic" uploads, clean audio),
+// then regular YouTube.
+type YouTube struct {
+	Binary         string // default "yt-dlp"
+	FFmpeg         string // default "ffmpeg"; also required by yt-dlp for audio extraction
+	Format         string // audio format, default "opus"
+	Cookies        string // optional cookies.txt, helps with age-restricted or blocked videos
+	AttemptTimeout time.Duration
+	On             bool
+}
+
+func (y *YouTube) Name() string         { return "youtube" }
+func (y *YouTube) Enabled() bool        { return y.On }
+func (y *YouTube) Supports(k Kind) bool { return k == KindTrack }
+
+func (y *YouTube) Fetch(ctx context.Context, req Request, destDir string) (Result, error) {
+	d := &ytdlp{Binary: y.Binary, FFmpeg: y.FFmpeg, Format: y.Format, Cookies: y.Cookies, AttemptTimeout: y.AttemptTimeout}
+	res, _, err := d.fetch(ctx, []webSite{siteYouTubeMusic, siteYouTube}, req, destDir)
+	return res, err
+}
+
+// SoundCloud is a second web source, useful when YouTube blocks or has nothing.
+type SoundCloud struct {
+	Binary         string
+	FFmpeg         string
+	Format         string
+	AttemptTimeout time.Duration
+	On             bool
+}
+
+func (s *SoundCloud) Name() string         { return "soundcloud" }
+func (s *SoundCloud) Enabled() bool        { return s.On }
+func (s *SoundCloud) Supports(k Kind) bool { return k == KindTrack }
+
+func (s *SoundCloud) Fetch(ctx context.Context, req Request, destDir string) (Result, error) {
+	d := &ytdlp{Binary: s.Binary, FFmpeg: s.FFmpeg, Format: s.Format, AttemptTimeout: s.AttemptTimeout}
+	res, _, err := d.fetch(ctx, []webSite{siteSoundCloud}, req, destDir)
+	return res, err
+}
diff --git a/core/acquire/source_web_test.go b/core/acquire/source_web_test.go
new file mode 100644
index 0000000..3a4c2fa
--- /dev/null
+++ b/core/acquire/source_web_test.go
@@ -0,0 +1,189 @@
+package acquire
+
+import (
+	"context"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+)
+
+// fakeWebTools writes a fake yt-dlp and ffmpeg. yt-dlp answers searches from
+// the JSON files in dir (music.json, yt.json, sc.json) and "downloads" by
+// writing the -o file, except for URLs that say fail, slow or needsclient
+// (which only works with --extractor-args). Every call is logged to calls.log.
+func fakeWebTools(t *testing.T, searches map[string]string) (dir, ytdlpBin, ffmpegBin string) {
+	t.Helper()
+	dir = t.TempDir()
+	for name, body := range searches {
+		if err := os.WriteFile(filepath.Join(dir, name), []byte(body), 0o600); err != nil {
+			t.Fatal(err)
+		}
+	}
+	ytdlpBin = filepath.Join(dir, "yt-dlp")
+	script := `#!/bin/sh
+D="` + dir + `"
+echo "$*" >> "$D/calls.log"
+out=""; client=""; search=""; url=""
+while [ $# -gt 0 ]; do
+  case "$1" in
+    -o) out="$2"; shift;;
+    --extractor-args) client="$2"; shift;;
+    --flat-playlist) search=1;;
+    --) url="$2"; shift;;
+  esac
+  shift
+done
+if [ -n "$search" ]; then
+  case "$url" in
+    https://music.youtube.com/*) f=music.json;;
+    ytsearch*) f=yt.json;;
+    scsearch*) f=sc.json;;
+  esac
+  if [ ! -f "$D/$f" ]; then echo "ERROR: search blocked" >&2; exit 1; fi
+  cat "$D/$f"; exit 0
+fi
+case "$url" in
+  *fail*) echo "ERROR: [youtube] Sign in to confirm you're not a bot" >&2; exit 1;;
+  *slow*) sleep 5;;
+  *needsclient*) [ -z "$client" ] && { echo "ERROR: HTTP Error 403: Forbidden" >&2; exit 1; };;
+esac
+f=$(echo "$out" | sed 's/%(ext)s/opus/')
+mkdir -p "$(dirname "$f")"; echo "$url" > "$f"; echo "$f"
+`
+	if err := os.WriteFile(ytdlpBin, []byte(script), 0o755); err != nil { //nolint:gosec
+		t.Fatal(err)
+	}
+	ffmpegBin = filepath.Join(dir, "ffmpeg")
+	// copies the input to the last argument and logs the metadata it was given
+	ff := `#!/bin/sh
+D="` + dir + `"
+in=""; last=""
+prev=""
+for a in "$@"; do
+  [ "$prev" = "-i" ] && in="$a"
+  [ "$prev" = "-metadata" ] && echo "$a" >> "$D/tags.log"
+  prev="$a"; last="$a"
+done
+cp "$in" "$last"
+`
+	if err := os.WriteFile(ffmpegBin, []byte(ff), 0o755); err != nil { //nolint:gosec
+		t.Fatal(err)
+	}
+	return dir, ytdlpBin, ffmpegBin
+}
+
+func readFile(t *testing.T, p string) string {
+	t.Helper()
+	b, _ := os.ReadFile(p)
+	return string(b)
+}
+
+func TestScoreCandidate(t *testing.T) {
+	req := Request{Artist: "Charlie Brown Jr.", Title: "Só os Loucos Sabem", DurationMs: 181000}
+	official := scoreCandidate(req, webCandidate{Title: "Só Os Loucos Sabem", Channel: "Charlie Brown Jr. - Topic", Duration: 182})
+	live := scoreCandidate(req, webCandidate{Title: "Charlie Brown Jr - Só os Loucos Sabem (Ao Vivo)", Channel: "Fã clube", Duration: 260})
+	other := scoreCandidate(req, webCandidate{Title: "Proibida pra Mim", Channel: "Charlie Brown Jr. - Topic", Duration: 181})
+	long := scoreCandidate(req, webCandidate{Title: "Só os Loucos Sabem", Channel: "Charlie Brown Jr.", Duration: 3600})
+	if official < 100 || live >= 40 || other != 0 || long != 0 {
+		t.Errorf("official=%d live=%d other=%d long=%d", official, live, other, long)
+	}
+	// a live version is fine when the live version was requested
+	req.Title = "Só os Loucos Sabem (Ao Vivo)"
+	req.DurationMs = 0
+	if s := scoreCandidate(req, webCandidate{Title: "Só os Loucos Sabem (Ao Vivo)", Channel: "Charlie Brown Jr."}); s < 40 {
+		t.Errorf("requested live version scored %d", s)
+	}
+}
+
+func TestYouTubeTriesCandidatesAndPlayerClients(t *testing.T) {
+	music := `{"entries":[
+		{"url":"https://music.youtube.com/watch?v=live","title":"Paranoid Android (Live)","channel":"Radiohead - Topic","duration":420},
+		{"url":"https://music.youtube.com/watch?v=fail1","title":"Paranoid Android","channel":"Radiohead - Topic","duration":387},
+		{"url":"https://music.youtube.com/watch?v=needsclient","title":"Paranoid Android","channel":"Radiohead","duration":386},
+		{"url":"https://music.youtube.com/watch?v=other","title":"Karma Police","channel":"Radiohead - Topic","duration":261}]}`
+	dir, bin, ff := fakeWebTools(t, map[string]string{"music.json": music})
+	dest := filepath.Join(dir, "music")
+	y := &YouTube{On: true, Binary: bin, FFmpeg: ff, Cookies: "/data/cookies.txt"}
+	req := Request{Kind: KindTrack, MBID: "rec-1", Artist: "Radiohead", Album: "OK Computer", Title: "Paranoid Android", DurationMs: 387000}
+	res, err := y.Fetch(context.Background(), req, dest)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(res.Paths) != 1 || !strings.HasSuffix(res.Paths[0], filepath.Join("Radiohead", "OK Computer", "Paranoid Android.opus")) {
+		t.Fatalf("paths = %v", res.Paths)
+	}
+	if got := readFile(t, res.Paths[0]); !strings.Contains(got, "needsclient") {
+		t.Errorf("downloaded %q, want the needsclient upload", got)
+	}
+	calls := readFile(t, filepath.Join(dir, "calls.log"))
+	if strings.Contains(calls, "v=live") || strings.Contains(calls, "v=other") {
+		t.Errorf("tried a live version or another song:\n%s", calls)
+	}
+	if strings.Count(calls, "v=fail1") != 3 || !strings.Contains(calls, "player_client=web_safari,mweb -- https://music.youtube.com/watch?v=needsclient") {
+		t.Errorf("expected each player client on the failing upload, then the second upload:\n%s", calls)
+	}
+	if !strings.Contains(calls, "--cookies /data/cookies.txt") {
+		t.Errorf("cookies not passed:\n%s", calls)
+	}
+	tags := readFile(t, filepath.Join(dir, "tags.log"))
+	if !strings.Contains(tags, "MUSICBRAINZ_TRACKID=rec-1") || !strings.Contains(tags, "title=Paranoid Android") {
+		t.Errorf("tags = %s", tags)
+	}
+}
+
+func TestYouTubeFallsBackToRegularSearchAndSkipsSlowDownloads(t *testing.T) {
+	yt := `{"entries":[
+		{"url":"https://www.youtube.com/watch?v=slow","title":"AmarElo","channel":"Emicida - Topic","duration":300},
+		{"url":"https://www.youtube.com/watch?v=ok","title":"Emicida - AmarElo","channel":"Emicida","duration":301}]}`
+	// no music.json: the YouTube Music search fails
+	dir, bin, ff := fakeWebTools(t, map[string]string{"yt.json": yt})
+	y := &YouTube{On: true, Binary: bin, FFmpeg: ff, AttemptTimeout: 300 * time.Millisecond}
+	start := time.Now()
+	res, err := y.Fetch(context.Background(), Request{Kind: KindTrack, MBID: "r", Artist: "Emicida", Title: "AmarElo"}, filepath.Join(dir, "m"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got := readFile(t, res.Paths[0]); !strings.Contains(got, "v=ok") {
+		t.Errorf("downloaded %q", got)
+	}
+	if !strings.Contains(readFile(t, filepath.Join(dir, "calls.log")), "v=slow") {
+		t.Error("the slow upload should have been tried first")
+	}
+	if time.Since(start) > 4*time.Second {
+		t.Errorf("slow download was not abandoned (%s)", time.Since(start))
+	}
+}
+
+func TestSoundCloudAndErrors(t *testing.T) {
+	sc := `{"entries":[{"webpage_url":"https://soundcloud.com/a/b","title":"Racionais - Negro Drama","uploader":"racionais","duration":411}]}`
+	dir, bin, ff := fakeWebTools(t, map[string]string{"sc.json": sc})
+	s := &SoundCloud{On: true, Binary: bin, FFmpeg: ff}
+	if !s.Supports(KindTrack) || s.Supports(KindAlbum) {
+		t.Error("SoundCloud handles tracks only")
+	}
+	res, err := s.Fetch(context.Background(), Request{Kind: KindTrack, MBID: "r", Artist: "Racionais MC's", Title: "Negro Drama"}, filepath.Join(dir, "m"))
+	if err != nil || len(res.Paths) != 1 {
+		t.Fatalf("soundcloud: %v %v", res, err)
+	}
+	// YouTube with every search blocked explains what happened on each site
+	y := &YouTube{On: true, Binary: bin, FFmpeg: ff}
+	_, err = y.Fetch(context.Background(), Request{Kind: KindTrack, MBID: "r", Artist: "A", Title: "B"}, filepath.Join(dir, "m"))
+	if err == nil || !strings.Contains(err.Error(), "YouTube Music: search failed") || !strings.Contains(err.Error(), "YouTube: search failed") {
+		t.Errorf("err = %v", err)
+	}
+}
+
+func TestScoreCandidateWholeWords(t *testing.T) {
+	req := Request{Artist: "Charlie Brown Jr.", Title: "Faixa 1", DurationMs: 187000}
+	if s := scoreCandidate(req, webCandidate{Title: "Faixa 10", Channel: "Charlie Brown Jr. - Topic", Duration: 187}); s != 0 {
+		t.Errorf("Faixa 10 matched Faixa 1 (%d)", s)
+	}
+	req.Title, req.DurationMs = "Faixa 6", 222000
+	good := scoreCandidate(req, webCandidate{Title: "Faixa 6", Channel: "Charlie Brown Jr. - Topic", Duration: 180})
+	live := scoreCandidate(req, webCandidate{Title: "Faixa 6 (Ao Vivo)", Channel: "fan", Duration: 220})
+	if live >= 40 || good <= live {
+		t.Errorf("good=%d live=%d", good, live)
+	}
+}
