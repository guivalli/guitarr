+  m = error.match(/^(\d+) of (\d+) tracks could not be downloaded: (.*)$/)
+  if (m) {
+    return translate('resources.seer.progress.missing', {
+      smart_count: Number(m[1]),
+      total: m[2],
+      list: m[3],
+    })
+  }
+  if (error.startsWith('storage limit reached')) {
+    return translate('resources.seer.storage.fullShort')
+  }
+  return error
+}
