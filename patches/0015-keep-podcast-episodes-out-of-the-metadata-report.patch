+// isPodcastPath tells downloaded podcast episodes (Seer/Podcasts/<channel>/...) from music.
+func isPodcastPath(p string) bool {
+	return strings.Contains("/"+strings.ToLower(filepath.ToSlash(p)), "/podcasts/")
+}
+
+// withoutPodcasts drops podcast episodes and the "albums" made only of them: a channel is not an
+// album and has no MusicBrainz release to match.
+func withoutPodcasts(albums model.Albums, files model.MediaFiles) (model.Albums, model.MediaFiles) {
+	music := make(model.MediaFiles, 0, len(files))
+	hasMusic := map[string]bool{}
+	for _, f := range files {
+		if isPodcastPath(f.Path) {
+			continue
+		}
+		music = append(music, f)
+		hasMusic[f.AlbumID] = true
+	}
+	keep := make(model.Albums, 0, len(albums))
+	for _, a := range albums {
+		if hasMusic[a.ID] {
+			keep = append(keep, a)
+		}
+	}
+	return keep, music
+}
+
 func buildMetaReport(albums model.Albums, files model.MediaFiles) *MetaReport {
+	albums, files = withoutPodcasts(albums, files)
 	r := &MetaReport{Songs: len(files), Albums: len(albums),
 		AlbumGroups: []AlbumGroup{}, ArtistGroups: []ArtistGroup{}, NoMBID: []AlbumVariant{}, Unknown: []UnknownTrack{}}
 
