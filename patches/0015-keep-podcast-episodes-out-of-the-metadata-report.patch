+func TestIsPodcastPath(t *testing.T) {
+	for p, want := range map[string]bool{
+		"Seer/Podcasts/Canal/2026-01-01 - ep.mp3": true, "Podcasts/Canal/ep.mp3": true,
+		"Seer/Blink/Podcasts Of Doom/01.flac": false, "Seer/Artista/Album/01.flac": false,
+	} {
+		if got := isPodcastPath(p); got != want {
+			t.Errorf("isPodcastPath(%q) = %v, want %v", p, got, want)
 		}
 	}
 }
