diff --git a/ui/src/seer/MetadataView.jsx b/ui/src/seer/MetadataView.jsx
new file mode 100644
index 0000000..baea501
--- /dev/null
+++ b/ui/src/seer/MetadataView.jsx
@@ -0,0 +1,257 @@
+import { useEffect, useState } from 'react'
+import { Button, Chip, Paper, Typography } from '@material-ui/core'
+import { makeStyles } from '@material-ui/core/styles'
+import { useHistory } from 'react-router-dom'
+import { useNotify, useTranslate } from 'react-admin'
+import { getMetadataReport } from './api'
+import { Section } from './components'
+
+// How many rows each list shows; the real totals are always printed.
+const LIMIT = 60
+
+const useStyles = makeStyles((theme) => ({
+  summary: {
+    display: 'grid',
+    gridTemplateColumns: 'repeat(auto-fit, minmax(140px, 1fr))',
+    gap: theme.spacing(1.5),
+    margin: theme.spacing(2, 0),
+  },
+  stat: {
+    padding: theme.spacing(2),
+    borderRadius: 16,
+    background: theme.palette.background.paper,
+  },
+  statValue: { fontSize: 26, fontWeight: 800, lineHeight: 1.1 },
+  row: {
+    display: 'flex',
+    alignItems: 'center',
+    gap: theme.spacing(1.5),
+    padding: theme.spacing(1.25, 1.5),
+    borderRadius: 12,
+    background: theme.palette.background.paper,
+    marginBottom: theme.spacing(1),
+  },
+  rowText: { flex: 1, minWidth: 0 },
+  rowTitle: { fontWeight: 600, overflow: 'hidden', textOverflow: 'ellipsis', whiteSpace: 'nowrap' },
+  rowMeta: { color: theme.palette.text.secondary, fontSize: 13, overflow: 'hidden', textOverflow: 'ellipsis', whiteSpace: 'nowrap' },
+  group: {
+    padding: theme.spacing(1.5),
+    borderRadius: 16,
+    border: `1px solid ${theme.palette.divider}`,
+    marginBottom: theme.spacing(1.5),
+  },
+  empty: { color: theme.palette.text.secondary, padding: theme.spacing(1, 0) },
+  more: { color: theme.palette.text.secondary, fontSize: 13, marginTop: theme.spacing(1) },
+}))
+
+const albumLine = (a) =>
+  [a.artist, a.year ? String(a.year) : '', `${a.songs} faixas`].filter(Boolean).join(' · ')
+
+const MetadataRow = ({ title, meta, actions, chip }) => {
+  const classes = useStyles()
+  return (
+    <div className={classes.row}>
+      <div className={classes.rowText}>
+        <div className={classes.rowTitle}>{title}</div>
+        <div className={classes.rowMeta}>{meta}</div>
+      </div>
+      {chip}
+      {actions}
+    </div>
+  )
+}
+
+// A list section: shows LIMIT rows and says how many more there are.
+const Rows = ({ items, render, empty }) => {
+  const classes = useStyles()
+  const translate = useTranslate()
+  if (items.length === 0) {
+    return <Typography className={classes.empty}>{empty}</Typography>
+  }
+  return (
+    <>
+      {items.slice(0, LIMIT).map(render)}
+      {items.length > LIMIT && (
+        <Typography className={classes.more}>
+          {translate('resources.seer.metadata.more', { count: items.length - LIMIT })}
+        </Typography>
+      )}
+    </>
+  )
+}
+
+export const MetadataView = () => {
+  const classes = useStyles()
+  const translate = useTranslate()
+  const notify = useNotify()
+  const history = useHistory()
+  const [report, setReport] = useState(null)
+
+  useEffect(() => {
+    getMetadataReport()
+      .then(setReport)
+      .catch(() => notify('resources.seer.metadata.loadError', 'warning'))
+  }, [notify])
+
+  const editAlbum = (id) => history.push(`/album/${id}/show`)
+  const editSong = (id) => history.push(`/song/${id}/show`)
+  const searchFor = (q) => history.push(`/seer?q=${encodeURIComponent(q)}`)
+
+  const albumActions = (a) => (
+    <>
+      <Button size="small" onClick={() => editAlbum(a.id)}>
+        {translate('resources.seer.metadata.edit')}
+      </Button>
+      {!a.mbzAlbumId && (
+        <Button size="small" onClick={() => searchFor(`${a.artist} ${a.name}`)}>
+          {translate('resources.seer.metadata.findInCatalog')}
+        </Button>
+      )}
+    </>
+  )
+
+  const albumRow = (a) => (
+    <MetadataRow
+      key={a.id}
+      title={a.name}
+      meta={albumLine(a)}
+      actions={albumActions(a)}
+    />
+  )
+
+  const back = (
+    <Button size="small" onClick={() => history.push('/seer')}>
+      {translate('resources.seer.metadata.back')}
+    </Button>
+  )
+
+  if (!report) {
+    return (
+      <Section title={translate('resources.seer.metadata.title')}>
+        <Typography className={classes.empty}>
+          {translate('resources.seer.metadata.loading')}
+        </Typography>
+      </Section>
+    )
+  }
+
+  const withMbid = report.songs ? Math.round((report.songsWithAlbumMbid / report.songs) * 100) : 0
+
+  return (
+    <Section
+      title={translate('resources.seer.metadata.title')}
+      action={back}
+    >
+      <Typography color="textSecondary">{translate('resources.seer.metadata.intro')}</Typography>
+
+      <div className={classes.summary}>
+        <Paper className={classes.stat} elevation={0}>
+          <div className={classes.statValue}>{report.songs}</div>
+          <Typography variant="body2" color="textSecondary">{translate('resources.seer.metadata.songs')}</Typography>
+        </Paper>
+        <Paper className={classes.stat} elevation={0}>
+          <div className={classes.statValue}>{report.albums}</div>
+          <Typography variant="body2" color="textSecondary">{translate('resources.seer.metadata.albums')}</Typography>
+        </Paper>
+        <Paper className={classes.stat} elevation={0}>
+          <div className={classes.statValue}>{report.artists}</div>
+          <Typography variant="body2" color="textSecondary">{translate('resources.seer.metadata.artists')}</Typography>
+        </Paper>
+        <Paper className={classes.stat} elevation={0}>
+          <div className={classes.statValue}>{withMbid}%</div>
+          <Typography variant="body2" color="textSecondary">{translate('resources.seer.metadata.withMbid')}</Typography>
+        </Paper>
+      </div>
+
+      <Section title={`${translate('resources.seer.metadata.noMbid')} (${report.noMbid?.length ?? 0})`}>
+        <div style={{ marginTop: 12 }}>
+          <Rows
+            items={report.noMbid || []}
+            render={albumRow}
+            empty={translate('resources.seer.metadata.none')}
+          />
+        </div>
+      </Section>
+
+      <Section title={`${translate('resources.seer.metadata.albumGroups')} (${report.albumGroups?.length ?? 0})`}>
+        <div style={{ marginTop: 12 }}>
+          {(report.albumGroups || []).length === 0 && (
+            <Typography className={classes.empty}>{translate('resources.seer.metadata.none')}</Typography>
+          )}
+          {(report.albumGroups || []).slice(0, LIMIT).map((g, i) => (
+            <div key={i} className={classes.group}>
+              <Chip
+                size="small"
+                color={g.sameReleaseGroup ? 'default' : 'secondary'}
+                label={translate(
+                  g.sameReleaseGroup
+                    ? 'resources.seer.metadata.sameEdition'
+                    : 'resources.seer.metadata.possibleDuplicate',
+                )}
+                style={{ marginBottom: 8 }}
+              />
+              {g.variants.map(albumRow)}
+            </div>
+          ))}
+        </div>
+      </Section>
+
+      <Section title={`${translate('resources.seer.metadata.artistGroups')} (${report.artistGroups?.length ?? 0})`}>
+        <div style={{ marginTop: 12 }}>
+          {(report.artistGroups || []).length === 0 && (
+            <Typography className={classes.empty}>{translate('resources.seer.metadata.none')}</Typography>
+          )}
+          {(report.artistGroups || []).slice(0, LIMIT).map((g, i) => (
+            <div key={i} className={classes.group}>
+              {g.variants.map((v) => (
+                <MetadataRow
+                  key={v.name}
+                  title={v.name}
+                  meta={translate('resources.seer.metadata.artistLine', { tracks: v.tracks, albums: v.albums?.length ?? 0 })}
+                  actions={
+                    <Button size="small" onClick={() => searchFor(v.name)}>
+                      {translate('resources.seer.metadata.findInCatalog')}
+                    </Button>
+                  }
+                />
+              ))}
+            </div>
+          ))}
+        </div>
+      </Section>
+
+      <Section title={`${translate('resources.seer.metadata.unknown')} (${report.unknown?.length ?? 0})`}>
+        <div style={{ marginTop: 12 }}>
+          <Rows
+            items={report.unknown || []}
+            empty={translate('resources.seer.metadata.none')}
+            render={(t) => (
+              <MetadataRow
+                key={t.id}
+                title={t.title || t.path}
+                meta={[t.artist, t.album, t.path].filter(Boolean).join(' · ')}
+                actions={
+                  <Button size="small" onClick={() => editSong(t.id)}>
+                    {translate('resources.seer.metadata.edit')}
+                  </Button>
+                }
+              />
+            )}
+          />
+        </div>
+      </Section>
+
+      <Section
+        title={`${translate('resources.seer.metadata.noCover')} (${report.noCoverTotal ?? report.noCover?.length ?? 0})`}
+      >
+        <div style={{ marginTop: 12 }}>
+          <Rows
+            items={report.noCover || []}
+            render={albumRow}
+            empty={translate('resources.seer.metadata.none')}
+          />
+        </div>
+      </Section>
+    </Section>
+  )
+}
