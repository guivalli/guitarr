+func TestRotateCandidatesMovesOnPerAttempt(t *testing.T) {
+	c := []slskCandidate{{User: "a", matchesAlbum: true}, {User: "b", matchesAlbum: true}, {User: "c", matchesAlbum: true}, {User: "d"}}
+	users := func(l []slskCandidate) string {
+		var s []string
+		for _, x := range l {
+			s = append(s, x.User)
+		}
+		return strings.Join(s, "")
+	}
+	if got := users(rotateCandidates(c, 0)); got != "abcd" {
+		t.Errorf("attempt 0 keeps the order, got %s", got)
+	}
+	if got := users(rotateCandidates(c, 1)); got != "bcad" {
+		t.Errorf("attempt 1, got %s", got)
+	}
+	if got := users(rotateCandidates(c, 2)); got != "cabd" {
+		t.Errorf("attempt 2, got %s", got)
+	}
+}
