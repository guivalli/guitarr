+// retryState remembers, in memory, how a failed request has been retried: how
+// many times and which sources already failed, so the next try goes another way.
+type retryState struct {
+	attempt int
+	failed  map[string]bool
+}
+
+// noteRetry records a retry of a failed request. The sources that failed are
+// read from the request's error ("youtube: ...; soulseek: ...").
+func (s *Service) noteRetry(id, lastError string) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	rs := s.retries[id]
+	if rs == nil {
+		rs = &retryState{failed: map[string]bool{}}
+		s.retries[id] = rs
+	}
+	rs.attempt++
+	for _, src := range s.sources {
+		if strings.Contains(lastError, src.Name()+": ") {
+			rs.failed[src.Name()] = true
+		}
+	}
+}
+
+// retryOrder returns the attempt number and the sources in the order to try
+// them: the ones that did not fail last time first, the failed ones after.
+func (s *Service) retryOrder(id string) (int, []Source) {
+	s.mu.Lock()
+	rs := s.retries[id]
+	s.mu.Unlock()
+	if rs == nil {
+		return 0, s.sources
+	}
+	var first, last []Source
+	for _, src := range s.sources {
+		if rs.failed[src.Name()] {
+			last = append(last, src)
+		} else {
+			first = append(first, src)
+		}
+	}
+	return rs.attempt, append(first, last...)
+}
