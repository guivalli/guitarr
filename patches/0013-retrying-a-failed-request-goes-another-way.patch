+// rotateCandidates makes a retry start from another peer: among the leading
+// candidates of the same kind (album folders, or loose files) the one tried
+// first moves on by one per attempt.
+func rotateCandidates(c []slskCandidate, attempt int) []slskCandidate {
+	if attempt <= 0 || len(c) < 2 {
+		return c
+	}
+	n := 0
+	for n < len(c) && n < 5 && c[n].matchesAlbum == c[0].matchesAlbum {
+		n++
+	}
+	if n < 2 {
+		return c
+	}
+	k := attempt % n
+	out := make([]slskCandidate, 0, len(c))
+	out = append(out, c[k:n]...)
+	out = append(out, c[:k]...)
+	return append(out, c[n:]...)
+}
+
