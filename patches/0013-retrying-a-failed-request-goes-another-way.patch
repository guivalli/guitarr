+// orderSource records the order in which sources are asked and the attempt number.
+type orderSource struct {
+	name  string
+	kind  Kind
+	fail  bool
+	lib   *fakeLib
+	log   *[]string
+	mu    *sync.Mutex
+	tries *[]int
+}
+
+func (s *orderSource) Name() string         { return s.name }
+func (s *orderSource) Enabled() bool        { return true }
+func (s *orderSource) Supports(k Kind) bool { return k == s.kind }
+func (s *orderSource) Fetch(_ context.Context, r Request, _ string) (Result, error) {
+	s.mu.Lock()
+	*s.log = append(*s.log, s.name)
+	*s.tries = append(*s.tries, r.Attempt)
+	s.mu.Unlock()
+	if s.fail {
+		return Result{}, errors.New("boom")
+	}
+	s.lib.mu.Lock()
+	s.lib.have[r.MBID] = true
+	s.lib.mu.Unlock()
+	return Result{Paths: []string{"/music/x.opus"}}, nil
+}
+
+func TestRetryAvoidsTheSourceThatFailed(t *testing.T) {
+	lib := &fakeLib{have: map[string]bool{}}
+	st := NewMemoryStore()
+	var mu sync.Mutex
+	var log []string
+	var tries []int
+	srcs := []Source{
+		&orderSource{name: "youtube", kind: KindTrack, fail: true, lib: lib, log: &log, mu: &mu, tries: &tries},
+		&orderSource{name: "soundcloud", kind: KindTrack, lib: lib, log: &log, mu: &mu, tries: &tries},
+	}
+	svc := NewService(fastConfig(false), fakeCatalog{}, srcs, st, lib)
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	svc.Start(ctx)
+
+	req, _ := svc.Submit(ctx, "u", CatalogItem{Kind: KindTrack, MBID: "m9", Artist: "A", Title: "T"})
+	// a request that failed on youtube only (soundcloud was never reached)
+	r, _ := st.Get(ctx, req.ID)
+	r.Status, r.Error = StatusFailed, "youtube: boom"
+	if err := st.Update(ctx, r); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := svc.Approve(ctx, req.ID); err != nil {
+		t.Fatal(err)
+	}
+	waitStatus(t, st, req.ID, StatusAvailable)
+
+	mu.Lock()
+	defer mu.Unlock()
+	if len(log) == 0 || log[0] != "soundcloud" {
+		t.Errorf("a retry should start with the source that did not fail, got order %v", log)
+	}
+	if len(tries) == 0 || tries[0] != 1 {
+		t.Errorf("the first retry should be attempt 1, got %v", tries)
+	}
+}
