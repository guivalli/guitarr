+import { Chip } from '@material-ui/core'
+import { useTranslate } from 'react-admin'
+
+const colors = {
+  available: 'primary',
+  failed: 'secondary',
+}
+
+export const StatusChip = ({ status, error }) => {
+  const translate = useTranslate()
+  return (
+    <Chip
+      size="small"
+      variant={status === 'available' ? 'default' : 'outlined'}
+      color={colors[status] || 'default'}
+      label={translate(`resources.seer.status.${status}`, { _: status })}
+      title={error || undefined}
+    />
+  )
+}
