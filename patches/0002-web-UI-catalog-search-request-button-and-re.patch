@@ -0,0 +1,120 @@
+import React from 'react'
+import { render, fireEvent } from '@testing-library/react'
+import { describe, it, expect, vi, beforeEach } from 'vitest'
+import * as RA from 'react-admin'
+import { CatalogResults } from './CatalogResults'
+import { RequestsTable } from './RequestsTable'
+
+vi.mock('react-admin', async () => {
+  const actual = await vi.importActual('react-admin')
+  return {
+    ...actual,
+    useTranslate: () => (key) => key,
+    useNotify: vi.fn(),
+    useDataProvider: vi.fn(),
+    usePermissions: vi.fn(() => ({ permissions: 'user' })),
+  }
+})
+
+vi.mock('react-redux', async () => {
+  const actual = await vi.importActual('react-redux')
+  return { ...actual, useDispatch: () => vi.fn() }
+})
+
+vi.mock('react-router-dom', async () => {
+  const actual = await vi.importActual('react-router-dom')
+  return { ...actual, useHistory: () => ({ push: vi.fn() }) }
+})
+
+const items = [
+  {
+    kind: 'album',
+    mbid: 'a1',
+    title: 'Owned',
+    artist: 'X',
+    inLibrary: true,
+    libraryId: 'l1',
+  },
+  { kind: 'track', mbid: 't1', title: 'Missing', artist: 'X' },
+  { kind: 'track', mbid: 't2', title: 'Asked', artist: 'X' },
+]
+
+describe('CatalogResults', () => {
+  it('shows open for owned items, request for missing ones and the status of active requests', () => {
+    const onRequest = vi.fn()
+    const requests = [
+      { id: 'r', kind: 'track', mbid: 't2', status: 'downloading' },
+    ]
+    const { getByText, getAllByText } = render(
+      <CatalogResults
+        items={items}
+        requests={requests}
+        onRequest={onRequest}
+      />,
+    )
+    expect(getByText('resources.seer.actions.open')).toBeTruthy()
+    expect(getByText('resources.seer.status.downloading')).toBeTruthy()
+    const requestButtons = getAllByText('resources.seer.actions.request')
+    expect(requestButtons).toHaveLength(1)
+    fireEvent.click(requestButtons[0])
+    expect(onRequest).toHaveBeenCalledWith(items[1])
+  })
+})
+
+describe('RequestsTable', () => {
+  const requests = [
+    {
+      id: '1',
+      kind: 'track',
+      title: 'P',
+      artist: 'A',
+      status: 'pending',
+      createdAt: '2026-10-10T00:00:00Z',
+    },
+    {
+      id: '2',
+      kind: 'album',
+      title: 'F',
+      artist: 'A',
+      status: 'failed',
+      error: 'boom',
+      createdAt: '2026-10-10T00:00:00Z',
+    },
+    {
+      id: '3',
+      kind: 'album',
+      title: 'OK',
+      artist: 'A',
+      status: 'available',
+      createdAt: '2026-10-10T00:00:00Z',
+    },
+  ]
+
+  beforeEach(() => vi.clearAllMocks())
+
+  it('hides approval buttons from regular users', () => {
+    const { queryByText, getByText } = render(
+      <RequestsTable requests={requests} onApprove={vi.fn()} />,
+    )
+    expect(queryByText('resources.seer.actions.approve')).toBeNull()
+    expect(getByText('boom')).toBeTruthy()
+  })
+
+  it('lets admins approve pending and retry failed requests', () => {
+    RA.usePermissions.mockReturnValue({ permissions: 'admin' })
+    const onApprove = vi.fn()
+    const { getByText } = render(
+      <RequestsTable requests={requests} onApprove={onApprove} />,
+    )
+    fireEvent.click(getByText('resources.seer.actions.approve'))
+    fireEvent.click(getByText('resources.seer.actions.retry'))
+    expect(onApprove.mock.calls.map((c) => c[0].id)).toEqual(['1', '2'])
+  })
+
+  it('shows an empty message', () => {
+    const { getByText } = render(
+      <RequestsTable requests={[]} onApprove={vi.fn()} />,
+    )
+    expect(getByText('resources.seer.message.noRequests')).toBeTruthy()
+  })
+})
