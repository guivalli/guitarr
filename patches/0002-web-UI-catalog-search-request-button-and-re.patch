+import { useCallback, useEffect, useState } from 'react'
+import {
+  Card,
+  CardContent,
+  CircularProgress,
+  InputAdornment,
+  TextField,
+  Typography,
+} from '@material-ui/core'
+import { makeStyles } from '@material-ui/core/styles'
+import SearchIcon from '@material-ui/icons/Search'
+import { Title, useNotify, useTranslate } from 'react-admin'
+import { useRefreshOnEvents } from '../common'
+import config from '../config'
+import {
+  approveRequest,
+  createRequest,
+  listRequests,
+  searchCatalog,
+} from './api'
+import { CatalogResults } from './CatalogResults'
+import { RequestsTable } from './RequestsTable'
+
+const useStyles = makeStyles((theme) => ({
+  root: { marginTop: theme.spacing(2) },
+  section: { marginBottom: theme.spacing(2) },
+  progress: { display: 'block', margin: theme.spacing(2, 'auto') },
+}))
+
+const errorMessage = (err) => err?.body || err?.message || String(err)
+
+const SeerPage = () => {
+  const classes = useStyles()
+  const translate = useTranslate()
+  const notify = useNotify()
+  const [query, setQuery] = useState('')
+  const [results, setResults] = useState(null)
+  const [searching, setSearching] = useState(false)
+  const [requests, setRequests] = useState([])
+
+  const loadRequests = useCallback(
+    () =>
+      listRequests()
+        .then(setRequests)
+        .catch((err) => notify(errorMessage(err), 'warning')),
+    [notify],
+  )
+
+  useEffect(() => {
+    loadRequests()
+  }, [loadRequests])
+  useRefreshOnEvents({ events: ['seer'], onRefresh: loadRequests })
+
+  // Debounced catalog search: MusicBrainz is slow (1 request/second), so wait for a pause.
+  useEffect(() => {
+    const q = query.trim()
+    if (q.length < 2) {
+      setResults(null)
+      return
+    }
+    let cancelled = false
+    const timer = setTimeout(
+      () => {
+        setSearching(true)
+        searchCatalog(q)
+          .then((items) => !cancelled && setResults(items))
+          .catch((err) => !cancelled && notify(errorMessage(err), 'warning'))
+          .finally(() => !cancelled && setSearching(false))
+      },
+      Math.max(config.uiSearchDebounceMs, 600),
+    )
+    return () => {
+      cancelled = true
+      clearTimeout(timer)
+    }
+  }, [query, notify])
+
+  const request = (item) =>
+    createRequest(item)
+      .then((req) => {
+        notify('resources.seer.message.requested', 'info')
+        setRequests((rs) => [req, ...rs.filter((r) => r.id !== req.id)])
+      })
+      .catch((err) => notify(errorMessage(err), 'warning'))
+
+  const approve = (req) =>
+    approveRequest(req.id)
+      .then(loadRequests)
+      .catch((err) => notify(errorMessage(err), 'warning'))
+
+  return (
+    <div className={classes.root}>
+      <Title
+        title={
+          'Navidrome - ' + translate('resources.seer.name', { smart_count: 2 })
+        }
+      />
+      <Card className={classes.section}>
+        <CardContent>
+          <TextField
+            fullWidth
+            autoFocus
+            variant="outlined"
+            placeholder={translate('resources.seer.message.searchPlaceholder')}
+            value={query}
+            onChange={(e) => setQuery(e.target.value)}
+            InputProps={{
+              startAdornment: (
+                <InputAdornment position="start">
+                  <SearchIcon />
+                </InputAdornment>
+              ),
+            }}
+          />
+          {searching && <CircularProgress className={classes.progress} />}
+          {!searching && results && results.length === 0 && (
+            <Typography variant="body2" color="textSecondary">
+              {translate('resources.seer.message.noResults')}
+            </Typography>
+          )}
+          {!searching && results && results.length > 0 && (
+            <CatalogResults
+              items={results}
+              requests={requests}
+              onRequest={request}
+            />
+          )}
+        </CardContent>
+      </Card>
+      <Card>
+        <CardContent>
+          <Typography variant="h6" gutterBottom>
+            {translate('resources.seer.requests')}
+          </Typography>
+          <RequestsTable requests={requests} onApprove={approve} />
+        </CardContent>
+      </Card>
+    </div>
+  )
+}
+
+export default SeerPage
