+import httpClient from '../dataProvider/httpClient'
+import { REST_URL } from '../consts'
+
+const SEER_URL = `${REST_URL}/seer`
+
+export const searchCatalog = (q, limit = 20) =>
+  httpClient(
+    `${SEER_URL}/catalog?q=${encodeURIComponent(q)}&limit=${limit}`,
+  ).then(({ json }) => json)
+
+export const listRequests = () =>
+  httpClient(`${SEER_URL}/requests`).then(({ json }) => json)
+
+export const createRequest = (item) =>
+  httpClient(`${SEER_URL}/requests`, {
+    method: 'POST',
+    body: JSON.stringify(item),
+  }).then(({ json }) => json)
+
+export const approveRequest = (id) =>
+  httpClient(`${SEER_URL}/requests/${id}/approve`, { method: 'POST' }).then(
+    ({ json }) => json,
+  )
