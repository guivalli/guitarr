diff --git a/ui/src/seer/CatalogResults.jsx b/ui/src/seer/CatalogResults.jsx
new file mode 100644
index 0000000..86699e8
--- /dev/null
+++ b/ui/src/seer/CatalogResults.jsx
@@ -0,0 +1,97 @@
+import {
+  Button,
+  List,
+  ListItem,
+  ListItemIcon,
+  ListItemSecondaryAction,
+  ListItemText,
+} from '@material-ui/core'
+import AlbumIcon from '@material-ui/icons/Album'
+import MusicNoteIcon from '@material-ui/icons/MusicNote'
+import PlayArrowIcon from '@material-ui/icons/PlayArrow'
+import AddIcon from '@material-ui/icons/Add'
+import { useDataProvider, useNotify, useTranslate } from 'react-admin'
+import { useDispatch } from 'react-redux'
+import { useHistory } from 'react-router-dom'
+import { playTracks } from '../actions'
+import { StatusChip } from './StatusChip'
+
+const describe = (item) =>
+  [item.artist, item.kind === 'track' ? item.album : null, item.year]
+    .filter(Boolean)
+    .join(' · ')
+
+const OwnedAction = ({ item }) => {
+  const translate = useTranslate()
+  const dataProvider = useDataProvider()
+  const dispatch = useDispatch()
+  const history = useHistory()
+  const notify = useNotify()
+
+  const play = () => {
+    if (item.kind === 'album') {
+      history.push(`/album/${item.libraryId}/show`)
+      return
+    }
+    dataProvider
+      .getOne('song', { id: item.libraryId })
+      .then(({ data }) => dispatch(playTracks({ [data.id]: data }, [data.id])))
+      .catch(() => notify('ra.page.error', 'warning'))
+  }
+
+  return (
+    <Button size="small" color="primary" onClick={play}>
+      <PlayArrowIcon fontSize="small" />
+      {translate(
+        item.kind === 'album'
+          ? 'resources.seer.actions.open'
+          : 'resources.seer.actions.play',
+      )}
+    </Button>
+  )
+}
+
+export const CatalogResults = ({ items, requests, onRequest }) => {
+  const translate = useTranslate()
+  const findRequest = (item) =>
+    requests.find(
+      (r) =>
+        r.kind === item.kind && r.mbid === item.mbid && r.status !== 'failed',
+    )
+
+  return (
+    <List dense>
+      {items.map((item) => {
+        const req = findRequest(item)
+        return (
+          <ListItem key={`${item.kind}-${item.mbid}`}>
+            <ListItemIcon>
+              {item.kind === 'album' ? <AlbumIcon /> : <MusicNoteIcon />}
+            </ListItemIcon>
+            <ListItemText
+              primary={item.title}
+              secondary={`${translate(`resources.seer.kind.${item.kind}`)} · ${describe(item)}`}
+            />
+            <ListItemSecondaryAction>
+              {item.inLibrary ? (
+                <OwnedAction item={item} />
+              ) : req ? (
+                <StatusChip status={req.status} error={req.error} />
+              ) : (
+                <Button
+                  size="small"
+                  variant="outlined"
+                  color="primary"
+                  onClick={() => onRequest(item)}
+                >
+                  <AddIcon fontSize="small" />
+                  {translate('resources.seer.actions.request')}
+                </Button>
+              )}
+            </ListItemSecondaryAction>
+          </ListItem>
+        )
+      })}
+    </List>
+  )
+}
diff --git a/ui/src/seer/RequestsTable.jsx b/ui/src/seer/RequestsTable.jsx
new file mode 100644
index 0000000..bc28a9a
--- /dev/null
+++ b/ui/src/seer/RequestsTable.jsx
@@ -0,0 +1,87 @@
+import {
+  Button,
+  Table,
+  TableBody,
+  TableCell,
+  TableHead,
+  TableRow,
+  Typography,
+} from '@material-ui/core'
+import { usePermissions, useTranslate } from 'react-admin'
+import { StatusChip } from './StatusChip'
+
+const formatDate = (d) => new Date(d).toLocaleString()
+
+export const RequestsTable = ({ requests, onApprove }) => {
+  const translate = useTranslate()
+  const { permissions } = usePermissions()
+  const isAdmin = permissions === 'admin'
+
+  if (requests.length === 0) {
+    return (
+      <Typography variant="body2" color="textSecondary">
+        {translate('resources.seer.message.noRequests')}
+      </Typography>
+    )
+  }
+
+  return (
+    <Table size="small">
+      <TableHead>
+        <TableRow>
+          <TableCell>{translate('resources.seer.fields.title')}</TableCell>
+          <TableCell>{translate('resources.seer.fields.artist')}</TableCell>
+          <TableCell>{translate('resources.seer.fields.status')}</TableCell>
+          <TableCell>{translate('resources.seer.fields.source')}</TableCell>
+          <TableCell>{translate('resources.seer.fields.createdAt')}</TableCell>
+          {isAdmin && <TableCell />}
+        </TableRow>
+      </TableHead>
+      <TableBody>
+        {requests.map((r) => (
+          <TableRow key={r.id}>
+            <TableCell>
+              {r.title}
+              <Typography
+                variant="caption"
+                display="block"
+                color="textSecondary"
+              >
+                {translate(`resources.seer.kind.${r.kind}`)}
+                {r.kind === 'track' && r.album ? ` · ${r.album}` : ''}
+              </Typography>
+            </TableCell>
+            <TableCell>{r.artist}</TableCell>
+            <TableCell>
+              <StatusChip status={r.status} error={r.error} />
+              {r.status === 'failed' && r.error && (
+                <Typography variant="caption" display="block" color="error">
+                  {r.error}
+                </Typography>
+              )}
+            </TableCell>
+            <TableCell>{r.source || '—'}</TableCell>
+            <TableCell>{formatDate(r.createdAt)}</TableCell>
+            {isAdmin && (
+              <TableCell align="right">
+                {(r.status === 'pending' || r.status === 'failed') && (
+                  <Button
+                    size="small"
+                    color="primary"
+                    onClick={() => onApprove(r)}
+                  >
+                    {translate(
+                      r.status === 'pending'
+                        ? 'resources.seer.actions.approve'
+                        : 'resources.seer.actions.retry',
+                    )}
+                  </Button>
+                )}
+              </TableCell>
+            )}
+          </TableRow>
+        ))}
+      </TableBody>
+    </Table>
+  )
+}
