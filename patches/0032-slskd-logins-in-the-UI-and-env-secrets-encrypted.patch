+
+// AdoptEnvSecrets copies the API keys and secrets given in the environment
+// (.env) into the database, encrypted, when the UI has not saved them yet. After
+// one start they can be deleted from .env.
+func (s *Settings) AdoptEnvSecrets(ctx context.Context) (int, error) {
+	o, err := s.stored(ctx)
+	if err != nil {
+		return 0, err
+	}
+	opts := conf.Server.Seer
+	var patch Overrides
+	n := 0
+	adopt := func(saved *string, env string) *string {
+		if saved != nil || env == "" {
+			return nil
+		}
+		n++
+		return &env
+	}
+	patch.SoulseekAPIKey = adopt(o.SoulseekAPIKey, opts.Soulseek.ApiKey)
+	patch.LidarrAPIKey = adopt(o.LidarrAPIKey, opts.Lidarr.ApiKey)
+	patch.SpotifyClientSecret = adopt(o.SpotifyClientSecret, opts.Spotify.ClientSecret)
+	if n == 0 {
+		return 0, nil
+	}
+	return n, s.Update(ctx, patch)
 }
 
 // MinFreeSpace is the free space to keep on the disk, from the UI or the .env.
diff --git a/core/seer/slskd_config.go b/core/seer/slskd_config.go
new file mode 100644
index 00000000..ac6473fb
--- /dev/null
+++ b/core/seer/slskd_config.go
@@ -0,0 +1,235 @@
+package seer
+
+import (
+	"bytes"
+	"context"
+	"fmt"
+	"net/http"
+	"os"
+	"strings"
+	"time"
+
+	"github.com/navidrome/navidrome/conf"
+	"github.com/navidrome/navidrome/log"
+	"gopkg.in/yaml.v3"
+)
+
+// The Soulseek account and the slskd web login live in slskd's own config file
+// (slskd.yml), which slskd watches and reloads. With Seer.Soulseek.ConfigFile
+// pointing at it, admins change them in the UI instead of in .env.
+var (
+	slskdSoulseekUser = []string{"soulseek", "username"}
+	slskdSoulseekPass = []string{"soulseek", "password"}
+	slskdWebUser      = []string{"web", "authentication", "username"}
+	slskdWebPass      = []string{"web", "authentication", "password"}
+)
+
+// SlskdAccount is what the UI may change in slskd.yml; nil fields stay as they are.
+type SlskdAccount struct {
+	SoulseekUsername *string
+	SoulseekPassword *string
+	WebUsername      *string
+	WebPassword      *string
+}
+
+func (a SlskdAccount) empty() bool {
+	return a.SoulseekUsername == nil && a.SoulseekPassword == nil && a.WebUsername == nil && a.WebPassword == nil
+}
+
+// takeAccount moves the slskd fields out of a UI patch: they go to slskd.yml, never to the database.
+func takeAccount(p *Overrides) SlskdAccount {
+	a := SlskdAccount{p.SoulseekUsername, p.SoulseekPassword, p.SlskdWebUsername, p.SlskdWebPassword}
+	p.SoulseekUsername, p.SoulseekPassword, p.SlskdWebUsername, p.SlskdWebPassword = nil, nil, nil, nil
+	return a
+}
+
+func slskdConfigFile() string { return strings.TrimSpace(conf.Server.Seer.Soulseek.ConfigFile) }
+
+// loadYAML reads a YAML file as a node tree (comments kept). A missing or
+// comment-only file gives an empty mapping.
+func loadYAML(path string) (*yaml.Node, error) {
+	data, err := os.ReadFile(path)
+	if err != nil && !os.IsNotExist(err) {
+		return nil, err
+	}
+	var doc yaml.Node
+	if err := yaml.Unmarshal(data, &doc); err != nil {
+		return nil, fmt.Errorf("%s: %w", path, err)
+	}
+	if doc.Kind != yaml.DocumentNode {
+		doc = yaml.Node{Kind: yaml.DocumentNode, HeadComment: doc.HeadComment}
+	}
+	if len(doc.Content) == 0 || doc.Content[0].Kind != yaml.MappingNode {
+		doc.Content = []*yaml.Node{{Kind: yaml.MappingNode, Tag: "!!map"}}
+	}
+	return &doc, nil
+}
+
+func yamlGet(doc *yaml.Node, keys ...string) string {
+	n := doc.Content[0]
+	for _, k := range keys {
+		n = yamlChild(n, k)
+		if n == nil {
+			return ""
+		}
+	}
+	if n.Kind != yaml.ScalarNode {
+		return ""
+	}
+	return n.Value
+}
+
+func yamlChild(m *yaml.Node, key string) *yaml.Node {
+	if m == nil || m.Kind != yaml.MappingNode {
+		return nil
+	}
+	for i := 0; i+1 < len(m.Content); i += 2 {
+		if m.Content[i].Value == key {
+			return m.Content[i+1]
+		}
+	}
+	return nil
+}
+
+// yamlSet writes a string at the path, creating the mappings on the way.
+func yamlSet(doc *yaml.Node, value string, keys ...string) {
+	m := doc.Content[0]
+	for i, k := range keys {
+		child := yamlChild(m, k)
+		last := i == len(keys)-1
+		if child == nil || (!last && child.Kind != yaml.MappingNode) {
+			if child == nil {
+				child = &yaml.Node{}
+				m.Content = append(m.Content, &yaml.Node{Kind: yaml.ScalarNode, Tag: "!!str", Value: k}, child)
+			}
+			if last {
+				*child = yaml.Node{Kind: yaml.ScalarNode}
+			} else {
+				*child = yaml.Node{Kind: yaml.MappingNode, Tag: "!!map"}
+			}
+		}
+		if last {
+			child.Kind, child.Tag, child.Value, child.Style = yaml.ScalarNode, "!!str", value, yaml.DoubleQuotedStyle
+		}
+		m = child
+	}
+}
+
+func saveYAML(path string, doc *yaml.Node) error {
+	var buf bytes.Buffer
+	enc := yaml.NewEncoder(&buf)
+	enc.SetIndent(2)
+	if err := enc.Encode(doc); err != nil {
+		return err
+	}
+	_ = enc.Close()
+	// Written in place (not renamed): the file is usually a single-file bind mount.
+	if err := os.WriteFile(path, buf.Bytes(), 0o600); err != nil {
+		return err
+	}
+	return os.Chmod(path, 0o600)
+}
+
+// slskdView fills the account part of the settings view from slskd.yml.
+func slskdView(v *ConfigView) {
+	path := slskdConfigFile()
+	if path == "" {
+		return
+	}
+	doc, err := loadYAML(path)
+	if err != nil {
+		log.Warn("Seer: reading slskd.yml failed", "path", path, err)
+		return
+	}
+	v.SlskdConfig = true
+	v.SoulseekUsername = yamlGet(doc, slskdSoulseekUser...)
+	v.SoulseekPasswordSet = yamlGet(doc, slskdSoulseekPass...) != ""
+	v.SlskdWebUsername = yamlGet(doc, slskdWebUser...)
+	v.SlskdWebPasswordSet = yamlGet(doc, slskdWebPass...) != ""
+}
+
+// writeSlskdAccount saves the account in slskd.yml. It reports whether the
+// Soulseek login changed, which needs a reconnect.
+func writeSlskdAccount(a SlskdAccount) (bool, error) {
+	path := slskdConfigFile()
+	if path == "" {
+		return false, fmt.Errorf("%w: slskd.yml is not available (set ND_SEER_SOULSEEK_CONFIGFILE)", ErrInvalidConfig)
+	}
+	doc, err := loadYAML(path)
+	if err != nil {
+		return false, err
+	}
+	reconnect := false
+	set := func(v *string, keys []string, soulseek bool) error {
+		if v == nil {
+			return nil
+		}
+		val := strings.TrimSpace(*v)
+		if val == "" {
+			return fmt.Errorf("%w: %s cannot be empty", ErrInvalidConfig, strings.Join(keys, "."))
+		}
+		if yamlGet(doc, keys...) != val {
+			yamlSet(doc, val, keys...)
+			reconnect = reconnect || soulseek
+		}
+		return nil
+	}
+	for _, f := range []struct {
+		v        *string
+		keys     []string
+		soulseek bool
+	}{{a.SoulseekUsername, slskdSoulseekUser, true}, {a.SoulseekPassword, slskdSoulseekPass, true},
+		{a.WebUsername, slskdWebUser, false}, {a.WebPassword, slskdWebPass, false}} {
+		if err := set(f.v, f.keys, f.soulseek); err != nil {
+			return false, err
+		}
+	}
+	return reconnect, saveYAML(path, doc)
+}
+
+// reconnectSlskd asks slskd to log in to Soulseek again once it reloaded slskd.yml.
+func reconnectSlskd(url, apiKey string) {
+	if url == "" || apiKey == "" {
+		return
+	}
+	go func() {
+		time.Sleep(3 * time.Second) // slskd reloads the file on its own; give it a moment
+		client := &http.Client{Timeout: 20 * time.Second}
+		for _, step := range []struct{ method, body string }{
+			{http.MethodDelete, `"Guitarr: Soulseek login changed"`}, {http.MethodPut, ""},
+		} {
+			req, err := http.NewRequest(step.method, strings.TrimRight(url, "/")+"/api/v0/server", strings.NewReader(step.body))
+			if err != nil {
+				return
+			}
+			req.Header.Set("X-API-Key", apiKey)
+			req.Header.Set("Content-Type", "application/json")
+			resp, err := client.Do(req)
+			if err != nil {
+				log.Warn("Seer: reconnecting slskd failed", err)
+				return
+			}
+			resp.Body.Close()
+			time.Sleep(2 * time.Second)
+		}
+		log.Info("Seer: slskd reconnected with the new Soulseek login")
+	}()
+}
+
+// applySlskdAccount writes the account and reconnects slskd when the Soulseek login changed.
+func (s *Seer) applySlskdAccount(ctx context.Context, a SlskdAccount) error {
+	if a.empty() {
+		return nil
+	}
+	reconnect, err := writeSlskdAccount(a)
+	if err != nil || !reconnect {
+		return err
+	}
+	o, err := s.Settings.Resolved(ctx)
+	if err != nil {
+		return err
+	}
+	opts := conf.Server.Seer.Soulseek
+	reconnectSlskd(pick(o.SoulseekURL, opts.URL), pick(o.SoulseekAPIKey, opts.ApiKey))
+	return nil
+}
diff --git a/core/seer/slskd_config_test.go b/core/seer/slskd_config_test.go
new file mode 100644
index 00000000..df7a8e4a
--- /dev/null
+++ b/core/seer/slskd_config_test.go
@@ -0,0 +1,77 @@
+package seer
+
+import (
+	"errors"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/navidrome/navidrome/conf"
+)
+
+func TestSlskdAccountInYAML(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "slskd.yml")
+	orig := "# slskd config\n# soulseek:\n#   username: ~\nshares:\n  directories:\n    - /music # keep me\n"
+	if err := os.WriteFile(path, []byte(orig), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	old := conf.Server.Seer.Soulseek.ConfigFile
+	conf.Server.Seer.Soulseek.ConfigFile = path
+	defer func() { conf.Server.Seer.Soulseek.ConfigFile = old }()
+
+	var v ConfigView
+	slskdView(&v)
+	if !v.SlskdConfig || v.SoulseekUsername != "" || v.SoulseekPasswordSet {
+		t.Fatalf("empty view = %+v", v)
+	}
+
+	user, pass, web, webPass := "user", `p@ss: "x" #1`, "admin", "w"
+	reconnect, err := writeSlskdAccount(SlskdAccount{SoulseekUsername: &user, SoulseekPassword: &pass, WebUsername: &web, WebPassword: &webPass})
+	if err != nil || !reconnect {
+		t.Fatalf("write: %v %v", reconnect, err)
+	}
+	data, _ := os.ReadFile(path)
+	s := string(data)
+	if !strings.Contains(s, "- /music # keep me") || !strings.Contains(s, "# slskd config") {
+		t.Errorf("comments or other keys lost:\n%s", s)
+	}
+	if st, _ := os.Stat(path); st.Mode().Perm() != 0o600 {
+		t.Errorf("mode = %v", st.Mode().Perm())
+	}
+	doc, err := loadYAML(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if yamlGet(doc, slskdSoulseekPass...) != pass || yamlGet(doc, slskdWebUser...) != "admin" {
+		t.Errorf("read back:\n%s", s)
+	}
+	slskdView(&v)
+	if v.SoulseekUsername != "user" || !v.SoulseekPasswordSet || v.SlskdWebUsername != "admin" || !v.SlskdWebPasswordSet {
+		t.Errorf("view = %+v", v)
+	}
+
+	// only the web password changes: no Soulseek reconnect
+	webPass = "w2"
+	if reconnect, err := writeSlskdAccount(SlskdAccount{WebPassword: &webPass, SoulseekUsername: &user}); err != nil || reconnect {
+		t.Errorf("web only: %v %v", reconnect, err)
+	}
+	empty := " "
+	if _, err := writeSlskdAccount(SlskdAccount{SoulseekPassword: &empty}); !errors.Is(err, ErrInvalidConfig) {
+		t.Errorf("empty password accepted: %v", err)
+	}
+
+	conf.Server.Seer.Soulseek.ConfigFile = ""
+	if _, err := writeSlskdAccount(SlskdAccount{SoulseekUsername: &user}); !errors.Is(err, ErrInvalidConfig) {
+		t.Errorf("no file: %v", err)
+	}
+}
+
+func TestTakeAccountKeepsSlskdOutOfTheDatabase(t *testing.T) {
+	u, src := "user", "soulseek"
+	p := Overrides{SoulseekUsername: &u, Sources: &src}
+	a := takeAccount(&p)
+	if a.SoulseekUsername == nil || p.SoulseekUsername != nil || p.Sources == nil || a.empty() {
+		t.Errorf("take: %+v %+v", a, p)
+	}
+}
