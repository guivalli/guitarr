+func (api *Router) listImports(w http.ResponseWriter, r *http.Request) {
+	user, _ := request.UserFrom(r.Context())
+	userID := user.ID
+	if user.IsAdmin && r.URL.Query().Get("mine") != "true" {
+		userID = ""
+	}
+	jobs, err := api.imp.Jobs(r.Context(), userID)
+	if err != nil {
+		log.Error(r.Context(), "Seer: listing imports failed", err)
+		http.Error(w, "internal error", http.StatusInternalServerError)
+		return
+	}
+	if jobs == nil {
+		jobs = []acquire.ImportJob{}
+	}
+	writeJSON(w, http.StatusOK, jobs)
+}
+
+// createImport takes {"url": "...", "sync": true} or a multipart "file" upload.
+func (api *Router) createImport(w http.ResponseWriter, r *http.Request) {
+	user, _ := request.UserFrom(r.Context())
+	var job *acquire.ImportJob
+	var err error
+	if strings.HasPrefix(r.Header.Get("Content-Type"), "multipart/") {
+		r.Body = http.MaxBytesReader(w, r.Body, 32<<20)
+		file, hdr, ferr := r.FormFile("file")
+		if ferr != nil {
+			http.Error(w, "file is required", http.StatusBadRequest)
+			return
+		}
+		defer file.Close()
+		data, rerr := io.ReadAll(file)
+		if rerr != nil {
+			http.Error(w, "file too large", http.StatusBadRequest)
+			return
+		}
+		list, perr := acquire.ParseImportFile(hdr.Filename, data)
+		if perr != nil {
+			http.Error(w, perr.Error(), http.StatusBadRequest)
+			return
+		}
+		if name := strings.TrimSpace(r.FormValue("name")); name != "" {
+			list.Name = name
+		}
+		job, err = api.imp.CreateFromList(r.Context(), user.ID, list)
+	} else {
+		var body struct {
+			URL  string `json:"url"`
+			Sync bool   `json:"sync"`
+		}
+		if err := json.NewDecoder(http.MaxBytesReader(w, r.Body, 64<<10)).Decode(&body); err != nil {
+			http.Error(w, "invalid body", http.StatusBadRequest)
+			return
+		}
+		job, err = api.imp.CreateFromLink(r.Context(), user.ID, body.URL, body.Sync)
+	}
+	if err != nil {
+		http.Error(w, err.Error(), http.StatusBadRequest)
+		return
+	}
+	writeJSON(w, http.StatusCreated, job)
+}
+
+// ownImport loads a job the caller may see, writing 404 otherwise.
+func (api *Router) ownImport(w http.ResponseWriter, r *http.Request) *acquire.ImportJob {
+	user, _ := request.UserFrom(r.Context())
+	job, err := api.imp.Job(r.Context(), chi.URLParam(r, "id"))
+	if err != nil || (!user.IsAdmin && job.UserID != user.ID) {
+		http.Error(w, "not found", http.StatusNotFound)
+		return nil
+	}
+	return job
+}
+
+func (api *Router) getImport(w http.ResponseWriter, r *http.Request) {
+	if job := api.ownImport(w, r); job != nil {
+		writeJSON(w, http.StatusOK, job)
+	}
+}
+
+func (api *Router) updateImport(w http.ResponseWriter, r *http.Request) {
+	job := api.ownImport(w, r)
+	if job == nil {
+		return
+	}
+	var body struct {
+		Sync bool `json:"sync"`
+	}
+	if err := json.NewDecoder(http.MaxBytesReader(w, r.Body, 4<<10)).Decode(&body); err != nil {
+		http.Error(w, "invalid body", http.StatusBadRequest)
+		return
+	}
+	if err := api.imp.SetSync(r.Context(), job.ID, body.Sync); err != nil {
+		http.Error(w, err.Error(), http.StatusInternalServerError)
+		return
+	}
+	job.Sync = body.Sync
+	writeJSON(w, http.StatusOK, job)
+}
+
+func (api *Router) deleteImport(w http.ResponseWriter, r *http.Request) {
+	job := api.ownImport(w, r)
+	if job == nil {
+		return
+	}
+	if err := api.imp.Delete(r.Context(), job.ID); err != nil {
+		http.Error(w, err.Error(), http.StatusInternalServerError)
+		return
+	}
+	w.WriteHeader(http.StatusNoContent)
+}
+
+func (api *Router) resolveImportItem(w http.ResponseWriter, r *http.Request) {
+	job := api.ownImport(w, r)
+	if job == nil {
+		return
+	}
+	pos, err := strconv.Atoi(chi.URLParam(r, "pos"))
+	if err != nil {
+		http.Error(w, "invalid position", http.StatusBadRequest)
+		return
+	}
+	var cat acquire.CatalogItem
+	if err := json.NewDecoder(http.MaxBytesReader(w, r.Body, 64<<10)).Decode(&cat); err != nil {
+		http.Error(w, "invalid body", http.StatusBadRequest)
+		return
+	}
+	it, err := api.imp.Resolve(r.Context(), job.ID, pos, cat)
+	switch {
+	case errors.Is(err, acquire.ErrNotFound):
+		http.Error(w, "not found", http.StatusNotFound)
+	case err != nil:
+		http.Error(w, err.Error(), http.StatusBadRequest)
+	default:
+		writeJSON(w, http.StatusOK, it)
+	}
+}
