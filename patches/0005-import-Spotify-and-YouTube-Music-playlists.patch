+    </div>
+  )
+}
+
+export const ProgressBar = ({ job, className }) => {
+  const c = job.counts || {}
+  const total = job.total || 1
+  const parts = [
+    [(c.owned || 0) + (c.available || 0), GREEN],
+    [c.requested || 0, '#4fb3ff'],
+    [c.notfound || 0, '#f5a524'],
+    [c.failed || 0, '#ff5c7a'],
+  ]
+  return (
+    <div className={className}>
+      {parts.map(([n, color], i) =>
+        n > 0 ? (
+          <span
+            key={i}
+            style={{ width: `${(n / total) * 100}%`, background: color }}
+          />
+        ) : null,
