+      .then(done, fail)
+      .finally(() => setBusy(false))
+  }
+  const upload = (e) => {
+    const file = e.target.files?.[0]
+    e.target.value = ''
+    if (!file) return
+    setBusy(true)
+    importFile(file)
+      .then(done, fail)
+      .finally(() => setBusy(false))
+  }
+
+  return (
+    <>
+      <form className={classes.box} onSubmit={submit}>
+        <h2 className={classes.title}>
+          {translate('resources.seer.imports.title')}
