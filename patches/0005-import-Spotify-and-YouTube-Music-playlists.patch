+type fakePlaylists struct {
+	mu    sync.Mutex
+	calls [][]string
+}
+
+func (p *fakePlaylists) WritePlaylist(_ context.Context, _, _, _ string, ids []string) (string, error) {
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	p.calls = append(p.calls, ids)
+	return "pls-1", nil
+}
+
+func (p *fakePlaylists) last() []string {
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	if len(p.calls) == 0 {
+		return nil
+	}
+	return p.calls[len(p.calls)-1]
+}
