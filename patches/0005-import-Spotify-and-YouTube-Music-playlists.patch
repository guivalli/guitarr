+package seer
+
+import (
+	"context"
+	"slices"
+
+	"github.com/navidrome/navidrome/model"
+	"github.com/navidrome/navidrome/model/request"
+)
+
+// playlistWriter mirrors imported playlists as regular Navidrome playlists.
+type playlistWriter struct {
+	ds model.DataStore
+}
+
+// WritePlaylist creates the playlist (when id is empty or it was deleted) and
+// sets its tracks, in order, when they changed.
+func (w *playlistWriter) WritePlaylist(ctx context.Context, userID, id, name string, ids []string) (string, error) {
+	user, err := w.ds.User().Get(ctx, userID)
+	if err != nil {
+		return "", err
+	}
+	ctx = request.WithUser(ctx, *user)
+	repo := w.ds.Playlist()
+	var pls *model.Playlist
+	if id != "" {
+		if pls, err = repo.Get(ctx, id); err != nil {
+			pls = nil // deleted by the user: make a new one
+		}
+	}
+	if pls == nil {
+		pls = &model.Playlist{Name: name, OwnerID: userID, Comment: "Seer"}
+	} else {
+		current, err := repo.Tracks(ctx, pls.ID, false).GetMediaFileIDs(ctx, model.QueryOptions{Sort: "id"})
+		if err == nil && slices.Equal(current, ids) {
+			return pls.ID, nil
+		}
+	}
+	pls.SetTracks(nil)
+	pls.AddMediaFilesByID(ids)
+	if err := repo.Put(ctx, pls); err != nil {
+		return "", err
+	}
+	return pls.ID, nil
+}
