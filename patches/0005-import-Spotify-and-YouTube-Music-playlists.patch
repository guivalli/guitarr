+      alignItems: 'center',
+      flexWrap: 'wrap',
+    },
+    field: {
+      flex: '1 1 320px',
+      display: 'flex',
+      alignItems: 'center',
+      gap: theme.spacing(1),
+      height: 48,
+      padding: theme.spacing(0, 2),
+      borderRadius: 999,
+      background: dark ? 'rgba(0,0,0,0.35)' : '#fff',
+      border: `2px solid transparent`,
+      '&:focus-within': { borderColor: theme.palette.text.primary },
+      '& svg': { color: theme.palette.text.secondary },
+    },
+    go: {
+      height: 48,
+      padding: '0 26px',
+      borderRadius: 999,
+      fontWeight: 800,
+      fontSize: 15,
+      background: GREEN,
+      color: '#000',
+      transition: 'transform 150ms ease',
+      '&:hover': { transform: 'scale(1.04)' },
+      '&.Mui-disabled': { opacity: 0.5 },
+    },
+    chip: {
+      height: 36,
+      padding: '0 14px',
+      borderRadius: 999,
+      fontSize: 13,
+      fontWeight: 600,
+      gap: 6,
+      color: theme.palette.text.primary,
+      background: dark ? 'rgba(255,255,255,0.08)' : 'rgba(0,0,0,0.06)',
+      '& svg': { fontSize: 18 },
+    },
+    chipOn: { background: `${GREEN}33`, color: dark ? GREEN : '#0a7a35' },
+    card: {
+      display: 'block',
+      width: '100%',
+      boxSizing: 'border-box',
+      textAlign: 'left',
+      padding: 14,
