diff --git a/core/acquire/catalog_musicbrainz.go b/core/acquire/catalog_musicbrainz.go
index 880b96e..294baa0 100644
--- a/core/acquire/catalog_musicbrainz.go
+++ b/core/acquire/catalog_musicbrainz.go
@@ -562,3 +562,79 @@ func (m *MusicBrainz) Album(ctx context.Context, mbid string) (*AlbumDetail, err
 	}
 	return detail, nil
 }
+
+// luceneEscaper escapes MusicBrainz's Lucene syntax inside quoted fields.
+var luceneEscaper = strings.NewReplacer(`\`, `\\`, `"`, `\"`)
+
+// noise strips what streaming services append to titles but MusicBrainz keeps apart.
+var noise = regexp.MustCompile(`(?i)\s*[-–(\[]\s*(\d{4}\s+)?(remaster(ed)?|feat\.?|ft\.?|with |radio edit|single version|album version|mono|stereo|explicit)[^)\]]*[)\]]?\s*$`)
+
+// cleanTitle turns "Song - 2011 Remaster" or "Song (feat. X)" into "Song".
+func cleanTitle(s string) string {
+	for {
+		c := strings.TrimSpace(noise.ReplaceAllString(s, ""))
+		if c == s || c == "" {
+			return s
+		}
+		s = c
+	}
+}
+
+// firstArtist keeps the main artist of "A, B" or "A feat. B".
+func firstArtist(s string) string {
+	for _, sep := range []string{", ", " feat. ", " ft. ", " & ", " x ", "; "} {
+		if a, _, ok := strings.Cut(s, sep); ok {
+			s = a
+		}
+	}
+	return strings.TrimSpace(s)
+}
+
+// MatchTrack finds the MusicBrainz recording for a track from a playlist:
+// by ISRC when there is one, then by artist and title, preferring the
+// recording whose length is closest to the playlist's.
+func (m *MusicBrainz) MatchTrack(ctx context.Context, t ImportTrack) (*CatalogItem, error) {
+	var lastErr error
+	if t.ISRC != "" {
+		items, err := m.searchRecordings(ctx, url.Values{"query": {"isrc:" + t.ISRC}}, 5)
+		if err == nil && len(items) > 0 {
+			return &items[0], nil
+		}
+		lastErr = err
+	}
+	title, artist := cleanTitle(t.Title), firstArtist(t.Artist)
+	if title == "" || artist == "" {
+		return nil, lastErr
+	}
+	var recs struct {
+		Recordings []mbRecording `json:"recordings"`
+	}
+	q := fmt.Sprintf(`recording:"%s" AND artist:"%s"`, luceneEscaper.Replace(title), luceneEscaper.Replace(artist))
+	if err := m.get(ctx, "/recording", url.Values{"query": {q}, "limit": {"25"}}, &recs); err != nil {
+		return nil, err
+	}
+	var best *CatalogItem
+	bestRank := 1 << 30
+	for i, r := range recs.Recordings {
+		it, ok := r.item()
+		if !ok || r.Score < 70 || fold(cleanTitle(it.Title)) != fold(title) {
+			continue
+		}
+		rank := i * 1000 // MusicBrainz relevance first...
+		if t.DurationMs > 0 && it.DurationMs > 0 {
+			diff := t.DurationMs - it.DurationMs
+			if diff < 0 {
+				diff = -diff
+			}
+			if diff > 15000 {
+				continue // another version (live, extended...)
+			}
+			rank = diff // ...unless we know the length: closest wins
+		}
+		if rank < bestRank {
+			c := it
+			best, bestRank = &c, rank
+		}
+	}
+	return best, nil
+}
diff --git a/core/acquire/import_read.go b/core/acquire/import_read.go
new file mode 100644
index 0000000..c0804a1
--- /dev/null
+++ b/core/acquire/import_read.go
@@ -0,0 +1,519 @@
+package acquire
+
+import (
+	"bytes"
+	"context"
+	"encoding/base64"
+	"encoding/csv"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+	"net/url"
+	"os/exec"
+	"regexp"
+	"strconv"
+	"strings"
+	"time"
+)
+
+// ImportTrack is one entry of an external playlist, before it is matched to MusicBrainz.
+type ImportTrack struct {
+	Artist     string `json:"artist"`
+	Title      string `json:"title"`
+	Album      string `json:"album,omitempty"`
+	ISRC       string `json:"isrc,omitempty"`
+	DurationMs int    `json:"durationMs,omitempty"`
+}
+
+// ImportList is a playlist read from Spotify, YouTube Music or a file.
+type ImportList struct {
+	Name   string
+	Source string // "spotify", "ytmusic" or "file"
+	Tracks []ImportTrack
+}
+
+// ErrUnsupportedLink is returned for links that are not a Spotify or YouTube playlist/album.
+var ErrUnsupportedLink = errors.New("unsupported link: paste a Spotify or YouTube Music playlist or album")
+
+// PlaylistReader reads playlists from streaming services.
+type PlaylistReader struct {
+	Client *http.Client
+	// Spotify Web API credentials (developer.spotify.com). Without them public
+	// playlists are read from Spotify's embed page, which may list fewer tracks.
+	SpotifyClientID     string
+	SpotifyClientSecret string
+	SpotifyAPI          string // tests only
+	SpotifyWeb          string // tests only
+	// YtDlp is the yt-dlp binary; Cookies an optional cookies.txt that gives
+	// access to private lists such as "Liked music".
+	YtDlp   string
+	Cookies string
+}
+
+var spotifyLink = regexp.MustCompile(`open\.spotify\.com/(?:intl-[a-z-]+/)?(?:embed/)?(playlist|album|track)/([A-Za-z0-9]+)`)
+
+// Read loads the playlist behind a link.
+func (p *PlaylistReader) Read(ctx context.Context, link string) (*ImportList, error) {
+	link = strings.TrimSpace(link)
+	if m := spotifyLink.FindStringSubmatch(link); m != nil {
+		if p.SpotifyClientID != "" && p.SpotifyClientSecret != "" {
+			return p.spotifyAPI(ctx, m[1], m[2])
+		}
+		return p.spotifyEmbed(ctx, m[1], m[2])
+	}
+	u, err := url.Parse(link)
+	if err == nil && (strings.HasSuffix(u.Hostname(), "youtube.com") || u.Hostname() == "youtu.be") {
+		return p.youtube(ctx, link)
+	}
+	return nil, ErrUnsupportedLink
+}
+
+func (p *PlaylistReader) client() *http.Client {
+	if p.Client != nil {
+		return p.Client
+	}
+	return &http.Client{Timeout: 30 * time.Second}
+}
+
+func (p *PlaylistReader) getJSON(ctx context.Context, u, token string, out any) error {
+	req, err := http.NewRequestWithContext(ctx, http.MethodGet, u, nil)
+	if err != nil {
+		return err
+	}
+	if token != "" {
+		req.Header.Set("Authorization", "Bearer "+token)
+	}
+	resp, err := p.client().Do(req)
+	if err != nil {
+		return err
+	}
+	defer resp.Body.Close()
+	if resp.StatusCode != http.StatusOK {
+		return fmt.Errorf("spotify: HTTP %d", resp.StatusCode)
+	}
+	return json.NewDecoder(resp.Body).Decode(out)
+}
+
+func (p *PlaylistReader) spotifyToken(ctx context.Context) (string, error) {
+	tokenURL := "https://accounts.spotify.com/api/token"
+	if p.SpotifyAPI != "" {
+		tokenURL = p.SpotifyAPI + "/api/token"
+	}
+	req, err := http.NewRequestWithContext(ctx, http.MethodPost, tokenURL, strings.NewReader("grant_type=client_credentials"))
+	if err != nil {
+		return "", err
+	}
+	req.Header.Set("Content-Type", "application/x-www-form-urlencoded")
+	req.Header.Set("Authorization", "Basic "+base64.StdEncoding.EncodeToString([]byte(p.SpotifyClientID+":"+p.SpotifyClientSecret)))
+	resp, err := p.client().Do(req)
+	if err != nil {
+		return "", err
+	}
+	defer resp.Body.Close()
+	if resp.StatusCode != http.StatusOK {
+		return "", fmt.Errorf("spotify login failed (HTTP %d): check Seer.Spotify.ClientID/ClientSecret", resp.StatusCode)
+	}
+	var t struct {
+		AccessToken string `json:"access_token"`
+	}
+	if err := json.NewDecoder(resp.Body).Decode(&t); err != nil {
+		return "", err
+	}
+	return t.AccessToken, nil
+}
+
+type spotifyTrack struct {
+	Name       string `json:"name"`
+	DurationMs int    `json:"duration_ms"`
+	Artists    []struct {
+		Name string `json:"name"`
+	} `json:"artists"`
+	Album struct {
+		Name string `json:"name"`
+	} `json:"album"`
+	ExternalIDs struct {
+		ISRC string `json:"isrc"`
+	} `json:"external_ids"`
+}
+
+func (t spotifyTrack) importTrack(album string) ImportTrack {
+	var names []string
+	for _, a := range t.Artists {
+		names = append(names, a.Name)
+	}
+	if album == "" {
+		album = t.Album.Name
+	}
+	return ImportTrack{Artist: strings.Join(names, ", "), Title: t.Name, Album: album, ISRC: t.ExternalIDs.ISRC, DurationMs: t.DurationMs}
+}
+
+func (p *PlaylistReader) spotifyAPI(ctx context.Context, kind, id string) (*ImportList, error) {
+	token, err := p.spotifyToken(ctx)
+	if err != nil {
+		return nil, err
+	}
+	api := "https://api.spotify.com/v1"
+	if p.SpotifyAPI != "" {
+		api = p.SpotifyAPI + "/v1"
+	}
+	list := &ImportList{Source: "spotify"}
+	switch kind {
+	case "track":
+		var t spotifyTrack
+		if err := p.getJSON(ctx, api+"/tracks/"+id, token, &t); err != nil {
+			return nil, err
+		}
+		list.Name, list.Tracks = t.Name, []ImportTrack{t.importTrack("")}
+	case "album":
+		var a struct {
+			Name   string `json:"name"`
+			Tracks struct {
+				Items []spotifyTrack `json:"items"`
+				Next  string         `json:"next"`
+			} `json:"tracks"`
+		}
+		if err := p.getJSON(ctx, api+"/albums/"+id, token, &a); err != nil {
+			return nil, err
+		}
+		list.Name = a.Name
+		for _, t := range a.Tracks.Items {
+			list.Tracks = append(list.Tracks, t.importTrack(a.Name))
+		}
+	default:
+		var meta struct {
+			Name string `json:"name"`
+		}
+		if err := p.getJSON(ctx, api+"/playlists/"+id+"?fields=name", token, &meta); err != nil {
+			return nil, err
+		}
+		list.Name = meta.Name
+		next := api + "/playlists/" + id + "/tracks?limit=100&fields=next,items(track(name,duration_ms,external_ids,artists(name),album(name)))"
+		for next != "" && len(list.Tracks) < 5000 {
+			var page struct {
+				Next  string `json:"next"`
+				Items []struct {
+					Track *spotifyTrack `json:"track"`
+				} `json:"items"`
+			}
+			if err := p.getJSON(ctx, next, token, &page); err != nil {
+				return nil, err
+			}
+			for _, it := range page.Items {
+				if it.Track != nil && it.Track.Name != "" {
+					list.Tracks = append(list.Tracks, it.Track.importTrack(""))
+				}
+			}
+			next = page.Next
+		}
+	}
+	return list, nil
+}
+
+var nextData = regexp.MustCompile(`(?s)<script id="__NEXT_DATA__" type="application/json">(.*?)</script>`)
+
+// spotifyEmbed reads the public embed page, which needs no credentials.
+func (p *PlaylistReader) spotifyEmbed(ctx context.Context, kind, id string) (*ImportList, error) {
+	base := "https://open.spotify.com"
+	if p.SpotifyWeb != "" {
+		base = p.SpotifyWeb
+	}
+	req, err := http.NewRequestWithContext(ctx, http.MethodGet, base+"/embed/"+kind+"/"+id, nil)
+	if err != nil {
+		return nil, err
+	}
+	req.Header.Set("User-Agent", "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/130 Safari/537.36")
+	resp, err := p.client().Do(req)
+	if err != nil {
+		return nil, err
+	}
+	defer resp.Body.Close()
+	body, _ := io.ReadAll(io.LimitReader(resp.Body, 16<<20))
+	if resp.StatusCode != http.StatusOK {
+		return nil, fmt.Errorf("spotify: HTTP %d", resp.StatusCode)
+	}
+	m := nextData.FindSubmatch(body)
+	if m == nil {
+		return nil, errors.New("spotify page changed; set Seer.Spotify.ClientID/ClientSecret to use the API")
+	}
+	var data any
+	if err := json.Unmarshal(m[1], &data); err != nil {
+		return nil, err
+	}
+	entity := findKey(data, "entity")
+	e, _ := entity.(map[string]any)
+	if e == nil {
+		return nil, errors.New("spotify: playlist not found or private")
+	}
+	list := &ImportList{Source: "spotify", Name: str(e["name"])}
+	if list.Name == "" {
+		list.Name = str(e["title"])
+	}
+	tl, _ := e["trackList"].([]any)
+	for _, raw := range tl {
+		t, _ := raw.(map[string]any)
+		if t == nil {
+			continue
+		}
+		artist := strings.ReplaceAll(str(t["subtitle"]), " ", " ")
+		dur, _ := t["duration"].(float64)
+		if title := str(t["title"]); title != "" {
+			list.Tracks = append(list.Tracks, ImportTrack{Artist: artist, Title: title, DurationMs: int(dur)})
+		}
+	}
+	if kind == "track" && len(list.Tracks) == 0 && list.Name != "" {
+		var names []string
+		if as, ok := e["artists"].([]any); ok {
+			for _, a := range as {
+				if am, ok := a.(map[string]any); ok {
+					names = append(names, str(am["name"]))
+				}
+			}
+		}
+		dur, _ := e["duration"].(float64)
+		list.Tracks = []ImportTrack{{Artist: strings.Join(names, ", "), Title: list.Name, DurationMs: int(dur)}}
+	}
+	if len(list.Tracks) == 0 {
+		return nil, errors.New("spotify: no tracks found (private playlist?)")
+	}
+	return list, nil
+}
+
+func findKey(v any, key string) any {
+	switch t := v.(type) {
+	case map[string]any:
+		if found, ok := t[key]; ok {
+			return found
+		}
+		for _, c := range t {
+			if f := findKey(c, key); f != nil {
+				return f
+			}
+		}
+	case []any:
+		for _, c := range t {
+			if f := findKey(c, key); f != nil {
+				return f
+			}
+		}
+	}
+	return nil
+}
+
+func str(v any) string {
+	s, _ := v.(string)
+	return strings.TrimSpace(s)
+}
+
+// youtube lists a YouTube / YouTube Music playlist with yt-dlp (no download).
+func (p *PlaylistReader) youtube(ctx context.Context, link string) (*ImportList, error) {
+	ctx, cancel := context.WithTimeout(ctx, 5*time.Minute)
+	defer cancel()
+	args := []string{"--flat-playlist", "-J", "--no-warnings"}
+	if p.Cookies != "" {
+		args = append(args, "--cookies", p.Cookies)
+	}
+	cmd := exec.CommandContext(ctx, cmp(p.YtDlp, "yt-dlp"), append(args, "--", link)...)
+	var out, stderr bytes.Buffer
+	cmd.Stdout, cmd.Stderr = &out, &stderr
+	if err := cmd.Run(); err != nil {
+		msg := strings.TrimSpace(stderr.String())
+		if p.Cookies == "" && (strings.Contains(msg, "Sign in") || strings.Contains(msg, "private")) {
+			msg += " (private list: set Seer.YouTube.Cookies to a cookies.txt from your browser)"
+		}
+		return nil, fmt.Errorf("yt-dlp: %w: %s", err, msg)
+	}
+	var pl struct {
+		Title   string `json:"title"`
+		Entries []struct {
+			Title    string   `json:"title"`
+			Track    string   `json:"track"`
+			Artist   string   `json:"artist"`
+			Artists  []string `json:"artists"`
+			Channel  string   `json:"channel"`
+			Uploader string   `json:"uploader"`
+			Album    string   `json:"album"`
+			Duration float64  `json:"duration"`
+		} `json:"entries"`
+	}
+	if err := json.Unmarshal(out.Bytes(), &pl); err != nil {
+		return nil, fmt.Errorf("yt-dlp: %w", err)
+	}
+	list := &ImportList{Name: pl.Title, Source: "ytmusic"}
+	for _, e := range pl.Entries {
+		t := ImportTrack{Title: cmp(e.Track, e.Title), Album: e.Album, DurationMs: int(e.Duration * 1000)}
+		switch {
+		case len(e.Artists) > 0:
+			t.Artist = strings.Join(e.Artists, ", ")
+		case e.Artist != "":
+			t.Artist = e.Artist
+		default:
+			ch := cmp(e.Channel, e.Uploader)
+			if strings.HasSuffix(ch, " - Topic") {
+				t.Artist = strings.TrimSuffix(ch, " - Topic")
+			} else if a, title, ok := strings.Cut(t.Title, " - "); ok {
+				t.Artist, t.Title = strings.TrimSpace(a), strings.TrimSpace(title)
+			} else {
+				t.Artist = ch
+			}
+		}
+		if t.Title != "" && t.Title != "[Private video]" && t.Title != "[Deleted video]" {
+			list.Tracks = append(list.Tracks, t)
+		}
+	}
+	if list.Name == "Liked music" || list.Name == "" {
+		list.Name = cmp(list.Name, "YouTube Music")
+	}
+	return list, nil
+}
+
+// ParseImportFile reads an exported playlist: an Exportify / Google Takeout CSV,
+// Spotify's data export (YourLibrary.json, Playlist1.json) or plain
+// "Artist - Title" lines.
+func ParseImportFile(name string, data []byte) (*ImportList, error) {
+	base := name
+	if i := strings.LastIndexAny(base, `/\`); i >= 0 {
+		base = base[i+1:]
+	}
+	list := &ImportList{Source: "file", Name: strings.TrimSuffix(base, fileExt(base))}
+	trimmed := bytes.TrimSpace(bytes.TrimPrefix(data, []byte("\xef\xbb\xbf")))
+	switch {
+	case len(trimmed) > 0 && (trimmed[0] == '{' || trimmed[0] == '['):
+		parseJSONExport(trimmed, list)
+	case bytes.Contains(firstLine(trimmed), []byte(",")) || bytes.Contains(firstLine(trimmed), []byte(";")):
+		if err := parseCSVExport(trimmed, list); err != nil {
+			return nil, err
+		}
+	default:
+		for _, line := range strings.Split(string(trimmed), "\n") {
+			line = strings.TrimSpace(line)
+			if a, t, ok := strings.Cut(line, " - "); ok {
+				list.Tracks = append(list.Tracks, ImportTrack{Artist: strings.TrimSpace(a), Title: strings.TrimSpace(t)})
+			}
+		}
+	}
+	if len(list.Tracks) == 0 {
+		return nil, errors.New("no tracks found in the file")
+	}
+	return list, nil
+}
+
+func fileExt(s string) string {
+	if i := strings.LastIndex(s, "."); i > 0 {
+		return s[i:]
+	}
+	return ""
+}
+
+func firstLine(b []byte) []byte {
+	if i := bytes.IndexByte(b, '\n'); i >= 0 {
+		return b[:i]
+	}
+	return b
+}
+
+func parseCSVExport(data []byte, list *ImportList) error {
+	r := csv.NewReader(bytes.NewReader(data))
+	if bytes.Count(firstLine(data), []byte(";")) > bytes.Count(firstLine(data), []byte(",")) {
+		r.Comma = ';'
+	}
+	r.FieldsPerRecord = -1
+	r.LazyQuotes = true
+	rows, err := r.ReadAll()
+	if err != nil {
+		return fmt.Errorf("reading CSV: %w", err)
+	}
+	if len(rows) < 2 {
+		return nil
+	}
+	col := func(names ...string) int {
+		for _, n := range names {
+			for i, h := range rows[0] {
+				if strings.EqualFold(strings.TrimSpace(h), n) {
+					return i
+				}
+			}
+		}
+		return -1
+	}
+	title := col("Track Name", "Song Title", "Title", "Track", "Song", "Name", "Música", "Titulo", "Título")
+	artist := col("Artist Name(s)", "Artist Name 1", "Artist Names", "Artist", "Artists", "Artista")
+	album := col("Album Name", "Album Title", "Album", "Álbum")
+	isrc := col("ISRC")
+	dur := col("Duration (ms)", "Track Duration (ms)", "Duration")
+	if title < 0 || artist < 0 {
+		return errors.New("CSV needs a title and an artist column")
+	}
+	get := func(row []string, i int) string {
+		if i < 0 || i >= len(row) {
+			return ""
+		}
+		return strings.TrimSpace(row[i])
+	}
+	for _, row := range rows[1:] {
+		t := ImportTrack{Title: get(row, title), Artist: get(row, artist), Album: get(row, album), ISRC: get(row, isrc)}
+		t.Artist = strings.ReplaceAll(t.Artist, ";", ", ") // Exportify separates artists with ";"... or ","
+		if d, err := strconv.Atoi(get(row, dur)); err == nil {
+			t.DurationMs = d
+		}
+		if t.Title != "" && t.Artist != "" {
+			list.Tracks = append(list.Tracks, t)
+		}
+	}
+	return nil
+}
+
+func parseJSONExport(data []byte, list *ImportList) {
+	var v any
+	if json.Unmarshal(data, &v) != nil {
+		return
+	}
+	if m, ok := v.(map[string]any); ok {
+		if n := str(m["name"]); n != "" {
+			list.Name = n
+		}
+	}
+	var walk func(any)
+	walk = func(v any) {
+		switch t := v.(type) {
+		case []any:
+			for _, c := range t {
+				walk(c)
+			}
+		case map[string]any:
+			title := firstStr(t, "track", "trackName", "master_metadata_track_name", "title")
+			artist := firstStr(t, "artist", "artistName", "master_metadata_album_artist_name")
+			if title != "" && artist != "" {
+				list.Tracks = append(list.Tracks, ImportTrack{Title: title, Artist: artist,
+					Album: firstStr(t, "album", "albumName", "master_metadata_album_album_name")})
+				return
+			}
+			for _, c := range t {
+				walk(c)
+			}
+		}
+	}
+	walk(v)
+	// Spotify playlists export wraps tracks as {"track": {"trackName", ...}}; the
+	// streaming history repeats songs: keep the first of each.
+	seen := map[string]bool{}
+	uniq := list.Tracks[:0]
+	for _, t := range list.Tracks {
+		k := fold(t.Artist) + "|" + fold(t.Title)
+		if !seen[k] {
+			seen[k] = true
+			uniq = append(uniq, t)
+		}
+	}
+	list.Tracks = uniq
+}
+
+func firstStr(m map[string]any, keys ...string) string {
+	for _, k := range keys {
+		if s := str(m[k]); s != "" {
+			return s
+		}
+	}
+	return ""
+}
diff --git a/core/acquire/importer.go b/core/acquire/importer.go
new file mode 100644
index 0000000..ebff3d2
--- /dev/null
+++ b/core/acquire/importer.go
@@ -0,0 +1,593 @@
+package acquire
+
+import (
+	"context"
+	"database/sql"
+	"errors"
+	"fmt"
+	"strings"
+	"sync"
+	"time"
+)
+
+// ImportJob is a playlist being brought into the library.
+type ImportJob struct {
+	ID         string    `json:"id"`
+	UserID     string    `json:"userId"`
+	Name       string    `json:"name"`
+	Source     string    `json:"source"`
+	URL        string    `json:"url,omitempty"`
+	Status     string    `json:"status"` // reading, matching, downloading, done, failed
+	Error      string    `json:"error,omitempty"`
+	Sync       bool      `json:"sync"` // re-read the link every day and add new songs
+	PlaylistID string    `json:"playlistId,omitempty"`
+	CreatedAt  time.Time `json:"createdAt"`
+	UpdatedAt  time.Time `json:"updatedAt"`
+	// Counts by item state, filled when listing.
+	Counts map[string]int `json:"counts,omitempty"`
+	Total  int            `json:"total"`
+	Items  []ImportItem   `json:"items,omitempty"`
+}
+
+// Item states.
+const (
+	ItemPending   = "pending"
+	ItemNotFound  = "notfound"  // no MusicBrainz match: the user can pick one
+	ItemOwned     = "owned"     // already in the library
+	ItemRequested = "requested" // a request is on its way
+	ItemAvailable = "available" // downloaded and scanned
+	ItemFailed    = "failed"    // the request failed
+)
+
+type ImportItem struct {
+	Position int    `json:"position"`
+	ImportTrack
+	State     string `json:"state"`
+	MBID      string `json:"mbid,omitempty"`
+	CoverID   string `json:"coverId,omitempty"`
+	RequestID string `json:"requestId,omitempty"`
+	LibraryID string `json:"libraryId,omitempty"`
+	Note      string `json:"note,omitempty"`
+}
+
+// Matcher finds the catalog recording for a playlist entry (nil when none).
+type Matcher interface {
+	MatchTrack(ctx context.Context, t ImportTrack) (*CatalogItem, error)
+}
+
+// PlaylistWriter keeps a Navidrome playlist with the given songs, in order.
+// It returns the playlist ID (creating the playlist when id is empty).
+type PlaylistWriter interface {
+	WritePlaylist(ctx context.Context, userID, id, name string, mediaFileIDs []string) (string, error)
+}
+
+// ListReader reads a playlist from a link.
+type ListReader interface {
+	Read(ctx context.Context, link string) (*ImportList, error)
+}
+
+// Importer brings external playlists into the library: it reads them, matches
+// every song to MusicBrainz, requests what is missing through the Service and
+// mirrors the playlist in Navidrome as songs arrive.
+type Importer struct {
+	svc       *Service
+	db        *sql.DB
+	matcher   Matcher
+	reader    ListReader
+	playlists PlaylistWriter
+	// OnChange is called when a job makes progress (for live UI refresh).
+	OnChange func()
+	// RefreshInterval: how often requested songs are checked (default 30s).
+	RefreshInterval time.Duration
+	// SyncInterval: how often synced playlists are read again (default 24h).
+	SyncInterval time.Duration
+	// RetryDelay between MusicBrainz attempts (default 5s).
+	RetryDelay time.Duration
+
+	queue chan string
+	mu    sync.Mutex
+	busy  map[string]bool
+	wg    sync.WaitGroup
+}
+
+func NewImporter(svc *Service, db *sql.DB, m Matcher, r ListReader, p PlaylistWriter) *Importer {
+	return &Importer{svc: svc, db: db, matcher: m, reader: r, playlists: p,
+		queue: make(chan string, 64), busy: map[string]bool{}}
+}
+
+// Start runs one job at a time (MusicBrainz allows 1 request/second) and the
+// periodic refresh/sync loop. Unfinished jobs resume.
+func (im *Importer) Start(ctx context.Context) {
+	refresh, syncEvery := im.RefreshInterval, im.SyncInterval
+	if refresh <= 0 {
+		refresh = 30 * time.Second
+	}
+	if syncEvery <= 0 {
+		syncEvery = 24 * time.Hour
+	}
+	im.wg.Go(func() {
+		for {
+			select {
+			case <-ctx.Done():
+				return
+			case id := <-im.queue:
+				im.run(ctx, id)
+			}
+		}
+	})
+	im.wg.Go(func() {
+		t := time.NewTicker(refresh)
+		defer t.Stop()
+		for {
+			select {
+			case <-ctx.Done():
+				return
+			case <-t.C:
+			}
+			im.refreshAll(ctx, syncEvery)
+		}
+	})
+	rows, err := im.db.QueryContext(ctx, `SELECT id FROM import_job WHERE status IN ('reading','matching') ORDER BY created_at`)
+	if err != nil {
+		return
+	}
+	var ids []string
+	for rows.Next() {
+		var id string
+		if rows.Scan(&id) == nil {
+			ids = append(ids, id)
+		}
+	}
+	rows.Close()
+	for _, id := range ids {
+		im.enqueue(id)
+	}
+}
+
+func (im *Importer) Wait() { im.wg.Wait() }
+
+func (im *Importer) enqueue(id string) {
+	im.mu.Lock()
+	if im.busy[id] {
+		im.mu.Unlock()
+		return
+	}
+	im.busy[id] = true
+	im.mu.Unlock()
+	select {
+	case im.queue <- id:
+	default:
+		go func() { im.queue <- id }()
+	}
+}
+
+func (im *Importer) notify() {
+	if im.OnChange != nil {
+		im.OnChange()
+	}
+}
+
+// CreateFromLink starts importing a Spotify / YouTube Music link.
+func (im *Importer) CreateFromLink(ctx context.Context, userID, link string, syncDaily bool) (*ImportJob, error) {
+	link = strings.TrimSpace(link)
+	if !spotifyLink.MatchString(link) && !strings.Contains(link, "youtube.com") && !strings.Contains(link, "youtu.be") {
+		return nil, ErrUnsupportedLink
+	}
+	source := "ytmusic"
+	if spotifyLink.MatchString(link) {
+		source = "spotify"
+	}
+	job := &ImportJob{ID: newID(), UserID: userID, Source: source, URL: link, Status: "reading", Sync: syncDaily, Name: link}
+	if err := im.insertJob(ctx, job); err != nil {
+		return nil, err
+	}
+	im.notify()
+	im.enqueue(job.ID)
+	return job, nil
+}
+
+// CreateFromList starts importing tracks already parsed (an uploaded file).
+func (im *Importer) CreateFromList(ctx context.Context, userID string, list *ImportList) (*ImportJob, error) {
+	job := &ImportJob{ID: newID(), UserID: userID, Source: list.Source, Status: "matching", Name: list.Name}
+	if err := im.insertJob(ctx, job); err != nil {
+		return nil, err
+	}
+	if err := im.addTracks(ctx, job.ID, list.Tracks); err != nil {
+		return nil, err
+	}
+	im.notify()
+	im.enqueue(job.ID)
+	return job, nil
+}
+
+func (im *Importer) insertJob(ctx context.Context, j *ImportJob) error {
+	now := time.Now()
+	j.CreatedAt, j.UpdatedAt = now, now
+	_, err := im.db.ExecContext(ctx, `INSERT INTO import_job (id, user_id, name, source, url, status, sync, created_at, updated_at)
+		VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)`, j.ID, j.UserID, j.Name, j.Source, j.URL, j.Status, j.Sync, now, now)
+	return err
+}
+
+// addTracks appends the tracks that are not in the job yet (by artist and title).
+func (im *Importer) addTracks(ctx context.Context, jobID string, tracks []ImportTrack) error {
+	items, err := im.items(ctx, jobID)
+	if err != nil {
+		return err
+	}
+	seen := map[string]bool{}
+	for _, it := range items {
+		seen[fold(it.Artist)+"|"+fold(it.Title)] = true
+	}
+	pos := len(items)
+	tx, err := im.db.BeginTx(ctx, nil)
+	if err != nil {
+		return err
+	}
+	defer func() { _ = tx.Rollback() }()
+	for _, t := range tracks {
+		k := fold(t.Artist) + "|" + fold(t.Title)
+		if seen[k] || t.Title == "" {
+			continue
+		}
+		seen[k] = true
+		pos++
+		if _, err := tx.ExecContext(ctx, `INSERT INTO import_item (job_id, position, artist, title, album, isrc, duration_ms)
+			VALUES (?, ?, ?, ?, ?, ?, ?)`, jobID, pos, t.Artist, t.Title, t.Album, t.ISRC, t.DurationMs); err != nil {
+			return err
+		}
+	}
+	return tx.Commit()
+}
+
+func (im *Importer) setJob(ctx context.Context, id, status, errMsg string) {
+	_, _ = im.db.ExecContext(ctx, `UPDATE import_job SET status = ?, error = ?, updated_at = ? WHERE id = ?`,
+		status, errMsg, time.Now(), id)
+	im.notify()
+}
+
+func (im *Importer) setItem(ctx context.Context, jobID string, it *ImportItem) {
+	_, _ = im.db.ExecContext(ctx, `UPDATE import_item SET state = ?, mbid = ?, cover_id = ?, request_id = ?, library_id = ?, note = ?
+		WHERE job_id = ? AND position = ?`, it.State, it.MBID, it.CoverID, it.RequestID, it.LibraryID, it.Note, jobID, it.Position)
+}
+
+// run reads (when needed) and matches one job.
+func (im *Importer) run(ctx context.Context, id string) {
+	defer func() {
+		im.mu.Lock()
+		delete(im.busy, id)
+		im.mu.Unlock()
+	}()
+	job, err := im.job(ctx, id)
+	if err != nil {
+		return
+	}
+	if job.Status == "reading" {
+		list, err := im.reader.Read(ctx, job.URL)
+		if err != nil {
+			im.setJob(ctx, id, "failed", err.Error())
+			return
+		}
+		if list.Name != "" {
+			_, _ = im.db.ExecContext(ctx, `UPDATE import_job SET name = ?, source = ? WHERE id = ?`, list.Name, list.Source, id)
+		}
+		if err := im.addTracks(ctx, id, list.Tracks); err != nil {
+			im.setJob(ctx, id, "failed", err.Error())
+			return
+		}
+		im.setJob(ctx, id, "matching", "")
+	}
+	items, err := im.items(ctx, id)
+	if err != nil {
+		im.setJob(ctx, id, "failed", err.Error())
+		return
+	}
+	for i := range items {
+		if ctx.Err() != nil {
+			return // resumes on the next start
+		}
+		if items[i].State == ItemPending {
+			if err := im.resolve(ctx, job, &items[i], nil); err != nil {
+				// MusicBrainz unreachable: keep the rest pending; refreshAll retries the job
+				im.setJob(ctx, id, "matching", err.Error())
+				return
+			}
+		}
+	}
+	im.setJob(ctx, id, "downloading", "")
+	im.refresh(ctx, id)
+}
+
+// resolve matches an item (or uses the catalog item the user picked) and
+// requests it when it is not in the library yet.
+// It returns an error only when the catalog could not be reached.
+func (im *Importer) resolve(ctx context.Context, job *ImportJob, it *ImportItem, picked *CatalogItem) error {
+	cat := picked
+	if cat == nil {
+		var err error
+		for attempt := range 3 {
+			if cat, err = im.matcher.MatchTrack(ctx, it.ImportTrack); err == nil || ctx.Err() != nil {
+				break
+			}
+			select {
+			case <-time.After(time.Duration(attempt+1) * im.retryDelay()):
+			case <-ctx.Done():
+			}
+		}
+		if err != nil {
+			return err
+		}
+	}
+	if cat == nil {
+		it.State, it.Note = ItemNotFound, ""
+		im.setItem(ctx, job.ID, it)
+		im.notify()
+		return nil
+	}
+	cat.Kind = KindTrack
+	it.MBID, it.CoverID, it.Note = cat.MBID, cat.CoverID, ""
+	if libID, ok := im.svc.lib.Match(ctx, *cat); ok {
+		it.State, it.LibraryID = ItemOwned, libID
+	} else {
+		req, err := im.svc.Submit(ctx, job.UserID, *cat)
+		switch {
+		case errors.Is(err, ErrInLibrary):
+			it.State = ItemOwned
+		case err != nil:
+			it.State, it.Note = ItemFailed, err.Error()
+		default:
+			it.State, it.RequestID = ItemRequested, req.ID
+		}
+	}
+	im.setItem(ctx, job.ID, it)
+	im.notify()
+	return nil
+}
+
+func (im *Importer) retryDelay() time.Duration {
+	if im.RetryDelay > 0 {
+		return im.RetryDelay
+	}
+	return 5 * time.Second
+}
+
+// Resolve applies the user's choice for a song that was not matched.
+func (im *Importer) Resolve(ctx context.Context, jobID string, position int, cat CatalogItem) (*ImportItem, error) {
+	job, err := im.job(ctx, jobID)
+	if err != nil {
+		return nil, err
+	}
+	items, err := im.items(ctx, jobID)
+	if err != nil {
+		return nil, err
+	}
+	for i := range items {
+		if items[i].Position == position {
+			if cat.MBID == "" || cat.Title == "" {
+				return nil, errors.New("mbid and title are required")
+			}
+			if err := im.resolve(ctx, job, &items[i], &cat); err != nil {
+				return nil, err
+			}
+			return &items[i], nil
+		}
+	}
+	return nil, ErrNotFound
+}
+
+func (im *Importer) refreshAll(ctx context.Context, syncEvery time.Duration) {
+	// jobs that stopped because MusicBrainz was unreachable
+	if rows, err := im.db.QueryContext(ctx, `SELECT id FROM import_job WHERE status = 'matching' AND error != ''`); err == nil {
+		var ids []string
+		for rows.Next() {
+			var id string
+			if rows.Scan(&id) == nil {
+				ids = append(ids, id)
+			}
+		}
+		rows.Close()
+		for _, id := range ids {
+			im.enqueue(id)
+		}
+	}
+	rows, err := im.db.QueryContext(ctx, `SELECT id, sync, url, synced_at, created_at FROM import_job WHERE status IN ('downloading','done')`)
+	if err != nil {
+		return
+	}
+	type row struct {
+		id, url string
+		sync    bool
+		synced  time.Time
+	}
+	var jobs []row
+	for rows.Next() {
+		var r row
+		var synced sql.NullTime
+		if rows.Scan(&r.id, &r.sync, &r.url, &synced, &r.synced) == nil {
+			if synced.Valid {
+				r.synced = synced.Time
+			}
+			jobs = append(jobs, r)
+		}
+	}
+	rows.Close()
+	for _, j := range jobs {
+		im.refresh(ctx, j.id)
+		if j.sync && j.url != "" && time.Since(j.synced) >= syncEvery {
+			_, _ = im.db.ExecContext(ctx, `UPDATE import_job SET status = 'reading', synced_at = ? WHERE id = ?`, time.Now(), j.id)
+			im.enqueue(j.id)
+		}
+	}
+}
+
+// refresh follows the requests of a job and rewrites its Navidrome playlist.
+func (im *Importer) refresh(ctx context.Context, id string) {
+	job, err := im.job(ctx, id)
+	if err != nil {
+		return
+	}
+	items, err := im.items(ctx, id)
+	if err != nil {
+		return
+	}
+	changed, open := false, false
+	var ids []string
+	for i := range items {
+		it := &items[i]
+		if it.State == ItemRequested {
+			req, err := im.svc.store.Get(ctx, it.RequestID)
+			switch {
+			case err != nil:
+			case req.Status == StatusAvailable:
+				if libID, ok := im.svc.lib.Match(ctx, CatalogItem{Kind: KindTrack, MBID: it.MBID, Artist: req.Artist, Title: req.Title}); ok {
+					it.State, it.LibraryID = ItemAvailable, libID
+					im.setItem(ctx, id, it)
+					changed = true
+				}
+			case req.Status == StatusFailed:
+				it.State, it.Note = ItemFailed, req.Error
+				im.setItem(ctx, id, it)
+				changed = true
+			default:
+				open = true
+			}
+		}
+		if it.State == ItemOwned && it.LibraryID == "" {
+			if libID, ok := im.svc.lib.Match(ctx, CatalogItem{Kind: KindTrack, MBID: it.MBID, Artist: it.Artist, Title: it.Title}); ok {
+				it.LibraryID = libID
+				im.setItem(ctx, id, it)
+			}
+		}
+		if it.LibraryID != "" {
+			ids = append(ids, it.LibraryID)
+		}
+	}
+	if im.playlists != nil && len(ids) > 0 && (changed || job.PlaylistID == "" || job.Status != "done") {
+		plsID, err := im.playlists.WritePlaylist(ctx, job.UserID, job.PlaylistID, job.Name, ids)
+		if err == nil && plsID != job.PlaylistID {
+			_, _ = im.db.ExecContext(ctx, `UPDATE import_job SET playlist_id = ? WHERE id = ?`, plsID, id)
+		}
+	}
+	if !open && job.Status == "downloading" {
+		im.setJob(ctx, id, "done", "")
+	} else if changed {
+		im.notify()
+	}
+}
+
+const jobColumns = `id, user_id, name, source, url, status, error, sync, playlist_id, created_at, updated_at`
+
+func scanJob(row interface{ Scan(...any) error }) (*ImportJob, error) {
+	var j ImportJob
+	err := row.Scan(&j.ID, &j.UserID, &j.Name, &j.Source, &j.URL, &j.Status, &j.Error, &j.Sync, &j.PlaylistID, &j.CreatedAt, &j.UpdatedAt)
+	if errors.Is(err, sql.ErrNoRows) {
+		return nil, ErrNotFound
+	}
+	return &j, err
+}
+
+func (im *Importer) job(ctx context.Context, id string) (*ImportJob, error) {
+	return scanJob(im.db.QueryRowContext(ctx, `SELECT `+jobColumns+` FROM import_job WHERE id = ?`, id))
+}
+
+func (im *Importer) items(ctx context.Context, jobID string) ([]ImportItem, error) {
+	rows, err := im.db.QueryContext(ctx, `SELECT position, artist, title, album, isrc, duration_ms, state, mbid, cover_id, request_id, library_id, note
+		FROM import_item WHERE job_id = ? ORDER BY position`, jobID)
+	if err != nil {
+		return nil, err
+	}
+	defer rows.Close()
+	var out []ImportItem
+	for rows.Next() {
+		var it ImportItem
+		if err := rows.Scan(&it.Position, &it.Artist, &it.Title, &it.Album, &it.ISRC, &it.DurationMs, &it.State,
+			&it.MBID, &it.CoverID, &it.RequestID, &it.LibraryID, &it.Note); err != nil {
+			return nil, err
+		}
+		out = append(out, it)
+	}
+	return out, rows.Err()
+}
+
+func (im *Importer) counts(ctx context.Context, j *ImportJob) {
+	rows, err := im.db.QueryContext(ctx, `SELECT state, COUNT(*) FROM import_item WHERE job_id = ? GROUP BY state`, j.ID)
+	if err != nil {
+		return
+	}
+	defer rows.Close()
+	j.Counts = map[string]int{}
+	for rows.Next() {
+		var s string
+		var n int
+		if rows.Scan(&s, &n) == nil {
+			j.Counts[s] = n
+			j.Total += n
+		}
+	}
+}
+
+// Jobs lists the imports of a user (everybody's when userID is empty), newest first.
+func (im *Importer) Jobs(ctx context.Context, userID string) ([]ImportJob, error) {
+	q, args := `SELECT `+jobColumns+` FROM import_job ORDER BY created_at DESC`, []any{}
+	if userID != "" {
+		q, args = `SELECT `+jobColumns+` FROM import_job WHERE user_id = ? ORDER BY created_at DESC`, []any{userID}
+	}
+	rows, err := im.db.QueryContext(ctx, q, args...)
+	if err != nil {
+		return nil, err
+	}
+	var out []ImportJob
+	for rows.Next() {
+		j, err := scanJob(rows)
+		if err != nil {
+			rows.Close()
+			return nil, err
+		}
+		out = append(out, *j)
+	}
+	rows.Close()
+	for i := range out {
+		im.counts(ctx, &out[i])
+	}
+	return out, nil
+}
+
+// Job returns one import with its items.
+func (im *Importer) Job(ctx context.Context, id string) (*ImportJob, error) {
+	j, err := im.job(ctx, id)
+	if err != nil {
+		return nil, err
+	}
+	im.counts(ctx, j)
+	if j.Items, err = im.items(ctx, id); err != nil {
+		return nil, err
+	}
+	return j, nil
+}
+
+// SetSync turns the daily re-read of the link on or off.
+func (im *Importer) SetSync(ctx context.Context, id string, on bool) error {
+	res, err := im.db.ExecContext(ctx, `UPDATE import_job SET sync = ? WHERE id = ?`, on, id)
+	if err != nil {
+		return err
+	}
+	if n, _ := res.RowsAffected(); n == 0 {
+		return ErrNotFound
+	}
+	return nil
+}
+
+// Delete forgets an import (its requests and playlist stay).
+func (im *Importer) Delete(ctx context.Context, id string) error {
+	if _, err := im.db.ExecContext(ctx, `DELETE FROM import_item WHERE job_id = ?`, id); err != nil {
+		return err
+	}
+	res, err := im.db.ExecContext(ctx, `DELETE FROM import_job WHERE id = ?`, id)
+	if err != nil {
+		return err
+	}
+	if n, _ := res.RowsAffected(); n == 0 {
+		return fmt.Errorf("%w", ErrNotFound)
+	}
+	im.notify()
+	return nil
+}
