+        {job?.playlistId && (
+          <ButtonBase
+            className={classes.action}
+            onClick={() => history.push(`/playlist/${job.playlistId}/show`)}
+          >
+            <PlaylistPlayIcon />
+            {translate('resources.seer.imports.openPlaylist')}
+          </ButtonBase>
+        )}
+        {job?.url && (
+          <ButtonBase
+            className={`${classes.action} ${job.sync ? classes.on : ''}`}
+            onClick={toggleSync}
+            aria-pressed={job.sync}
+          >
+            <SyncIcon />
+            {translate('resources.seer.imports.syncDaily')}
+          </ButtonBase>
+        )}
+        {job && (
+          <Tooltip title={translate('resources.seer.imports.delete')}>
+            <IconButton
+              onClick={remove}
+              aria-label={translate('resources.seer.imports.delete')}
+            >
+              <DeleteIcon />
+            </IconButton>
+          </Tooltip>
+        )}
+      </Hero>
+      {job?.error && (
+        <div
+          className={classes.sub}
+          style={{ color: '#ff5c7a', margin: '8px 0' }}
+        >
+          {job.error}
+        </div>
+      )}
+      {job && <ProgressBar job={job} className={classes.bar} />}
+      {!job
+        ? [0, 1, 2, 3, 4].map((i) => (
+            <Shimmer key={i} height={44} style={{ margin: '12px 0' }} />
+          ))
+        : (job.items || []).map((it) => {
+            const sc = STATE_COLORS[it.state] || '#999'
+            return (
+              <div key={it.position} className={classes.row}>
+                <span className={classes.num}>{it.position}</span>
+                <Cover
+                  id={it.coverId}
+                  seed={it.album || it.title}
+                  radius={4}
+                  style={{ width: 44, height: 44, fontSize: 9 }}
+                />
+                <div style={{ minWidth: 0 }}>
+                  <div className={classes.title} title={it.title}>
+                    {it.title}
+                  </div>
+                  <div className={classes.sub} title={it.note || undefined}>
+                    {[it.artist, it.album].filter(Boolean).join(' · ')}
+                  </div>
+                </div>
+                <span className={classes.dur}>
+                  {formatDuration(it.durationMs)}
+                </span>
+                <div
+                  style={{
+                    display: 'flex',
+                    alignItems: 'center',
+                    justifyContent: 'flex-end',
+                  }}
+                >
+                  <span
+                    className={classes.pill}
+                    style={{ color: sc, background: `${sc}1f` }}
+                    title={it.note || undefined}
+                  >
+                    {translate(`resources.seer.imports.state.${it.state}`)}
+                  </span>
+                  {(it.state === 'notfound' || it.state === 'failed') && (
+                    <ButtonBase
+                      className={classes.pick}
+                      onClick={() => setPicking(it)}
+                    >
+                      {translate('resources.seer.imports.pick')}
+                    </ButtonBase>
+                  )}
+                </div>
+              </div>
+            )
+          })}
+      {picking && (
+        <PickDialog
+          item={picking}
+          onClose={() => setPicking(null)}
+          onPick={(cat) => pick(picking, cat)}
+        />
+      )}
+    </>
+  )
+}
