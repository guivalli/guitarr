+              placeholder={translate('resources.seer.imports.placeholder')}
+              inputProps={{
+                'aria-label': translate('resources.seer.imports.placeholder'),
+              }}
+            />
+          </div>
+          <ButtonBase
+            type="submit"
+            className={classes.go}
+            disabled={busy || !link.trim()}
+          >
+            {busy ? (
+              <CircularProgress size={20} style={{ color: '#000' }} />
+            ) : (
+              translate('resources.seer.imports.go')
+            )}
+          </ButtonBase>
+        </div>
+        <div className={classes.row} style={{ marginTop: 12 }}>
+          <ButtonBase
+            className={`${classes.chip} ${sync ? classes.chipOn : ''}`}
+            onClick={() => setSync((s) => !s)}
+            aria-pressed={sync}
+          >
+            <SyncIcon />
+            {translate('resources.seer.imports.syncDaily')}
+          </ButtonBase>
+          <ButtonBase
+            className={classes.chip}
+            onClick={() => fileRef.current?.click()}
+          >
+            <UploadIcon />
+            {translate('resources.seer.imports.upload')}
+          </ButtonBase>
+          <input
+            ref={fileRef}
+            type="file"
+            accept=".csv,.json,.txt"
+            hidden
+            onChange={upload}
+          />
+        </div>
+      </form>
+      {imports.length > 0 && (
+        <div style={{ marginTop: 24 }}>
+          <Grid>
+            {imports.map((job) => {
+              const c = job.counts || {}
+              const have = (c.owned || 0) + (c.available || 0)
+              return (
+                <ButtonBase
+                  key={job.id}
+                  component="div"
+                  className={classes.card}
+                  onClick={() => history.push(`/seer?import=${job.id}`)}
+                  focusRipple
+                >
+                  <ImportArt job={job} className={classes.art} />
+                  <div className={classes.name} title={job.name}>
+                    {job.name}
+                  </div>
+                  <div className={classes.sub}>
+                    {job.status === 'reading' || job.status === 'failed'
+                      ? translate(`resources.seer.imports.status.${job.status}`)
+                      : translate('resources.seer.imports.progress', {
+                          have,
+                          total: job.total,
+                        })}
+                  </div>
+                  <ProgressBar job={job} className={classes.bar} />
+                </ButtonBase>
+              )
+            })}
+          </Grid>
+        </div>
+      )}
+    </>
+  )
+}
