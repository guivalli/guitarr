+	}}
+	pls := &fakePlaylists{}
+	down := &atomic.Int32{}
+	down.Store(4) // MusicBrainz fails 4 times: the job pauses and resumes
+	im := NewImporter(svc, db, fakeMatcher{down: down}, fakeReader{list}, pls)
+	im.RefreshInterval = 20 * time.Millisecond
+	im.RetryDelay = time.Millisecond
