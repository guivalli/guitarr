+type fakeMatcher struct{ down *atomic.Int32 }
+
+func (m fakeMatcher) MatchTrack(_ context.Context, t ImportTrack) (*CatalogItem, error) {
+	if m.down != nil && m.down.Add(-1) >= 0 {
+		return nil, errors.New("connection refused")
+	}
+	if strings.Contains(t.Title, "Unknown") {
+		return nil, nil
+	}
+	return &CatalogItem{Kind: KindTrack, MBID: "mb-" + fold(t.Title), Artist: t.Artist, Title: t.Title, CoverID: ""}, nil
