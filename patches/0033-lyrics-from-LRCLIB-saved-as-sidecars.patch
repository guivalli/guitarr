+++ b/server/seerapi/lyrics_test.go
@@ -0,0 +1,58 @@
+package seerapi
+
+import (
+	"context"
+	"strings"
+	"testing"
+
+	"github.com/navidrome/navidrome/core/seer"
+	"github.com/navidrome/navidrome/model"
+)
+
+type fakeLyrics struct {
+	saved  [3]string
+	starts int
+}
+
+func (f *fakeLyrics) Find(_ context.Context, id string) ([]seer.LyricsCandidate, error) {
+	if id == "none" {
+		return nil, model.ErrNotFound
+	}
+	return []seer.LyricsCandidate{{ID: 7, Title: "T", Synced: "[00:01.00] a"}}, nil
+}
+func (f *fakeLyrics) Save(_ context.Context, id, synced, plain string) error {
+	f.saved = [3]string{id, synced, plain}
+	return nil
+}
+func (f *fakeLyrics) FetchMissing(context.Context) seer.LyricsJob {
+	f.starts++
+	return seer.LyricsJob{Running: true}
+}
+func (f *fakeLyrics) Job() seer.LyricsJob { return seer.LyricsJob{Done: 3, Total: 5} }
+
+func TestSeerLyricsAPI(t *testing.T) {
+	lyr := &fakeLyrics{}
+	api := NewWithImports(nil, &fakeService{}, nil)
+	api.lyrics = lyr
+	api.Handler = api.routes()
+	user, admin := model.User{ID: "u1"}, model.User{ID: "a", IsAdmin: true}
+
+	if w := do(t, api, user, "GET", "/lyrics/s1/lrclib", ""); w.Code != 200 || !strings.Contains(w.Body.String(), `"synced":"[00:01.00] a"`) {
+		t.Errorf("lrclib: %d %s", w.Code, w.Body)
+	}
+	if w := do(t, api, user, "GET", "/lyrics/none/lrclib", ""); w.Code != 404 {
+		t.Errorf("unknown song: %d", w.Code)
+	}
+	if w := do(t, api, user, "PUT", "/lyrics/s1", `{"plain":"x"}`); w.Code != 403 {
+		t.Errorf("only admins save lyrics: %d", w.Code)
+	}
+	if w := do(t, api, admin, "PUT", "/lyrics/s1", `{"synced":"[00:02.00] b","plain":""}`); w.Code != 204 || lyr.saved != [3]string{"s1", "[00:02.00] b", ""} {
+		t.Errorf("save: %d %v", w.Code, lyr.saved)
+	}
+	if w := do(t, api, admin, "POST", "/lyrics-batch", ""); w.Code != 202 || lyr.starts != 1 {
+		t.Errorf("batch: %d", w.Code)
+	}
+	if w := do(t, api, admin, "GET", "/lyrics-batch", ""); w.Code != 200 || !strings.Contains(w.Body.String(), `"total":5`) {
+		t.Errorf("batch status: %d %s", w.Code, w.Body)
+	}
+}
