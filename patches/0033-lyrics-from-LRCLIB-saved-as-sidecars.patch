diff --git a/core/seer/lyrics.go b/core/seer/lyrics.go
new file mode 100644
index 00000000..f82fe544
--- /dev/null
+++ b/core/seer/lyrics.go
@@ -0,0 +1,322 @@
+package seer
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"math"
+	"net/http"
+	"net/url"
+	"os"
+	"path/filepath"
+	"strings"
+	"sync"
+	"time"
+
+	"github.com/Masterminds/squirrel"
+	"github.com/navidrome/navidrome/log"
+	"github.com/navidrome/navidrome/model"
+)
+
+// Lyrics finds song lyrics on LRCLIB (lrclib.net, free and open) and saves them
+// next to the audio file as a sidecar (.lrc when time-synced, .txt otherwise).
+// Navidrome reads those sidecars on every request (LyricsPriority), so a saved
+// lyric is served by getLyricsBySongId at once, without a rescan.
+type Lyrics struct {
+	ds        model.DataStore
+	client    *http.Client
+	baseURL   string // https://lrclib.net, replaced in tests
+	userAgent string
+	pause     time.Duration // between songs in the batch
+
+	mu  sync.Mutex
+	job LyricsJob
+}
+
+// LyricsCandidate is one LRCLIB entry.
+type LyricsCandidate struct {
+	ID       int64   `json:"id"`
+	Title    string  `json:"title"`
+	Artist   string  `json:"artist"`
+	Album    string  `json:"album"`
+	Duration float64 `json:"duration"`
+	Synced   string  `json:"synced,omitempty"`
+	Plain    string  `json:"plain,omitempty"`
+	Instr    bool    `json:"instrumental,omitempty"`
+}
+
+// LyricsJob is the progress of the "fetch missing lyrics" batch.
+type LyricsJob struct {
+	Running  bool      `json:"running"`
+	Total    int       `json:"total"`
+	Done     int       `json:"done"`
+	Synced   int       `json:"synced"`
+	Plain    int       `json:"plain"`
+	NotFound int       `json:"notFound"`
+	Failed   int       `json:"failed"`
+	Started  time.Time `json:"started,omitzero"`
+	Finished time.Time `json:"finished,omitzero"`
+	Error    string    `json:"error,omitempty"`
+}
+
+var ErrNoLyrics = errors.New("no lyrics found")
+
+func NewLyrics(ds model.DataStore, userAgent string) *Lyrics {
+	if userAgent == "" {
+		userAgent = "Guitarr (https://github.com/guivalli/guitarr)"
+	}
+	return &Lyrics{ds: ds, client: &http.Client{Timeout: 15 * time.Second}, baseURL: "https://lrclib.net", userAgent: userAgent, pause: 300 * time.Millisecond}
+}
+
+type lrclibEntry struct {
+	ID           int64   `json:"id"`
+	TrackName    string  `json:"trackName"`
+	ArtistName   string  `json:"artistName"`
+	AlbumName    string  `json:"albumName"`
+	Duration     float64 `json:"duration"`
+	Instrumental bool    `json:"instrumental"`
+	PlainLyrics  string  `json:"plainLyrics"`
+	SyncedLyrics string  `json:"syncedLyrics"`
+}
+
+func (e lrclibEntry) candidate() LyricsCandidate {
+	return LyricsCandidate{ID: e.ID, Title: e.TrackName, Artist: e.ArtistName, Album: e.AlbumName, Duration: e.Duration,
+		Synced: e.SyncedLyrics, Plain: e.PlainLyrics, Instr: e.Instrumental}
+}
+
+func (l *Lyrics) get(ctx context.Context, path string, q url.Values, out any) (bool, error) {
+	req, err := http.NewRequestWithContext(ctx, http.MethodGet, l.baseURL+path+"?"+q.Encode(), nil)
+	if err != nil {
+		return false, err
+	}
+	req.Header.Set("User-Agent", l.userAgent)
+	req.Header.Set("Lrclib-Client", l.userAgent)
+	resp, err := l.client.Do(req)
+	if err != nil {
+		return false, err
+	}
+	defer resp.Body.Close()
+	if resp.StatusCode == http.StatusNotFound {
+		return false, nil
+	}
+	if resp.StatusCode != http.StatusOK {
+		return false, fmt.Errorf("lrclib: HTTP %d", resp.StatusCode)
+	}
+	return true, json.NewDecoder(resp.Body).Decode(out)
+}
+
+func firstArtist(mf *model.MediaFile) string {
+	a := mf.Artist
+	if a == "" {
+		a = mf.AlbumArtist
+	}
+	return a
+}
+
+// Candidates looks the song up on LRCLIB: the exact match first (artist, title,
+// album and duration), then a search, closest duration first.
+func (l *Lyrics) Candidates(ctx context.Context, mf *model.MediaFile) ([]LyricsCandidate, error) {
+	var out []LyricsCandidate
+	seen := map[int64]bool{}
+	var exact lrclibEntry
+	q := url.Values{"artist_name": {firstArtist(mf)}, "track_name": {mf.Title}, "album_name": {mf.Album},
+		"duration": {fmt.Sprint(int(math.Round(float64(mf.Duration))))}}
+	if ok, err := l.get(ctx, "/api/get", q, &exact); err != nil {
+		return nil, err
+	} else if ok && exact.ID != 0 {
+		out = append(out, exact.candidate())
+		seen[exact.ID] = true
+	}
+	var found []lrclibEntry
+	if _, err := l.get(ctx, "/api/search", url.Values{"track_name": {mf.Title}, "artist_name": {firstArtist(mf)}}, &found); err != nil && len(out) == 0 {
+		return nil, err
+	}
+	dur := float64(mf.Duration)
+	rest := make([]LyricsCandidate, 0, len(found))
+	for _, e := range found {
+		if !seen[e.ID] && (e.SyncedLyrics != "" || e.PlainLyrics != "") {
+			seen[e.ID] = true
+			rest = append(rest, e.candidate())
+		}
+	}
+	// closest duration first, synced before plain
+	sortCandidates(rest, dur)
+	out = append(out, rest...)
+	if len(out) > 10 {
+		out = out[:10]
+	}
+	return out, nil
+}
+
+func sortCandidates(c []LyricsCandidate, dur float64) {
+	score := func(x LyricsCandidate) float64 {
+		s := math.Abs(x.Duration - dur)
+		if x.Synced == "" {
+			s += 1000
+		}
+		return s
+	}
+	for i := 1; i < len(c); i++ {
+		for j := i; j > 0 && score(c[j]) < score(c[j-1]); j-- {
+			c[j], c[j-1] = c[j-1], c[j]
+		}
+	}
+}
+
+// best is the candidate saved automatically: synced and within 3 s of the song, or plain within 3 s.
+func best(c []LyricsCandidate, dur float64) *LyricsCandidate {
+	var plain *LyricsCandidate
+	for i := range c {
+		if math.Abs(c[i].Duration-dur) > 3 || c[i].Instr {
+			continue
+		}
+		if c[i].Synced != "" {
+			return &c[i]
+		}
+		if plain == nil && c[i].Plain != "" {
+			plain = &c[i]
+		}
+	}
+	return plain
+}
+
+func sidecar(mf *model.MediaFile, ext string) string {
+	p := mf.AbsolutePath()
+	return strings.TrimSuffix(p, filepath.Ext(p)) + ext
+}
+
+// HasLyrics reports lyrics embedded in the file or in a sidecar Navidrome reads.
+func HasLyrics(mf *model.MediaFile) bool {
+	if l, err := mf.StructuredLyrics(); err == nil && len(l) > 0 {
+		return true
+	}
+	for _, ext := range []string{".lrc", ".txt", ".elrc", ".ttml", ".srt", ".yaml", ".yml"} {
+		if _, err := os.Stat(sidecar(mf, ext)); err == nil {
+			return true
+		}
+	}
+	return false
+}
+
+// Save writes the lyrics next to the song: synced (LRC) to .lrc, plain text to
+// .txt. Both empty removes the sidecars written here.
+func (l *Lyrics) Save(ctx context.Context, songID, synced, plain string) error {
+	mf, err := l.ds.MediaFile().Get(ctx, songID)
+	if err != nil {
+		return err
+	}
+	return saveSidecar(mf, synced, plain)
+}
+
+func saveSidecar(mf *model.MediaFile, synced, plain string) error {
+	if mf.LibraryPath == "" {
+		return errors.New("song has no library path")
+	}
+	lrc, txt := sidecar(mf, ".lrc"), sidecar(mf, ".txt")
+	synced, plain = strings.TrimSpace(synced), strings.TrimSpace(plain)
+	write := func(path, body string) error { return os.WriteFile(path, []byte(body+"\n"), 0o644) }
+	remove := func(path string) error {
+		if err := os.Remove(path); err != nil && !os.IsNotExist(err) {
+			return err
+		}
+		return nil
+	}
+	switch {
+	case synced != "":
+		if err := write(lrc, synced); err != nil {
+			return err
+		}
+		return remove(txt)
+	case plain != "":
+		if err := write(txt, plain); err != nil {
+			return err
+		}
+		return remove(lrc)
+	default:
+		if err := remove(lrc); err != nil {
+			return err
+		}
+		return remove(txt)
+	}
+}
+
+// Find returns the LRCLIB candidates of a song (for the editor and the player fallback).
+func (l *Lyrics) Find(ctx context.Context, songID string) ([]LyricsCandidate, error) {
+	mf, err := l.ds.MediaFile().Get(ctx, songID)
+	if err != nil {
+		return nil, err
+	}
+	return l.Candidates(ctx, mf)
+}
+
+// Job returns the progress of the batch.
+func (l *Lyrics) Job() LyricsJob {
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	return l.job
+}
+
+// FetchMissing starts (once) a background pass over the music without lyrics,
+// saving what LRCLIB has. Podcast episodes are skipped.
+func (l *Lyrics) FetchMissing(ctx context.Context) LyricsJob {
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	if l.job.Running {
+		return l.job
+	}
+	l.job = LyricsJob{Running: true, Started: time.Now()}
+	go l.runBatch(context.WithoutCancel(ctx))
+	return l.job
+}
+
+func (l *Lyrics) update(f func(j *LyricsJob)) {
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	f(&l.job)
+}
+
+func (l *Lyrics) runBatch(ctx context.Context) {
+	defer l.update(func(j *LyricsJob) { j.Running, j.Finished = false, time.Now() })
+	files, err := l.ds.MediaFile().GetAll(ctx, model.QueryOptions{Filters: squirrel.Eq{"missing": false}, Sort: "path"})
+	if err != nil {
+		l.update(func(j *LyricsJob) { j.Error = err.Error() })
+		return
+	}
+	var todo []*model.MediaFile
+	for i := range files {
+		mf := &files[i]
+		if isPodcastPath(mf.Path) || mf.Title == "" || HasLyrics(mf) {
+			continue
+		}
+		todo = append(todo, mf)
+	}
+	l.update(func(j *LyricsJob) { j.Total = len(todo) })
+	log.Info(ctx, "Seer: fetching missing lyrics from LRCLIB", "songs", len(todo))
+	for _, mf := range todo {
+		cands, err := l.Candidates(ctx, mf)
+		var pick *LyricsCandidate
+		if err == nil {
+			pick = best(cands, float64(mf.Duration))
+		}
+		switch {
+		case err != nil:
+			l.update(func(j *LyricsJob) { j.Failed++ })
+		case pick == nil:
+			l.update(func(j *LyricsJob) { j.NotFound++ })
+		default:
+			if err := saveSidecar(mf, pick.Synced, pick.Plain); err != nil {
+				log.Warn(ctx, "Seer: saving lyrics failed", "path", mf.Path, err)
+				l.update(func(j *LyricsJob) { j.Failed++ })
+			} else if pick.Synced != "" {
+				l.update(func(j *LyricsJob) { j.Synced++ })
+			} else {
+				l.update(func(j *LyricsJob) { j.Plain++ })
+			}
+		}
+		l.update(func(j *LyricsJob) { j.Done++ })
+		time.Sleep(l.pause) // be gentle with a free service
+	}
+	j := l.Job()
+	log.Info(ctx, "Seer: lyrics batch finished", "synced", j.Synced, "plain", j.Plain, "notFound", j.NotFound, "failed", j.Failed)
+}
