+package seer
+
+import (
+	"context"
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/navidrome/navidrome/model"
+)
+
+func TestLyricsCandidatesAndSidecars(t *testing.T) {
+	var gotUA string
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		gotUA = r.Header.Get("User-Agent")
+		switch r.URL.Path {
+		case "/api/get":
+			if r.URL.Query().Get("duration") != "200" || r.URL.Query().Get("album_name") != "Disco" {
+				t.Errorf("get query = %v", r.URL.Query())
+			}
+			http.NotFound(w, r)
+		case "/api/search":
+			_ = json.NewEncoder(w).Encode([]lrclibEntry{
+				{ID: 1, TrackName: "Faixa", ArtistName: "Banda", Duration: 260, SyncedLyrics: "[00:01.00] longe"},
+				{ID: 2, TrackName: "Faixa", ArtistName: "Banda", Duration: 201, PlainLyrics: "só texto"},
+				{ID: 3, TrackName: "Faixa", ArtistName: "Banda", Duration: 199, SyncedLyrics: "[00:01.00] perto\n[00:02.50] fim"},
+				{ID: 4, TrackName: "Faixa", ArtistName: "Banda", Duration: 200},
+			})
+		}
+	}))
+	defer srv.Close()
+	l := NewLyrics(nil, "test-agent")
+	l.baseURL = srv.URL
+
+	dir := t.TempDir()
+	if err := os.MkdirAll(filepath.Join(dir, "Banda", "Disco"), 0o755); err != nil {
+		t.Fatal(err)
+	}
+	mf := &model.MediaFile{ID: "s1", Title: "Faixa", Artist: "Banda", Album: "Disco", Duration: 200.2,
+		LibraryPath: dir, Path: filepath.Join("Banda", "Disco", "01 Faixa.flac")}
+
+	c, err := l.Candidates(context.Background(), mf)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if gotUA != "test-agent" || len(c) != 3 || c[0].ID != 3 || c[1].ID != 1 || c[2].ID != 2 {
+		t.Fatalf("candidates = %+v (ua %q)", c, gotUA)
+	}
+	pick := best(c, 200)
+	if pick == nil || pick.ID != 3 {
+		t.Fatalf("best = %+v", pick)
+	}
+	if best([]LyricsCandidate{{Duration: 260, Synced: "x"}}, 200) != nil {
+		t.Error("a lyric 60 s off must not be saved automatically")
+	}
+
+	if HasLyrics(mf) {
+		t.Error("no lyrics yet")
+	}
+	if err := saveSidecar(mf, pick.Synced, ""); err != nil {
+		t.Fatal(err)
+	}
+	lrc := filepath.Join(dir, "Banda", "Disco", "01 Faixa.lrc")
+	if b, _ := os.ReadFile(lrc); !strings.HasPrefix(string(b), "[00:01.00] perto") || !HasLyrics(mf) {
+		t.Errorf("lrc = %q", b)
+	}
+	// manual plain text replaces the synced file
+	if err := saveSidecar(mf, "", "linha um\nlinha dois"); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := os.Stat(lrc); !os.IsNotExist(err) {
+		t.Error(".lrc should be gone")
+	}
+	if b, _ := os.ReadFile(filepath.Join(dir, "Banda", "Disco", "01 Faixa.txt")); string(b) != "linha um\nlinha dois\n" {
+		t.Errorf("txt = %q", b)
+	}
+	// both empty clears
+	if err := saveSidecar(mf, " ", ""); err != nil || HasLyrics(mf) {
+		t.Errorf("clear: %v, has %v", err, HasLyrics(mf))
+	}
+}
