diff --git a/server/seerapi/lyrics.go b/server/seerapi/lyrics.go
new file mode 100644
index 00000000..ffd6eb1d
--- /dev/null
+++ b/server/seerapi/lyrics.go
@@ -0,0 +1,68 @@
+package seerapi
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"net/http"
+
+	"github.com/go-chi/chi/v5"
+	"github.com/navidrome/navidrome/core/seer"
+	"github.com/navidrome/navidrome/log"
+	"github.com/navidrome/navidrome/model"
+)
+
+// LyricsService finds lyrics on LRCLIB and saves them next to the songs.
+type LyricsService interface {
+	Find(ctx context.Context, songID string) ([]seer.LyricsCandidate, error)
+	Save(ctx context.Context, songID, synced, plain string) error
+	FetchMissing(ctx context.Context) seer.LyricsJob
+	Job() seer.LyricsJob
+}
+
+// lrclibLyrics lists the LRCLIB candidates of a song (player fallback and editor).
+func (api *Router) lrclibLyrics(w http.ResponseWriter, r *http.Request) {
+	c, err := api.lyrics.Find(r.Context(), chi.URLParam(r, "id"))
+	switch {
+	case errors.Is(err, model.ErrNotFound):
+		http.Error(w, "song not found", http.StatusNotFound)
+	case err != nil:
+		log.Warn(r.Context(), "Seer: LRCLIB lookup failed", err)
+		http.Error(w, "LRCLIB is unavailable: "+err.Error(), http.StatusBadGateway)
+	default:
+		if c == nil {
+			c = []seer.LyricsCandidate{}
+		}
+		writeJSON(w, http.StatusOK, c)
+	}
+}
+
+// saveLyrics writes {"synced": "[00:01.00] ...", "plain": "..."}; both empty removes them.
+func (api *Router) saveLyrics(w http.ResponseWriter, r *http.Request) {
+	var body struct {
+		Synced string `json:"synced"`
+		Plain  string `json:"plain"`
+	}
+	if err := json.NewDecoder(http.MaxBytesReader(w, r.Body, 512<<10)).Decode(&body); err != nil {
+		http.Error(w, "invalid body", http.StatusBadRequest)
+		return
+	}
+	err := api.lyrics.Save(r.Context(), chi.URLParam(r, "id"), body.Synced, body.Plain)
+	switch {
+	case errors.Is(err, model.ErrNotFound):
+		http.Error(w, "song not found", http.StatusNotFound)
+	case err != nil:
+		log.Error(r.Context(), "Seer: saving lyrics failed", err)
+		http.Error(w, err.Error(), http.StatusInternalServerError)
+	default:
+		w.WriteHeader(http.StatusNoContent)
+	}
+}
+
+func (api *Router) fetchMissingLyrics(w http.ResponseWriter, r *http.Request) {
+	writeJSON(w, http.StatusAccepted, api.lyrics.FetchMissing(r.Context()))
+}
+
+func (api *Router) lyricsJob(w http.ResponseWriter, _ *http.Request) {
+	writeJSON(w, http.StatusOK, api.lyrics.Job())
+}
diff --git a/server/seerapi/lyrics_test.go b/server/seerapi/lyrics_test.go
