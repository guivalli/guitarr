new file mode 100644
index 0000000..346c244
--- /dev/null
+++ b/core/seer/storage_test.go
@@ -0,0 +1,65 @@
+package seer
+
+import (
+	"context"
+	"errors"
+	"strings"
+	"testing"
+
+	"github.com/navidrome/navidrome/conf"
+	"github.com/navidrome/navidrome/core/acquire"
+	"github.com/navidrome/navidrome/model"
+	"github.com/navidrome/navidrome/tests"
+)
+
+func TestParseSize(t *testing.T) {
+	for in, want := range map[string]int64{"": 0, "0": 0, "1024": 1024, "2GB": 2_000_000_000, "1.5 TB": 1_500_000_000_000, "10GiB": 10 << 30} {
+		if got, err := ParseSize(in); err != nil || got != want {
+			t.Errorf("ParseSize(%q) = %d, %v; want %d", in, got, err, want)
+		}
+	}
+	if _, err := ParseSize("lots"); err == nil {
+		t.Error("ParseSize accepted garbage")
+	}
+}
+
+func TestStorageLimits(t *testing.T) {
+	conf.Server.Seer.StorageLimit = "100GB"
+	conf.Server.Seer.MinFreeSpace = "2GB"
+	conf.Server.Seer.DestFolder = "/music/Seer"
+	t.Cleanup(func() {
+		conf.Server.Seer.StorageLimit, conf.Server.Seer.MinFreeSpace, conf.Server.Seer.DestFolder = "", "2GB", ""
+	})
+	libs := &tests.MockLibraryRepo{}
+	libs.SetData(model.Libraries{{ID: 1, Path: "/music", TotalSize: 40_000_000_000}, {ID: 2, Path: "/more", TotalSize: 20_000_000_000}})
+	ds := &tests.MockDataStore{MockedLibrary: libs, MockedProperty: &tests.MockedPropertyRepo{}}
+	free := uint64(500_000_000_000)
+	st := NewStorage(ds)
+	st.disk = func(string) (uint64, uint64, error) { return 1_000_000_000_000, free, nil }
+	ctx := context.Background()
+
+	info, err := st.Info(ctx)
+	if err != nil || info.Used != 60_000_000_000 || info.Limit != 100_000_000_000 || info.Full || info.DiskFree != free {
+		t.Fatalf("info = %+v, %v", info, err)
+	}
+	if err := st.Check(ctx); err != nil {
+		t.Fatalf("check under the limit: %v", err)
+	}
+
+	// The limit set in the UI wins over the config, and takes effect at once.
+	if err := st.SetLimit(ctx, 50_000_000_000); err != nil {
+		t.Fatal(err)
+	}
+	err = st.Check(ctx)
+	if !errors.Is(err, acquire.ErrStorageFull) || !strings.Contains(err.Error(), "60 GB of 50 GB") {
+		t.Fatalf("check over the limit: %v", err)
+	}
+
+	// No limit, but the disk itself is nearly full.
+	_ = st.SetLimit(ctx, 0)
+	free = 1_000_000_000
+	info, _ = st.Info(ctx)
+	if info.Limit != 0 || !info.Full || !strings.Contains(info.Reason, "free on disk") {
+		t.Fatalf("low disk: %+v", info)
+	}
+}
diff --git a/core/seer/storage_unix.go b/core/seer/storage_unix.go
new file mode 100644
index 0000000..49a37e5
--- /dev/null
+++ b/core/seer/storage_unix.go
@@ -0,0 +1,32 @@
+//go:build !windows
+
+package seer
+
+import (
+	"os"
+	"path/filepath"
+	"syscall"
+)
+
+func diskUsage(path string) (total, free uint64, err error) {
+	var fs syscall.Statfs_t
+	if err := syscall.Statfs(path, &fs); err != nil {
+		return 0, 0, err
+	}
+	bs := uint64(fs.Bsize) //nolint:gosec
+	return fs.Blocks * bs, fs.Bavail * bs, nil
+}
+
+// nearestDir walks up to the first existing directory (the Seer folder may not exist yet).
+func nearestDir(path string) string {
+	for {
+		if _, err := os.Stat(path); err == nil {
+			return path
+		}
+		parent := filepath.Dir(path)
+		if parent == path {
+			return path
+		}
+		path = parent
+	}
+}
