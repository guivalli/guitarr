+		t.Fatalf("want ErrStorageFull, got %v", err)
+	}
+	if _, err := svc.Approve(ctx, req.ID); err != nil {
+		t.Fatal(err)
+	}
+	got := waitStatus(t, st, req.ID, StatusFailed)
+	if !strings.Contains(got.Error, "storage limit") {
+		t.Fatalf("error = %q", got.Error)
+	}
+	if n := src.calls.Load(); n != 0 {
+		t.Fatalf("source was called %d times while storage was full", n)
+	}
+}
