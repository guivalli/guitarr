@@ -0,0 +1,334 @@
+import { useCallback, useEffect, useState } from 'react'
+import {
+  Button,
+  ButtonBase,
+  Dialog,
+  DialogActions,
+  DialogContent,
+  DialogTitle,
+  InputAdornment,
+  TextField,
+} from '@material-ui/core'
+import { makeStyles } from '@material-ui/core/styles'
+import StorageIcon from '@material-ui/icons/Storage'
+import { useLocale, useNotify, usePermissions, useTranslate } from 'react-admin'
+import { useRefreshOnEvents } from '../common'
+import { GREEN } from './actions'
+import { getStorage, setStorageLimit } from './api'
+
+const GB = 1e9
+const PRESETS = [100, 250, 500, 1000, 2000]
+
+const formatNumber = (v, locale, digits) => {
+  try {
+    return v.toLocaleString(locale, { maximumFractionDigits: digits })
+  } catch {
+    return v.toFixed(digits)
+  }
+}
+
+export const formatBytes = (n, locale) => {
+  if (!n) return '0 GB'
+  const [div, unit] =
+    n >= 1e12 ? [1e12, 'TB'] : n >= GB ? [GB, 'GB'] : [1e6, 'MB']
+  const v = n / div
+  return `${formatNumber(v, locale, v < 10 ? 1 : 0)} ${unit}`
+}
+
+// share of the bar: of the limit when there is one, otherwise of the disk
+export const usage = (info) => {
+  const of = info.limit || info.diskTotal || 0
+  return of ? Math.min(1, info.used / of) : 0
+}
+
+const barColor = (info, pct) =>
+  info.full ? '#ff5c7a' : pct > 0.85 ? '#f5a524' : GREEN
+
+const useStyles = makeStyles((theme) => {
+  const dark = theme.palette.type === 'dark'
+  return {
+    root: {
+      display: 'block',
+      width: 'calc(100% - 16px)',
+      boxSizing: 'border-box',
+      margin: theme.spacing(1, 1, 1),
+      padding: theme.spacing(1.5, 1.5),
+      borderRadius: 12,
+      textAlign: 'left',
+      background: dark ? 'rgba(255,255,255,0.05)' : 'rgba(0,0,0,0.04)',
+      transition: 'background 150ms ease',
+      '&:hover': {
+        background: dark ? 'rgba(255,255,255,0.09)' : 'rgba(0,0,0,0.07)',
+      },
+    },
+    compact: {
+      width: 39,
+      height: 39,
+      padding: 0,
+      margin: theme.spacing(1, 'auto'),
+      display: 'flex',
+      alignItems: 'center',
+      justifyContent: 'center',
+    },
+    head: {
+      display: 'flex',
+      alignItems: 'center',
+      gap: 8,
+      fontSize: 13,
+      fontWeight: 700,
+      color: theme.palette.text.primary,
+      '& svg': { fontSize: 18, color: theme.palette.text.secondary },
+    },
+    bar: {
+      height: 6,
+      borderRadius: 999,
+      overflow: 'hidden',
+      margin: '10px 0 8px',
+      background: dark ? 'rgba(255,255,255,0.1)' : 'rgba(0,0,0,0.1)',
+      '& > span': {
+        display: 'block',
+        height: '100%',
+        borderRadius: 999,
+        transition: 'width 400ms ease',
+      },
+    },
+    sub: {
+      fontSize: 12,
+      color: theme.palette.text.secondary,
+      lineHeight: 1.4,
+    },
+    full: { color: '#ff5c7a', fontWeight: 600 },
+    presets: {
+      display: 'flex',
+      flexWrap: 'wrap',
+      gap: 8,
+      margin: theme.spacing(2, 0, 1),
+    },
+    preset: {
+      height: 34,
+      padding: '0 14px',
+      borderRadius: 999,
+      fontSize: 13,
+      fontWeight: 600,
+      border: `1px solid ${theme.palette.divider}`,
+      '&:hover': { borderColor: theme.palette.text.primary },
+    },
+    presetOn: {
+      background: `${GREEN}26`,
+      borderColor: GREEN,
+      color: dark ? GREEN : '#0a7a35',
+    },
+    big: {
+      fontSize: 34,
+      fontWeight: 900,
+      letterSpacing: '-0.03em',
+      lineHeight: 1.1,
+    },
+  }
+})
+
+const StorageDialog = ({ info, onClose, onSaved }) => {
+  const classes = useStyles()
+  const translate = useTranslate()
+  const notify = useNotify()
+  const { permissions } = usePermissions()
+  const isAdmin = permissions === 'admin'
+  const locale = useLocale()
+  const [gb, setGb] = useState(info.limit ? String(info.limit / GB) : '')
+  const [saving, setSaving] = useState(false)
+  const pct = usage(info)
+
+  const save = (value) => {
+    const n = Number(String(value).replace(',', '.'))
+    if (value !== '' && (!Number.isFinite(n) || n < 0)) {
+      notify('resources.seer.storage.invalid', 'warning')
+      return
+    }
+    setSaving(true)
+    setStorageLimit(value === '' ? 0 : Math.round(n * GB))
+      .then((next) => {
+        onSaved(next)
+        notify('resources.seer.storage.saved', 'info')
+        onClose()
+      })
+      .catch((e) => notify(e?.body || e?.message || String(e), 'warning'))
+      .finally(() => setSaving(false))
+  }
+
+  return (
+    <Dialog open onClose={onClose} fullWidth maxWidth="xs">
+      <DialogTitle>{translate('resources.seer.storage.title')}</DialogTitle>
+      <DialogContent>
+        <div className={classes.big}>{formatBytes(info.used, locale)}</div>
+        <div className={classes.sub}>
+          {info.limit
+            ? translate('resources.seer.storage.ofLimit', {
+                limit: formatBytes(info.limit, locale),
+              })
+            : translate('resources.seer.storage.noLimit')}
+        </div>
+        <div className={classes.bar}>
+          <span
+            style={{
+              width: `${pct * 100}%`,
+              background: barColor(info, pct),
+            }}
+          />
+        </div>
+        {info.diskTotal > 0 && (
+          <div className={classes.sub}>
+            {translate('resources.seer.storage.disk', {
+              free: formatBytes(info.diskFree, locale),
+              total: formatBytes(info.diskTotal, locale),
+            })}
+          </div>
+        )}
+        {info.full && (
+          <div className={`${classes.sub} ${classes.full}`}>
+            {translate('resources.seer.storage.paused')}
+          </div>
+        )}
+        {isAdmin ? (
+          <>
+            <div className={classes.presets}>
+              {PRESETS.map((p) => (
+                <ButtonBase
+                  key={p}
+                  className={`${classes.preset} ${
+                    Number(gb) === p ? classes.presetOn : ''
+                  }`}
+                  onClick={() => setGb(String(p))}
+                >
+                  {formatBytes(p * GB, locale)}
+                </ButtonBase>
+              ))}
+              <ButtonBase
+                className={`${classes.preset} ${gb === '' ? classes.presetOn : ''}`}
+                onClick={() => setGb('')}
+              >
+                {translate('resources.seer.storage.unlimited')}
+              </ButtonBase>
+            </div>
+            <TextField
+              fullWidth
+              variant="outlined"
+              margin="dense"
+              label={translate('resources.seer.storage.limitLabel')}
+              value={gb}
+              onChange={(e) => setGb(e.target.value)}
+              placeholder={translate('resources.seer.storage.unlimited')}
+              inputProps={{ inputMode: 'decimal' }}
+              InputProps={{
+                endAdornment: (
+                  <InputAdornment position="end">GB</InputAdornment>
+                ),
+              }}
+            />
+            <div className={classes.sub}>
+              {translate('resources.seer.storage.help')}
+            </div>
+          </>
+        ) : (
+          <div className={classes.sub} style={{ marginTop: 16 }}>
+            {translate('resources.seer.storage.adminOnly')}
+          </div>
+        )}
+      </DialogContent>
+      <DialogActions>
+        <Button onClick={onClose}>{translate('ra.action.close')}</Button>
+        {isAdmin && (
+          <Button
+            color="primary"
+            variant="contained"
+            disabled={saving}
+            onClick={() => save(gb.trim())}
+          >
+            {translate('ra.action.save')}
+          </Button>
+        )}
+      </DialogActions>
+    </Dialog>
+  )
+}
+
+export const useStorage = () => {
+  const [info, setInfo] = useState(null)
+  const load = useCallback(
+    () =>
+      getStorage()
+        .then(setInfo)
+        .catch(() => {}),
+    [],
+  )
+  useEffect(() => {
+    load()
+    const t = setInterval(load, 60000)
+    return () => clearInterval(t)
+  }, [load])
+  useRefreshOnEvents({ events: ['seer'], onRefresh: load })
+  return [info, setInfo]
+}
+
+export const StorageWidget = ({ open = true }) => {
+  const classes = useStyles()
+  const translate = useTranslate()
+  const [info, setInfo] = useStorage()
+  const [dialog, setDialog] = useState(false)
+  if (!info) return null
+  const locale = useLocale()
+  const pct = usage(info)
+  const color = barColor(info, pct)
+  const title = translate('resources.seer.storage.title')
+
+  return (
+    <>
+      {open ? (
+        <ButtonBase
+          className={classes.root}
+          onClick={() => setDialog(true)}
+          aria-label={title}
+        >
+          <div className={classes.head}>
+            <StorageIcon />
+            {formatBytes(info.used, locale)}
+            <span className={classes.sub} style={{ fontWeight: 500 }}>
+              {info.limit
+                ? translate('resources.seer.storage.ofLimit', {
+                    limit: formatBytes(info.limit, locale),
+                  })
+                : translate('resources.seer.storage.music')}
+            </span>
+          </div>
+          <div className={classes.bar}>
+            <span style={{ width: `${pct * 100}%`, background: color }} />
+          </div>
+          <div className={`${classes.sub} ${info.full ? classes.full : ''}`}>
+            {info.full
+              ? translate('resources.seer.storage.fullShort')
+              : info.diskTotal > 0
+                ? translate('resources.seer.storage.diskFree', {
+                    free: formatBytes(info.diskFree, locale),
+                  })
+                : title}
+          </div>
+        </ButtonBase>
+      ) : (
+        <ButtonBase
+          className={`${classes.root} ${classes.compact}`}
+          onClick={() => setDialog(true)}
+          aria-label={title}
+          title={`${title}: ${formatBytes(info.used, locale)}`}
+        >
+          <StorageIcon style={{ color }} />
+        </ButtonBase>
+      )}
+      {dialog && (
+        <StorageDialog
+          info={info}
+          onClose={() => setDialog(false)}
+          onSaved={setInfo}
+        />
+      )}
+    </>
+  )
+}
