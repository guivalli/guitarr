diff --git a/core/seer/storage.go b/core/seer/storage.go
new file mode 100644
index 0000000..a3940ca
--- /dev/null
+++ b/core/seer/storage.go
@@ -0,0 +1,146 @@
+package seer
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"strconv"
+	"strings"
+	"sync"
+	"time"
+
+	"github.com/dustin/go-humanize"
+	"github.com/navidrome/navidrome/conf"
+	"github.com/navidrome/navidrome/core/acquire"
+	"github.com/navidrome/navidrome/log"
+	"github.com/navidrome/navidrome/model"
+)
+
+// storageLimitKey holds the limit set in the UI, in bytes. It wins over Seer.StorageLimit.
+const storageLimitKey = "SeerStorageLimit"
+
+// StorageInfo is what the storage widget shows.
+type StorageInfo struct {
+	Used      int64  `json:"used"`      // size of the music in all libraries, from the last scan
+	Limit     int64  `json:"limit"`     // 0 = no limit
+	DiskTotal uint64 `json:"diskTotal"` // the disk holding the music folder (0 if unknown)
+	DiskFree  uint64 `json:"diskFree"`
+	MinFree   uint64 `json:"minFree"`
+	Full      bool   `json:"full"`             // new downloads are refused
+	Reason    string `json:"reason,omitempty"` // why, when Full
+}
+
+// Storage measures how much the music takes and enforces the configured limits.
+type Storage struct {
+	ds   model.DataStore
+	disk func(path string) (total, free uint64, err error)
+
+	mu     sync.Mutex
+	cached *StorageInfo
+	at     time.Time
+}
+
+func NewStorage(ds model.DataStore) *Storage {
+	return &Storage{ds: ds, disk: diskUsage}
+}
+
+// ParseSize reads sizes like "500GB", "1.5 TB" or a plain number of bytes.
+// An empty string or "0" means no limit.
+func ParseSize(s string) (int64, error) {
+	s = strings.TrimSpace(s)
+	if s == "" || s == "0" {
+		return 0, nil
+	}
+	if n, err := strconv.ParseInt(s, 10, 64); err == nil {
+		return n, nil
+	}
+	n, err := humanize.ParseBytes(s)
+	if err != nil {
+		return 0, err
+	}
+	return int64(n), nil
+}
+
+func (st *Storage) limit(ctx context.Context) int64 {
+	if v, err := st.ds.Property().Get(ctx, storageLimitKey); err == nil && v != "" {
+		if n, err := strconv.ParseInt(v, 10, 64); err == nil {
+			return n
+		}
+	}
+	n, err := ParseSize(conf.Server.Seer.StorageLimit)
+	if err != nil {
+		log.Warn(ctx, "Seer: invalid Seer.StorageLimit", "value", conf.Server.Seer.StorageLimit, err)
+	}
+	return n
+}
+
+// SetLimit stores a new limit (0 removes it).
+func (st *Storage) SetLimit(ctx context.Context, bytes int64) error {
+	if bytes < 0 {
+		return errors.New("limit cannot be negative")
+	}
+	if err := st.ds.Property().Put(ctx, storageLimitKey, strconv.FormatInt(bytes, 10)); err != nil {
+		return err
+	}
+	st.mu.Lock()
+	st.cached = nil
+	st.mu.Unlock()
+	return nil
+}
+
+// Info returns the current usage. It is cached for a few seconds, since every
+// request and every import item asks for it.
+func (st *Storage) Info(ctx context.Context) (*StorageInfo, error) {
+	st.mu.Lock()
+	defer st.mu.Unlock()
+	if st.cached != nil && time.Since(st.at) < 10*time.Second {
+		c := *st.cached
+		return &c, nil
+	}
+	libs, err := st.ds.Library().GetAll(ctx)
+	if err != nil {
+		return nil, err
+	}
+	info := &StorageInfo{Limit: st.limit(ctx)}
+	minFree, err := ParseSize(conf.Server.Seer.MinFreeSpace)
+	if err != nil {
+		log.Warn(ctx, "Seer: invalid Seer.MinFreeSpace", "value", conf.Server.Seer.MinFreeSpace, err)
+	}
+	info.MinFree = uint64(max(minFree, 0))
+	for _, l := range libs {
+		info.Used += l.TotalSize
+	}
+	path := conf.Server.Seer.DestFolder
+	if path == "" && len(libs) > 0 {
+		path = libs[0].Path
+	}
+	if path != "" {
+		if total, free, err := st.disk(nearestDir(path)); err == nil {
+			info.DiskTotal, info.DiskFree = total, free
+		}
+	}
+	switch {
+	case info.Limit > 0 && info.Used >= info.Limit:
+		info.Full = true
+		info.Reason = fmt.Sprintf("%s of %s used", humanize.Bytes(uint64(info.Used)), humanize.Bytes(uint64(info.Limit)))
+	case info.DiskTotal > 0 && info.MinFree > 0 && info.DiskFree < info.MinFree:
+		info.Full = true
+		info.Reason = fmt.Sprintf("only %s free on disk", humanize.Bytes(info.DiskFree))
+	}
+	st.cached, st.at = info, time.Now()
+	c := *info
+	return &c, nil
+}
+
+// Check is the acquire.Config.CheckSpace hook.
+func (st *Storage) Check(ctx context.Context) error {
+	info, err := st.Info(ctx)
+	if err != nil {
+		log.Warn(ctx, "Seer: could not measure storage, allowing the download", err)
+		return nil
+	}
+	if info.Full {
+		return fmt.Errorf("%w: %s", acquire.ErrStorageFull, info.Reason)
+	}
+	return nil
+}
