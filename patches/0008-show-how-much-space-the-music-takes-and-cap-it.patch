+func TestStorageLimit(t *testing.T) {
+	lib := &fakeLib{have: map[string]bool{}}
+	st := NewMemoryStore()
+	var full atomic.Bool
+	cfg := fastConfig(false)
+	cfg.CheckSpace = func(context.Context) error {
+		if full.Load() {
+			return fmt.Errorf("%w: 10 GB of 10 GB used", ErrStorageFull)
+		}
+		return nil
+	}
+	src := &fakeSource{name: "a", kind: KindAlbum}
+	svc := NewService(cfg, fakeCatalog{}, []Source{src}, st, lib)
+	ctx, cancel := context.WithCancel(context.Background())
