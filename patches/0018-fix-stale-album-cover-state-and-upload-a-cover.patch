+	put("gave-up", "", "", "[]")
+	ds := &tests.MockDataStore{MockedFolder: &fakeFolders{all: []model.Folder{folder}}, MockedArtwork: repo}
+	e := NewEditor(ds, nil, nil, nil, nil)
+	albums := []model.Album{
