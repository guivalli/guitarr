+		{ID: "fine", FolderIDs: []string{"f1"}},
+		{ID: "gave-up", FolderIDs: []string{"f1"}},
+		{ID: "no-state", FolderIDs: []string{"f1"}},
+		{ID: "nothing", FolderIDs: []string{"nowhere"}},
+	}
+	got, err := e.coverStates(context.Background(), albums)
+	if err != nil {
+		t.Fatal(err)
+	}
+	want := map[string]coverState{"stale": coverStale, "fine": coverOK, "gave-up": coverStale, "no-state": coverOK, "nothing": coverNone}
+	for id, w := range want {
