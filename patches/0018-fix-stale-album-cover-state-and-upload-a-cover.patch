+// ErrBadImage: the uploaded file cannot be used as a cover (not an image, wrong format, too big).
+var ErrBadImage = errors.New("unusable image")
+
+// maxCoverUpload caps an uploaded cover; larger pictures only slow the player down.
+const maxCoverUpload = 15 << 20
+
+// SetCoverImage saves a picture the admin chose as the album's cover (same placement rules as a
+// downloaded one) and replaces whatever cover the album had. Only JPEG and PNG are accepted: those
+// are the formats that can also be embedded in the tracks.
+func (e *Editor) SetCoverImage(ctx context.Context, albumID string, data []byte) (*CoverResult, error) {
+	if len(data) == 0 {
+		return nil, fmt.Errorf("%w: empty file", ErrBadImage)
+	}
+	if len(data) > maxCoverUpload {
+		return nil, fmt.Errorf("%w: larger than %d MB", ErrBadImage, maxCoverUpload>>20)
+	}
+	cfg, format, err := image.DecodeConfig(bytes.NewReader(data))
+	if err != nil {
+		return nil, fmt.Errorf("%w: the file is not a valid image", ErrBadImage)
+	}
+	ext := ""
+	switch format {
+	case "jpeg":
+		ext = ".jpg"
+	case "png":
+		ext = ".png"
+	default:
+		return nil, fmt.Errorf("%w: use a JPG or PNG image (got %s)", ErrBadImage, format)
+	}
+	album, err := e.ds.Album().Get(ctx, albumID)
+	if errors.Is(err, model.ErrNotFound) || (err == nil && album.Missing) {
+		return nil, ErrItemNotFound
+	}
+	if err != nil {
+		return nil, err
+	}
+	files, err := e.albumSongs(ctx, albumID)
+	if err != nil {
+		return nil, err
+	}
+	cover := &acquire.Cover{Data: data, Ext: ext, Source: "manual", Width: cfg.Width, Height: cfg.Height}
+	where, err := e.storeCover(ctx, files, cover, true)
+	if err != nil {
+		return nil, fmt.Errorf("could not save the cover (is the music folder writable?): %w", err)
+	}
+	log.Info(ctx, "Seer: cover uploaded", "album", album.Name, "size", fmt.Sprintf("%dx%d", cfg.Width, cfg.Height), "where", where)
+	if err := e.rescan(ctx, files); err != nil {
+		return nil, err
+	}
+	e.refreshArtwork(ctx, albumID)
+	return &CoverResult{AlbumID: albumID, Found: true, Source: "manual"}, nil
+}
+
+// refreshArtwork makes Navidrome resolve the album's image again. Best effort: the files are
+// already in place, so a failure here only delays the new cover until the next retry.
+func (e *Editor) refreshArtwork(ctx context.Context, albumID string) {
+	if err := artwork.Refresh(context.WithoutCancel(ctx), e.ds, model.KindAlbumArtwork, albumID); err != nil {
+		log.Warn(ctx, "Seer: could not refresh album artwork", "album", albumID, err)
+	}
+}
