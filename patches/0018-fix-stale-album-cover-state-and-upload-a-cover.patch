+// albumsWithoutCover returns the albums Navidrome shows a placeholder for (stale reports which of
+// them already have the image and only need a refresh).
+func (e *Editor) albumsWithoutCover(ctx context.Context, albums model.Albums) (missing []model.Album, stale map[string]bool, err error) {
+	states, err := e.coverStates(ctx, albums)
+	if err != nil {
+		return nil, nil, err
+	}
+	stale = map[string]bool{}
+	for _, a := range albums {
+		switch states[a.ID] {
+		case coverNone:
+			missing = append(missing, a)
+		case coverStale:
+			missing = append(missing, a)
+			stale[a.ID] = true
+		}
+	}
+	sort.SliceStable(missing, func(i, j int) bool { return missing[i].SongCount > missing[j].SongCount })
+	return missing, stale, nil
+}
