+	repo := tests.CreateMockArtworkRepo()
+	put := func(id, source, path, failure string) {
+		if err := repo.PutItemArtwork(context.Background(), &model.ItemArtwork{ItemKind: "al", ItemID: id, ImageType: model.ImageTypePrimary,
+			Source: source, SourcePath: path, LastFailure: failure}); err != nil {
+			t.Fatal(err)
+		}
+	}
+	put("stale", "embedded", filepath.Join(root, "A", "ok", "01-moved.flac"), "")
