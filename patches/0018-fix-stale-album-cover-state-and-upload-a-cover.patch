+// uploadCover takes a JPEG or PNG as the request body and makes it the album's cover.
+func (api *Router) uploadCover(w http.ResponseWriter, r *http.Request) {
+	const limit = 16 << 20
+	data, err := io.ReadAll(http.MaxBytesReader(w, r.Body, limit))
+	if err != nil {
+		http.Error(w, "image too large", http.StatusRequestEntityTooLarge)
+		return
+	}
+	res, err := api.editor.SetCoverImage(r.Context(), chi.URLParam(r, "id"), data)
+	switch {
+	case errors.Is(err, seer.ErrItemNotFound):
+		http.Error(w, "not found", http.StatusNotFound)
+	case errors.Is(err, seer.ErrBadImage):
+		http.Error(w, err.Error(), http.StatusBadRequest)
+	case err != nil:
+		log.Error(r.Context(), "Seer: cover upload failed", err)
+		http.Error(w, err.Error(), http.StatusInternalServerError)
+	default:
+		writeJSON(w, http.StatusOK, res)
+	}
+}
