--- /dev/null
+++ b/server/seerapi/seerapi.go
@@ -0,0 +1,158 @@
+// Package seerapi exposes the Seer (on-demand acquisition) endpoints under /api/seer.
+package seerapi
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"net/http"
+	"strconv"
+
+	"github.com/go-chi/chi/v5"
+	"github.com/navidrome/navidrome/core/acquire"
+	"github.com/navidrome/navidrome/core/seer"
+	"github.com/navidrome/navidrome/log"
+	"github.com/navidrome/navidrome/model"
+	"github.com/navidrome/navidrome/model/request"
+	"github.com/navidrome/navidrome/server"
+)
+
+// Service is the part of the Seer used by the API.
+type Service interface {
+	SearchCatalog(ctx context.Context, query string, limit int) ([]acquire.CatalogItem, error)
+	Submit(ctx context.Context, userID string, item acquire.CatalogItem) (*acquire.Request, error)
+	Approve(ctx context.Context, id string) (*acquire.Request, error)
+	Get(ctx context.Context, id string) (*acquire.Request, error)
+	List(ctx context.Context, userID string) ([]acquire.Request, error)
+}
+
+type Router struct {
+	http.Handler
+	ds  model.DataStore
+	svc Service
+}
+
+func New(ds model.DataStore, s *seer.Seer) *Router {
+	return NewWithService(ds, s)
+}
+
+// NewWithService builds the router around any Service (used by tests).
+func NewWithService(ds model.DataStore, svc Service) *Router {
+	r := &Router{ds: ds, svc: svc}
+	r.Handler = r.routes()
+	return r
+}
+
+func (api *Router) routes() http.Handler {
+	r := chi.NewRouter()
+	r.Group(func(r chi.Router) {
+		if api.ds != nil {
+			r.Use(server.Authenticator(api.ds))
+			r.Use(server.JWTRefresher)
+		}
+		r.Get("/catalog", api.searchCatalog)
+		r.Route("/requests", func(r chi.Router) {
+			r.Get("/", api.listRequests)
+			r.Post("/", api.createRequest)
+			r.Get("/{id}", api.getRequest)
+			r.With(adminOnly).Post("/{id}/approve", api.approveRequest)
+		})
+	})
+	return r
+}
+
+func (api *Router) searchCatalog(w http.ResponseWriter, r *http.Request) {
+	limit, _ := strconv.Atoi(r.URL.Query().Get("limit"))
+	if limit <= 0 || limit > 50 {
+		limit = 10
+	}
+	items, err := api.svc.SearchCatalog(r.Context(), r.URL.Query().Get("q"), limit)
+	if err != nil {
+		log.Error(r.Context(), "Seer: catalog search failed", err)
+		http.Error(w, "catalog search failed", http.StatusBadGateway)
+		return
+	}
+	if items == nil {
+		items = []acquire.CatalogItem{}
+	}
+	writeJSON(w, http.StatusOK, items)
+}
+
+// listRequests returns the caller's requests; admins see everyone's unless ?mine=true.
+func (api *Router) listRequests(w http.ResponseWriter, r *http.Request) {
+	user, _ := request.UserFrom(r.Context())
+	userID := user.ID
+	if user.IsAdmin && r.URL.Query().Get("mine") != "true" {
+		userID = ""
+	}
+	reqs, err := api.svc.List(r.Context(), userID)
+	if err != nil {
+		log.Error(r.Context(), "Seer: listing requests failed", err)
+		http.Error(w, "internal error", http.StatusInternalServerError)
+		return
+	}
+	if reqs == nil {
+		reqs = []acquire.Request{}
+	}
+	w.Header().Set("X-Total-Count", strconv.Itoa(len(reqs)))
+	writeJSON(w, http.StatusOK, reqs)
+}
+
+func (api *Router) createRequest(w http.ResponseWriter, r *http.Request) {
+	user, _ := request.UserFrom(r.Context())
+	var item acquire.CatalogItem
+	if err := json.NewDecoder(http.MaxBytesReader(w, r.Body, 64<<10)).Decode(&item); err != nil {
+		http.Error(w, "invalid body", http.StatusBadRequest)
+		return
+	}
+	req, err := api.svc.Submit(r.Context(), user.ID, item)
+	switch {
+	case errors.Is(err, acquire.ErrInLibrary):
+		http.Error(w, err.Error(), http.StatusConflict)
+	case err != nil:
+		http.Error(w, err.Error(), http.StatusBadRequest)
+	default:
+		writeJSON(w, http.StatusCreated, req)
+	}
+}
+
+func (api *Router) getRequest(w http.ResponseWriter, r *http.Request) {
+	user, _ := request.UserFrom(r.Context())
+	req, err := api.svc.Get(r.Context(), chi.URLParam(r, "id"))
+	if err != nil || (!user.IsAdmin && req.UserID != user.ID) {
+		http.Error(w, "not found", http.StatusNotFound)
+		return
+	}
+	writeJSON(w, http.StatusOK, req)
+}
+
+func (api *Router) approveRequest(w http.ResponseWriter, r *http.Request) {
+	req, err := api.svc.Approve(r.Context(), chi.URLParam(r, "id"))
+	switch {
+	case errors.Is(err, acquire.ErrNotFound):
+		http.Error(w, "not found", http.StatusNotFound)
+	case errors.Is(err, acquire.ErrBadState):
+		http.Error(w, err.Error(), http.StatusConflict)
+	case err != nil:
+		log.Error(r.Context(), "Seer: approve failed", err)
+		http.Error(w, "internal error", http.StatusInternalServerError)
+	default:
+		writeJSON(w, http.StatusOK, req)
+	}
+}
+
+func adminOnly(next http.Handler) http.Handler {
+	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if user, ok := request.UserFrom(r.Context()); !ok || !user.IsAdmin {
+			http.Error(w, "Access denied: admin privileges required", http.StatusForbidden)
+			return
+		}
+		next.ServeHTTP(w, r)
+	})
+}
+
+func writeJSON(w http.ResponseWriter, status int, v any) {
+	w.Header().Set("Content-Type", "application/json")
+	w.WriteHeader(status)
+	_ = json.NewEncoder(w).Encode(v)
+}
