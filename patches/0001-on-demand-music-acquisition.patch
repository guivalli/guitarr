@@ -0,0 +1,100 @@
+package seerapi
+
+import (
+	"context"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+
+	"github.com/navidrome/navidrome/core/acquire"
+	"github.com/navidrome/navidrome/model"
+	"github.com/navidrome/navidrome/model/request"
+)
+
+type fakeService struct {
+	reqs     map[string]*acquire.Request
+	listedBy *string
+}
+
+func (f *fakeService) SearchCatalog(context.Context, string, int) ([]acquire.CatalogItem, error) {
+	return []acquire.CatalogItem{{Kind: acquire.KindTrack, MBID: "m", Title: "T"}}, nil
+}
+func (f *fakeService) Submit(_ context.Context, userID string, item acquire.CatalogItem) (*acquire.Request, error) {
+	if item.MBID == "owned" {
+		return nil, acquire.ErrInLibrary
+	}
+	r := &acquire.Request{ID: "new", UserID: userID, MBID: item.MBID, Status: acquire.StatusPending}
+	f.reqs[r.ID] = r
+	return r, nil
+}
+func (f *fakeService) Approve(_ context.Context, id string) (*acquire.Request, error) {
+	r, ok := f.reqs[id]
+	if !ok {
+		return nil, acquire.ErrNotFound
+	}
+	r.Status = acquire.StatusQueued
+	return r, nil
+}
+func (f *fakeService) Get(_ context.Context, id string) (*acquire.Request, error) {
+	if r, ok := f.reqs[id]; ok {
+		return r, nil
+	}
+	return nil, acquire.ErrNotFound
+}
+func (f *fakeService) List(_ context.Context, userID string) ([]acquire.Request, error) {
+	f.listedBy = &userID
+	return nil, nil
+}
+
+func do(t *testing.T, h http.Handler, user model.User, method, path, body string) *httptest.ResponseRecorder {
+	t.Helper()
+	r := httptest.NewRequest(method, path, strings.NewReader(body))
+	r = r.WithContext(request.WithUser(r.Context(), user))
+	w := httptest.NewRecorder()
+	h.ServeHTTP(w, r)
+	return w
+}
+
+func TestSeerAPI(t *testing.T) {
+	svc := &fakeService{reqs: map[string]*acquire.Request{"other": {ID: "other", UserID: "u2"}}}
+	api := NewWithService(nil, svc)
+	user := model.User{ID: "u1"}
+	admin := model.User{ID: "adm", IsAdmin: true}
+
+	if w := do(t, api, user, "GET", "/catalog?q=x", ""); w.Code != 200 || !strings.Contains(w.Body.String(), `"mbid":"m"`) {
+		t.Errorf("catalog: %d %s", w.Code, w.Body)
+	}
+	if w := do(t, api, user, "POST", "/requests", `{"kind":"track","mbid":"x","title":"T"}`); w.Code != 201 || svc.reqs["new"].UserID != "u1" {
+		t.Errorf("create: %d %s", w.Code, w.Body)
+	}
+	if w := do(t, api, user, "POST", "/requests", `{"kind":"track","mbid":"owned","title":"T"}`); w.Code != http.StatusConflict {
+		t.Errorf("create owned: %d", w.Code)
+	}
+	if w := do(t, api, user, "POST", "/requests", `not json`); w.Code != http.StatusBadRequest {
+		t.Errorf("create bad body: %d", w.Code)
+	}
+	if w := do(t, api, user, "GET", "/requests/other", ""); w.Code != http.StatusNotFound {
+		t.Errorf("users must not see other users' requests: %d", w.Code)
+	}
+	if w := do(t, api, admin, "GET", "/requests/other", ""); w.Code != 200 {
+		t.Errorf("admin get: %d", w.Code)
+	}
+	if w := do(t, api, user, "POST", "/requests/new/approve", ""); w.Code != http.StatusForbidden {
+		t.Errorf("non-admin approve: %d", w.Code)
+	}
+	if w := do(t, api, admin, "POST", "/requests/new/approve", ""); w.Code != 200 || svc.reqs["new"].Status != acquire.StatusQueued {
+		t.Errorf("admin approve: %d", w.Code)
+	}
+	if w := do(t, api, admin, "POST", "/requests/nope/approve", ""); w.Code != http.StatusNotFound {
+		t.Errorf("approve missing: %d", w.Code)
+	}
+
+	do(t, api, user, "GET", "/requests", "")
+	if *svc.listedBy != "u1" {
+		t.Errorf("users list only their own requests, listed %q", *svc.listedBy)
+	}
+	if w := do(t, api, admin, "GET", "/requests", ""); *svc.listedBy != "" || w.Body.String() != "[]\n" {
+		t.Errorf("admins list everything, listed %q body %q", *svc.listedBy, w.Body)
+	}
+}
