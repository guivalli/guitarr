diff --git a/core/acquire/catalog_musicbrainz.go b/core/acquire/catalog_musicbrainz.go
new file mode 100644
index 0000000..f39936f
--- /dev/null
+++ b/core/acquire/catalog_musicbrainz.go
@@ -0,0 +1,148 @@
+package acquire
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"net/http"
+	"net/url"
+	"strconv"
+	"strings"
+	"sync"
+	"time"
+)
+
+// DefaultUserAgent is sent when none is configured; MusicBrainz blocks empty ones.
+const DefaultUserAgent = "NavidromeSeer/0.1 ( https://github.com/navidrome/navidrome )"
+
+// luceneEscaper escapes the characters that have a meaning in MusicBrainz's
+// Lucene query syntax, so free text from the user is searched literally.
+var luceneEscaper = strings.NewReplacer(
+	`\`, `\\`, `+`, `\+`, `-`, `\-`, `!`, `\!`, `(`, `\(`, `)`, `\)`, `{`, `\{`, `}`, `\}`,
+	`[`, `\[`, `]`, `\]`, `^`, `\^`, `"`, `\"`, `~`, `\~`, `*`, `\*`, `?`, `\?`, `:`, `\:`,
+	`/`, `\/`, `&&`, `\&&`, `||`, `\||`,
+)
+
+// MusicBrainz implements Catalog using the MusicBrainz web service.
+// MusicBrainz asks for a meaningful User-Agent and at most 1 request/second.
+type MusicBrainz struct {
+	UserAgent string // e.g. "navidrome-acquire/0.1 (you@example.com)"
+	Client    *http.Client
+	BaseURL   string // default https://musicbrainz.org/ws/2
+
+	mu   sync.Mutex
+	last time.Time
+}
+
+func (m *MusicBrainz) throttle() {
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	if wait := time.Second - time.Since(m.last); wait > 0 {
+		time.Sleep(wait)
+	}
+	m.last = time.Now()
+}
+
+func (m *MusicBrainz) get(ctx context.Context, path string, q url.Values, out any) error {
+	base := m.BaseURL
+	if base == "" {
+		base = "https://musicbrainz.org/ws/2"
+	}
+	cl := m.Client
+	if cl == nil {
+		cl = &http.Client{Timeout: 15 * time.Second}
+	}
+	q.Set("fmt", "json")
+	req, err := http.NewRequestWithContext(ctx, http.MethodGet, base+path+"?"+q.Encode(), nil)
+	if err != nil {
+		return err
+	}
+	ua := m.UserAgent
+	if ua == "" {
+		ua = DefaultUserAgent
+	}
+	req.Header.Set("User-Agent", ua)
+	m.throttle()
+	resp, err := cl.Do(req)
+	if err != nil {
+		return err
+	}
+	defer resp.Body.Close()
+	if resp.StatusCode != http.StatusOK {
+		return fmt.Errorf("musicbrainz: HTTP %d", resp.StatusCode)
+	}
+	return json.NewDecoder(resp.Body).Decode(out)
+}
+
+type mbArtistCredit []struct {
+	Name string `json:"name"`
+}
+
+func (a mbArtistCredit) String() string {
+	names := make([]string, 0, len(a))
+	for _, c := range a {
+		names = append(names, c.Name)
+	}
+	return strings.Join(names, ", ")
+}
+
+func yearOf(date string) int {
+	if len(date) >= 4 {
+		if y, err := strconv.Atoi(date[:4]); err == nil {
+			return y
+		}
+	}
+	return 0
+}
+
+// Search returns a mix of albums (release groups) and tracks (recordings).
+func (m *MusicBrainz) Search(ctx context.Context, query string, limit int) ([]CatalogItem, error) {
+	if limit <= 0 {
+		limit = 10
+	}
+	var out []CatalogItem
+	query = luceneEscaper.Replace(query)
+
+	var rgs struct {
+		ReleaseGroups []struct {
+			ID           string         `json:"id"`
+			Title        string         `json:"title"`
+			PrimaryType  string         `json:"primary-type"`
+			FirstRelease string         `json:"first-release-date"`
+			ArtistCredit mbArtistCredit `json:"artist-credit"`
+		} `json:"release-groups"`
+	}
+	if err := m.get(ctx, "/release-group", url.Values{"query": {query}, "limit": {strconv.Itoa(limit)}}, &rgs); err != nil {
+		return nil, err
+	}
+	for _, rg := range rgs.ReleaseGroups {
+		if rg.PrimaryType != "" && rg.PrimaryType != "Album" && rg.PrimaryType != "EP" {
+			continue
+		}
+		out = append(out, CatalogItem{Kind: KindAlbum, MBID: rg.ID, Artist: rg.ArtistCredit.String(), Album: rg.Title, Title: rg.Title, Year: yearOf(rg.FirstRelease)})
+	}
+
+	var recs struct {
+		Recordings []struct {
+			ID           string         `json:"id"`
+			Title        string         `json:"title"`
+			Length       int            `json:"length"`
+			ArtistCredit mbArtistCredit `json:"artist-credit"`
+			Releases     []struct {
+				Title string `json:"title"`
+				Date  string `json:"date"`
+			} `json:"releases"`
+		} `json:"recordings"`
+	}
+	if err := m.get(ctx, "/recording", url.Values{"query": {query}, "limit": {strconv.Itoa(limit)}}, &recs); err != nil {
+		return out, nil // albums alone are still useful
+	}
+	for _, r := range recs.Recordings {
+		it := CatalogItem{Kind: KindTrack, MBID: r.ID, Artist: r.ArtistCredit.String(), Title: r.Title, DurationMs: r.Length}
+		if len(r.Releases) > 0 {
+			it.Album, it.Year = r.Releases[0].Title, yearOf(r.Releases[0].Date)
+		}
+		out = append(out, it)
+	}
+	return out, nil
+}
