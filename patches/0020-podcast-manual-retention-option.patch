 }
 
+// KeepManual is the keep policy for channels where nothing is downloaded by itself:
+// the user picks each episode to download.
+const KeepManual = -1
+
 // processChannelEpisodes downloads episodes matching keep policy and deletes older ones.
 func (s *PodcastService) processChannelEpisodes(ctx context.Context, ch *PodcastChannel) error {
+	if ch.KeepPolicy == KeepManual {
+		return nil
+	}
 	allEps, err := s.store.ListEpisodes(ctx, ch.ID)
 	if err != nil {
 		return err
