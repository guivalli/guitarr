+func TestManualChannelDownloadsNothingByItself(t *testing.T) {
+	db := setupTestDB(t)
+	defer db.Close()
+	store := NewPodcastStore(db)
+	ctx := context.Background()
+
+	ch := &PodcastChannel{ID: "m1", UserID: "u1", Title: "Manual", FeedURL: "https://example.com/f.xml", KeepPolicy: KeepManual}
+	if err := store.CreateChannel(ctx, ch); err != nil {
+		t.Fatalf("CreateChannel failed: %v", err)
+	}
+	pub := time.Now().UTC()
+	if err := store.CreateEpisode(ctx, &PodcastEpisode{ID: "x1", ChannelID: "m1", GUID: "g1", Title: "Ep", PublishedAt: &pub, Status: "pending"}); err != nil {
+		t.Fatalf("CreateEpisode failed: %v", err)
+	}
+
+	svc := NewPodcastService(store, func() string { return t.TempDir() }, nil, nil, "ffmpeg", "yt-dlp")
+	if err := svc.processChannelEpisodes(ctx, ch); err != nil {
+		t.Fatalf("processChannelEpisodes failed: %v", err)
+	}
+	eps, err := store.ListEpisodes(ctx, "m1")
+	if err != nil || len(eps) != 1 || eps[0].Status != "pending" {
+		t.Fatalf("manual channel must leave episodes pending, got %+v (err %v)", eps, err)
+	}
+}
