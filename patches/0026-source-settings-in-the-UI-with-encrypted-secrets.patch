diff --git a/core/seer/secrets.go b/core/seer/secrets.go
new file mode 100644
index 0000000..7124bdd
--- /dev/null
+++ b/core/seer/secrets.go
@@ -0,0 +1,114 @@
+package seer
+
+import (
+	"crypto/aes"
+	"crypto/cipher"
+	"crypto/rand"
+	"encoding/base64"
+	"errors"
+	"io"
+	"os"
+	"path/filepath"
+	"strings"
+	"sync"
+
+	"github.com/navidrome/navidrome/conf"
+)
+
+// sealedPrefix marks a value that is encrypted at rest.
+const sealedPrefix = "enc1:"
+
+const seerKeyFile = "seer.key"
+
+var (
+	keyOnce sync.Once
+	keyVal  []byte
+	keyErr  error
+)
+
+// secretKey returns the instance key that seals the secrets. It is created once, next to the
+// database, with owner-only permissions. Whoever can read the database and this file can read the
+// secrets; a copy of the database alone cannot.
+func secretKey() ([]byte, error) {
+	keyOnce.Do(func() {
+		keyVal, keyErr = loadOrCreateKey(filepath.Join(conf.Server.DataFolder.String(), seerKeyFile))
+	})
+	return keyVal, keyErr
+}
+
+func loadOrCreateKey(path string) ([]byte, error) {
+	b, err := os.ReadFile(path)
+	if err == nil {
+		key, err := base64.StdEncoding.DecodeString(strings.TrimSpace(string(b)))
+		if err != nil || len(key) != 32 {
+			return nil, errors.New("seer key file is corrupted: " + path)
+		}
+		return key, nil
+	}
+	if !errors.Is(err, os.ErrNotExist) {
+		return nil, err
+	}
+	key := make([]byte, 32)
+	if _, err := io.ReadFull(rand.Reader, key); err != nil {
+		return nil, err
+	}
+	if err := os.WriteFile(path, []byte(base64.StdEncoding.EncodeToString(key)+"\n"), 0o600); err != nil {
+		return nil, err
+	}
+	return key, nil
+}
+
+// sealSecret encrypts a secret for the database. An empty value stays empty.
+func sealSecret(plain string) (string, error) {
+	if plain == "" {
+		return "", nil
+	}
+	gcm, err := newGCM()
+	if err != nil {
+		return "", err
+	}
+	nonce := make([]byte, gcm.NonceSize())
+	if _, err := io.ReadFull(rand.Reader, nonce); err != nil {
+		return "", err
+	}
+	sealed := gcm.Seal(nonce, nonce, []byte(plain), nil)
+	return sealedPrefix + base64.StdEncoding.EncodeToString(sealed), nil
+}
+
+// openSecret decrypts a value written by sealSecret.
+func openSecret(stored string) (string, error) {
+	if stored == "" {
+		return "", nil
+	}
+	if !strings.HasPrefix(stored, sealedPrefix) {
+		return "", errors.New("secret is not sealed")
+	}
+	raw, err := base64.StdEncoding.DecodeString(strings.TrimPrefix(stored, sealedPrefix))
+	if err != nil {
+		return "", err
+	}
+	gcm, err := newGCM()
+	if err != nil {
+		return "", err
+	}
+	if len(raw) < gcm.NonceSize() {
+		return "", errors.New("sealed secret is too short")
+	}
+	plain, err := gcm.Open(nil, raw[:gcm.NonceSize()], raw[gcm.NonceSize():], nil)
+	if err != nil {
+		return "", err
+	}
+	return string(plain), nil
+}
+
+func newGCM() (cipher.AEAD, error) {
+	key, err := secretKey()
+	if err != nil {
+		return nil, err
+	}
+	block, err := aes.NewCipher(key)
+	if err != nil {
+		return nil, err
+	}
+	return cipher.NewGCM(block)
+}
