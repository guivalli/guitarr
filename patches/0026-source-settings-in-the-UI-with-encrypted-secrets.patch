+
+// stored returns the overrides as they are in the database: secrets still sealed.
+func (s *Settings) stored(ctx context.Context) (Overrides, error) {
+	var o Overrides
+	raw, err := s.ds.Property().DefaultGet(ctx, overridesKey, "")
+	if err != nil {
+		return o, err
+	}
+	if raw == "" {
+		return o, nil
+	}
+	err = json.Unmarshal([]byte(raw), &o)
+	return o, err
+}
+
+// Resolved returns the overrides with the secrets opened, ready to build the sources.
+func (s *Settings) Resolved(ctx context.Context) (Overrides, error) {
+	o, err := s.stored(ctx)
+	if err != nil {
+		return o, err
+	}
+	if o.SoulseekAPIKey, err = openPtr(o.SoulseekAPIKey); err != nil {
+		return o, err
+	}
+	if o.LidarrAPIKey, err = openPtr(o.LidarrAPIKey); err != nil {
+		return o, err
+	}
+	if o.SpotifyClientSecret, err = openPtr(o.SpotifyClientSecret); err != nil {
+		return o, err
+	}
+	return o, nil
+}
+
+// Update merges a patch from the UI into the saved overrides. Secrets in the patch are sealed
+// before they are stored; a nil field in the patch leaves the saved value alone.
+func (s *Settings) Update(ctx context.Context, patch Overrides) error {
+	if patch.Sources != nil {
+		if err := validateSources(*patch.Sources); err != nil {
+			return err
+		}
+	}
+	var err error
+	if patch.SoulseekAPIKey, err = sealPtr(patch.SoulseekAPIKey); err != nil {
+		return err
+	}
+	if patch.LidarrAPIKey, err = sealPtr(patch.LidarrAPIKey); err != nil {
+		return err
+	}
+	if patch.SpotifyClientSecret, err = sealPtr(patch.SpotifyClientSecret); err != nil {
+		return err
+	}
+	o, err := s.stored(ctx)
+	if err != nil {
+		return err
+	}
+	o.merge(patch)
+	raw, err := json.Marshal(o)
+	if err != nil {
+		return err
+	}
+	return s.ds.Property().Put(ctx, overridesKey, string(raw))
+}
