+		o.LidarrEnabled = p.LidarrEnabled
+	}
+	if p.LidarrURL != nil {
+		o.LidarrURL = p.LidarrURL
+	}
+	if p.LidarrAPIKey != nil {
+		o.LidarrAPIKey = p.LidarrAPIKey
+	}
+	if p.LidarrRootFolder != nil {
+		o.LidarrRootFolder = p.LidarrRootFolder
+	}
+	if p.SpotifyClientID != nil {
+		o.SpotifyClientID = p.SpotifyClientID
+	}
+	if p.SpotifyClientSecret != nil {
+		o.SpotifyClientSecret = p.SpotifyClientSecret
+	}
+	if p.MinFreeSpace != nil {
+		o.MinFreeSpace = p.MinFreeSpace
+	}
+}
+
+// validSources are the names liveSources knows how to build.
+var validSources = map[string]bool{"youtube": true, "soundcloud": true, "soulseek": true, "lidarr": true}
+
+func validateSources(list string) error {
+	for _, name := range strings.Split(list, ",") {
+		name = strings.ToLower(strings.TrimSpace(name))
+		if name != "" && !validSources[name] {
+			return fmt.Errorf("%w: unknown source %q", ErrInvalidConfig, name)
+		}
+	}
+	return nil
+}
+
+// pick returns the UI value when it was set there, else the .env value.
+func pick[T any](v *T, def T) T {
+	if v != nil {
+		return *v
+	}
+	return def
+}
+
+func sealPtr(v *string) (*string, error) {
+	if v == nil {
+		return nil, nil
+	}
+	sealed, err := sealSecret(*v)
+	if err != nil {
+		return nil, err
+	}
+	return &sealed, nil
+}
+
+func openPtr(v *string) (*string, error) {
+	if v == nil {
+		return nil, nil
+	}
+	plain, err := openSecret(*v)
+	if err != nil {
+		return nil, err
+	}
+	return &plain, nil
+}
