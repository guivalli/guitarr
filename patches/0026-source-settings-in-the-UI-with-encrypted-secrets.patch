+
+// getConfig returns the source settings in effect, with the secrets only reported as set.
+func (api *Router) getConfig(w http.ResponseWriter, r *http.Request) {
+	view, err := api.settings.ConfigView(r.Context())
+	if err != nil {
+		log.Error(r.Context(), "Seer: reading the config failed", err)
+		http.Error(w, "internal error", http.StatusInternalServerError)
+		return
+	}
+	writeJSON(w, http.StatusOK, view)
+}
+
+// setConfig saves the fields present in the body and applies them; absent fields are kept.
+func (api *Router) setConfig(w http.ResponseWriter, r *http.Request) {
+	var patch seer.Overrides
+	if err := json.NewDecoder(http.MaxBytesReader(w, r.Body, 16<<10)).Decode(&patch); err != nil {
+		http.Error(w, "invalid body", http.StatusBadRequest)
+		return
+	}
+	if err := api.settings.UpdateConfig(r.Context(), patch); err != nil {
+		if errors.Is(err, seer.ErrInvalidConfig) {
+			http.Error(w, err.Error(), http.StatusUnprocessableEntity)
+			return
+		}
+		log.Error(r.Context(), "Seer: saving the config failed", err)
+		http.Error(w, "internal error", http.StatusInternalServerError)
+		return
+	}
+	api.getConfig(w, r)
+}
