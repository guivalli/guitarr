From 3cfbb8dd38eaa5d05876b766c5fc8bebc3250877 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sat, 10 Oct 2026 21:33:52 +0000
Subject: [PATCH 07/10] Seer: installable app for phones and desktops

The web app installs as Guitarr, with a black splash, a new icon,
a maskable icon for Android and shortcuts to Requests and Albums. An
"Install app" entry appears in the user menu when the browser allows it.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>

---
 resources/i18n/pt-br.json            |   5 ++--
 ui/index.html                        |   2 +-
 ui/public/android-chrome-192x192.png | Bin 9876 -> 27389 bytes
 ui/public/android-chrome-512x512.png | Bin 30347 -> 142495 bytes
 ui/public/apple-touch-icon.png       | Bin 8193 -> 21192 bytes
 ui/public/favicon-16x16.png          | Bin 1002 -> 1032 bytes
 ui/public/favicon-32x32.png          | Bin 1827 -> 1817 bytes
 ui/public/favicon.ico                | Bin 15086 -> 15086 bytes
 ui/public/maskable-512x512.png       | Bin 0 -> 125008 bytes
 ui/src/common/installPrompt.js       |  36 +++++++++++++++++++++++++++
 ui/src/i18n/en.json                  |   3 ++-
 ui/src/index.jsx                     |   1 +
 ui/src/layout/AppBar.jsx             |  17 +++++++++++++
 ui/vite.config.js                    |  33 ++++++++++++++++++++----
 14 files changed, 88 insertions(+), 9 deletions(-)
 create mode 100644 ui/public/maskable-512x512.png
 create mode 100644 ui/src/common/installPrompt.js

diff --git a/resources/i18n/pt-br.json b/resources/i18n/pt-br.json
index 637be0b..dd8f16d 100644
--- a/resources/i18n/pt-br.json
+++ b/resources/i18n/pt-br.json
@@ -812,7 +812,8 @@
       "confirm": "Conectar %{app} %{version} em %{device} à sua conta?",
       "continue": "Continuar",
       "approve": "Aprovar"
-    }
+    },
+    "installApp": "Instalar app"
   },
   "player": {
     "playListsText": "Fila de Execução",
@@ -898,4 +899,4 @@
     "empty": "Nada tocando",
     "minutesAgo": "%{smart_count} minuto atrás |||| %{smart_count} minutos atrás"
   }
-}
\ No newline at end of file
+}
