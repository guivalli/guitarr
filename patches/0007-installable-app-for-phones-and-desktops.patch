diff --git a/ui/src/common/installPrompt.js b/ui/src/common/installPrompt.js
new file mode 100644
index 0000000..61ca9c3
--- /dev/null
+++ b/ui/src/common/installPrompt.js
@@ -0,0 +1,36 @@
+import { useEffect, useState } from 'react'
+
+// Chrome and Edge fire beforeinstallprompt once, early, when the app can be
+// installed. Keep it so a menu item can offer "Install app" later on.
+let deferred = null
+const listeners = new Set()
+const notify = () => listeners.forEach((l) => l(deferred))
+
+if (typeof window !== 'undefined') {
+  window.addEventListener('beforeinstallprompt', (e) => {
+    e.preventDefault()
+    deferred = e
+    notify()
+  })
+  window.addEventListener('appinstalled', () => {
+    deferred = null
+    notify()
+  })
+}
+
+export const useInstallPrompt = () => {
+  const [prompt, setPrompt] = useState(deferred)
+  useEffect(() => {
+    listeners.add(setPrompt)
+    return () => listeners.delete(setPrompt)
+  }, [])
+  const install = () => {
+    if (!prompt) return
+    prompt.prompt()
+    prompt.userChoice.finally(() => {
+      deferred = null
+      notify()
+    })
+  }
+  return { canInstall: !!prompt, install }
+}
