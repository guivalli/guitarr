+package seerapi
+
+import (
+	"context"
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+
+	"github.com/navidrome/navidrome/model"
+	"github.com/navidrome/navidrome/model/request"
+	"github.com/navidrome/navidrome/tests"
+)
+
+func callState(t *testing.T, api *Router, user model.User, method, body string) (int, map[string]json.RawMessage) {
+	t.Helper()
+	req := httptest.NewRequest(method, "/state", strings.NewReader(body))
+	req = req.WithContext(request.WithUser(context.Background(), user))
+	w := httptest.NewRecorder()
+	if method == http.MethodGet {
+		api.getState(w, req)
+	} else {
+		api.putState(w, req)
+	}
+	var out map[string]json.RawMessage
+	_ = json.Unmarshal(w.Body.Bytes(), &out)
+	return w.Code, out
+}
+
+func TestClientStateMergesPerKeyAndPerUser(t *testing.T) {
+	api := &Router{ds: &tests.MockDataStore{}}
+	u1, u2 := model.User{ID: "u1"}, model.User{ID: "u2"}
+
+	if code, st := callState(t, api, u1, "GET", ""); code != 200 || len(st) != 0 {
+		t.Fatalf("empty GET: %d %v", code, st)
+	}
+	callState(t, api, u1, "PUT", `{"playback":{"trackId":"s1","pos":42},"web":{"view":"songs"}}`)
+	code, st := callState(t, api, u1, "PUT", `{"mobile":{"tab":"seer"},"web":null}`)
+	if code != 200 {
+		t.Fatalf("PUT: %d", code)
+	}
+	if string(st["playback"]) != `{"trackId":"s1","pos":42}` || string(st["mobile"]) != `{"tab":"seer"}` {
+		t.Errorf("merged state = %v", st)
+	}
+	if _, ok := st["web"]; ok {
+		t.Errorf("null did not remove the key: %v", st)
+	}
+	var at map[string]int64
+	_ = json.Unmarshal(st["_at"], &at)
+	if at["playback"] == 0 || at["mobile"] == 0 || len(at) != 2 {
+		t.Errorf("_at = %v", at)
+	}
+	if _, other := callState(t, api, u2, "GET", ""); len(other) != 0 {
+		t.Errorf("another user sees the state: %v", other)
+	}
+	if code, _ := callState(t, api, u1, "PUT", `not json`); code != 400 {
+		t.Errorf("invalid body: %d", code)
+	}
+	if code, _ := callState(t, api, u1, "PUT", `{"big":"`+strings.Repeat("x", maxStateBytes)+`"}`); code != http.StatusRequestEntityTooLarge {
+		t.Errorf("oversized body: %d", code)
+	}
+}
