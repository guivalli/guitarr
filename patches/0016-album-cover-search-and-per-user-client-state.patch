+// fetchCover looks the album's front cover up online and saves it next to the tracks. It answers
+// 200 with found=false when no source has one; ?force=1 replaces a cover the album already has.
+func (api *Router) fetchCover(w http.ResponseWriter, r *http.Request) {
+	force := r.URL.Query().Get("force") == "1"
+	res, err := api.editor.FetchCover(r.Context(), chi.URLParam(r, "id"), force)
+	switch {
+	case errors.Is(err, seer.ErrItemNotFound):
+		http.Error(w, "not found", http.StatusNotFound)
+	case err != nil:
+		log.Error(r.Context(), "Seer: cover search failed", err)
+		http.Error(w, err.Error(), http.StatusInternalServerError)
+	default:
+		writeJSON(w, http.StatusOK, res)
+	}
+}
