+	write("A/stale/01.flac") // exists but has no embedded picture
+	folder := func(id, parent, dir string, imgs ...string) model.Folder {
+		return model.Folder{ID: id, ParentID: parent, LibraryPath: root, Path: filepath.Dir(dir), Name: filepath.Base(dir), ImageFiles: imgs}
