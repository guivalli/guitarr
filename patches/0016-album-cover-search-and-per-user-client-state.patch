+		{ID: "thumbnails-only", FolderIDs: []string{"f-thumbs"}},
+		{ID: "disc-folders", FolderIDs: []string{"f-d1", "f-d2"}},
+		{ID: "stale-embed", LibraryPath: root, EmbedArtPath: "A/stale/renamed.flac", FolderIDs: []string{"f-stale"}},
+		{ID: "embed-without-picture", LibraryPath: root, EmbedArtPath: "A/stale/01.flac", FolderIDs: []string{"f-stale"}},
+	}
+	got, err := e.albumHasCover(context.Background(), albums)
+	if err != nil {
