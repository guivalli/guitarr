diff --git a/server/seerapi/state.go b/server/seerapi/state.go
new file mode 100644
index 0000000..33ca86a
--- /dev/null
+++ b/server/seerapi/state.go
@@ -0,0 +1,121 @@
+package seerapi
+
+import (
+	"encoding/json"
+	"errors"
+	"io"
+	"net/http"
+	"sync"
+	"time"
+
+	"github.com/navidrome/navidrome/log"
+	"github.com/navidrome/navidrome/model"
+	"github.com/navidrome/navidrome/model/request"
+)
+
+// The client state lets a page that reloads, or another browser or phone, pick up where the user
+// stopped: what was playing and where, the open screen, and so on. It is an opaque JSON object
+// per user; every client owns its own top-level keys ("playback", "web", "mobile"...).
+
+const (
+	stateKey      = "seer.client-state"
+	maxStateBytes = 256 << 10
+)
+
+// stateMu serializes the read-merge-write of PUT /state.
+var stateMu sync.Mutex
+
+type clientState map[string]json.RawMessage
+
+func loadState(r *http.Request, ds model.DataStore, userID string) (clientState, error) {
+	raw, err := ds.UserProps().DefaultGet(r.Context(), userID, stateKey, "")
+	if err != nil {
+		return nil, err
+	}
+	st := clientState{}
+	if raw != "" {
+		if err := json.Unmarshal([]byte(raw), &st); err != nil {
+			st = clientState{} // a corrupted value must never lock the user out
+		}
+	}
+	return st, nil
+}
+
+// getState returns the stored state ({} when there is none).
+func (api *Router) getState(w http.ResponseWriter, r *http.Request) {
+	user, ok := request.UserFrom(r.Context())
+	if !ok {
+		http.Error(w, "unauthorized", http.StatusUnauthorized)
+		return
+	}
+	st, err := loadState(r, api.ds, user.ID)
+	if err != nil {
+		log.Error(r.Context(), "Seer: reading client state failed", err)
+		http.Error(w, "internal error", http.StatusInternalServerError)
+		return
+	}
+	writeJSON(w, http.StatusOK, st)
+}
+
+// putState merges the body into the stored state: each top-level key of the body replaces the
+// stored one, and null removes it. Keys the body does not mention are kept, so a phone and a
+// browser that save different parts never overwrite each other. The server stamps "_at.<key>"
+// (unix ms) so a client can tell how fresh a part is.
+func (api *Router) putState(w http.ResponseWriter, r *http.Request) {
+	user, ok := request.UserFrom(r.Context())
+	if !ok {
+		http.Error(w, "unauthorized", http.StatusUnauthorized)
+		return
+	}
+	body, err := io.ReadAll(http.MaxBytesReader(w, r.Body, maxStateBytes))
+	if err != nil {
+		http.Error(w, "body too large", http.StatusRequestEntityTooLarge)
+		return
+	}
+	patch := clientState{}
+	if err := json.Unmarshal(body, &patch); err != nil {
+		http.Error(w, "invalid body", http.StatusBadRequest)
+		return
+	}
+	stateMu.Lock()
+	defer stateMu.Unlock()
+	st, err := loadState(r, api.ds, user.ID)
+	if err != nil {
+		log.Error(r.Context(), "Seer: reading client state failed", err)
+		http.Error(w, "internal error", http.StatusInternalServerError)
+		return
+	}
+	stamps := map[string]int64{}
+	if raw, ok := st["_at"]; ok {
+		_ = json.Unmarshal(raw, &stamps)
+	}
+	now := time.Now().UnixMilli()
+	for k, v := range patch {
+		if k == "" || k == "_at" {
+			continue
+		}
+		if string(v) == "null" {
+			delete(st, k)
+			delete(stamps, k)
+			continue
+		}
+		st[k] = v
+		stamps[k] = now
+	}
+	st["_at"], _ = json.Marshal(stamps)
+	out, err := json.Marshal(st)
+	if err == nil && len(out) > maxStateBytes {
+		err = errors.New("state too large")
+		http.Error(w, err.Error(), http.StatusRequestEntityTooLarge)
+		return
+	}
+	if err == nil {
+		err = api.ds.UserProps().Put(r.Context(), user.ID, stateKey, string(out))
+	}
+	if err != nil {
+		log.Error(r.Context(), "Seer: saving client state failed", err)
+		http.Error(w, "internal error", http.StatusInternalServerError)
+		return
+	}
+	writeJSON(w, http.StatusOK, st)
+}
