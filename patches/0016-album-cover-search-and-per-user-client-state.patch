+func fetchCoverSetup(t *testing.T) (string, *tests.MockDataStore, *httptest.Server) {
+	var img bytes.Buffer
+	_ = jpeg.Encode(&img, image.NewRGBA(image.Rect(0, 0, 400, 400)), nil)
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
