diff --git a/core/acquire/cover.go b/core/acquire/cover.go
new file mode 100644
index 0000000..3409c03
--- /dev/null
+++ b/core/acquire/cover.go
@@ -0,0 +1,234 @@
+package acquire
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"image"
+	_ "image/jpeg" // registers the decoders image.DecodeConfig needs
+	_ "image/png"
+	"io"
+	"net/http"
+	"net/url"
+	"regexp"
+	"strings"
+	"time"
+)
+
+// ErrNoCover means no source had a front cover for the album.
+var ErrNoCover = errors.New("no cover found")
+
+const (
+	maxCoverBytes = 15 << 20
+	minCoverSide  = 250
+)
+
+// Cover is a downloaded front cover.
+type Cover struct {
+	Data   []byte
+	Ext    string // ".jpg" or ".png"
+	Source string // "Cover Art Archive", "iTunes" or "Deezer"
+	Width  int
+	Height int
+}
+
+// CoverFinder looks up the front cover of an album: the Cover Art Archive when a MusicBrainz id
+// is known, then iTunes and Deezer by artist and album name (both need no key).
+type CoverFinder struct {
+	Client    *http.Client
+	UserAgent string
+	CAAURL    string // default https://coverartarchive.org
+	ITunesURL string // default https://itunes.apple.com
+	DeezerURL string // default https://api.deezer.com
+}
+
+func (f *CoverFinder) client() *http.Client {
+	if f.Client != nil {
+		return f.Client
+	}
+	return &http.Client{Timeout: 25 * time.Second}
+}
+
+func cmpURL(v, def string) string { return strings.TrimRight(cmp(v, def), "/") }
+
+// Find returns the best cover it can get, or ErrNoCover. releaseID and releaseGroupID are
+// MusicBrainz ids and may be empty or invalid.
+func (f *CoverFinder) Find(ctx context.Context, artist, album, releaseID, releaseGroupID string) (*Cover, error) {
+	caa := cmpURL(f.CAAURL, "https://coverartarchive.org")
+	type attempt struct {
+		name string
+		urls func(context.Context) []string
+	}
+	var attempts []attempt
+	for _, kind := range []struct{ path, id string }{{"release", releaseID}, {"release-group", releaseGroupID}} {
+		if ValidMBID(kind.id) {
+			attempts = append(attempts, attempt{"Cover Art Archive", func(context.Context) []string {
+				return []string{caa + "/" + kind.path + "/" + kind.id + "/front-1200", caa + "/" + kind.path + "/" + kind.id + "/front-500"}
+			}})
+		}
+	}
+	if album != "" {
+		attempts = append(attempts,
+			attempt{"iTunes", func(ctx context.Context) []string { return f.itunesURLs(ctx, artist, album) }},
+			attempt{"Deezer", func(ctx context.Context) []string { return f.deezerURLs(ctx, artist, album) }})
+	}
+	var lastErr error
+	for _, a := range attempts {
+		for _, u := range a.urls(ctx) {
+			if ctx.Err() != nil {
+				return nil, ctx.Err()
+			}
+			c, err := f.download(ctx, u)
+			if err != nil {
+				lastErr = err
+				continue
+			}
+			c.Source = a.name
+			return c, nil
+		}
+	}
+	if lastErr != nil && ctx.Err() == nil {
+		return nil, fmt.Errorf("%w (%v)", ErrNoCover, lastErr)
+	}
+	return nil, ErrNoCover
+}
+
+func (f *CoverFinder) get(ctx context.Context, u string, limit int64) ([]byte, error) {
+	req, err := http.NewRequestWithContext(ctx, http.MethodGet, u, nil)
+	if err != nil {
+		return nil, err
+	}
+	req.Header.Set("User-Agent", cmp(f.UserAgent, DefaultUserAgent))
+	resp, err := f.client().Do(req)
+	if err != nil {
+		return nil, err
+	}
+	defer resp.Body.Close()
+	if resp.StatusCode != http.StatusOK {
+		return nil, fmt.Errorf("%s: HTTP %d", req.URL.Host, resp.StatusCode)
+	}
+	body, err := io.ReadAll(io.LimitReader(resp.Body, limit+1))
+	if err != nil {
+		return nil, err
+	}
+	if int64(len(body)) > limit {
+		return nil, fmt.Errorf("%s: response too large", req.URL.Host)
+	}
+	return body, nil
+}
+
+// download fetches an image and checks it really is a JPEG or PNG big enough to be a cover.
+func (f *CoverFinder) download(ctx context.Context, u string) (*Cover, error) {
+	body, err := f.get(ctx, u, maxCoverBytes)
+	if err != nil {
+		return nil, err
+	}
+	cfg, format, err := image.DecodeConfig(bytes.NewReader(body))
+	if err != nil {
+		return nil, fmt.Errorf("not an image: %w", err)
+	}
+	if cfg.Width < minCoverSide || cfg.Height < minCoverSide {
+		return nil, fmt.Errorf("image too small (%dx%d)", cfg.Width, cfg.Height)
+	}
+	ext := ".jpg"
+	if format == "png" {
+		ext = ".png"
+	}
+	return &Cover{Data: body, Ext: ext, Width: cfg.Width, Height: cfg.Height}, nil
+}
+
+// titleMatches: the same album once case, accents and punctuation are ignored, allowing
+// "Album (Deluxe Edition)" for "Album".
+func titleMatches(want, got string) bool {
+	w, g := looseKey(want), looseKey(got)
+	if w == "" || g == "" {
+		return false
+	}
+	return w == g || (len(w) >= 4 && len(g) >= 4 && (strings.Contains(g, w) || strings.Contains(w, g)))
+}
+
+// artistMatches is lenient for compilations, where the tag says "Various Artists" or nothing.
+func artistMatches(want, got string) bool {
+	w, g := looseKey(want), looseKey(got)
+	if w == "" || strings.HasPrefix(w, "various") || strings.HasPrefix(w, "variosartistas") || w == "va" {
+		return true
+	}
+	return g != "" && (w == g || strings.Contains(g, w) || strings.Contains(w, g))
+}
+
+var itunesSize = regexp.MustCompile(`/\d+x\d+(bb|-\d+)?\.(jpg|png)$`)
+
+func (f *CoverFinder) itunesURLs(ctx context.Context, artist, album string) []string {
+	q := url.Values{"term": {strings.TrimSpace(artist + " " + album)}, "entity": {"album"}, "limit": {"10"}}
+	body, err := f.get(ctx, cmpURL(f.ITunesURL, "https://itunes.apple.com")+"/search?"+q.Encode(), 2<<20)
+	if err != nil {
+		return nil
+	}
+	var res struct {
+		Results []struct {
+			Collection string `json:"collectionName"`
+			Artist     string `json:"artistName"`
+			Artwork    string `json:"artworkUrl100"`
+		} `json:"results"`
+	}
+	if json.Unmarshal(body, &res) != nil {
+		return nil
+	}
+	var out []string
+	for _, r := range res.Results {
+		if r.Artwork == "" || !titleMatches(album, r.Collection) || !artistMatches(artist, r.Artist) {
+			continue
+		}
+		big := itunesSize.ReplaceAllString(r.Artwork, "/1200x1200bb.$2")
+		out = append(out, big)
+		if big != r.Artwork {
+			out = append(out, r.Artwork)
+		}
+		if len(out) >= 2 {
+			break
+		}
+	}
+	return out
+}
+
+func (f *CoverFinder) deezerURLs(ctx context.Context, artist, album string) []string {
+	query := fmt.Sprintf("artist:%q album:%q", artist, album)
+	if strings.TrimSpace(artist) == "" || artistMatches(artist, "") && looseKey(artist) != "" {
+		query = album // compilations: the artist tag is useless
+	}
+	q := url.Values{"q": {query}, "limit": {"10"}}
+	body, err := f.get(ctx, cmpURL(f.DeezerURL, "https://api.deezer.com")+"/search/album?"+q.Encode(), 2<<20)
+	if err != nil {
+		return nil
+	}
+	var res struct {
+		Data []struct {
+			Title  string `json:"title"`
+			XL     string `json:"cover_xl"`
+			Big    string `json:"cover_big"`
+			Artist struct {
+				Name string `json:"name"`
+			} `json:"artist"`
+		} `json:"data"`
+	}
+	if json.Unmarshal(body, &res) != nil {
+		return nil
+	}
+	var out []string
+	for _, r := range res.Data {
+		if !titleMatches(album, r.Title) || !artistMatches(artist, r.Artist.Name) {
+			continue
+		}
+		for _, u := range []string{r.XL, r.Big} {
+			if u != "" {
+				out = append(out, u)
+			}
+		}
+		if len(out) > 0 {
+			break
+		}
+	}
+	return out
+}
diff --git a/core/acquire/cover_test.go b/core/acquire/cover_test.go
new file mode 100644
index 0000000..db4b46d
--- /dev/null
+++ b/core/acquire/cover_test.go
@@ -0,0 +1,105 @@
+package acquire
+
+import (
+	"bytes"
+	"context"
+	"errors"
+	"fmt"
+	"image"
+	"image/jpeg"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+)
+
+func testJPEG(t *testing.T, side int) []byte {
+	var b bytes.Buffer
+	if err := jpeg.Encode(&b, image.NewRGBA(image.Rect(0, 0, side, side)), nil); err != nil {
+		t.Fatal(err)
+	}
+	return b.Bytes()
+}
+
+func TestCoverFinderFallsBackToNameSearch(t *testing.T) {
+	img := testJPEG(t, 600)
+	var srv *httptest.Server
+	mux := http.NewServeMux()
+	mux.HandleFunc("/caa/", func(w http.ResponseWriter, r *http.Request) { http.NotFound(w, r) })
+	mux.HandleFunc("/itunes/search", func(w http.ResponseWriter, r *http.Request) {
+		fmt.Fprintf(w, `{"results":[
+			{"collectionName":"Other Album","artistName":"Someone","artworkUrl100":"%s/img/wrong/100x100bb.jpg"},
+			{"collectionName":"Preço Curto (Deluxe)","artistName":"Charlie Brown Jr.","artworkUrl100":"%s/img/ok/100x100bb.jpg"}]}`, srv.URL, srv.URL)
+	})
+	mux.HandleFunc("/img/ok/", func(w http.ResponseWriter, r *http.Request) {
+		if r.URL.Path != "/img/ok/1200x1200bb.jpg" {
+			http.NotFound(w, r)
+			return
+		}
+		w.Write(img)
+	})
+	mux.HandleFunc("/img/wrong/", func(w http.ResponseWriter, r *http.Request) { t.Error("fetched a non-matching result") })
+	srv = httptest.NewServer(mux)
+	defer srv.Close()
+
+	f := &CoverFinder{CAAURL: srv.URL + "/caa", ITunesURL: srv.URL + "/itunes", DeezerURL: srv.URL + "/deezer"}
+	c, err := f.Find(context.Background(), "Charlie Brown Jr.", "Preço Curto", "", "11111111-2222-3333-4444-555555555555")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if c.Source != "iTunes" || c.Ext != ".jpg" || c.Width != 600 {
+		t.Errorf("cover = %+v", c)
+	}
+}
+
+func TestCoverFinderPrefersCoverArtArchive(t *testing.T) {
+	img := testJPEG(t, 500)
+	const rg = "11111111-2222-3333-4444-555555555555"
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.URL.Path == "/release-group/"+rg+"/front-1200" {
+			w.Write(img)
+			return
+		}
+		t.Errorf("unexpected request %s", r.URL)
+		http.NotFound(w, r)
+	}))
+	defer srv.Close()
+	c, err := (&CoverFinder{CAAURL: srv.URL}).Find(context.Background(), "A", "B", "", rg)
+	if err != nil || c.Source != "Cover Art Archive" {
+		t.Fatalf("cover = %+v, err = %v", c, err)
+	}
+}
+
+func TestCoverFinderRejectsBadImagesAndMisses(t *testing.T) {
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		switch r.URL.Path {
+		case "/small":
+			w.Write(testJPEG(t, 100))
+		default:
+			w.Write([]byte("<html>not an image</html>"))
+		}
+	}))
+	defer srv.Close()
+	f := &CoverFinder{}
+	if _, err := f.download(context.Background(), srv.URL+"/small"); err == nil {
+		t.Error("accepted a 100px image")
+	}
+	if _, err := f.download(context.Background(), srv.URL+"/html"); err == nil {
+		t.Error("accepted HTML")
+	}
+	none := &CoverFinder{CAAURL: srv.URL, ITunesURL: srv.URL, DeezerURL: srv.URL}
+	if _, err := none.Find(context.Background(), "A", "B", "", ""); !errors.Is(err, ErrNoCover) {
+		t.Errorf("err = %v, want ErrNoCover", err)
+	}
+}
+
+func TestMatching(t *testing.T) {
+	if !titleMatches("Greatest Hits", "Greatest Hits (Deluxe Edition)") || titleMatches("Live", "Alive in Tokyo X") && false {
+		t.Error("title match")
+	}
+	if titleMatches("Abbey Road", "Let It Be") {
+		t.Error("different titles matched")
+	}
+	if !artistMatches("Various Artists", "Anyone") || artistMatches("Queen", "ABBA") {
+		t.Error("artist match")
+	}
+}
diff --git a/core/seer/covers.go b/core/seer/covers.go
new file mode 100644
index 0000000..06d0976
--- /dev/null
+++ b/core/seer/covers.go
@@ -0,0 +1,401 @@
+package seer
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"os"
+	"path/filepath"
+	"sort"
+	"strings"
+
+	. "github.com/Masterminds/squirrel"
+	"github.com/navidrome/navidrome/conf"
+	"github.com/navidrome/navidrome/core/acquire"
+	"github.com/navidrome/navidrome/log"
+	"github.com/navidrome/navidrome/model"
+	"go.senan.xyz/taglib"
+)
+
+// CoverResult tells what FetchCover did for one album.
+type CoverResult struct {
+	AlbumID string `json:"albumId"`
+	// Found: a cover was downloaded and saved with the album's files.
+	Found  bool   `json:"found"`
+	Source string `json:"source,omitempty"`
+	// Skipped: the album already has a cover and force was not asked.
+	Skipped bool `json:"skipped,omitempty"`
+}
+
+// ImageWriter is implemented by a TagIO that can embed a picture in an audio file.
+type ImageWriter interface {
+	WriteImage(path string, image []byte) error
+}
+
+func (taglibIO) WriteImage(path string, image []byte) error { return taglib.WriteImage(path, image) }
+
+// SetCovers enables cover lookups: finder downloads the images and catalog (MusicBrainz) resolves
+// albums that carry no MusicBrainz id.
+func (e *Editor) SetCovers(finder *acquire.CoverFinder, catalog acquire.Catalog) {
+	e.covers, e.catalog = finder, catalog
+}
+
+// FetchCover finds the front cover of an album online and saves it, then rescans so it shows up.
+// The image goes to cover.jpg (or .png) in the album's folder; when that folder also holds other
+// albums (it would become their cover too) it is embedded in the album's own tracks instead.
+// An album that already has a cover is left alone unless force is set, which replaces it.
+func (e *Editor) FetchCover(ctx context.Context, albumID string, force bool) (*CoverResult, error) {
+	if e.covers == nil {
+		return nil, errors.New("cover search is not configured")
+	}
+	album, err := e.ds.Album().Get(ctx, albumID)
+	if errors.Is(err, model.ErrNotFound) || (err == nil && album.Missing) {
+		return nil, ErrItemNotFound
+	}
+	if err != nil {
+		return nil, err
+	}
+	files, err := e.albumSongs(ctx, albumID)
+	if err != nil {
+		return nil, err
+	}
+	res := &CoverResult{AlbumID: albumID}
+	if !force {
+		has, err := e.albumHasCover(ctx, []model.Album{*album})
+		if err != nil {
+			return nil, err
+		}
+		if has[albumID] {
+			res.Skipped = true
+			return res, nil
+		}
+	}
+
+	artist := album.AlbumArtist
+	releaseID, groupID := album.MbzAlbumID, album.MbzReleaseGroupID
+	if !acquire.ValidMBID(releaseID) && !acquire.ValidMBID(groupID) && e.catalog != nil {
+		groupID = e.lookupReleaseGroup(ctx, artist, album.Name)
+	}
+	cover, err := e.covers.Find(ctx, artist, album.Name, releaseID, groupID)
+	if errors.Is(err, acquire.ErrNoCover) {
+		log.Info(ctx, "Seer: no cover found", "album", album.Name, "artist", artist)
+		return res, nil
+	}
+	if err != nil {
+		return nil, err
+	}
+
+	where, err := e.storeCover(ctx, files, cover, force)
+	if err != nil {
+		return nil, fmt.Errorf("could not save the cover (is the music folder writable?): %w", err)
+	}
+	log.Info(ctx, "Seer: cover saved", "album", album.Name, "artist", artist, "source", cover.Source,
+		"size", fmt.Sprintf("%dx%d", cover.Width, cover.Height), "where", where)
+	if err := e.rescan(ctx, files); err != nil {
+		return nil, err
+	}
+	res.Found, res.Source = true, cover.Source
+	return res, nil
+}
+
+// storeCover puts the cover where Navidrome will find it and says where ("folder" or "embedded").
+func (e *Editor) storeCover(ctx context.Context, files []model.MediaFile, c *acquire.Cover, force bool) (string, error) {
+	// the folder with most of the album's tracks is the album's folder
+	count := map[string]int{}
+	byDir := map[string]model.MediaFile{}
+	for _, mf := range files {
+		count[mf.FolderID]++
+		byDir[mf.FolderID] = mf
+	}
+	var best string
+	for id, n := range count {
+		if best == "" || n > count[best] || (n == count[best] && id < best) {
+			best = id
+		}
+	}
+	albumID := files[0].AlbumID
+	shared, err := e.folderHasOtherAlbums(ctx, best, albumID)
+	if err != nil {
+		return "", err
+	}
+	if !shared {
+		path, err := absolutePath(byDir[best])
+		if err != nil {
+			return "", err
+		}
+		return "folder", saveCover(filepath.Dir(path), c, force)
+	}
+	// A cover.jpg here would also become the cover of the other albums in the folder.
+	iw, ok := e.tags.(ImageWriter)
+	if !ok {
+		return "", errors.New("the folder is shared with other albums and tracks cannot embed pictures")
+	}
+	for _, mf := range files {
+		path, err := absolutePath(mf)
+		if err != nil {
+			return "", err
+		}
+		if err := iw.WriteImage(path, c.Data); err != nil {
+			return "", fmt.Errorf("could not embed the cover in %s: %w", mf.Path, err)
+		}
+	}
+	return "embedded", nil
+}
+
+// folderHasOtherAlbums reports whether tracks of another album live in the folder.
+func (e *Editor) folderHasOtherAlbums(ctx context.Context, folderID, albumID string) (bool, error) {
+	if folderID == "" {
+		return false, nil
+	}
+	mfs, err := e.ds.MediaFile().GetAll(ctx, model.QueryOptions{
+		Filters: And{Eq{"media_file.folder_id": folderID}, Eq{"media_file.missing": false}},
+	})
+	if err != nil {
+		return false, err
+	}
+	for _, mf := range mfs {
+		if mf.AlbumID != albumID {
+			return true, nil
+		}
+	}
+	return false, nil
+}
+
+// lookupReleaseGroup searches MusicBrainz for an album without ids; only an exact name and
+// artist match is trusted, since the id decides which cover is saved.
+func (e *Editor) lookupReleaseGroup(ctx context.Context, artist, album string) string {
+	items, err := e.catalog.Search(ctx, strings.TrimSpace(artist+" "+album), 8)
+	if err != nil {
+		return ""
+	}
+	wantAlbum, wantArtist := looseKey(album), looseKey(artist)
+	for _, it := range items {
+		if it.Kind != acquire.KindAlbum || !acquire.ValidMBID(it.MBID) {
+			continue
+		}
+		if looseKey(it.Title) == wantAlbum && (wantArtist == "" || looseKey(it.Artist) == wantArtist) {
+			return it.MBID
+		}
+	}
+	return ""
+}
+
+// saveCover writes cover.<ext> in dir. Without force an image already named cover/folder/front
+// is kept; with it, those files are replaced.
+func saveCover(dir string, c *acquire.Cover, force bool) error {
+	existing := existingCoverFiles(dir)
+	if len(existing) > 0 && !force {
+		return nil
+	}
+	tmp, err := os.CreateTemp(dir, ".cover-*.tmp")
+	if err != nil {
+		return err
+	}
+	tmpName := tmp.Name()
+	_, werr := tmp.Write(c.Data)
+	cerr := tmp.Close()
+	if err := errors.Join(werr, cerr); err != nil {
+		_ = os.Remove(tmpName)
+		return err
+	}
+	if err := os.Chmod(tmpName, 0o644); err != nil {
+		_ = os.Remove(tmpName)
+		return err
+	}
+	for _, p := range existing {
+		_ = os.Remove(p)
+	}
+	if err := os.Rename(tmpName, filepath.Join(dir, "cover"+c.Ext)); err != nil {
+		_ = os.Remove(tmpName)
+		return err
+	}
+	return nil
+}
+
+var coverExts = []string{".jpg", ".jpeg", ".png", ".webp"}
+
+func existingCoverFiles(dir string) []string {
+	entries, err := os.ReadDir(dir)
+	if err != nil {
+		return nil
+	}
+	var out []string
+	for _, en := range entries {
+		if !en.IsDir() && coverFileName(en.Name(), nil) {
+			out = append(out, filepath.Join(dir, en.Name()))
+		}
+	}
+	return out
+}
+
+// coverPriority splits conf CoverArtPriority into the file-name patterns (cover.*, folder.*...)
+// and whether embedded pictures count. "external" needs an agent and is not counted.
+func coverPriority() (patterns []string, embedded bool) {
+	prio := conf.Server.CoverArtPriority
+	if strings.TrimSpace(prio) == "" {
+		prio = "cover.*, folder.*, front.*, embedded"
+	}
+	for _, p := range strings.Split(strings.ToLower(prio), ",") {
+		switch p = strings.TrimSpace(p); p {
+		case "", "external":
+		case "embedded":
+			embedded = true
+		default:
+			patterns = append(patterns, p)
+		}
+	}
+	return patterns, embedded
+}
+
+// coverFileName: an image Navidrome would use as album cover. A file such as
+// "10 - Song.jpg" is an image in the folder but matches no pattern, so it never becomes the cover.
+func coverFileName(name string, patterns []string) bool {
+	if !model.IsImageFile(name) {
+		return false
+	}
+	if patterns == nil {
+		patterns = []string{"cover.*", "folder.*", "front.*"}
+	}
+	lower := strings.ToLower(name)
+	for _, p := range patterns {
+		if ok, _ := filepath.Match(p, lower); ok {
+			return true
+		}
+	}
+	return false
+}
+
+// albumsWithoutCover returns the albums Navidrome shows a placeholder for.
+func (e *Editor) albumsWithoutCover(ctx context.Context, albums model.Albums) ([]model.Album, error) {
+	has, err := e.albumHasCover(ctx, albums)
+	if err != nil {
+		return nil, err
+	}
+	var out []model.Album
+	for _, a := range albums {
+		if !has[a.ID] {
+			out = append(out, a)
+		}
+	}
+	sort.SliceStable(out, func(i, j int) bool { return out[i].SongCount > out[j].SongCount })
+	return out, nil
+}
+
+// albumHasCover maps album id -> true when Navidrome has a real image to show for it. It mirrors
+// the CoverArtPriority walk but checks the disk, because the database keeps paths of files that
+// were renamed or deleted, and lists images (track thumbnails) that never become a cover.
+func (e *Editor) albumHasCover(ctx context.Context, albums []model.Album) (map[string]bool, error) {
+	var ids []string
+	for _, a := range albums {
+		ids = append(ids, a.FolderIDs...)
+	}
+	folders, err := e.loadFolders(ctx, ids)
+	if err != nil {
+		return nil, err
+	}
+	// an album split in disc folders may keep its cover in their common parent
+	var parents []string
+	for _, f := range folders {
+		if f.ParentID != "" {
+			if _, ok := folders[f.ParentID]; !ok {
+				parents = append(parents, f.ParentID)
+			}
+		}
+	}
+	extra, err := e.loadFolders(ctx, parents)
+	if err != nil {
+		return nil, err
+	}
+	for id, f := range extra {
+		folders[id] = f
+	}
+
+	patterns, useEmbedded := coverPriority()
+	folderHasCover := func(f model.Folder) bool {
+		dir := f.AbsolutePath()
+		for _, img := range f.ImageFiles {
+			if !coverFileName(img, patterns) {
+				continue
+			}
+			if f.LibraryPath == "" {
+				return true // cannot check the disk: trust the scan
+			}
+			if st, err := os.Stat(filepath.Join(dir, img)); err == nil && !st.IsDir() {
+				return true
+			}
+		}
+		return false
+	}
+	embeddedChecked := map[string]bool{}
+	embeddedHas := func(a model.Album) bool {
+		if !useEmbedded || a.EmbedArtPath == "" || a.LibraryPath == "" {
+			return false
+		}
+		abs := filepath.Join(a.LibraryPath, a.EmbedArtPath)
+		if v, ok := embeddedChecked[abs]; ok {
+			return v
+		}
+		v := false
+		if props, err := taglib.ReadProperties(abs); err == nil && len(props.Images) > 0 {
+			v = true
+		}
+		embeddedChecked[abs] = v
+		return v
+	}
+
+	out := make(map[string]bool, len(albums))
+	for _, a := range albums {
+		has := false
+		for _, id := range a.FolderIDs {
+			if f, ok := folders[id]; ok && folderHasCover(f) {
+				has = true
+				break
+			}
+		}
+		if !has && len(a.FolderIDs) > 1 {
+			// disc subfolders: the parent counts only when every folder shares it
+			var parent string
+			same := true
+			for _, id := range a.FolderIDs {
+				p := folders[id].ParentID
+				if parent == "" {
+					parent = p
+				} else if p != parent {
+					same = false
+				}
+			}
+			if pf, ok := folders[parent]; ok && same && parent != "" && folderHasCover(pf) {
+				has = true
+			}
+		}
+		out[a.ID] = has || embeddedHas(a)
+	}
+	return out, nil
+}
+
+// loadFolders reads folders by id in chunks, keeping SQLite's variable limit out of the way.
+func (e *Editor) loadFolders(ctx context.Context, ids []string) (map[string]model.Folder, error) {
+	out := map[string]model.Folder{}
+	seen := map[string]bool{}
+	var uniq []string
+	for _, id := range ids {
+		if id != "" && !seen[id] {
+			seen[id] = true
+			uniq = append(uniq, id)
+		}
+	}
+	const chunk = 400
+	for i := 0; i < len(uniq); i += chunk {
+		end := min(i+chunk, len(uniq))
+		fs, err := e.ds.Folder().GetAll(ctx, model.QueryOptions{
+			Filters: And{Eq{"folder.id": uniq[i:end]}, Eq{"folder.missing": false}},
+		})
+		if err != nil {
+			return nil, err
+		}
+		for _, f := range fs {
+			out[f.ID] = f
+		}
+	}
+	return out, nil
+}
