+// A folder holding tracks of another album must not get a cover.jpg (it would cover both).
+func TestFetchCoverEmbedsWhenFolderIsShared(t *testing.T) {
+	root, ds, srv := fetchCoverSetup(t)
+	files := model.MediaFiles{
