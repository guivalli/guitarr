+	if err := saveCover(dir, c, true); err != nil {
+		t.Fatal(err)
+	}
+	if b, _ := os.ReadFile(filepath.Join(dir, "cover.png")); string(b) != "new" {
+		t.Errorf("cover.png = %q", b)
+	}
+	if _, err := os.Stat(old); err == nil {
+		t.Error("old cover kept after force")
+	}
+	if m, _ := filepath.Glob(filepath.Join(dir, ".cover-*")); len(m) != 0 {
+		t.Errorf("temp files left: %v", m)
