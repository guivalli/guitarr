# Guitarr needs no secrets here: run ./setup.sh and use Settings in the web UI.
# Everything below is optional (none of it is secret).
# Copy this file to .env (cp .env.example .env) and uncomment what you want to change.

# Where the data (database, slskd, downloads) and the music library live. Default: ./data and ./music
# GUITARR_DATA=/srv/guitarr
# MUSIC_DIR=/srv/music

# Public address (goes in the User-Agent of the MusicBrainz queries), time zone and file owner
# PUBLIC_URL=https://guitarr.example.com
# TZ=America/Sao_Paulo
# PUID=1000
# PGID=1000

# Docker Compose project name (change only if you already had an install under another name)
# COMPOSE_PROJECT_NAME=guitarr

# YouTube cookies, to import private lists (a file inside GUITARR_DATA/guitarr)
# YOUTUBE_COOKIES=/data/youtube-cookies.txt

# Faster Spotify playlist import (optional; public playlists work without it). Prefer the Settings page.
# SPOTIFY_CLIENT_ID=
